module d_uhex4
 ! vec3: se reutiliza la definicion real de mtipos.f90 (no se retipea).
 ! Solo se usa a traves de %comp en todo duhe4x/uhe4x -- nunca se llama
 ! a los operadores sobrecargados (+,-,*,=) que mtipos.f90 define para
 ! vec3, asi que no hace falta preocuparse de si esos operadores (que
 ! son solo host) se pueden usar en device: aqui no se usan en absoluto.
 use mtipos, only: vec3
 ! calpleg/calderpleg ya portados y probados en calpleg-calderpleg/ --
 ! se reutilizan en vez de volver a escribirlos.
 use mlegendre_gpu, only: calpleg => calplegd, calderpleg => calderplegd, lmax_dev
 ! rij**pxhe4(2,il)/rij**pxhe4(4,il): exponente REAL (nu/p4 de in.mcv,
 ! no enteros) -> pow(x,y), que tiene implementaciones independientes
 ! en host (rapida/precisa segun -Kieee) y device (libdevice), sin
 ! garantia de coincidir con gfortran -- ver docs-kernels/
 ! He_dihydrogen.md Parte 5 y glibc_math.md Parte 4. mypow (glibc_pow.cuf)
 ! cierra ese hueco, verificado con 30 casos (incluido este rij real).
 use glibc_pow_mod, only: mypow

 implicit none
 integer, private, parameter :: i4 = selected_int_kind(9)
 integer, private, parameter :: r8 = selected_real_kind(15,9)

 ! lxhe4, impurmol y pxhe4 en el original (mparametros.f90) NO son
 ! PARAMETER: son variables que mentradatos.f90 rellena una vez al leer
 ! in.mcv y que se quedan fijas el resto de la simulacion. Al ser
 ! variables de verdad (no constantes de compilacion), necesitan su
 ! propia copia "device" y un copiado explicito desde el host -- pero
 ! se declaran aqui, a nivel de modulo, con el MISMO nombre que usa el
 ! cuerpo de duhe4x/uhe4x (sin cambiar ni una linea de esos cuerpos),
 ! y una variable device a nivel de modulo se puede leer tanto desde
 ! el host como desde el device de una subrutina host,device (comprobado).
 integer(kind=i4), device :: lxhe4
 logical, device :: impurmol
 real(kind=r8), device :: pxhe4(5,0:lmax_dev)

contains

attributes(host, device) subroutine duhe4x(rivec, smol, d1ux, d2ux, d1zux, d2zux)
  type(vec3), intent (in) :: rivec,smol(3)
  type(vec3), intent (out) :: d1ux
  real(kind=r8), intent (out) :: d2ux
  real(kind=r8), intent (out) :: d1zux(2),d2zux
  type(vec3) :: grz,grpl,grul
  real(kind=r8) :: rij,cth,zpr,grz2,lapz
  real(kind=r8) :: gpz(2),lpz,gpz2
  real(kind=r8) :: ulx,ulxp,ulxs,lapl
  real(kind=r8) :: rijp2,rijp4
  real(kind=r8) :: pl(0:lmax_dev),d1pl(0:lmax_dev),d2pl(0:lmax_dev)
  integer(kind=i4) :: il

   rij=sqrt(dot_product(rivec%comp,rivec%comp))
   if(impurmol) then
     cth=dot_product(rivec%comp,smol(3)%comp)/rij
     zpr=cth/rij
     grz%comp=(smol(3)%comp-zpr*rivec%comp)/rij
     grz2=dot_product(grz%comp,grz%comp)
     lapz=-2.0_r8*zpr/rij
     gpz(1)=-dot_product(rivec%comp,smol(2)%comp)/rij
     gpz(2)= dot_product(rivec%comp,smol(1)%comp)/rij
     gpz2=dot_product(gpz,gpz)
     lpz=-cth-cth
   else
     cth=0.0_r8
     grz%comp=0.0_r8
     grz2=0.0_r8
     lapz=0.0_r8
     gpz=0.0_r8
     lpz=0.0_r8
   endif
   call calderpleg(lxhe4,cth,pl(0:lxhe4),d1pl(0:lxhe4),d2pl(0:lxhe4))
   do il=1,lxhe4
     pl(il)=1.0_r8-pl(il)
     d1pl(il)=-d1pl(il)
     d2pl(il)=-d2pl(il)
   enddo

   d1ux%comp=0.0_r8
   d2ux=0.0_r8
   d1zux=0.0_r8
   d2zux=0.0_r8
   do il=0,lxhe4
     rijp2=mypow(rij,pxhe4(2,il))
     rijp4=mypow(rij,pxhe4(4,il))
     ulx=  -pxhe4(1,il)/rijp2                                   &
 &         -pxhe4(3,il)*rijp4-pxhe4(5,il)*log(rij)
     ulxp=( pxhe4(1,il)*pxhe4(2,il)/rijp2                       &
 &         -pxhe4(3,il)*pxhe4(4,il)*rijp4-pxhe4(5,il))/rij
     ulxs=(-pxhe4(1,il)*pxhe4(2,il)*(pxhe4(2,il)+1.0_r8)/rijp2  &
 &         -pxhe4(3,il)*pxhe4(4,il)*(pxhe4(4,il)-1.0_r8)*rijp4  &
 &         +pxhe4(5,il))/rij**2
     ulxs=ulxs+2.0_r8*ulxp/rij
     grul%comp=ulxp/rij*rivec%comp
     grpl%comp=d1pl(il)*grz%comp
     lapl=lapz*d1pl(il)+grz2*d2pl(il)
     d1ux%comp=d1ux%comp+pl(il)*grul%comp
     d1ux%comp=d1ux%comp+ulx*grpl%comp
     d2ux=d2ux+pl(il)*ulxs
     d2ux=d2ux+ulx*lapl
     d2ux=d2ux+2.0_r8*dot_product(grul%comp,grpl%comp)
     d1zux(:)=d1zux(:)+ulx*d1pl(il)*gpz(:)
     d2zux=d2zux+ulx*(d1pl(il)*lpz+d2pl(il)*gpz2)
   enddo
end subroutine duhe4x

attributes(host, device) function uhe4x(rij, cth)
  real(kind=r8) :: uhe4x
  real(kind=r8), intent (in) :: rij,cth
  real(kind=r8) :: pl(0:lmax_dev)
  real(kind=r8) :: ul
  integer(kind=i4) :: il

   call calpleg(lxhe4,cth,pl(0:lxhe4))
   do il=1,lxhe4
     pl(il)=1.0_r8-pl(il)
   enddo

   uhe4x=0.0_r8
   do il=0,lxhe4
     ul=-pxhe4(1,il)/mypow(rij,pxhe4(2,il))-pxhe4(3,il)*mypow(rij,pxhe4(4,il))  &
 &      -pxhe4(5,il)*log(rij)
     uhe4x=uhe4x+ul*pl(il)
   enddo
end function uhe4x

! un hilo = un rivec (+ el marco smol compartido) = un duhe4x
attributes(global) subroutine k_duhe4x(n, rivec, smol, d1ux, d2ux, d1zux, d2zux)
  integer(kind=i4), value :: n
  type(vec3), device, intent (in)  :: rivec(n), smol(3)
  type(vec3), device, intent (out) :: d1ux(n)
  real(kind=r8), device, intent (out) :: d2ux(n)
  real(kind=r8), device, intent (out) :: d1zux(2,n), d2zux(n)
  integer(kind=i4) :: i

  i = (blockIdx%x - 1) * blockDim%x + threadIdx%x
  if (i <= n) then
    call duhe4x(rivec(i), smol, d1ux(i), d2ux(i), d1zux(:,i), d2zux(i))
  endif
end subroutine k_duhe4x

! un hilo = un (rij,cth) = un uhe4x
attributes(global) subroutine k_uhe4x(n, rij, cth, uhe4x_out)
  integer(kind=i4), value :: n
  real(kind=r8), device, intent (in)  :: rij(n), cth(n)
  real(kind=r8), device, intent (out) :: uhe4x_out(n)
  integer(kind=i4) :: i

  i = (blockIdx%x - 1) * blockDim%x + threadIdx%x
  if (i <= n) then
    uhe4x_out(i) = uhe4x(rij(i), cth(i))
  endif
end subroutine k_uhe4x

end module d_uhex4


