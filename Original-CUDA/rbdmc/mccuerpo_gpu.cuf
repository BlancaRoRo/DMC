! mccuerpo_gpu.cuf
!
! Kernel CUDA para ccuerpo (msistref.f90).
! Transforma las posiciones de los atomos He del sistema lab al sistema
! de referencia de la molecula impureza.
!
! Para cada atomo jatom (1..ngatom):
!   rtemp = atom(jatom) - atom(natom)       [posicion relativa al CM impureza]
!   rhe(ic, jatom) = sum_jc sprop(ic)%comp(jc) * rtemp(jc)  [rotacion]
!
! SOA entrada: atom(natom, nw), sprop(3, 3, nw)
! SOA salida:  rhe(3*ngatom, nw)  -- mismo formato que la CPU (array 1D)
!
module mccuerpo_gpu
  use cudafor
  implicit none

  integer, private, parameter :: r8 = selected_real_kind(15,9)
  integer, private, parameter :: i4 = selected_int_kind(9)

  integer(i4), parameter, public :: NATOM_MAX_CC = 26

  !---------------------------------------------------------------------------
  ! Parametros en device
  !---------------------------------------------------------------------------
  integer(i4), device, public :: d_ngatom_cc  ! He4 + He3
  integer(i4), device, public :: d_natom_cc   ! ngatom + 1 (CM impureza)

  !---------------------------------------------------------------------------
  ! SOA en device
  !---------------------------------------------------------------------------
  real(r8), device, allocatable, public :: d_atom_soa_cc(:,:,:)   ! (3, natom, nw)
  real(r8), device, allocatable, public :: d_sprop_soa_cc(:,:,:)  ! (3, 3, nw)
  real(r8), device, allocatable, public :: d_rhe_soa(:,:)         ! (3*ngatom, nw)

contains

  !===========================================================================
  subroutine ccuerpo_gpu_init(ngatom_h, natom_h)
    integer(i4), intent(in) :: ngatom_h, natom_h
    d_ngatom_cc = ngatom_h
    d_natom_cc  = natom_h
  end subroutine ccuerpo_gpu_init

  !===========================================================================
  subroutine ccuerpo_gpu_alloc(nw, ng, na)
    integer(i4), intent(in) :: nw, ng, na
    integer :: istat
    if (allocated(d_atom_soa_cc)) &
      deallocate(d_atom_soa_cc, d_sprop_soa_cc, d_rhe_soa)
    allocate(d_atom_soa_cc(3, na, nw),  stat=istat)
    allocate(d_sprop_soa_cc(3, 3, nw), stat=istat)
    allocate(d_rhe_soa(3*ng, nw),      stat=istat)
  end subroutine ccuerpo_gpu_alloc

  !===========================================================================
  ! AOS -> SOA (H2D)
  !===========================================================================
  subroutine aos_to_soa_cc(wsim, nw, na)
    use mtipos, only: walker
    type(walker), intent(in) :: wsim(nw)
    integer(i4),  intent(in) :: nw, na
    real(r8) :: h_atom(3, na, nw), h_sprop(3, 3, nw)
    integer(i4) :: iw, ia, iv
    do iw = 1, nw
      do ia = 1, na
        h_atom(1,ia,iw) = wsim(iw)%atom(ia)%comp(1)
        h_atom(2,ia,iw) = wsim(iw)%atom(ia)%comp(2)
        h_atom(3,ia,iw) = wsim(iw)%atom(ia)%comp(3)
      end do
      do iv = 1, 3
        h_sprop(1,iv,iw) = wsim(iw)%sprop(iv)%comp(1)
        h_sprop(2,iv,iw) = wsim(iw)%sprop(iv)%comp(2)
        h_sprop(3,iv,iw) = wsim(iw)%sprop(iv)%comp(3)
      end do
    end do
    d_atom_soa_cc  = h_atom
    d_sprop_soa_cc = h_sprop
  end subroutine aos_to_soa_cc

  !===========================================================================
  ! Kernel ccuerpo: un hilo por walker
  !===========================================================================
  attributes(global) subroutine ccuerpo_kernel(nw)
    integer(i4), value :: nw
    integer(i4) :: iw, jatom, ic, jc
    real(r8) :: rtemp(3), sprop(3, 3), rhe_atom(3)

    iw = (blockIdx%x - 1) * blockDim%x + threadIdx%x
    if (iw > nw) return

    ! Cargar matrix de rotacion sprop(jc, ic) = sprop(ic)%comp(jc) en CPU
    do ic = 1, 3
      do jc = 1, 3
        sprop(jc, ic) = d_sprop_soa_cc(jc, ic, iw)
      end do
    end do

    do jatom = 1, d_ngatom_cc
      ! Posicion relativa al CM de la impureza
      rtemp(1) = d_atom_soa_cc(1, jatom, iw) - d_atom_soa_cc(1, d_natom_cc, iw)
      rtemp(2) = d_atom_soa_cc(2, jatom, iw) - d_atom_soa_cc(2, d_natom_cc, iw)
      rtemp(3) = d_atom_soa_cc(3, jatom, iw) - d_atom_soa_cc(3, d_natom_cc, iw)
      ! Rotacion al sistema molecular: rhe_ic = sum_jc sprop(ic)%comp(jc) * rtemp_jc
      do ic = 1, 3
        rhe_atom(ic) = sprop(1,ic)*rtemp(1) + sprop(2,ic)*rtemp(2) + sprop(3,ic)*rtemp(3)
      end do
      d_rhe_soa(3*(jatom-1)+1, iw) = rhe_atom(1)
      d_rhe_soa(3*(jatom-1)+2, iw) = rhe_atom(2)
      d_rhe_soa(3*(jatom-1)+3, iw) = rhe_atom(3)
    end do
  end subroutine ccuerpo_kernel

  !===========================================================================
  subroutine ccuerpo_gpu_run(nw)
    integer(i4), intent(in) :: nw
    integer(i4), parameter  :: NTHREADS = 256
    integer(i4) :: nblocks; integer :: istat
    nblocks = (nw + NTHREADS - 1) / NTHREADS
    call ccuerpo_kernel<<<nblocks, NTHREADS>>>(nw)
    istat = cudaDeviceSynchronize()
  end subroutine ccuerpo_gpu_run

  !===========================================================================
  ! SOA -> AOS (D2H)
  !===========================================================================
  subroutine soa_to_aos_cc(nw, ng, rhe_out)
    integer(i4), intent(in)  :: nw, ng
    real(r8),    intent(out) :: rhe_out(3*ng, nw)
    rhe_out = d_rhe_soa
  end subroutine soa_to_aos_cc

  !===========================================================================
  ! Wrapper completo
  !===========================================================================
  subroutine ccuerpo_gpu(wsim, nw, ng, na, rhe_out)
    use mtipos, only: walker
    type(walker), intent(in) :: wsim(nw)
    integer(i4),  intent(in) :: nw, ng, na
    real(r8),    intent(out) :: rhe_out(3*ng, nw)
    call ccuerpo_gpu_init(ng, na)
    call ccuerpo_gpu_alloc(nw, ng, na)
    call aos_to_soa_cc(wsim, nw, na)
    call ccuerpo_gpu_run(nw)
    call soa_to_aos_cc(nw, ng, rhe_out)
  end subroutine ccuerpo_gpu

end module mccuerpo_gpu
