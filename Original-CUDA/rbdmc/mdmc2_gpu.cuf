! mdmc2_gpu.cuf
!
! Implementacion GPU de dmc2 (msteps.f90) mediante enfoque multi-kernel.
!
! Un kernel global no puede llamar a otro kernel global, por lo que dmc2_gpu
! orquesta kernels separados ya verificados:
!
!   1. difusion_kernel: x += sigma1*gauss3 + 0.5*sigma2*dwf  (1er semipaso)
!                        + rotacion molecular (si rotamol)
!   2. hpsi_gpu_run: derananum + vpot + ene=kin+pot
!   3. Comprobacion signo y ratio (branching_check_kernel, escribe d_activo)
!   4. deriva_kernel: x += 0.5*sigma2*dwf  (2o semipaso)
!                     + rotacion molecular (si rotamol)
!   5. hpsi_gpu_run: segunda evaluacion
!   6. Comprobacion signo, ratio y branching_kernel: nsons = int(gb + rn1)
!
! Esta estructura multi-kernel sacrifica eficiencia (6 lanzamientos por paso)
! pero permite reutilizar los modulos ya verificados sin duplicar codigo.
! Un kernel monolitico de produccion necesitaria inlinear todo (estilo SIMT).
!
! SOA propios: sigma1, sigma2, sigmas de rotacion, bandera activo, nsons.
! SOA compartidos con mderananum_gpu, mvpot_gpu, mhpsi_gpu, mgauss3_gpu.
!
module mdmc2_gpu
  use cudafor
  use mgauss3_gpu,    only: rn1_g3, gauss3_d, gauss3_gpu_alloc, gauss3_gpu_init_seeds, d_irn_g3
  use mrota_gpu,      only: rota_d
  use mderananum_gpu, only: d_atom_soa_da, d_sprop_soa_da, d_dwf_soa_da, d_dphi_soa_da, &
                             d_wf_soa_da, d_kin_soa_da, d_signoup_soa_da, d_signodw_soa_da, &
                             d_natom_da, d_wfhe4_soa_da, d_wfhe3_soa_da, d_wfm_soa_da,     &
                             d_wfx_soa_da, d_eimp_soa_da, d_erot_soa_da,                    &
                             d_hb2m_soa_da, d_b_soa_da
  use mvpot_gpu,      only: d_atom_soa_vp, d_sprop_soa_vp, d_pot_vp, d_natom_vp
  use mhpsi_gpu,      only: hpsi_gpu_run, d_ene_hpsi, hpsi_gpu_alloc_ene
  implicit none

  integer, private, parameter :: r8 = selected_real_kind(15,9)
  integer, private, parameter :: i4 = selected_int_kind(9)
  integer, private, parameter :: i8 = selected_int_kind(15)

  !---------------------------------------------------------------------------
  ! Parametros en device especificos de dmc2
  !---------------------------------------------------------------------------
  integer(i4), device, public :: d_ncmtras_d2
  logical,     device, public :: d_rotamol_d2
  real(r8),    device, public :: d_etrial_d2, d_dtau_d2, d_ratio_d2

  !---------------------------------------------------------------------------
  ! SOA propios de dmc2
  !---------------------------------------------------------------------------
  real(r8),    device, allocatable, public :: d_sigma1_d2(:,:)
  real(r8),    device, allocatable, public :: d_sigma2_d2(:,:)
  real(r8),    device, allocatable, public :: d_sig1rot_d2(:)
  real(r8),    device, allocatable, public :: d_sig2rot_d2(:)
  real(r8),    device, allocatable, public :: d_sig1hrot_d2(:)
  real(r8),    device, allocatable, public :: d_sig2hrot_d2(:)
  ! Estado del walker antes del paso (para branching)
  real(r8),    device, allocatable, public :: d_eold_d2(:)
  real(r8),    device, allocatable, public :: d_logwfold_d2(:)   ! log(|wf|) antes del paso
  integer(i4), device, allocatable, public :: d_supold_d2(:), d_sdwold_d2(:)
  ! Bandera: walker activo (no rechazado por signo o ratio)
  integer(i4), device, allocatable, public :: d_activo_d2(:)
  ! Resultado
  integer(i4), device, allocatable, public :: d_nsons_d2(:)
  ! Indice para scatter de branching GPU: new_index(iw_new) = iw_old
  integer(i4), device, allocatable, public :: d_new_index_d2(:)
  ! Gaussianos prefijados por la CPU para el test de logica sin RNG GPU
  real(r8),    device, allocatable, public :: d_gauss_fixed(:,:,:)  ! (3, n_gauss, nw)

contains

  !===========================================================================
  subroutine dmc2_gpu_init(ncmtras_h, rotamol_h, etrial_h, dtau_h, ratio_h)
    integer(i4), intent(in) :: ncmtras_h
    logical,     intent(in) :: rotamol_h
    real(r8),    intent(in) :: etrial_h, dtau_h, ratio_h
    d_ncmtras_d2 = ncmtras_h
    d_rotamol_d2 = rotamol_h
    d_etrial_d2  = etrial_h
    d_dtau_d2    = dtau_h
    d_ratio_d2   = ratio_h
  end subroutine dmc2_gpu_init

  !===========================================================================
  subroutine dmc2_gpu_alloc(nw, na)
    integer(i4), intent(in) :: nw, na
    integer :: istat
    if (allocated(d_sigma1_d2)) then
      deallocate(d_sigma1_d2, d_sigma2_d2)
      deallocate(d_sig1rot_d2, d_sig2rot_d2, d_sig1hrot_d2, d_sig2hrot_d2)
      deallocate(d_eold_d2, d_logwfold_d2, d_supold_d2, d_sdwold_d2)
      deallocate(d_activo_d2, d_nsons_d2)
    end if
    allocate(d_sigma1_d2(na, nw),  stat=istat)
    allocate(d_sigma2_d2(na, nw),  stat=istat)
    allocate(d_sig1rot_d2(nw),     stat=istat)
    allocate(d_sig2rot_d2(nw),     stat=istat)
    allocate(d_sig1hrot_d2(nw),    stat=istat)
    allocate(d_sig2hrot_d2(nw),    stat=istat)
    allocate(d_eold_d2(nw),        stat=istat)
    allocate(d_logwfold_d2(nw),    stat=istat)
    allocate(d_supold_d2(nw),      stat=istat)
    allocate(d_sdwold_d2(nw),      stat=istat)
    allocate(d_activo_d2(nw),      stat=istat)
    allocate(d_nsons_d2(nw),       stat=istat)
    allocate(d_new_index_d2(nw),   stat=istat)
    call gauss3_gpu_alloc(nw)
    call hpsi_gpu_alloc_ene(nw)
  end subroutine dmc2_gpu_alloc

  !===========================================================================
  subroutine aos_to_soa_d2(wsim, nw, na)
    use mtipos, only: walker
    type(walker), intent(in) :: wsim(nw)
    integer(i4),  intent(in) :: nw, na
    real(r8), allocatable :: h_s1(:,:), h_s2(:,:)
    real(r8), allocatable :: h_sr1(:), h_sr2(:), h_shr1(:), h_shr2(:)
    integer(i4) :: iw, ia
    allocate(h_s1(na,nw), h_s2(na,nw), h_sr1(nw), h_sr2(nw), h_shr1(nw), h_shr2(nw))
    do iw = 1, nw
      do ia = 1, na
        h_s1(ia,iw) = wsim(iw)%sigma1(ia)
        h_s2(ia,iw) = wsim(iw)%sigma2(ia)
      end do
      h_sr1(iw)  = wsim(iw)%sig1rot
      h_sr2(iw)  = wsim(iw)%sig2rot
      h_shr1(iw) = wsim(iw)%sig1hrot
      h_shr2(iw) = wsim(iw)%sig2hrot
    end do
    d_sigma1_d2=h_s1;    d_sigma2_d2=h_s2
    d_sig1rot_d2=h_sr1;  d_sig2rot_d2=h_sr2
    d_sig1hrot_d2=h_shr1; d_sig2hrot_d2=h_shr2
    deallocate(h_s1, h_s2, h_sr1, h_sr2, h_shr1, h_shr2)
  end subroutine aos_to_soa_d2

  !===========================================================================
  ! Kernel 0: guardar estado inicial del walker (eold, wfold, signos)
  !===========================================================================
  attributes(global) subroutine save_state_kernel(nw)
    integer(i4), value :: nw
    integer(i4) :: iw
    iw = (blockIdx%x-1)*blockDim%x + threadIdx%x
    if (iw > nw) return
    d_eold_d2(iw)     = d_ene_hpsi(iw)
    d_logwfold_d2(iw) = log(abs(d_wf_soa_da(iw)))
    d_supold_d2(iw) = d_signoup_soa_da(iw)
    d_sdwold_d2(iw) = d_signodw_soa_da(iw)
    d_activo_d2(iw) = 1
    d_nsons_d2(iw)  = 0
  end subroutine save_state_kernel

  !===========================================================================
  ! Kernel 1: primer semipaso de difusion + rotacion
  ! x_i <- x_i + sigma1_i * xi + 0.5 * sigma2_i * dwf_i
  !===========================================================================
  attributes(global) subroutine difusion_kernel(nw)
    integer(i4), value :: nw
    integer(i4) :: iw, iatom, ic
    real(r8) :: g1, g2, g3, xl, arg, sig1, sig2, phix1, phiy, phix2
    real(r8) :: sprop(3, 3)
    integer(8) :: st, s1, s2
    ! LCG hardcodeado: el estado 'st' vive en registro durante todo el kernel.
    ! Esto evita que el compilador cachee d_irn_g3(iw) entre llamadas,
    ! que era la causa de que los atomos 2..N usasen la semilla incorrecta.
    integer(8), parameter :: mk24 = 16777215_8
    integer(8), parameter :: mk48 = 281474976710655_8
    real(r8),   parameter :: tm48 = 2.0_r8**(-48)
    real(r8),   parameter :: pi2  = 6.2831853071795864_r8
    integer(8), parameter :: m11k = 15184245_8
    integer(8), parameter :: m12k = 2651554_8
    integer(8), parameter :: ak   = 96309754297_8

    iw = (blockIdx%x-1)*blockDim%x + threadIdx%x
    if (iw > nw) return

    ! Una sola lectura de memoria global → registro local st
    st = d_irn_g3(iw)

    do iatom = 1, d_ncmtras_d2
      ! Box-Muller inline con 4 pasos LCG sobre st (todo en registros)
      s2=iand(ishft(st,-24),mk24); s1=iand(st,mk24)
      st=iand(ishft(iand(s1*m12k+s2*m11k,mk24),24)+s1*m11k+ak,mk48)
      arg = pi2 * real(ior(st,1_8),r8) * tm48
      s2=iand(ishft(st,-24),mk24); s1=iand(st,mk24)
      st=iand(ishft(iand(s1*m12k+s2*m11k,mk24),24)+s1*m11k+ak,mk48)
      xl = sqrt(-2.0_r8 * log(real(ior(st,1_8),r8) * tm48))
      g1 = xl * sin(arg);  g2 = xl * cos(arg)
      s2=iand(ishft(st,-24),mk24); s1=iand(st,mk24)
      st=iand(ishft(iand(s1*m12k+s2*m11k,mk24),24)+s1*m11k+ak,mk48)
      arg = pi2 * real(ior(st,1_8),r8) * tm48
      s2=iand(ishft(st,-24),mk24); s1=iand(st,mk24)
      st=iand(ishft(iand(s1*m12k+s2*m11k,mk24),24)+s1*m11k+ak,mk48)
      xl = sqrt(-2.0_r8 * log(real(ior(st,1_8),r8) * tm48))
      g3 = xl * sin(arg)
      sig1 = d_sigma1_d2(iatom,iw);  sig2 = d_sigma2_d2(iatom,iw)
      d_atom_soa_da(1,iatom,iw) = d_atom_soa_da(1,iatom,iw) + sig1*g1 + 0.5_r8*sig2*d_dwf_soa_da(1,iatom,iw)
      d_atom_soa_da(2,iatom,iw) = d_atom_soa_da(2,iatom,iw) + sig1*g2 + 0.5_r8*sig2*d_dwf_soa_da(2,iatom,iw)
      d_atom_soa_da(3,iatom,iw) = d_atom_soa_da(3,iatom,iw) + sig1*g3 + 0.5_r8*sig2*d_dwf_soa_da(3,iatom,iw)
    end do

    if (d_rotamol_d2) then
      ! Rotacion: otro Box-Muller con el mismo estado st continuo
      s2=iand(ishft(st,-24),mk24); s1=iand(st,mk24)
      st=iand(ishft(iand(s1*m12k+s2*m11k,mk24),24)+s1*m11k+ak,mk48)
      arg = pi2 * real(ior(st,1_8),r8) * tm48
      s2=iand(ishft(st,-24),mk24); s1=iand(st,mk24)
      st=iand(ishft(iand(s1*m12k+s2*m11k,mk24),24)+s1*m11k+ak,mk48)
      xl = sqrt(-2.0_r8 * log(real(ior(st,1_8),r8) * tm48))
      g1 = xl * sin(arg);  g2 = xl * cos(arg)
      s2=iand(ishft(st,-24),mk24); s1=iand(st,mk24)
      st=iand(ishft(iand(s1*m12k+s2*m11k,mk24),24)+s1*m11k+ak,mk48)
      arg = pi2 * real(ior(st,1_8),r8) * tm48
      s2=iand(ishft(st,-24),mk24); s1=iand(st,mk24)
      st=iand(ishft(iand(s1*m12k+s2*m11k,mk24),24)+s1*m11k+ak,mk48)
      xl = sqrt(-2.0_r8 * log(real(ior(st,1_8),r8) * tm48))
      g3 = xl * sin(arg)
      phix1=d_sig1hrot_d2(iw)*g1+0.5_r8*d_sig2hrot_d2(iw)*d_dphi_soa_da(1,iw)
      phiy =d_sig1rot_d2(iw) *g2+0.5_r8*d_sig2rot_d2(iw) *d_dphi_soa_da(2,iw)
      phix2=d_sig1hrot_d2(iw)*g3+0.5_r8*d_sig2hrot_d2(iw)*d_dphi_soa_da(1,iw)
      do ic=1,3; do iatom=1,3; sprop(ic,iatom)=d_sprop_soa_da(ic,iatom,iw); end do; end do
      call rota_d(1,phix1,sprop); call rota_d(2,phiy,sprop); call rota_d(1,phix2,sprop)
      do ic=1,3; do iatom=1,3; d_sprop_soa_da(ic,iatom,iw)=sprop(ic,iatom); end do; end do
    end if

    ! Una sola escritura a memoria global al final del kernel
    d_irn_g3(iw) = st
  end subroutine difusion_kernel

  !===========================================================================
  ! Kernel 2: comprobar signo y ratio tras primer hpsi
  ! wftest = (wf_new/wf_old)^2 = exp(2*(logwf_new - logwfold))
  ! Se compara en espacio log para evitar underflow a 0.
  ! IEEE 754: si wf_old=0 y wf_new=0 -> -Inf-(-Inf)=NaN, NaN<log(ratio)=F.
  !===========================================================================
  attributes(global) subroutine check1_kernel(nw)
    integer(i4), value :: nw
    integer(i4) :: iw
    real(r8) :: logdiff
    iw = (blockIdx%x-1)*blockDim%x + threadIdx%x
    if (iw > nw) return
    if (d_signoup_soa_da(iw) /= d_supold_d2(iw) .or. d_signodw_soa_da(iw) /= d_sdwold_d2(iw)) then
      d_activo_d2(iw) = 0;  return
    end if
    logdiff = 2.0_r8 * (log(abs(d_wf_soa_da(iw))) - d_logwfold_d2(iw))
    if (logdiff < log(d_ratio_d2)) d_activo_d2(iw) = 0
  end subroutine check1_kernel

!===========================================================================
  ! Kernel 3: segundo semipaso de deriva (solo walkers activos)
  !===========================================================================
  attributes(global) subroutine deriva_kernel(nw)
    integer(i4), value :: nw
    integer(i4) :: iw, iatom, ic
    real(r8) :: phix1, phiy, phix2, sprop(3,3)
    iw = (blockIdx%x-1)*blockDim%x + threadIdx%x
    if (iw > nw) return
    if (d_activo_d2(iw) == 0) return
    do iatom = 1, d_ncmtras_d2
      d_atom_soa_da(1,iatom,iw)=d_atom_soa_da(1,iatom,iw)+0.5_r8*d_sigma2_d2(iatom,iw)*d_dwf_soa_da(1,iatom,iw)
      d_atom_soa_da(2,iatom,iw)=d_atom_soa_da(2,iatom,iw)+0.5_r8*d_sigma2_d2(iatom,iw)*d_dwf_soa_da(2,iatom,iw)
      d_atom_soa_da(3,iatom,iw)=d_atom_soa_da(3,iatom,iw)+0.5_r8*d_sigma2_d2(iatom,iw)*d_dwf_soa_da(3,iatom,iw)
    end do
    if (d_rotamol_d2) then
      phix1=0.5_r8*d_sig2hrot_d2(iw)*d_dphi_soa_da(1,iw)
      phiy =0.5_r8*d_sig2rot_d2(iw) *d_dphi_soa_da(2,iw)
      phix2=0.5_r8*d_sig2hrot_d2(iw)*d_dphi_soa_da(1,iw)
      do ic=1,3; do iatom=1,3; sprop(ic,iatom)=d_sprop_soa_da(ic,iatom,iw); end do; end do
      call rota_d(1,phix1,sprop); call rota_d(2,phiy,sprop); call rota_d(1,phix2,sprop)
      do ic=1,3; do iatom=1,3; d_sprop_soa_da(ic,iatom,iw)=sprop(ic,iatom); end do; end do
    end if
  end subroutine deriva_kernel

  !===========================================================================
  ! Kernel 4: branching (solo walkers activos tras 2o hpsi)
  !===========================================================================
  attributes(global) subroutine branching_kernel(nw)
    integer(i4), value :: nw
    integer(i4) :: iw, nsons
    real(r8) :: gb, logdiff
    iw = (blockIdx%x-1)*blockDim%x + threadIdx%x
    if (iw > nw) return
    if (d_activo_d2(iw) == 0) then; d_nsons_d2(iw)=0; return; end if
    if (d_signoup_soa_da(iw)/=d_supold_d2(iw) .or. d_signodw_soa_da(iw)/=d_sdwold_d2(iw)) then
      d_nsons_d2(iw)=0; return
    end if
    logdiff = 2.0_r8 * (log(abs(d_wf_soa_da(iw))) - d_logwfold_d2(iw))
    if (logdiff < log(d_ratio_d2)) then; d_nsons_d2(iw)=0; return; end if
    gb    = exp(-(0.5_r8*(d_eold_d2(iw)+d_ene_hpsi(iw)) - d_etrial_d2)*d_dtau_d2)
    nsons = int(gb + rn1_g3(iw))
    if (nsons > 10) nsons = 0
    d_nsons_d2(iw) = nsons
  end subroutine branching_kernel

  !===========================================================================
  ! Kernel de sincronizacion: copia posiciones de d_atom_soa_da (derananum)
  ! a d_atom_soa_vp (vpot) para que vpot use las posiciones actualizadas.
  ! Necesario tras difusion_kernel y deriva_kernel.
  !===========================================================================
  attributes(global) subroutine sync_soa_kernel(nw, na)
    integer(i4), value :: nw, na
    integer(i4) :: iw, ia, ic
    iw = (blockIdx%x-1)*blockDim%x + threadIdx%x
    if (iw > nw) return
    do ia = 1, na
      d_atom_soa_vp(1,ia,iw) = d_atom_soa_da(1,ia,iw)
      d_atom_soa_vp(2,ia,iw) = d_atom_soa_da(2,ia,iw)
      d_atom_soa_vp(3,ia,iw) = d_atom_soa_da(3,ia,iw)
    end do
    do ic = 1, 3
      d_sprop_soa_vp(1,ic,iw) = d_sprop_soa_da(1,ic,iw)
      d_sprop_soa_vp(2,ic,iw) = d_sprop_soa_da(2,ic,iw)
      d_sprop_soa_vp(3,ic,iw) = d_sprop_soa_da(3,ic,iw)
    end do
  end subroutine sync_soa_kernel

  !===========================================================================
  ! SOA -> AOS (D2H): escribe estado actualizado del walker en wsim
  ! (usado por pasodmc_gpu en mmontecarlo para recuperar resultados a CPU)
  !===========================================================================
  subroutine soa_to_aos_dmc_result(wsim, nw, na)
    use mtipos, only: walker
    type(walker), intent(inout) :: wsim(nw)
    integer(i4),  intent(in)   :: nw, na
    ! Allocatable para evitar stack overflow (h_atom y h_dwf son ~3 MB cada una)
    real(r8), allocatable :: h_atom(:,:,:), h_sprop(:,:,:), h_dwf(:,:,:), h_dphi(:,:)
    real(r8), allocatable :: h_wf(:), h_wfhe4(:), h_wfhe3(:), h_wfm(:), h_wfx(:)
    real(r8), allocatable :: h_kin(:), h_pot(:), h_ene(:), h_eimp(:), h_erot(:)
    integer(i4), allocatable :: h_sup(:), h_sdw(:)
    integer(i4) :: iw, ia
    allocate(h_atom(3,na,nw), h_sprop(3,3,nw), h_dwf(3,na,nw), h_dphi(2,nw))
    allocate(h_wf(nw), h_wfhe4(nw), h_wfhe3(nw), h_wfm(nw), h_wfx(nw))
    allocate(h_kin(nw), h_pot(nw), h_ene(nw), h_eimp(nw), h_erot(nw))
    allocate(h_sup(nw), h_sdw(nw))
    ! D2H
    h_atom=d_atom_soa_da; h_sprop=d_sprop_soa_da; h_dwf=d_dwf_soa_da; h_dphi=d_dphi_soa_da
    h_wf=d_wf_soa_da; h_wfhe4=d_wfhe4_soa_da; h_wfhe3=d_wfhe3_soa_da
    h_wfm=d_wfm_soa_da; h_wfx=d_wfx_soa_da
    h_kin=d_kin_soa_da; h_pot=d_pot_vp; h_ene=d_ene_hpsi
    h_eimp=d_eimp_soa_da; h_erot=d_erot_soa_da
    h_sup=d_signoup_soa_da; h_sdw=d_signodw_soa_da
    ! Escribir a wsim
    do iw = 1, nw
      do ia = 1, na
        wsim(iw)%atom(ia)%comp(1)=h_atom(1,ia,iw)
        wsim(iw)%atom(ia)%comp(2)=h_atom(2,ia,iw)
        wsim(iw)%atom(ia)%comp(3)=h_atom(3,ia,iw)
        wsim(iw)%dwf(ia)%comp(1) =h_dwf(1,ia,iw)
        wsim(iw)%dwf(ia)%comp(2) =h_dwf(2,ia,iw)
        wsim(iw)%dwf(ia)%comp(3) =h_dwf(3,ia,iw)
      end do
      do ia = 1, 3
        wsim(iw)%sprop(ia)%comp(1)=h_sprop(1,ia,iw)
        wsim(iw)%sprop(ia)%comp(2)=h_sprop(2,ia,iw)
        wsim(iw)%sprop(ia)%comp(3)=h_sprop(3,ia,iw)
      end do
      wsim(iw)%dphi=h_dphi(:,iw)
      wsim(iw)%lw%wf=h_wf(iw); wsim(iw)%lw%wfhe4=h_wfhe4(iw); wsim(iw)%lw%wfhe3=h_wfhe3(iw)
      wsim(iw)%lw%wfm=h_wfm(iw); wsim(iw)%lw%wfx=h_wfx(iw)
      wsim(iw)%lw%kin=h_kin(iw); wsim(iw)%lw%pot=h_pot(iw); wsim(iw)%lw%ene=h_ene(iw)
      wsim(iw)%lw%eimp=h_eimp(iw); wsim(iw)%lw%erot=h_erot(iw)
      wsim(iw)%lw%signoup=h_sup(iw); wsim(iw)%lw%signodw=h_sdw(iw)
    end do
    deallocate(h_atom, h_sprop, h_dwf, h_dphi)
    deallocate(h_wf, h_wfhe4, h_wfhe3, h_wfm, h_wfx)
    deallocate(h_kin, h_pot, h_ene, h_eimp, h_erot)
    deallocate(h_sup, h_sdw)
  end subroutine soa_to_aos_dmc_result

!===========================================================================
  ! Orquestador principal: secuencia completa de dmc2 en GPU
  ! El sync_soa_kernel garantiza que vpot use las posiciones actualizadas
  ! tras la difusion y la deriva.
  !===========================================================================
  subroutine dmc2_gpu_run(nw, libre_h)
    integer(i4), intent(in) :: nw
    logical,     intent(in) :: libre_h
    integer(i4), parameter  :: NTHREADS = 256
    integer(i4) :: nblocks, na; integer :: istat
    nblocks = (nw+NTHREADS-1)/NTHREADS
    na = d_natom_da

    call save_state_kernel<<<nblocks,NTHREADS>>>(nw)
    istat = cudaDeviceSynchronize()

    call difusion_kernel<<<nblocks,NTHREADS>>>(nw)
    istat = cudaDeviceSynchronize()

    ! Sincronizar posiciones a SOA de vpot antes de hpsi
    call sync_soa_kernel<<<nblocks,NTHREADS>>>(nw, na)
    istat = cudaDeviceSynchronize()

    call hpsi_gpu_run(nw, libre_h)

    call check1_kernel<<<nblocks,NTHREADS>>>(nw)
    istat = cudaDeviceSynchronize()

    call deriva_kernel<<<nblocks,NTHREADS>>>(nw)
    istat = cudaDeviceSynchronize()

    ! Sincronizar de nuevo tras la deriva
    call sync_soa_kernel<<<nblocks,NTHREADS>>>(nw, na)
    istat = cudaDeviceSynchronize()

    call hpsi_gpu_run(nw, libre_h)

    call branching_kernel<<<nblocks,NTHREADS>>>(nw)
    istat = cudaDeviceSynchronize()
  end subroutine dmc2_gpu_run

  !===========================================================================
  ! Kernel scatter para branching GPU.
  ! Reorganiza el SOA en base al array d_new_index_d2:
  !   d_new_index_d2(iw_new) = iw_old -> copia SOA[iw_old] -> SOA[iw_new]
  !
  ! El branching CPU garantiza que new_index[i] >= i para i en el primer
  ! barrido, por lo que NO hay hazards de lectura/escritura entre hilos.
  !
  ! Todos los campos del walker se copian (dinamicos + constantes), para
  ! que la nueva poblacion sea coherente sin necesitar nada de la CPU.
  !===========================================================================
  attributes(global) subroutine scatter_soa_kernel(nw_new, na)
    integer(i4), value :: nw_new, na
    integer(i4) :: iw_new, iw_old, ia, ic
    integer(i8) :: seed_mix

    iw_new = (blockIdx%x-1)*blockDim%x + threadIdx%x
    if (iw_new > nw_new) return
    iw_old = d_new_index_d2(iw_new)
    if (iw_new == iw_old) return  ! walker no movido, nada que copiar

    ! Campos de mderananum_gpu
    ! Copiar todos los atomos (da Y vp deben tener los mismos na atomos)
    do ia = 1, na
      d_atom_soa_da(1,ia,iw_new) = d_atom_soa_da(1,ia,iw_old)
      d_atom_soa_da(2,ia,iw_new) = d_atom_soa_da(2,ia,iw_old)
      d_atom_soa_da(3,ia,iw_new) = d_atom_soa_da(3,ia,iw_old)
      d_atom_soa_vp(1,ia,iw_new) = d_atom_soa_vp(1,ia,iw_old)   ! bug fix: ia no ic
      d_atom_soa_vp(2,ia,iw_new) = d_atom_soa_vp(2,ia,iw_old)
      d_atom_soa_vp(3,ia,iw_new) = d_atom_soa_vp(3,ia,iw_old)
      d_dwf_soa_da(1,ia,iw_new)  = d_dwf_soa_da(1,ia,iw_old)
      d_dwf_soa_da(2,ia,iw_new)  = d_dwf_soa_da(2,ia,iw_old)
      d_dwf_soa_da(3,ia,iw_new)  = d_dwf_soa_da(3,ia,iw_old)
      d_hb2m_soa_da(ia,iw_new)   = d_hb2m_soa_da(ia,iw_old)
      d_sigma1_d2(ia,iw_new)     = d_sigma1_d2(ia,iw_old)
      d_sigma2_d2(ia,iw_new)     = d_sigma2_d2(ia,iw_old)
    end do
    ! Copiar los 3 ejes moleculares (sprop: dimension 3x3)
    do ic = 1, 3
      d_sprop_soa_da(1,ic,iw_new) = d_sprop_soa_da(1,ic,iw_old)
      d_sprop_soa_da(2,ic,iw_new) = d_sprop_soa_da(2,ic,iw_old)
      d_sprop_soa_da(3,ic,iw_new) = d_sprop_soa_da(3,ic,iw_old)
      d_sprop_soa_vp(1,ic,iw_new) = d_sprop_soa_vp(1,ic,iw_old)
      d_sprop_soa_vp(2,ic,iw_new) = d_sprop_soa_vp(2,ic,iw_old)
      d_sprop_soa_vp(3,ic,iw_new) = d_sprop_soa_vp(3,ic,iw_old)
    end do
    d_dphi_soa_da(1,iw_new)  = d_dphi_soa_da(1,iw_old)
    d_dphi_soa_da(2,iw_new)  = d_dphi_soa_da(2,iw_old)
    d_wf_soa_da(iw_new)      = d_wf_soa_da(iw_old)
    d_wfhe4_soa_da(iw_new)   = d_wfhe4_soa_da(iw_old)
    d_wfhe3_soa_da(iw_new)   = d_wfhe3_soa_da(iw_old)
    d_wfm_soa_da(iw_new)     = d_wfm_soa_da(iw_old)
    d_wfx_soa_da(iw_new)     = d_wfx_soa_da(iw_old)
    d_kin_soa_da(iw_new)     = d_kin_soa_da(iw_old)
    d_pot_vp(iw_new)          = d_pot_vp(iw_old)
    d_ene_hpsi(iw_new)        = d_ene_hpsi(iw_old)
    d_eimp_soa_da(iw_new)    = d_eimp_soa_da(iw_old)
    d_erot_soa_da(iw_new)    = d_erot_soa_da(iw_old)
    d_signoup_soa_da(iw_new) = d_signoup_soa_da(iw_old)
    d_signodw_soa_da(iw_new) = d_signodw_soa_da(iw_old)
    d_b_soa_da(iw_new)       = d_b_soa_da(iw_old)
    d_sig1rot_d2(iw_new)     = d_sig1rot_d2(iw_old)
    d_sig2rot_d2(iw_new)     = d_sig2rot_d2(iw_old)
    d_sig1hrot_d2(iw_new)    = d_sig1hrot_d2(iw_old)
    d_sig2hrot_d2(iw_new)    = d_sig2hrot_d2(iw_old)
    ! Semilla RNG: deriva desde la semilla origen para decorrelacionar walkers replicados
    seed_mix = ieor(d_irn_g3(iw_old), int(iw_new, i8) * 6364136223846793005_i8)
    d_irn_g3(iw_new) = seed_mix
  end subroutine scatter_soa_kernel

  !===========================================================================
  ! apply_scatter: sube indices desde CPU, ejecuta scatter en GPU.
  ! Transferencia minima: 4 bytes × nw_new (H2D tiny).
  !===========================================================================
  subroutine apply_scatter(h_new_index, nw_new, na)
    integer(i4), intent(in) :: h_new_index(nw_new), nw_new, na
    integer(i4), parameter  :: NTHREADS = 256
    integer(i4) :: nblocks; integer :: istat
    d_new_index_d2(1:nw_new) = h_new_index   ! H2D tiny
    nblocks = (nw_new+NTHREADS-1)/NTHREADS
    call scatter_soa_kernel<<<nblocks,NTHREADS>>>(nw_new, na)
    istat = cudaDeviceSynchronize()
  end subroutine apply_scatter

  !===========================================================================
  ! Asignar d_gauss_fixed: (3, n_gauss, nw) para test de logica sin RNG GPU
  !===========================================================================
  subroutine gauss_fixed_alloc(nw, n_gauss)
    integer(i4), intent(in) :: nw, n_gauss
    integer :: istat
    if (allocated(d_gauss_fixed)) deallocate(d_gauss_fixed)
    allocate(d_gauss_fixed(3, n_gauss, nw), stat=istat)
  end subroutine gauss_fixed_alloc

  !===========================================================================
  ! Kernel de difusion con gaussianos prefijados (lee de d_gauss_fixed en vez de RNG)
  ! Identico a difusion_kernel salvo que g1,g2,g3 vienen de d_gauss_fixed(:,iatom,iw)
  ! y el bloque rotamol usa d_gauss_fixed(:,d_ncmtras_d2+1,iw).
  !===========================================================================
  attributes(global) subroutine difusion_fixed_kernel(nw)
    integer(i4), value :: nw
    integer(i4) :: iw, iatom, ic
    real(r8) :: g1, g2, g3, sig1, sig2, phix1, phiy, phix2
    real(r8) :: sprop(3,3)

    iw = (blockIdx%x-1)*blockDim%x + threadIdx%x
    if (iw > nw) return

    do iatom = 1, d_ncmtras_d2
      g1 = d_gauss_fixed(1, iatom, iw)
      g2 = d_gauss_fixed(2, iatom, iw)
      g3 = d_gauss_fixed(3, iatom, iw)
      sig1 = d_sigma1_d2(iatom, iw);  sig2 = d_sigma2_d2(iatom, iw)
      d_atom_soa_da(1,iatom,iw) = d_atom_soa_da(1,iatom,iw) + sig1*g1 + 0.5_r8*sig2*d_dwf_soa_da(1,iatom,iw)
      d_atom_soa_da(2,iatom,iw) = d_atom_soa_da(2,iatom,iw) + sig1*g2 + 0.5_r8*sig2*d_dwf_soa_da(2,iatom,iw)
      d_atom_soa_da(3,iatom,iw) = d_atom_soa_da(3,iatom,iw) + sig1*g3 + 0.5_r8*sig2*d_dwf_soa_da(3,iatom,iw)
    end do

    if (d_rotamol_d2) then
      g1 = d_gauss_fixed(1, d_ncmtras_d2+1, iw)
      g2 = d_gauss_fixed(2, d_ncmtras_d2+1, iw)
      g3 = d_gauss_fixed(3, d_ncmtras_d2+1, iw)
      phix1=d_sig1hrot_d2(iw)*g1+0.5_r8*d_sig2hrot_d2(iw)*d_dphi_soa_da(1,iw)
      phiy =d_sig1rot_d2(iw) *g2+0.5_r8*d_sig2rot_d2(iw) *d_dphi_soa_da(2,iw)
      phix2=d_sig1hrot_d2(iw)*g3+0.5_r8*d_sig2hrot_d2(iw)*d_dphi_soa_da(1,iw)
      do ic=1,3; do iatom=1,3; sprop(ic,iatom)=d_sprop_soa_da(ic,iatom,iw); end do; end do
      call rota_d(1,phix1,sprop); call rota_d(2,phiy,sprop); call rota_d(1,phix2,sprop)
      do ic=1,3; do iatom=1,3; d_sprop_soa_da(ic,iatom,iw)=sprop(ic,iatom); end do; end do
    end if
  end subroutine difusion_fixed_kernel

  subroutine difusion_fixed_run(nw)
    integer(i4), intent(in) :: nw
    integer(i4), parameter  :: NTHREADS = 256
    integer(i4) :: nblocks; integer :: istat
    nblocks = (nw+NTHREADS-1)/NTHREADS
    call difusion_fixed_kernel<<<nblocks,NTHREADS>>>(nw)
    istat = cudaDeviceSynchronize()
  end subroutine difusion_fixed_run

end module mdmc2_gpu
