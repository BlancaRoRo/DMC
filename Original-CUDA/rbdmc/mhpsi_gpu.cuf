! mhpsi_gpu.cuf
!
! Modulo GPU para hpsi (mwavef.f90).
! hpsi = derananum + vpot + ene=kin+pot  (si .not. libre)
!      = valibre                          (si libre)
!
! Estrategia: orquesta los modulos ya verificados en lugar de duplicar codigo.
!   1. derananum_gpu_run  -> d_kin_soa_da, d_dwf_soa_da, d_wf_soa_da, etc.
!   2. vpot_gpu_run       -> d_pot_vp
!   3. hpsi_combine_kernel-> d_ene_hpsi = d_kin_soa_da + d_pot_vp
!
! Para libre=.T.: solo se llama a valibre_gpu_run.
!
module mhpsi_gpu
  use cudafor
  use mderananum_gpu
  use mvpot_gpu
  use mvalibre_gpu
  implicit none

  integer, private, parameter :: r8 = selected_real_kind(15,9)
  integer, private, parameter :: i4 = selected_int_kind(9)

  !---------------------------------------------------------------------------
  ! Array de energia total en device (kin + pot)
  !---------------------------------------------------------------------------
  real(r8), device, allocatable, public :: d_ene_hpsi(:)

contains

  !===========================================================================
  subroutine hpsi_gpu_alloc_ene(nw)
    integer(i4), intent(in) :: nw
    integer :: istat
    if (allocated(d_ene_hpsi)) deallocate(d_ene_hpsi)
    allocate(d_ene_hpsi(nw), stat=istat)
  end subroutine hpsi_gpu_alloc_ene

  !===========================================================================
  ! Kernel: ene(iw) = kin(iw) + pot(iw)
  ! Lee de los SOA de mderananum_gpu y mvpot_gpu.
  !===========================================================================
  attributes(global) subroutine hpsi_combine_kernel(nw)
    integer(i4), value :: nw
    integer(i4) :: iw
    iw = (blockIdx%x-1)*blockDim%x + threadIdx%x
    if (iw > nw) return
    d_ene_hpsi(iw) = d_kin_soa_da(iw) + d_pot_vp(iw)
  end subroutine hpsi_combine_kernel

  !===========================================================================
  ! hpsi GPU completo:
  !   - si libre=.F.: derananum + vpot + combine
  !   - si libre=.T.: valibre
  ! Prerequisito: llamar a derananum_gpu_init, vpot_gpu_init,
  !   derananum_gpu_alloc, vpot_gpu_alloc, valibre_gpu_init, valibre_gpu_alloc
  !   ANTES de este wrapper.
  !===========================================================================
  subroutine hpsi_gpu_run(nw, libre_h)
    integer(i4), intent(in) :: nw
    logical,     intent(in) :: libre_h
    integer(i4), parameter  :: NTHREADS = 256
    integer(i4) :: nblocks; integer :: istat

    if (libre_h) then
      call valibre_gpu_run(nw)
    else
      call derananum_gpu_run(nw)
      call vpot_gpu_run(nw)
      nblocks = (nw+NTHREADS-1)/NTHREADS
      call hpsi_combine_kernel<<<nblocks,NTHREADS>>>(nw)
      istat = cudaDeviceSynchronize()
    end if
  end subroutine hpsi_gpu_run

end module mhpsi_gpu
