! mpotenbh_gpu.cuf
!
! Kernel CUDA para potenbh (bh_heh2m.f), dado rhe ya en sistema molecular.
! Implementa He_dihydrogen (ENERGY1+ENERGY2+ENERGY3) sin ccuerpo.
!
! El flujo completo de vpot para opot=4 es:
!   ccuerpo_gpu → potenbh_gpu → vpotbh
!
! Este modulo asume que rhe ya esta calculado (por ccuerpo o ccuerpo_gpu).
! Tomar rhe como entrada permite testar potenbh independientemente de ccuerpo.
!
! Parametros fisicos: copiados de param_atoms_bh.h (mismo que mhedihydrogen_gpu).
! Funciones de amortiguamiento FN1_pb, FN2_pb, V_hehe_pb: iguales a las de
! mhedihydrogen_gpu pero con sufijo _pb para evitar conflictos de nombres.
!
module mpotenbh_gpu
  use cudafor
  implicit none

  integer, private, parameter :: r8 = selected_real_kind(15,9)
  integer, private, parameter :: i4 = selected_int_kind(9)

  integer(i4), parameter, public :: NGATOM_MAX_PB = 25

  !---------------------------------------------------------------------------
  ! Constantes fisicas (de param_atoms_bh.h)
  !---------------------------------------------------------------------------
  real(r8), private, parameter :: &
    a0_pb  = 65344.8145d0,  a1_pb = -0.42497d0,  a2_pb = 3.95634d0,  a3_pb = 0.07852d0, &
    b0_pb  = 3.49361d0,     b1_pb =  0.13908d0,  b2_pb = 1.89258d0,  b3_pb = -0.01065d0, &
    c60_pb = 4091.45747d0, c61_pb = 106.89633d0, c62_pb = 226.68798d0, c63_pb = -117.37656d0, &
    conve3_pb = 27.2d3, pi_pb = 3.141592d0, pi12_pb = 3.141592d0/2.0d0, &
    A_HeHe_pb     = 1.89635353d5,   c6_HeHe_pb  = 1.34687065d0, &
    c8_HeHe_pb    = 0.41308398d0,   c10_HeHe_pb = 0.17060159d0, &
    alpha_HeHe_pb = 10.70203539d0,  beta_HeHe_pb = -1.90740649d0, &
    D_HeHe_pb     = 1.4088d0,       req_HeHe_pb  = 2.9695d0, &
    eps_HeHe_pb   = 10.97d0 * 0.695d0 * 4.55633538d-6, &
    Aa_HeHe_pb    = 0.0026d0,       xx1_HeHe_pb  = 1.003535949d0, &
    xx2_HeHe_pb   = 1.454790369d0, &
    Ba_HeHe_pb    = 2.0d0*3.141592d0/(1.454790369d0 - 1.003535949d0), &
    cte_pb        = 14393.894d0,   alpha_pb = 1.38d0*(0.5291772d0)**3, &
    q_pb          = 0.7435d0

  !---------------------------------------------------------------------------
  ! Parametros en device
  !---------------------------------------------------------------------------
  integer(i4), device, public :: d_ngatom_pb
  real(r8),    device, public :: d_dhcm_pb

  !---------------------------------------------------------------------------
  ! SOA en device
  ! Entrada: rhe(3*ngatom, nw)  -- posiciones ya en sistema molecular
  ! Salida:  vpotbh(nw)
  !---------------------------------------------------------------------------
  real(r8), device, allocatable, public :: d_rhe_soa_pb(:,:)
  real(r8), device, allocatable, public :: d_vpotbh_pb(:)

contains

  !===========================================================================
  subroutine potenbh_gpu_init(ngatom_h, dhcm_h)
    integer(i4), intent(in) :: ngatom_h
    real(r8),    intent(in) :: dhcm_h
    d_ngatom_pb = ngatom_h
    d_dhcm_pb   = dhcm_h
  end subroutine potenbh_gpu_init

  !===========================================================================
  subroutine potenbh_gpu_alloc(nw, ng)
    integer(i4), intent(in) :: nw, ng
    integer :: istat
    if (allocated(d_rhe_soa_pb)) deallocate(d_rhe_soa_pb, d_vpotbh_pb)
    allocate(d_rhe_soa_pb(3*ng, nw), stat=istat)
    allocate(d_vpotbh_pb(nw),        stat=istat)
  end subroutine potenbh_gpu_alloc

  !===========================================================================
  ! H2D: copia rhe_host(3*ngatom, nw) al device
  !===========================================================================
  subroutine rhe_h2d(rhe_host, nw, ng)
    real(r8),    intent(in) :: rhe_host(3*ng, nw)
    integer(i4), intent(in) :: nw, ng
    d_rhe_soa_pb = rhe_host
  end subroutine rhe_h2d

  !===========================================================================
  ! Device: funciones de amortiguamiento (sufijo _pb)
  !===========================================================================
  attributes(device) function FN1_pb(x) result(f)
    real(r8), value :: x; real(r8) :: ex, f
    ex = exp(-x)
    f = 1.0d0 - ex*(1.0d0 + x + x**2/2.0d0 + x**3/6.0d0 + &
                    x**4/24.0d0 + x**5/120.0d0 + x**6/720.0d0)
  end function FN1_pb

  attributes(device) function FN2_pb(x) result(f)
    real(r8), value :: x; real(r8) :: ex, f
    ex = exp(-x)
    f = 1.0d0 - ex*(1.0d0 + x + x**2/2.0d0)
  end function FN2_pb

  attributes(device) function V_hehe_pb(r) result(v)
    real(r8), value :: r; real(r8) :: v, x, x2, x6, x8, x10, F, vsum, addin
    x = r/req_HeHe_pb; x2=x*x; x6=x2*x2*x2; x8=x6*x2; x10=x8*x2
    F = 1.0d0
    if (x < D_HeHe_pb) F = exp(-(D_HeHe_pb/x - 1.0d0)**2)
    vsum = A_HeHe_pb*exp(-alpha_HeHe_pb*x + beta_HeHe_pb*x2) - F*(c6_HeHe_pb/x6 + c8_HeHe_pb/x8 + c10_HeHe_pb/x10)
    addin = 0.0d0
    if (x >= xx1_HeHe_pb .and. x <= xx2_HeHe_pb) &
      addin = Aa_HeHe_pb*(sin(Ba_HeHe_pb*(x-xx1_HeHe_pb) - pi12_pb) + 1.0d0)
    v = eps_HeHe_pb * (vsum + addin)
  end function V_hehe_pb

  !===========================================================================
  ! Kernel potenbh: un hilo por walker
  ! Entrada: rhe(3*ngatom, nw) ya en sistema molecular
  ! Calcula ENERGY1 + ENERGY2 + ENERGY3 (He_dihydrogen sin ccuerpo)
  !===========================================================================
  attributes(global) subroutine potenbh_kernel(nw)
    integer(i4), value :: nw
    integer(i4) :: iw, j, j1, j2, ic
    real(r8) :: x(3*NGATOM_MAX_PB)
    real(r8) :: dhcm, rdih1(3), rdih2(3), orHH(3)
    real(r8) :: energy1, energy2, energy3
    real(r8) :: R, rvec(3), rnorm, onorm, theta, ror, fi
    real(r8) :: atheta, btheta, c6theta
    real(r8) :: rh1, rh2, r0, Ex0, Ey0, Ez0, q0_loc
    integer(i4) :: N

    iw = (blockIdx%x - 1) * blockDim%x + threadIdx%x
    if (iw > nw) return

    N    = d_ngatom_pb
    dhcm = d_dhcm_pb

    ! Cargar posiciones en sistema molecular
    do ic = 1, 3*N
      x(ic) = d_rhe_soa_pb(ic, iw)
    end do

    ! Geometria H2 desde dhcm (identica a potenbh en CPU)
    rdih1(1)=0.0d0; rdih1(2)=0.0d0; rdih1(3)= dhcm
    rdih2(1)=0.0d0; rdih2(2)=0.0d0; rdih2(3)=-dhcm
    orHH(1) =0.0d0; orHH(2) =0.0d0; orHH(3) =-2.0d0*dhcm

    ! ENERGY1: pares He-He
    energy1 = 0.0d0
    do j1 = 1, N-1
      do j2 = j1+1, N
        R = sqrt( (x(3*(j1-1)+1)-x(3*(j2-1)+1))**2 &
                + (x(3*(j1-1)+2)-x(3*(j2-1)+2))**2 &
                + (x(3*(j1-1)+3)-x(3*(j2-1)+3))**2 )
        energy1 = energy1 + V_hehe_pb(R)
      end do
    end do
    energy1 = energy1 * conve3_pb

    ! ENERGY2: rep+disp TT
    energy2 = 0.0d0
    onorm = sqrt(orHH(1)**2 + orHH(2)**2 + orHH(3)**2)
    do j = 1, N
      rvec(1)=x(3*(j-1)+1); rvec(2)=x(3*(j-1)+2); rvec(3)=x(3*(j-1)+3)
      rnorm = sqrt(rvec(1)**2+rvec(2)**2+rvec(3)**2)
      ror   = rvec(1)*orHH(1)+rvec(2)*orHH(2)+rvec(3)*orHH(3)
      fi    = min(1.0d0, max(-1.0d0, ror/(rnorm*onorm)))
      theta = acos(fi)
      atheta  = a1_pb*cos(theta)**2 + a2_pb*cos(theta)**4 + a3_pb*cos(theta)**6
      btheta  = b0_pb + b1_pb*cos(theta)**2 + b2_pb*cos(theta)**4 + b3_pb*cos(theta)**6
      c6theta = c60_pb + c61_pb*sin(theta)**2 + c62_pb*sin(theta)**4 + c63_pb*sin(theta)**6
      energy2 = energy2 + a0_pb*exp(atheta-rnorm*btheta) - FN1_pb(rnorm*btheta)*c6theta/rnorm**6
    end do

    ! ENERGY3: induccion
    energy3 = 0.0d0
    q0_loc  = 2.0d0*q_pb - 1.0d0
    do j = 1, N
      rh1 = sqrt((x(3*(j-1)+1)-rdih1(1))**2+(x(3*(j-1)+2)-rdih1(2))**2+(x(3*(j-1)+3)-rdih1(3))**2)
      rh2 = sqrt((x(3*(j-1)+1)-rdih2(1))**2+(x(3*(j-1)+2)-rdih2(2))**2+(x(3*(j-1)+3)-rdih2(3))**2)
      r0  = sqrt(x(3*(j-1)+1)**2+x(3*(j-1)+2)**2+x(3*(j-1)+3)**2)
      rvec(1)=x(3*(j-1)+1); rvec(2)=x(3*(j-1)+2); rvec(3)=x(3*(j-1)+3)
      rnorm = sqrt(rvec(1)**2+rvec(2)**2+rvec(3)**2)
      ror   = rvec(1)*orHH(1)+rvec(2)*orHH(2)+rvec(3)*orHH(3)
      fi    = min(1.0d0, max(-1.0d0, ror/(rnorm*onorm)))
      theta = acos(fi)
      btheta = b0_pb + b1_pb*cos(theta)**2 + b2_pb*cos(theta)**4 + b3_pb*cos(theta)**6
      Ex0 = q_pb*FN2_pb(btheta*rh1)*(x(3*(j-1)+1)-rdih1(1))/rh1**3 &
          + q_pb*FN2_pb(btheta*rh2)*(x(3*(j-1)+1)-rdih2(1))/rh2**3 &
          - q0_loc*FN2_pb(btheta*r0)*x(3*(j-1)+1)/r0**3
      Ey0 = q_pb*FN2_pb(btheta*rh1)*(x(3*(j-1)+2)-rdih1(2))/rh1**3 &
          + q_pb*FN2_pb(btheta*rh2)*(x(3*(j-1)+2)-rdih2(2))/rh2**3 &
          - q0_loc*FN2_pb(btheta*r0)*x(3*(j-1)+2)/r0**3
      Ez0 = q_pb*FN2_pb(btheta*rh1)*(x(3*(j-1)+3)-rdih1(3))/rh1**3 &
          + q_pb*FN2_pb(btheta*rh2)*(x(3*(j-1)+3)-rdih2(3))/rh2**3 &
          - q0_loc*FN2_pb(btheta*r0)*x(3*(j-1)+3)/r0**3
      energy3 = energy3 + Ex0*Ex0 + Ey0*Ey0 + Ez0*Ez0
    end do
    energy3 = -0.5d0 * alpha_pb * cte_pb * energy3

    d_vpotbh_pb(iw) = energy1 + energy2 + energy3
  end subroutine potenbh_kernel

  !===========================================================================
  subroutine potenbh_gpu_run(nw)
    integer(i4), intent(in) :: nw
    integer(i4), parameter  :: NTHREADS = 64
    integer(i4) :: nblocks; integer :: istat
    nblocks = (nw + NTHREADS - 1) / NTHREADS
    call potenbh_kernel<<<nblocks, NTHREADS>>>(nw)
    istat = cudaDeviceSynchronize()
  end subroutine potenbh_gpu_run

  !===========================================================================
  ! SOA -> AOS (D2H)
  !===========================================================================
  subroutine soa_to_aos_pb(nw, vpotbh_out)
    integer(i4), intent(in)  :: nw
    real(r8),    intent(out) :: vpotbh_out(nw)
    vpotbh_out = d_vpotbh_pb
  end subroutine soa_to_aos_pb

  !===========================================================================
  ! Wrapper: dado rhe en host, calcula vpotbh en GPU
  !===========================================================================
  subroutine potenbh_gpu(rhe_host, nw, ng, dhcm_h, vpotbh_out)
    real(r8),    intent(in)  :: rhe_host(3*ng, nw)
    integer(i4), intent(in)  :: nw, ng
    real(r8),    intent(in)  :: dhcm_h
    real(r8),    intent(out) :: vpotbh_out(nw)
    call potenbh_gpu_init(ng, dhcm_h)
    call potenbh_gpu_alloc(nw, ng)
    call rhe_h2d(rhe_host, nw, ng)
    call potenbh_gpu_run(nw)
    call soa_to_aos_pb(nw, vpotbh_out)
  end subroutine potenbh_gpu

end module mpotenbh_gpu
