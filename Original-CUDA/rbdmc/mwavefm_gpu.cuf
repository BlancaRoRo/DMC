! mwavefm_gpu.cuf
!
! Kernel CUDA para wavefm (mwavef.f90).
! Calcula el factor de Jastrow mixto He4-He3:
!   ujas = sum_{i in He4, j in He3} [ -pmix(1)/rij^pmix(2) - pmix(3)*rij ]
!   wfm  = exp(ujas)
!
! Salida: un escalar wfm por walker (frente a derwavefm que da arrays por atomo).
!
module mwavefm_gpu
  use cudafor
  implicit none

  integer, private, parameter :: r8 = selected_real_kind(15,9)
  integer, private, parameter :: i4 = selected_int_kind(9)

  integer(i4), parameter, public :: NGATOM_MAX_WFM = 25

  !---------------------------------------------------------------------------
  ! Parametros en device
  !---------------------------------------------------------------------------
  integer(i4), device, public :: d_nhe4_wfm, d_nhe3_wfm, d_ngatom_wfm
  real(r8),    device, public :: d_pmix_wfm(3)

  !---------------------------------------------------------------------------
  ! Arrays SOA en device
  ! d_atom_soa_wfm(ic, ia, iw) : posiciones
  ! d_wfm_soa(iw)              : resultado wfm por walker
  !---------------------------------------------------------------------------
  real(r8), device, allocatable, public :: d_atom_soa_wfm(:,:,:)
  real(r8), device, allocatable, public :: d_wfm_soa(:)

contains

  !===========================================================================
  subroutine wavefm_gpu_init(nhe4_h, nhe3_h, ngatom_h, pmix_h)
    integer(i4), intent(in) :: nhe4_h, nhe3_h, ngatom_h
    real(r8),    intent(in) :: pmix_h(3)
    d_nhe4_wfm   = nhe4_h
    d_nhe3_wfm   = nhe3_h
    d_ngatom_wfm = ngatom_h
    d_pmix_wfm   = pmix_h
  end subroutine wavefm_gpu_init

  !===========================================================================
  subroutine wavefm_gpu_alloc(nw, ng)
    integer(i4), intent(in) :: nw, ng
    integer :: istat
    if (allocated(d_atom_soa_wfm)) deallocate(d_atom_soa_wfm, d_wfm_soa)
    allocate(d_atom_soa_wfm(3, ng, nw), stat=istat)
    allocate(d_wfm_soa(nw),             stat=istat)
  end subroutine wavefm_gpu_alloc

  !===========================================================================
  ! AOS -> SOA (H2D): posiciones de wsim al array de device
  !===========================================================================
  subroutine aos_to_soa_wfm(wsim, nw, ng)
    use mtipos, only: walker
    type(walker), intent(in) :: wsim(nw)
    integer(i4),  intent(in) :: nw, ng
    real(r8) :: h_soa(3, ng, nw)
    integer(i4) :: iw, ia
    do iw = 1, nw
      do ia = 1, ng
        h_soa(1, ia, iw) = wsim(iw)%atom(ia)%comp(1)
        h_soa(2, ia, iw) = wsim(iw)%atom(ia)%comp(2)
        h_soa(3, ia, iw) = wsim(iw)%atom(ia)%comp(3)
      end do
    end do
    d_atom_soa_wfm = h_soa
  end subroutine aos_to_soa_wfm

  !===========================================================================
  ! Kernel: un hilo por walker
  !===========================================================================
  attributes(global) subroutine wavefm_kernel(nw)
    integer(i4), value :: nw
    integer(i4) :: iw, i, j
    real(r8) :: atom(3, NGATOM_MAX_WFM)
    real(r8) :: ujas, rij, rt(3)

    iw = (blockIdx%x - 1) * blockDim%x + threadIdx%x
    if (iw > nw) return

    do i = 1, d_ngatom_wfm
      atom(1, i) = d_atom_soa_wfm(1, i, iw)
      atom(2, i) = d_atom_soa_wfm(2, i, iw)
      atom(3, i) = d_atom_soa_wfm(3, i, iw)
    end do

    ujas = 0.0_r8
    do i = 1, d_nhe4_wfm
      do j = d_nhe4_wfm + 1, d_ngatom_wfm
        rt(1) = atom(1,i) - atom(1,j)
        rt(2) = atom(2,i) - atom(2,j)
        rt(3) = atom(3,i) - atom(3,j)
        rij   = sqrt(rt(1)**2 + rt(2)**2 + rt(3)**2)
        ujas  = ujas - d_pmix_wfm(1)/rij**d_pmix_wfm(2) - d_pmix_wfm(3)*rij
      end do
    end do

    d_wfm_soa(iw) = exp(ujas)
  end subroutine wavefm_kernel

  !===========================================================================
  subroutine wavefm_gpu_run(nw)
    integer(i4), intent(in) :: nw
    integer(i4), parameter  :: NTHREADS = 256
    integer(i4) :: nblocks
    integer      :: istat
    nblocks = (nw + NTHREADS - 1) / NTHREADS
    call wavefm_kernel<<<nblocks, NTHREADS>>>(nw)
    istat = cudaDeviceSynchronize()
  end subroutine wavefm_gpu_run

  !===========================================================================
  ! SOA -> AOS (D2H): resultado wfm al array host
  !===========================================================================
  subroutine soa_to_aos_wfm(nw, wfm_out)
    integer(i4), intent(in)  :: nw
    real(r8),    intent(out) :: wfm_out(nw)
    wfm_out = d_wfm_soa
  end subroutine soa_to_aos_wfm

  !===========================================================================
  ! Wrapper completo
  !===========================================================================
  subroutine wavefm_gpu(wsim, nw, ng, wfm_out)
    use mtipos, only: walker
    type(walker), intent(in) :: wsim(nw)
    integer(i4),  intent(in) :: nw, ng
    real(r8),    intent(out) :: wfm_out(nw)
    call aos_to_soa_wfm(wsim, nw, ng)
    call wavefm_gpu_run(nw)
    call soa_to_aos_wfm(nw, wfm_out)
  end subroutine wavefm_gpu

end module mwavefm_gpu
