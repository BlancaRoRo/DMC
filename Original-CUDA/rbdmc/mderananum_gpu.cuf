! mderananum_gpu.cuf
!
! Kernel CUDA para derananum (mwavef.f90).
! Calcula wavef + las 4 derivadas + la combinacion que da dwf y kin.
!
! Inlinea todo: wavef, derwavefhe4, derwavefhe3 (numerica), derwavefm,
! derwavefx (analitica con duhe4x/duhe3x/calderpleg).
!
! Optimizacion: wfhe3 calculado en wavef se reutiliza como wf0 en
! derwavefhe3 (evita una llamada extra a wavefhe3_inline).
!
! SOA entrada: atom(natom), sprop(3,3), hb2m(natom), b por walker
! SOA salida:  dwf(3,natom), kin, eimp, erot, dphi(2),
!              wf, wfhe4, wfhe3, wfm, wfx, signoup, signodw
!
! 32 hilos/bloque: ~500 doubles de arrays locales -> sin spilling.
!
module mderananum_gpu
  use cudafor
  implicit none

  integer, private, parameter :: r8 = selected_real_kind(15,9)
  integer, private, parameter :: i4 = selected_int_kind(9)

  real(r8), private, parameter :: UMAX_DA =  200.0_r8
  real(r8), private, parameter :: UMIN_DA = -200.0_r8
  real(r8), private, parameter :: DX_DA   = 1.0d-3

  integer(i4), parameter, public :: NHE3_MAX_DA  = 5
  integer(i4), parameter, public :: NHE4_MAX_DA  = 22
  integer(i4), parameter, public :: NFERMAX_DA   = 4
  integer(i4), parameter, public :: NATOM_MAX_DA = 26
  integer(i4), parameter, public :: LMAX_DA      = 8

  !---------------------------------------------------------------------------
  ! Parametros en device
  !---------------------------------------------------------------------------
  integer(i4), device, public :: d_nhe4_da, d_nhe3_da
  integer(i4), device, public :: d_ngatom_da, d_natom_da
  integer(i4), device, public :: d_nhe3up_da, d_nhe3dw_da
  integer(i4), device, public :: d_lxhe4_da, d_lxhe3_da
  real(r8),    device, public :: d_mhe4_da, d_mhe3_da, d_mx_da
  real(r8),    device, public :: d_phe4_da(3), d_phe3_da(4), d_pmix_da(3)
  real(r8),    device, public :: d_pxhe4_da(5, 0:LMAX_DA)
  real(r8),    device, public :: d_pxhe3_da(5, 0:LMAX_DA)
  logical,     device, public :: d_impureza_da, d_impurmol_da
  logical,     device, public :: d_impurfija_da, d_rotamol_da

  !---------------------------------------------------------------------------
  ! SOA en device
  ! Entrada: atom, sprop, hb2m, b (datos del walker)
  ! Salida:  dwf, kin, eimp, erot, dphi + componentes de wavef
  !---------------------------------------------------------------------------
  real(r8),    device, allocatable, public :: d_atom_soa_da(:,:,:)   ! (3,natom,nw)
  real(r8),    device, allocatable, public :: d_sprop_soa_da(:,:,:)  ! (3,3,nw)
  real(r8),    device, allocatable, public :: d_hb2m_soa_da(:,:)     ! (natom,nw)
  real(r8),    device, allocatable, public :: d_b_soa_da(:)          ! (nw)
  real(r8),    device, allocatable, public :: d_dwf_soa_da(:,:,:)    ! (3,natom,nw)
  real(r8),    device, allocatable, public :: d_kin_soa_da(:)
  real(r8),    device, allocatable, public :: d_eimp_soa_da(:)
  real(r8),    device, allocatable, public :: d_erot_soa_da(:)
  real(r8),    device, allocatable, public :: d_dphi_soa_da(:,:)     ! (2,nw)
  real(r8),    device, allocatable, public :: d_wf_soa_da(:)
  real(r8),    device, allocatable, public :: d_wfhe4_soa_da(:)
  real(r8),    device, allocatable, public :: d_wfhe3_soa_da(:)
  real(r8),    device, allocatable, public :: d_wfm_soa_da(:)
  real(r8),    device, allocatable, public :: d_wfx_soa_da(:)
  integer(i4), device, allocatable, public :: d_signoup_soa_da(:)
  integer(i4), device, allocatable, public :: d_signodw_soa_da(:)

contains

  !===========================================================================
  subroutine derananum_gpu_init(nhe4_h, nhe3_h, ngatom_h, natom_h,       &
                                  nhe3up_h, nhe3dw_h, lxhe4_h, lxhe3_h,   &
                                  mhe4_h, mhe3_h, mx_h,                    &
                                  phe4_h, phe3_h, pmix_h,                  &
                                  pxhe4_h, pxhe3_h,                        &
                                  impureza_h, impurmol_h,                   &
                                  impurfija_h, rotamol_h)
    integer(i4), intent(in) :: nhe4_h, nhe3_h, ngatom_h, natom_h
    integer(i4), intent(in) :: nhe3up_h, nhe3dw_h, lxhe4_h, lxhe3_h
    real(r8),    intent(in) :: mhe4_h, mhe3_h, mx_h
    real(r8),    intent(in) :: phe4_h(3), phe3_h(4), pmix_h(3)
    real(r8),    intent(in) :: pxhe4_h(5,0:lxhe4_h), pxhe3_h(5,0:lxhe3_h)
    logical,     intent(in) :: impureza_h, impurmol_h, impurfija_h, rotamol_h
    d_nhe4_da=nhe4_h; d_nhe3_da=nhe3_h; d_ngatom_da=ngatom_h; d_natom_da=natom_h
    d_nhe3up_da=nhe3up_h; d_nhe3dw_da=nhe3dw_h
    d_lxhe4_da=lxhe4_h;   d_lxhe3_da=lxhe3_h
    d_mhe4_da=mhe4_h; d_mhe3_da=mhe3_h; d_mx_da=mx_h
    d_phe4_da=phe4_h; d_phe3_da=phe3_h; d_pmix_da=pmix_h
    d_pxhe4_da(1:5,0:lxhe4_h)=pxhe4_h; d_pxhe3_da(1:5,0:lxhe3_h)=pxhe3_h
    d_impureza_da=impureza_h; d_impurmol_da=impurmol_h
    d_impurfija_da=impurfija_h; d_rotamol_da=rotamol_h
  end subroutine derananum_gpu_init

  !===========================================================================
  subroutine derananum_gpu_alloc(nw, na)
    integer(i4), intent(in) :: nw, na
    integer :: istat
    if (allocated(d_atom_soa_da)) then
      deallocate(d_atom_soa_da, d_sprop_soa_da, d_hb2m_soa_da, d_b_soa_da)
      deallocate(d_dwf_soa_da, d_kin_soa_da, d_eimp_soa_da, d_erot_soa_da, d_dphi_soa_da)
      deallocate(d_wf_soa_da, d_wfhe4_soa_da, d_wfhe3_soa_da, d_wfm_soa_da, d_wfx_soa_da)
      deallocate(d_signoup_soa_da, d_signodw_soa_da)
    end if
    allocate(d_atom_soa_da(3,na,nw),   stat=istat)
    allocate(d_sprop_soa_da(3,3,nw),   stat=istat)
    allocate(d_hb2m_soa_da(na,nw),     stat=istat)
    allocate(d_b_soa_da(nw),           stat=istat)
    allocate(d_dwf_soa_da(3,na,nw),    stat=istat)
    allocate(d_kin_soa_da(nw),         stat=istat)
    allocate(d_eimp_soa_da(nw),        stat=istat)
    allocate(d_erot_soa_da(nw),        stat=istat)
    allocate(d_dphi_soa_da(2,nw),      stat=istat)
    allocate(d_wf_soa_da(nw),          stat=istat)
    allocate(d_wfhe4_soa_da(nw),       stat=istat)
    allocate(d_wfhe3_soa_da(nw),       stat=istat)
    allocate(d_wfm_soa_da(nw),         stat=istat)
    allocate(d_wfx_soa_da(nw),         stat=istat)
    allocate(d_signoup_soa_da(nw),     stat=istat)
    allocate(d_signodw_soa_da(nw),     stat=istat)
  end subroutine derananum_gpu_alloc

  !===========================================================================
  ! AOS -> SOA (H2D)
  !===========================================================================
  subroutine aos_to_soa_da(wsim, nw, na)
    use mtipos, only: walker
    type(walker), intent(in) :: wsim(nw)
    integer(i4),  intent(in) :: nw, na
    ! Allocatable para evitar stack overflow cuando nw es grande (>5000)
    real(r8), allocatable :: h_atom(:,:,:), h_sprop(:,:,:), h_hb2m(:,:), h_b(:)
    integer(i4) :: iw, ia, iv
    allocate(h_atom(3,na,nw), h_sprop(3,3,nw), h_hb2m(na,nw), h_b(nw))
    do iw = 1, nw
      do ia = 1, na
        h_atom(1,ia,iw)=wsim(iw)%atom(ia)%comp(1)
        h_atom(2,ia,iw)=wsim(iw)%atom(ia)%comp(2)
        h_atom(3,ia,iw)=wsim(iw)%atom(ia)%comp(3)
        h_hb2m(ia,iw)=wsim(iw)%hb2m(ia)
      end do
      do iv = 1, 3
        h_sprop(1,iv,iw)=wsim(iw)%sprop(iv)%comp(1)
        h_sprop(2,iv,iw)=wsim(iw)%sprop(iv)%comp(2)
        h_sprop(3,iv,iw)=wsim(iw)%sprop(iv)%comp(3)
      end do
      h_b(iw) = wsim(iw)%b
    end do
    d_atom_soa_da = h_atom;  d_sprop_soa_da = h_sprop
    d_hb2m_soa_da = h_hb2m; d_b_soa_da     = h_b
    deallocate(h_atom, h_sprop, h_hb2m, h_b)
  end subroutine aos_to_soa_da

  !===========================================================================
  ! Device functions (inlineadas)
  !===========================================================================

  attributes(device) subroutine getcm_d_da(atom, rcm)
    real(r8), intent(in) :: atom(3,NATOM_MAX_DA); real(r8), intent(out) :: rcm(3)
    real(r8) :: mtot; integer(i4) :: i
    rcm=0.0_r8
    do i=1,d_nhe4_da;       rcm=rcm+d_mhe4_da*atom(:,i);  end do
    do i=d_nhe4_da+1,d_ngatom_da; rcm=rcm+d_mhe3_da*atom(:,i); end do
    if(d_impureza_da) then
      rcm=rcm+d_mx_da*atom(:,d_natom_da); mtot=d_nhe4_da*d_mhe4_da+d_nhe3_da*d_mhe3_da+d_mx_da
    else; mtot=d_nhe4_da*d_mhe4_da+d_nhe3_da*d_mhe3_da; end if
    rcm=rcm/mtot
  end subroutine getcm_d_da

  attributes(device) function det_d_da(n,b) result(d)
    integer(i4), value :: n; real(r8), intent(in) :: b(NFERMAX_DA,NFERMAX_DA)
    real(r8) :: d, a(NFERMAX_DA,NFERMAX_DA), s, pivot, piv; integer(i4) :: i,j,k,ipiv
    a=b; d=1.0_r8
    do j=1,n
      if(j/=1) then; do i=2,n; s=a(i,j); do k=1,min(i-1,j-1); s=s-a(i,k)*a(k,j); end do; a(i,j)=s; end do; end if
      pivot=0.0_r8; ipiv=j; do k=j,n; piv=abs(a(k,j)); if(piv>pivot) then; ipiv=k; pivot=piv; end if; end do
      if(ipiv/=j) then; do i=1,n; piv=a(j,i); a(j,i)=a(ipiv,i); a(ipiv,i)=piv; end do; d=-d; end if
      pivot=a(j,j); if(j/=n) then; do k=j+1,n; a(k,j)=a(k,j)/pivot; end do; end if; d=d*pivot
    end do
  end function det_d_da

  attributes(device) subroutine slaterdet_d_da(npart,rpart,slater)
    integer(i4), value :: npart; real(r8), intent(in) :: rpart(3,NFERMAX_DA); real(r8), intent(out) :: slater
    real(r8) :: m(NFERMAX_DA,NFERMAX_DA); integer(i4) :: ip
    if(npart<=1) then; slater=1.0_r8; return; end if
    do ip=1,npart; m(ip,1)=1.0_r8; m(ip,2)=rpart(1,ip); if(npart==2) cycle
      m(ip,3)=rpart(2,ip); if(npart==3) cycle; m(ip,4)=rpart(3,ip); end do
    slater=det_d_da(npart,m)
  end subroutine slaterdet_d_da

  ! wavefhe3 inline (para derivadas numericas en derwavefhe3)
  attributes(device) subroutine wavefhe3_inline_da(atom, wfhe3_out, sup, sdw)
    real(r8), intent(in) :: atom(3,NATOM_MAX_DA); real(r8), intent(out) :: wfhe3_out; integer(i4), intent(out) :: sup,sdw
    real(r8) :: rcm(3),rb(3,NHE3_MAX_DA),rb_up(3,NFERMAX_DA),rb_dw(3,NFERMAX_DA)
    real(r8) :: rt(3),ujas,rij,etaij,slaterup,slaterdw; integer(i4) :: iatom,jatom,ihe3,jhe3
    call getcm_d_da(atom,rcm)
    do iatom=d_nhe4_da+1,d_ngatom_da; ihe3=iatom-d_nhe4_da
      rb(1,ihe3)=atom(1,iatom)-rcm(1); rb(2,ihe3)=atom(2,iatom)-rcm(2); rb(3,ihe3)=atom(3,iatom)-rcm(3); end do
    ujas=0.0_r8
    do iatom=d_nhe4_da+1,d_ngatom_da-1; ihe3=iatom-d_nhe4_da
      do jatom=iatom+1,d_ngatom_da; jhe3=jatom-d_nhe4_da
        rt(1)=atom(1,iatom)-atom(1,jatom); rt(2)=atom(2,iatom)-atom(2,jatom); rt(3)=atom(3,iatom)-atom(3,jatom)
        rij=sqrt(rt(1)**2+rt(2)**2+rt(3)**2); ujas=ujas-d_phe3_da(1)/rij**d_phe3_da(2)
        etaij=d_phe3_da(4)/rij**3
        rb(1,ihe3)=rb(1,ihe3)+etaij*rt(1); rb(2,ihe3)=rb(2,ihe3)+etaij*rt(2); rb(3,ihe3)=rb(3,ihe3)+etaij*rt(3)
        rb(1,jhe3)=rb(1,jhe3)-etaij*rt(1); rb(2,jhe3)=rb(2,jhe3)-etaij*rt(2); rb(3,jhe3)=rb(3,jhe3)-etaij*rt(3)
      end do; end do
    do ihe3=1,d_nhe3_da-1; do jhe3=ihe3+1,d_nhe3_da
      rt(1)=rb(1,ihe3)-rb(1,jhe3); rt(2)=rb(2,ihe3)-rb(2,jhe3); rt(3)=rb(3,ihe3)-rb(3,jhe3)
      ujas=ujas-d_phe3_da(3)*sqrt(rt(1)**2+rt(2)**2+rt(3)**2); end do; end do
    do ihe3=1,d_nhe3up_da; rb_up(:,ihe3)=rb(:,ihe3); end do
    do ihe3=1,d_nhe3dw_da; rb_dw(:,ihe3)=rb(:,d_nhe3up_da+ihe3); end do
    call slaterdet_d_da(d_nhe3up_da,rb_up,slaterup); call slaterdet_d_da(d_nhe3dw_da,rb_dw,slaterdw)
    ujas=min(ujas,UMAX_DA); ujas=max(ujas,UMIN_DA)
    wfhe3_out=exp(ujas)*slaterup*slaterdw; sup=merge(-1,1,slaterup<0.0_r8); sdw=merge(-1,1,slaterdw<0.0_r8)
  end subroutine wavefhe3_inline_da

  !===========================================================================
  ! calpleg_da: polinomios de Legendre (sin derivadas, para wfx)
  !===========================================================================
  attributes(device) subroutine calpleg_da(l, x, pl)
    integer(i4), value :: l;  real(r8), value :: x
    real(r8), intent(out) :: pl(0:LMAX_DA);  integer(i4) :: il
    pl(0)=1.0_r8;  if(l<1) return;  pl(1)=x
    do il=1,l-1
      pl(il+1)=((2.0_r8*il+1.0_r8)*x*pl(il)-il*pl(il-1))/real(il+1,r8)
    end do
  end subroutine calpleg_da

  !===========================================================================
  ! uhe4x_da_func: potencial He4-impureza (replica de uhe4x en mangwavef.f90)
  ! Suma completa sobre terminos de Legendre (todos los l, no solo l=0)
  !===========================================================================
  attributes(device) function uhe4x_da_func(rij, cth) result(u)
    real(r8), value :: rij, cth
    real(r8) :: u, pl(0:LMAX_DA), ul;  integer(i4) :: il
    call calpleg_da(d_lxhe4_da, cth, pl)
    do il=1,d_lxhe4_da;  pl(il)=1.0_r8-pl(il);  end do
    u=0.0_r8
    do il=0,d_lxhe4_da
      ul=-d_pxhe4_da(1,il)/rij**d_pxhe4_da(2,il) &
         -d_pxhe4_da(3,il)*rij**d_pxhe4_da(4,il) &
         -d_pxhe4_da(5,il)*log(rij)
      u=u+ul*pl(il)
    end do
  end function uhe4x_da_func

  !===========================================================================
  ! uhe3x_da_func: potencial He3-impureza (replica de uhe3x en mangwavef.f90)
  !===========================================================================
  attributes(device) function uhe3x_da_func(rij, cth) result(u)
    real(r8), value :: rij, cth
    real(r8) :: u, pl(0:LMAX_DA), ul;  integer(i4) :: il
    call calpleg_da(d_lxhe3_da, cth, pl)
    do il=1,d_lxhe3_da;  pl(il)=1.0_r8-pl(il);  end do
    u=0.0_r8
    do il=0,d_lxhe3_da
      ul=-d_pxhe3_da(1,il)/rij**d_pxhe3_da(2,il) &
         -d_pxhe3_da(3,il)*rij**d_pxhe3_da(4,il) &
         -d_pxhe3_da(5,il)*log(rij)
      u=u+ul*pl(il)
    end do
  end function uhe3x_da_func

  attributes(device) subroutine calderpleg_d_da(l,x,pl,d1pl,d2pl)
    integer(i4), value :: l; real(r8), value :: x
    real(r8), intent(out) :: pl(0:LMAX_DA),d1pl(0:LMAX_DA),d2pl(0:LMAX_DA); integer(i4) :: il
    pl(0)=1.0_r8; d1pl(0)=0.0_r8; d2pl(0)=0.0_r8; if(l<1) return
    pl(1)=x; d1pl(1)=1.0_r8; d2pl(1)=0.0_r8
    do il=1,l-1
      pl(il+1)=((2.0_r8*il+1.0_r8)*x*pl(il)-il*pl(il-1))/real(il+1,r8)
      d1pl(il+1)=(2.0_r8*il+1.0_r8)*pl(il)+d1pl(il-1); d2pl(il+1)=(2.0_r8*il+1.0_r8)*d1pl(il)+d2pl(il-1)
    end do
  end subroutine calderpleg_d_da

  attributes(device) subroutine duhe4x_d_da(rivec,smol,d1ux,d2ux,d1zux,d2zux)
    real(r8), intent(in) :: rivec(3),smol(3,3); real(r8), intent(out) :: d1ux(3),d2ux,d1zux(2),d2zux
    real(r8) :: grz(3),grpl(3),grul(3),rij,cth,zpr,grz2,lapz,gpz(2),lpz,gpz2
    real(r8) :: ulx,ulxp,ulxs,lapl,rijp2,rijp4,pl(0:LMAX_DA),d1pl(0:LMAX_DA),d2pl(0:LMAX_DA); integer(i4) :: il
    rij=sqrt(rivec(1)**2+rivec(2)**2+rivec(3)**2)
    if(d_impurmol_da) then
      cth=(rivec(1)*smol(1,3)+rivec(2)*smol(2,3)+rivec(3)*smol(3,3))/rij; zpr=cth/rij
      grz=(smol(:,3)-zpr*rivec)/rij; grz2=grz(1)**2+grz(2)**2+grz(3)**2; lapz=-2.0_r8*zpr/rij
      gpz(1)=-(rivec(1)*smol(1,2)+rivec(2)*smol(2,2)+rivec(3)*smol(3,2))/rij
      gpz(2)= (rivec(1)*smol(1,1)+rivec(2)*smol(2,1)+rivec(3)*smol(3,1))/rij
      gpz2=gpz(1)**2+gpz(2)**2; lpz=-cth-cth
    else; cth=0.0_r8; grz=0.0_r8; grz2=0.0_r8; lapz=0.0_r8; gpz=0.0_r8; gpz2=0.0_r8; lpz=0.0_r8; end if
    call calderpleg_d_da(d_lxhe4_da,cth,pl,d1pl,d2pl)
    do il=1,d_lxhe4_da; pl(il)=1.0_r8-pl(il); d1pl(il)=-d1pl(il); d2pl(il)=-d2pl(il); end do
    d1ux=0.0_r8; d2ux=0.0_r8; d1zux=0.0_r8; d2zux=0.0_r8
    do il=0,d_lxhe4_da
      rijp2=rij**d_pxhe4_da(2,il); rijp4=rij**d_pxhe4_da(4,il)
      ulx=-d_pxhe4_da(1,il)/rijp2-d_pxhe4_da(3,il)*rijp4-d_pxhe4_da(5,il)*log(rij)
      ulxp=(d_pxhe4_da(1,il)*d_pxhe4_da(2,il)/rijp2-d_pxhe4_da(3,il)*d_pxhe4_da(4,il)*rijp4-d_pxhe4_da(5,il))/rij
      ulxs=(-d_pxhe4_da(1,il)*d_pxhe4_da(2,il)*(d_pxhe4_da(2,il)+1.0_r8)/rijp2 &
            -d_pxhe4_da(3,il)*d_pxhe4_da(4,il)*(d_pxhe4_da(4,il)-1.0_r8)*rijp4 &
            +d_pxhe4_da(5,il))/rij**2+2.0_r8*ulxp/rij
      grul=ulxp/rij*rivec; grpl=d1pl(il)*grz; lapl=lapz*d1pl(il)+grz2*d2pl(il)
      d1ux=d1ux+pl(il)*grul+ulx*grpl; d2ux=d2ux+pl(il)*ulxs+ulx*lapl+2.0_r8*(grul(1)*grpl(1)+grul(2)*grpl(2)+grul(3)*grpl(3))
      d1zux=d1zux+ulx*d1pl(il)*gpz; d2zux=d2zux+ulx*(d1pl(il)*lpz+d2pl(il)*gpz2)
    end do
  end subroutine duhe4x_d_da

  attributes(device) subroutine duhe3x_d_da(rivec,smol,d1ux,d2ux,d1zux,d2zux)
    real(r8), intent(in) :: rivec(3),smol(3,3); real(r8), intent(out) :: d1ux(3),d2ux,d1zux(2),d2zux
    real(r8) :: grz(3),grpl(3),grul(3),rij,cth,zpr,grz2,lapz,gpz(2),lpz,gpz2
    real(r8) :: ulx,ulxp,ulxs,lapl,rijp2,rijp4,pl(0:LMAX_DA),d1pl(0:LMAX_DA),d2pl(0:LMAX_DA); integer(i4) :: il
    rij=sqrt(rivec(1)**2+rivec(2)**2+rivec(3)**2)
    if(d_impurmol_da) then
      cth=(rivec(1)*smol(1,3)+rivec(2)*smol(2,3)+rivec(3)*smol(3,3))/rij; zpr=cth/rij
      grz=(smol(:,3)-zpr*rivec)/rij; grz2=grz(1)**2+grz(2)**2+grz(3)**2; lapz=-2.0_r8*zpr/rij
      gpz(1)=-(rivec(1)*smol(1,2)+rivec(2)*smol(2,2)+rivec(3)*smol(3,2))/rij
      gpz(2)= (rivec(1)*smol(1,1)+rivec(2)*smol(2,1)+rivec(3)*smol(3,1))/rij
      gpz2=gpz(1)**2+gpz(2)**2; lpz=-cth-cth
    else; cth=0.0_r8; grz=0.0_r8; grz2=0.0_r8; lapz=0.0_r8; gpz=0.0_r8; gpz2=0.0_r8; lpz=0.0_r8; end if
    call calderpleg_d_da(d_lxhe3_da,cth,pl,d1pl,d2pl)
    do il=1,d_lxhe3_da; pl(il)=1.0_r8-pl(il); d1pl(il)=-d1pl(il); d2pl(il)=-d2pl(il); end do
    d1ux=0.0_r8; d2ux=0.0_r8; d1zux=0.0_r8; d2zux=0.0_r8
    do il=0,d_lxhe3_da
      rijp2=rij**d_pxhe3_da(2,il); rijp4=rij**d_pxhe3_da(4,il)
      ulx=-d_pxhe3_da(1,il)/rijp2-d_pxhe3_da(3,il)*rijp4-d_pxhe3_da(5,il)*log(rij)
      ulxp=(d_pxhe3_da(1,il)*d_pxhe3_da(2,il)/rijp2-d_pxhe3_da(3,il)*d_pxhe3_da(4,il)*rijp4-d_pxhe3_da(5,il))/rij
      ulxs=(-d_pxhe3_da(1,il)*d_pxhe3_da(2,il)*(d_pxhe3_da(2,il)+1.0_r8)/rijp2 &
            -d_pxhe3_da(3,il)*d_pxhe3_da(4,il)*(d_pxhe3_da(4,il)-1.0_r8)*rijp4 &
            +d_pxhe3_da(5,il))/rij**2+2.0_r8*ulxp/rij
      grul=ulxp/rij*rivec; grpl=d1pl(il)*grz; lapl=lapz*d1pl(il)+grz2*d2pl(il)
      d1ux=d1ux+pl(il)*grul+ulx*grpl; d2ux=d2ux+pl(il)*ulxs+ulx*lapl+2.0_r8*(grul(1)*grpl(1)+grul(2)*grpl(2)+grul(3)*grpl(3))
      d1zux=d1zux+ulx*d1pl(il)*gpz; d2zux=d2zux+ulx*(d1pl(il)*lpz+d2pl(il)*gpz2)
    end do
  end subroutine duhe3x_d_da

  !===========================================================================
  ! Kernel derananum: un hilo por walker
  !===========================================================================
  attributes(global) subroutine derananum_kernel(nw)
    integer(i4), value :: nw
    integer(i4) :: iw, i, j, ihe3, jhe3, iatom, jatom, ic, dum_sup, dum_sdw
    real(r8) :: atom(3,NATOM_MAX_DA), sprop(3,3), hb2m(NATOM_MAX_DA), b_val
    ! wavef
    real(r8) :: ujas, wfhe4, wfhe3, wfm, wfx, wf, rij, rt(3)
    real(r8) :: rcm(3), rb(3,NHE3_MAX_DA), rb_up(3,NFERMAX_DA), rb_dw(3,NFERMAX_DA)
    real(r8) :: etaij, slaterup, slaterdw
    integer(i4) :: signoup, signodw
    ! derwavef intermedios
    real(r8) :: d1wfhe4(3,NHE4_MAX_DA), d2wfhe4(NHE4_MAX_DA)
    real(r8) :: d1wfhe3(3,NHE3_MAX_DA), d2wfhe3(NHE3_MAX_DA)
    real(r8) :: d1wfm(3,NATOM_MAX_DA),  d2wfm(NATOM_MAX_DA)
    real(r8) :: d1wfx(3,NATOM_MAX_DA),  d2wfx(NATOM_MAX_DA)
    real(r8) :: d1zwfx(2), d2zwfx
    ! resultado
    real(r8) :: dwf(3,NATOM_MAX_DA), kin, eimp, erot, dphi(2)
    real(r8) :: smol(3,3), dnor, cth, rivec(3), d1ux(3), d2ux, d1zux(2), d2zux
    real(r8) :: ujasp, ujass, wf0, dend1, dend2, wfmas, wfmen, sumd2, der2, orig(3)

    iw = (blockIdx%x-1)*blockDim%x + threadIdx%x
    if(iw > nw) return

    ! --- Cargar datos del walker ---
    do i=1,d_natom_da
      atom(1,i)=d_atom_soa_da(1,i,iw); atom(2,i)=d_atom_soa_da(2,i,iw); atom(3,i)=d_atom_soa_da(3,i,iw)
      hb2m(i)=d_hb2m_soa_da(i,iw)
    end do
    do i=1,3; sprop(1,i)=d_sprop_soa_da(1,i,iw); sprop(2,i)=d_sprop_soa_da(2,i,iw); sprop(3,i)=d_sprop_soa_da(3,i,iw); end do
    b_val = d_b_soa_da(iw)

    !=========================================================================
    ! 1. WAVEF
    !=========================================================================
    ! wfhe4
    ujas=0.0_r8
    do i=1,d_nhe4_da-1; do j=i+1,d_nhe4_da
      rt=atom(:,i)-atom(:,j); rij=sqrt(rt(1)**2+rt(2)**2+rt(3)**2)
      ujas=ujas-d_phe4_da(1)/rij**d_phe4_da(2)-d_phe4_da(3)*rij
    end do; end do
    ujas=min(ujas,UMAX_DA); ujas=max(ujas,UMIN_DA); wfhe4=exp(ujas)

    ! wfhe3 (reutilizado como wf0 en derwavefhe3)
    call wavefhe3_inline_da(atom, wfhe3, signoup, signodw)

    ! wfm
    ujas=0.0_r8
    do i=1,d_nhe4_da; do j=d_nhe4_da+1,d_ngatom_da
      rt=atom(:,i)-atom(:,j); rij=sqrt(rt(1)**2+rt(2)**2+rt(3)**2)
      ujas=ujas-d_pmix_da(1)/rij**d_pmix_da(2)-d_pmix_da(3)*rij
    end do; end do
    wfm=exp(ujas)

    ! wfx: suma completa sobre terminos de Legendre (uhe4x + uhe3x)
    ! Antes usaba solo el termino l=0 — ahora usa la expansion correcta
    if(.not.d_impureza_da) then
      wfx=1.0_r8
    else
      ujas=0.0_r8
      cth=0.0_r8
      if(d_impurmol_da) dnor=sqrt(sprop(1,3)**2+sprop(2,3)**2+sprop(3,3)**2)
      ! He4 vs impureza
      do j=1,d_nhe4_da
        rt=atom(:,j)-atom(:,d_natom_da); rij=sqrt(rt(1)**2+rt(2)**2+rt(3)**2)
        if(d_impurmol_da) cth=(rt(1)*sprop(1,3)+rt(2)*sprop(2,3)+rt(3)*sprop(3,3))/(dnor*rij)
        ujas=ujas+uhe4x_da_func(rij, cth)
      end do
      ! He3 vs impureza (faltaba en la version anterior)
      do j=d_nhe4_da+1,d_ngatom_da
        rt=atom(:,j)-atom(:,d_natom_da); rij=sqrt(rt(1)**2+rt(2)**2+rt(3)**2)
        if(d_impurmol_da) cth=(rt(1)*sprop(1,3)+rt(2)*sprop(2,3)+rt(3)*sprop(3,3))/(dnor*rij)
        ujas=ujas+uhe3x_da_func(rij, cth)
      end do
      wfx=exp(ujas)
    end if
    wf=wfhe4*wfhe3*wfm*wfx

    !=========================================================================
    ! 2. DERWAVEFHE4 (analitica, pares He4-He4)
    !=========================================================================
    do i=1,d_nhe4_da; d1wfhe4(1,i)=0.0_r8; d1wfhe4(2,i)=0.0_r8; d1wfhe4(3,i)=0.0_r8; d2wfhe4(i)=0.0_r8; end do
    do i=1,d_nhe4_da-1; do j=i+1,d_nhe4_da
      rt=atom(:,i)-atom(:,j); rij=sqrt(rt(1)**2+rt(2)**2+rt(3)**2)
      ujasp=d_phe4_da(1)*d_phe4_da(2)/rij**(d_phe4_da(2)+1.0_r8)
      ujass=-(d_phe4_da(2)+1.0_r8)*ujasp/rij; ujasp=(ujasp-d_phe4_da(3))/rij
      d1wfhe4(1,i)=d1wfhe4(1,i)+ujasp*rt(1); d1wfhe4(2,i)=d1wfhe4(2,i)+ujasp*rt(2); d1wfhe4(3,i)=d1wfhe4(3,i)+ujasp*rt(3)
      d1wfhe4(1,j)=d1wfhe4(1,j)-ujasp*rt(1); d1wfhe4(2,j)=d1wfhe4(2,j)-ujasp*rt(2); d1wfhe4(3,j)=d1wfhe4(3,j)-ujasp*rt(3)
      d2wfhe4(i)=d2wfhe4(i)+ujass+2.0_r8*ujasp; d2wfhe4(j)=d2wfhe4(j)+ujass+2.0_r8*ujasp
    end do; end do
    do i=1,d_nhe4_da; d2wfhe4(i)=d2wfhe4(i)+d1wfhe4(1,i)**2+d1wfhe4(2,i)**2+d1wfhe4(3,i)**2; end do

    !=========================================================================
    ! 3. DERWAVEFHE3 (numerica, usando wfhe3 ya calculado como wf0)
    !=========================================================================
    wf0=wfhe3; dend1=2.0_r8*DX_DA*wf0; dend2=DX_DA**2*wf0
    do ihe3=1,d_nhe3_da
      iatom=d_nhe4_da+ihe3; orig=atom(:,iatom); sumd2=0.0_r8
      atom(1,iatom)=orig(1)+DX_DA; call wavefhe3_inline_da(atom,wfmas,dum_sup,dum_sdw)
      atom(1,iatom)=orig(1)-DX_DA; call wavefhe3_inline_da(atom,wfmen,dum_sup,dum_sdw)
      atom(1,iatom)=orig(1); d1wfhe3(1,ihe3)=(wfmas-wfmen)/dend1; sumd2=sumd2+(wfmas+wfmen-2.0_r8*wf0)
      atom(2,iatom)=orig(2)+DX_DA; call wavefhe3_inline_da(atom,wfmas,dum_sup,dum_sdw)
      atom(2,iatom)=orig(2)-DX_DA; call wavefhe3_inline_da(atom,wfmen,dum_sup,dum_sdw)
      atom(2,iatom)=orig(2); d1wfhe3(2,ihe3)=(wfmas-wfmen)/dend1; sumd2=sumd2+(wfmas+wfmen-2.0_r8*wf0)
      atom(3,iatom)=orig(3)+DX_DA; call wavefhe3_inline_da(atom,wfmas,dum_sup,dum_sdw)
      atom(3,iatom)=orig(3)-DX_DA; call wavefhe3_inline_da(atom,wfmen,dum_sup,dum_sdw)
      atom(3,iatom)=orig(3); d1wfhe3(3,ihe3)=(wfmas-wfmen)/dend1; sumd2=sumd2+(wfmas+wfmen-2.0_r8*wf0)
      d2wfhe3(ihe3)=sumd2/dend2
    end do

    !=========================================================================
    ! 4. DERWAVEFM (analitica, pares He4-He3)
    !=========================================================================
    do i=1,d_ngatom_da; d1wfm(1,i)=0.0_r8; d1wfm(2,i)=0.0_r8; d1wfm(3,i)=0.0_r8; d2wfm(i)=0.0_r8; end do
    do i=1,d_nhe4_da; do ihe3=1,d_nhe3_da; j=d_nhe4_da+ihe3
      rt=atom(:,i)-atom(:,j); rij=sqrt(rt(1)**2+rt(2)**2+rt(3)**2)
      ujasp=d_pmix_da(1)*d_pmix_da(2)/rij**(d_pmix_da(2)+1.0_r8)
      ujass=-(d_pmix_da(2)+1.0_r8)*ujasp/rij; ujasp=(ujasp-d_pmix_da(3))/rij
      d1wfm(1,i)=d1wfm(1,i)+ujasp*rt(1); d1wfm(2,i)=d1wfm(2,i)+ujasp*rt(2); d1wfm(3,i)=d1wfm(3,i)+ujasp*rt(3)
      d1wfm(1,j)=d1wfm(1,j)-ujasp*rt(1); d1wfm(2,j)=d1wfm(2,j)-ujasp*rt(2); d1wfm(3,j)=d1wfm(3,j)-ujasp*rt(3)
      d2wfm(i)=d2wfm(i)+ujass+2.0_r8*ujasp; d2wfm(j)=d2wfm(j)+ujass+2.0_r8*ujasp
    end do; end do
    do i=1,d_ngatom_da; d2wfm(i)=d2wfm(i)+d1wfm(1,i)**2+d1wfm(2,i)**2+d1wfm(3,i)**2; end do

    !=========================================================================
    ! 5. DERWAVEFX (analitica, impureza)
    !=========================================================================
    do i=1,d_natom_da; d1wfx(1,i)=0.0_r8; d1wfx(2,i)=0.0_r8; d1wfx(3,i)=0.0_r8; d2wfx(i)=0.0_r8; end do
    d1zwfx=0.0_r8; d2zwfx=0.0_r8
    if(d_impureza_da) then
      if(d_impurmol_da) then
        do ic=1,3; dnor=sqrt(sprop(1,ic)**2+sprop(2,ic)**2+sprop(3,ic)**2)
          smol(1,ic)=sprop(1,ic)/dnor; smol(2,ic)=sprop(2,ic)/dnor; smol(3,ic)=sprop(3,ic)/dnor; end do
      end if
      do j=1,d_nhe4_da
        rivec=atom(:,j)-atom(:,d_natom_da)
        call duhe4x_d_da(rivec,smol,d1ux,d2ux,d1zux,d2zux)
        d1wfx(:,j)=d1ux; d1wfx(:,d_natom_da)=d1wfx(:,d_natom_da)-d1ux
        d2wfx(j)=d2ux; d2wfx(d_natom_da)=d2wfx(d_natom_da)+d2ux; d1zwfx=d1zwfx+d1zux; d2zwfx=d2zwfx+d2zux
      end do
      do ihe3=1,d_ngatom_da-d_nhe4_da; j=d_nhe4_da+ihe3
        rivec=atom(:,j)-atom(:,d_natom_da)
        call duhe3x_d_da(rivec,smol,d1ux,d2ux,d1zux,d2zux)
        d1wfx(:,j)=d1ux; d1wfx(:,d_natom_da)=d1wfx(:,d_natom_da)-d1ux
        d2wfx(j)=d2ux; d2wfx(d_natom_da)=d2wfx(d_natom_da)+d2ux; d1zwfx=d1zwfx+d1zux; d2zwfx=d2zwfx+d2zux
      end do
      do i=1,d_natom_da; d2wfx(i)=d2wfx(i)+d1wfx(1,i)**2+d1wfx(2,i)**2+d1wfx(3,i)**2; end do
      d2zwfx=d2zwfx+d1zwfx(1)**2+d1zwfx(2)**2
    end if

    !=========================================================================
    ! 6. COMBINAR: dwf y kin
    !=========================================================================
    kin=0.0_r8
    do i=1,d_nhe4_da
      dwf(1,i)=d1wfhe4(1,i)+d1wfm(1,i)+d1wfx(1,i)
      dwf(2,i)=d1wfhe4(2,i)+d1wfm(2,i)+d1wfx(2,i)
      dwf(3,i)=d1wfhe4(3,i)+d1wfm(3,i)+d1wfx(3,i)
      der2 = d2wfhe4(i)+d2wfm(i)+d2wfx(i) &
           + 2.0_r8*(d1wfhe4(1,i)*d1wfm(1,i)+d1wfhe4(2,i)*d1wfm(2,i)+d1wfhe4(3,i)*d1wfm(3,i)) &
           + 2.0_r8*(d1wfhe4(1,i)*d1wfx(1,i)+d1wfhe4(2,i)*d1wfx(2,i)+d1wfhe4(3,i)*d1wfx(3,i)) &
           + 2.0_r8*(d1wfm(1,i)*d1wfx(1,i)+d1wfm(2,i)*d1wfx(2,i)+d1wfm(3,i)*d1wfx(3,i))
      kin=kin-hb2m(i)*der2
    end do
    do ihe3=1,d_nhe3_da
      iatom=d_nhe4_da+ihe3
      dwf(1,iatom)=d1wfhe3(1,ihe3)+d1wfm(1,iatom)+d1wfx(1,iatom)
      dwf(2,iatom)=d1wfhe3(2,ihe3)+d1wfm(2,iatom)+d1wfx(2,iatom)
      dwf(3,iatom)=d1wfhe3(3,ihe3)+d1wfm(3,iatom)+d1wfx(3,iatom)
      der2 = d2wfhe3(ihe3)+d2wfm(iatom)+d2wfx(iatom) &
           + 2.0_r8*(d1wfhe3(1,ihe3)*d1wfm(1,iatom)+d1wfhe3(2,ihe3)*d1wfm(2,iatom)+d1wfhe3(3,ihe3)*d1wfm(3,iatom)) &
           + 2.0_r8*(d1wfhe3(1,ihe3)*d1wfx(1,iatom)+d1wfhe3(2,ihe3)*d1wfx(2,iatom)+d1wfhe3(3,ihe3)*d1wfx(3,iatom)) &
           + 2.0_r8*(d1wfm(1,iatom)*d1wfx(1,iatom)+d1wfm(2,iatom)*d1wfx(2,iatom)+d1wfm(3,iatom)*d1wfx(3,iatom))
      kin=kin-hb2m(iatom)*der2
    end do

    ! Impureza
    if(.not.d_impurfija_da) then
      dwf(:,d_natom_da)=d1wfx(:,d_natom_da); kin=kin-hb2m(d_natom_da)*d2wfx(d_natom_da)
      eimp=-hb2m(d_natom_da)*d2wfx(d_natom_da)
    else; eimp=0.0_r8; end if

    ! Rotacion
    if(d_rotamol_da) then
      dphi=d1zwfx; kin=kin-b_val*d2zwfx; erot=-b_val*d2zwfx
    else; dphi=0.0_r8; erot=0.0_r8; end if

    !=========================================================================
    ! 7. ESCRIBIR AL SOA
    !=========================================================================
    do i=1,d_natom_da
      d_dwf_soa_da(1,i,iw)=dwf(1,i); d_dwf_soa_da(2,i,iw)=dwf(2,i); d_dwf_soa_da(3,i,iw)=dwf(3,i)
    end do
    d_kin_soa_da(iw)=kin; d_eimp_soa_da(iw)=eimp; d_erot_soa_da(iw)=erot
    d_dphi_soa_da(1,iw)=dphi(1); d_dphi_soa_da(2,iw)=dphi(2)
    d_wf_soa_da(iw)=wf; d_wfhe4_soa_da(iw)=wfhe4; d_wfhe3_soa_da(iw)=wfhe3
    d_wfm_soa_da(iw)=wfm; d_wfx_soa_da(iw)=wfx
    d_signoup_soa_da(iw)=signoup; d_signodw_soa_da(iw)=signodw
  end subroutine derananum_kernel

  !===========================================================================
  subroutine derananum_gpu_run(nw)
    integer(i4), intent(in) :: nw
    integer(i4), parameter  :: NTHREADS = 32
    integer(i4) :: nblocks; integer :: istat
    nblocks=(nw+NTHREADS-1)/NTHREADS
    call derananum_kernel<<<nblocks,NTHREADS>>>(nw)
    istat=cudaDeviceSynchronize()
  end subroutine derananum_gpu_run

  !===========================================================================
  ! SOA -> AOS (D2H): escribe resultados de vuelta a wsim
  !===========================================================================
  subroutine soa_to_aos_da(wsim, nw, na)
    use mtipos, only: walker
    type(walker), intent(inout) :: wsim(nw)
    integer(i4),  intent(in)   :: nw, na
    real(r8) :: h_dwf(3,na,nw), h_kin(nw), h_eimp(nw), h_erot(nw), h_dphi(2,nw)
    real(r8) :: h_wf(nw), h_wfhe4(nw), h_wfhe3(nw), h_wfm(nw), h_wfx(nw)
    integer(i4) :: h_sup(nw), h_sdw(nw)
    integer(i4) :: iw, ia
    h_dwf=d_dwf_soa_da; h_kin=d_kin_soa_da; h_eimp=d_eimp_soa_da; h_erot=d_erot_soa_da
    h_dphi=d_dphi_soa_da; h_wf=d_wf_soa_da; h_wfhe4=d_wfhe4_soa_da; h_wfhe3=d_wfhe3_soa_da
    h_wfm=d_wfm_soa_da; h_wfx=d_wfx_soa_da; h_sup=d_signoup_soa_da; h_sdw=d_signodw_soa_da
    do iw=1,nw
      do ia=1,na
        wsim(iw)%dwf(ia)%comp(1)=h_dwf(1,ia,iw)
        wsim(iw)%dwf(ia)%comp(2)=h_dwf(2,ia,iw)
        wsim(iw)%dwf(ia)%comp(3)=h_dwf(3,ia,iw)
      end do
      wsim(iw)%lw%kin=h_kin(iw); wsim(iw)%lw%eimp=h_eimp(iw); wsim(iw)%lw%erot=h_erot(iw)
      wsim(iw)%dphi=h_dphi(:,iw); wsim(iw)%lw%wf=h_wf(iw)
      wsim(iw)%lw%wfhe4=h_wfhe4(iw); wsim(iw)%lw%wfhe3=h_wfhe3(iw)
      wsim(iw)%lw%wfm=h_wfm(iw);     wsim(iw)%lw%wfx=h_wfx(iw)
      wsim(iw)%lw%signoup=h_sup(iw); wsim(iw)%lw%signodw=h_sdw(iw)
    end do
  end subroutine soa_to_aos_da

  !===========================================================================
  ! Wrapper completo
  !===========================================================================
  subroutine derananum_gpu(wsim, nw, na)
    use mtipos, only: walker
    type(walker), intent(inout) :: wsim(nw)
    integer(i4),  intent(in)   :: nw, na
    call aos_to_soa_da(wsim, nw, na)
    call derananum_gpu_run(nw)
    call soa_to_aos_da(wsim, nw, na)
  end subroutine derananum_gpu

end module mderananum_gpu
