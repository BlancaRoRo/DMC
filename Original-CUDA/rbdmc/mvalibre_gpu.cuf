! mvalibre_gpu.cuf
!
! Kernel CUDA para valibre (mwavef.f90).
! Pone todos los campos del walker a cero (particula libre, sin interacciones).
! Se usa cuando libre=.T. en hpsi.
!
! valibre en CPU:
!   wf=1, wfhe4=1, wfhe3=1, wfm=1, wfx=1
!   kin=0, pot=0, ene=0, erot=0, eimp=0
!   signoup=1, signodw=1
!   dwf(:) = 0, dphi = 0
!
! SOA salida: todos los campos anteriores por walker.
!
module mvalibre_gpu
  use cudafor
  implicit none

  integer, private, parameter :: r8 = selected_real_kind(15,9)
  integer, private, parameter :: i4 = selected_int_kind(9)

  !---------------------------------------------------------------------------
  ! Parametros en device
  !---------------------------------------------------------------------------
  integer(i4), device, public :: d_natom_vl

  !---------------------------------------------------------------------------
  ! SOA salida en device
  !---------------------------------------------------------------------------
  real(r8),    device, allocatable, public :: d_wf_vl(:)
  real(r8),    device, allocatable, public :: d_wfhe4_vl(:), d_wfhe3_vl(:)
  real(r8),    device, allocatable, public :: d_wfm_vl(:),   d_wfx_vl(:)
  real(r8),    device, allocatable, public :: d_kin_vl(:),   d_pot_vl(:), d_ene_vl(:)
  real(r8),    device, allocatable, public :: d_erot_vl(:),  d_eimp_vl(:)
  integer(i4), device, allocatable, public :: d_signoup_vl(:), d_signodw_vl(:)
  real(r8),    device, allocatable, public :: d_dwf_vl(:,:,:)  ! (3, natom, nw)
  real(r8),    device, allocatable, public :: d_dphi_vl(:,:)   ! (2, nw)

contains

  !===========================================================================
  subroutine valibre_gpu_init(natom_h)
    integer(i4), intent(in) :: natom_h
    d_natom_vl = natom_h
  end subroutine valibre_gpu_init

  !===========================================================================
  subroutine valibre_gpu_alloc(nw, na)
    integer(i4), intent(in) :: nw, na
    integer :: istat
    if (allocated(d_wf_vl)) then
      deallocate(d_wf_vl, d_wfhe4_vl, d_wfhe3_vl, d_wfm_vl, d_wfx_vl)
      deallocate(d_kin_vl, d_pot_vl, d_ene_vl, d_erot_vl, d_eimp_vl)
      deallocate(d_signoup_vl, d_signodw_vl, d_dwf_vl, d_dphi_vl)
    end if
    allocate(d_wf_vl(nw),         stat=istat)
    allocate(d_wfhe4_vl(nw),      stat=istat)
    allocate(d_wfhe3_vl(nw),      stat=istat)
    allocate(d_wfm_vl(nw),        stat=istat)
    allocate(d_wfx_vl(nw),        stat=istat)
    allocate(d_kin_vl(nw),        stat=istat)
    allocate(d_pot_vl(nw),        stat=istat)
    allocate(d_ene_vl(nw),        stat=istat)
    allocate(d_erot_vl(nw),       stat=istat)
    allocate(d_eimp_vl(nw),       stat=istat)
    allocate(d_signoup_vl(nw),    stat=istat)
    allocate(d_signodw_vl(nw),    stat=istat)
    allocate(d_dwf_vl(3, na, nw), stat=istat)
    allocate(d_dphi_vl(2, nw),    stat=istat)
  end subroutine valibre_gpu_alloc

  !===========================================================================
  ! Kernel valibre: un hilo por walker, pone todo a 0/1
  !===========================================================================
  attributes(global) subroutine valibre_kernel(nw)
    integer(i4), value :: nw
    integer(i4) :: iw, ia

    iw = (blockIdx%x - 1) * blockDim%x + threadIdx%x
    if (iw > nw) return

    d_wf_vl(iw)       = 1.0_r8
    d_wfhe4_vl(iw)    = 1.0_r8
    d_wfhe3_vl(iw)    = 1.0_r8
    d_wfm_vl(iw)      = 1.0_r8
    d_wfx_vl(iw)      = 1.0_r8
    d_kin_vl(iw)      = 0.0_r8
    d_pot_vl(iw)      = 0.0_r8
    d_ene_vl(iw)      = 0.0_r8
    d_erot_vl(iw)     = 0.0_r8
    d_eimp_vl(iw)     = 0.0_r8
    d_signoup_vl(iw)  = 1
    d_signodw_vl(iw)  = 1
    d_dphi_vl(1, iw)  = 0.0_r8
    d_dphi_vl(2, iw)  = 0.0_r8

    do ia = 1, d_natom_vl
      d_dwf_vl(1, ia, iw) = 0.0_r8
      d_dwf_vl(2, ia, iw) = 0.0_r8
      d_dwf_vl(3, ia, iw) = 0.0_r8
    end do
  end subroutine valibre_kernel

  !===========================================================================
  subroutine valibre_gpu_run(nw)
    integer(i4), intent(in) :: nw
    integer(i4), parameter  :: NTHREADS = 256
    integer(i4) :: nblocks; integer :: istat
    nblocks = (nw + NTHREADS - 1) / NTHREADS
    call valibre_kernel<<<nblocks, NTHREADS>>>(nw)
    istat = cudaDeviceSynchronize()
  end subroutine valibre_gpu_run

  !===========================================================================
  ! SOA -> AOS (D2H): escribe resultados de vuelta a wsim
  !===========================================================================
  subroutine soa_to_aos_vl(wsim, nw, na)
    use mtipos, only: walker
    type(walker), intent(inout) :: wsim(nw)
    integer(i4),  intent(in)   :: nw, na
    real(r8) :: h_dwf(3, na, nw), h_dphi(2, nw)
    real(r8) :: h_wf(nw), h_wfhe4(nw), h_wfhe3(nw), h_wfm(nw), h_wfx(nw)
    real(r8) :: h_kin(nw), h_pot(nw), h_ene(nw), h_erot(nw), h_eimp(nw)
    integer(i4) :: h_sup(nw), h_sdw(nw)
    integer(i4) :: iw, ia
    h_wf=d_wf_vl; h_wfhe4=d_wfhe4_vl; h_wfhe3=d_wfhe3_vl
    h_wfm=d_wfm_vl; h_wfx=d_wfx_vl
    h_kin=d_kin_vl; h_pot=d_pot_vl; h_ene=d_ene_vl
    h_erot=d_erot_vl; h_eimp=d_eimp_vl
    h_sup=d_signoup_vl; h_sdw=d_signodw_vl
    h_dwf=d_dwf_vl; h_dphi=d_dphi_vl
    do iw = 1, nw
      wsim(iw)%lw%wf=h_wf(iw); wsim(iw)%lw%wfhe4=h_wfhe4(iw)
      wsim(iw)%lw%wfhe3=h_wfhe3(iw); wsim(iw)%lw%wfm=h_wfm(iw)
      wsim(iw)%lw%wfx=h_wfx(iw); wsim(iw)%lw%kin=h_kin(iw)
      wsim(iw)%lw%pot=h_pot(iw); wsim(iw)%lw%ene=h_ene(iw)
      wsim(iw)%lw%erot=h_erot(iw); wsim(iw)%lw%eimp=h_eimp(iw)
      wsim(iw)%lw%signoup=h_sup(iw); wsim(iw)%lw%signodw=h_sdw(iw)
      wsim(iw)%dphi=h_dphi(:,iw)
      do ia = 1, na
        wsim(iw)%dwf(ia)%comp(1)=h_dwf(1,ia,iw)
        wsim(iw)%dwf(ia)%comp(2)=h_dwf(2,ia,iw)
        wsim(iw)%dwf(ia)%comp(3)=h_dwf(3,ia,iw)
      end do
    end do
  end subroutine soa_to_aos_vl

end module mvalibre_gpu
