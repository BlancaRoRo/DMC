! mrota_gpu.cuf
!
! Kernel CUDA para rota (mrotaciones.f90).
! Aplica una rotacion de angulo phi alrededor del eje i1 a los ejes
! moleculares sprop(3) de tipo vec3.
!
! La rotacion es determinista: el test compara sprop resultante CPU vs GPU.
!
! rota(i1, phi, ejes):
!   j1 = i1 mod 3 + 1,  k1 = j1 mod 3 + 1
!   ejes(j1) <- c*ejes(j1) + s*ejes(k1)
!   ejes(k1) <- -s*ejes(j1_old) + c*ejes(k1)
!
! SOA entrada:  sprop_in(3, 3, nw)  [ejes moleculares de cada walker]
! SOA salida:   sprop_out(3, 3, nw) [ejes rotados]
! Parametros:   axis_idx, phi_angle (iguales para todos los walkers en el test)
!
module mrota_gpu
  use cudafor
  implicit none

  integer, private, parameter :: r8 = selected_real_kind(15,9)
  integer, private, parameter :: i4 = selected_int_kind(9)

  !---------------------------------------------------------------------------
  ! Parametros en device (eje y angulo de rotacion para el test)
  !---------------------------------------------------------------------------
  integer(i4), device, public :: d_axis_rota
  real(r8),    device, public :: d_phi_rota

  !---------------------------------------------------------------------------
  ! SOA en device
  !---------------------------------------------------------------------------
  real(r8), device, allocatable, public :: d_sprop_in_rota(:,:,:)   ! (3, 3, nw)
  real(r8), device, allocatable, public :: d_sprop_out_rota(:,:,:)  ! (3, 3, nw)

contains

  !===========================================================================
  subroutine rota_gpu_alloc(nw)
    integer(i4), intent(in) :: nw
    integer :: istat
    if (allocated(d_sprop_in_rota)) deallocate(d_sprop_in_rota, d_sprop_out_rota)
    allocate(d_sprop_in_rota(3, 3, nw),  stat=istat)
    allocate(d_sprop_out_rota(3, 3, nw), stat=istat)
  end subroutine rota_gpu_alloc

  !===========================================================================
  ! AOS -> SOA: carga sprop de todos los walkers
  !===========================================================================
  subroutine aos_to_soa_rota(wsim, nw)
    use mtipos, only: walker
    type(walker), intent(in) :: wsim(nw)
    integer(i4),  intent(in) :: nw
    real(r8) :: h_sp(3, 3, nw)
    integer(i4) :: iw, iv
    do iw = 1, nw
      do iv = 1, 3
        h_sp(1,iv,iw) = wsim(iw)%sprop(iv)%comp(1)
        h_sp(2,iv,iw) = wsim(iw)%sprop(iv)%comp(2)
        h_sp(3,iv,iw) = wsim(iw)%sprop(iv)%comp(3)
      end do
    end do
    d_sprop_in_rota = h_sp
  end subroutine aos_to_soa_rota

  !===========================================================================
  ! Device: rota (identico a mrotaciones.f90)
  ! ejes(ic, iv): componente ic del eje iv
  !===========================================================================
  attributes(device) subroutine rota_d(i1, phi, ejes)
    integer(i4), value :: i1
    real(r8), value    :: phi
    real(r8), intent(inout) :: ejes(3, 3)
    real(r8) :: c, s, t
    integer(i4) :: j1, k1, ic
    j1 = mod(i1, 3) + 1
    k1 = mod(j1, 3) + 1
    c = cos(phi);  s = sin(phi)
    do ic = 1, 3
      t            =  c*ejes(ic,j1) + s*ejes(ic,k1)
      ejes(ic,k1)  = -s*ejes(ic,j1) + c*ejes(ic,k1)
      ejes(ic,j1)  = t
    end do
  end subroutine rota_d

  !===========================================================================
  ! Kernel: aplica una rotacion a los ejes de cada walker
  !===========================================================================
  attributes(global) subroutine rota_kernel(nw)
    integer(i4), value :: nw
    integer(i4) :: iw, ic, iv
    real(r8) :: ejes(3, 3)
    iw = (blockIdx%x-1)*blockDim%x + threadIdx%x
    if (iw > nw) return
    do iv = 1, 3
      do ic = 1, 3
        ejes(ic, iv) = d_sprop_in_rota(ic, iv, iw)
      end do
    end do
    call rota_d(d_axis_rota, d_phi_rota, ejes)
    do iv = 1, 3
      do ic = 1, 3
        d_sprop_out_rota(ic, iv, iw) = ejes(ic, iv)
      end do
    end do
  end subroutine rota_kernel

  !===========================================================================
  subroutine rota_gpu_run(nw, axis_h, phi_h)
    integer(i4), intent(in) :: nw, axis_h
    real(r8),    intent(in) :: phi_h
    integer(i4), parameter  :: NTHREADS = 256
    integer(i4) :: nblocks; integer :: istat
    d_axis_rota = axis_h
    d_phi_rota  = phi_h
    nblocks = (nw+NTHREADS-1)/NTHREADS
    call rota_kernel<<<nblocks,NTHREADS>>>(nw)
    istat = cudaDeviceSynchronize()
  end subroutine rota_gpu_run

  !===========================================================================
  ! SOA -> AOS (D2H)
  !===========================================================================
  subroutine soa_to_aos_rota(nw, sprop_out)
    integer(i4), intent(in)  :: nw
    real(r8),    intent(out) :: sprop_out(3, 3, nw)
    sprop_out = d_sprop_out_rota
  end subroutine soa_to_aos_rota

end module mrota_gpu
