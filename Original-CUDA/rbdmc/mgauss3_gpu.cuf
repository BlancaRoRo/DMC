! mgauss3_gpu.cuf
!
! Kernel CUDA para gauss3 (mrandom.f90).
! Box-Muller con el mismo LCG48 que mrandom2.f90 (rand1).
! Cada hilo tiene su propio estado RNG en d_irn_g3(iw).
!
! Test determinista: inicializando d_irn_g3(1) con la misma semilla
! que el RNG de la CPU, el walker 1 produce exactamente los mismos
! numeros que la CPU.
!
module mgauss3_gpu
  use cudafor
  implicit none

  integer, private, parameter :: r8 = selected_real_kind(15,9)
  integer, private, parameter :: i4 = 4   ! selected_int_kind(9) -> hardcoded para device
  integer, private, parameter :: i8 = 8   ! selected_int_kind(15) -> hardcoded (como mtipos.f90)

  real(r8), private, parameter :: PI_G3 = 3.1415926535897930_r8

  !---------------------------------------------------------------------------
  ! SOA en device
  ! d_irn_g3(iw): estado RNG por walker (int64)
  ! d_gvar3(3, iw): resultado de una llamada a gauss3 por walker
  !---------------------------------------------------------------------------
  integer(i8), device, allocatable, public :: d_irn_g3(:)
  real(r8),    device, allocatable, public :: d_gvar3(:,:)   ! (3, nw)

  ! Arrays para diagnostico LCG (un solo paso sin avanzar estado)
  integer(i8), device, allocatable, public :: d_diag_is1(:), d_diag_is2(:)
  integer(i8), device, allocatable, public :: d_diag_m11(:), d_diag_m12(:)
  integer(i8), device, allocatable, public :: d_diag_irn_nuevo(:)
  real(r8),    device, allocatable, public :: d_diag_rn(:)

  ! Arrays para diagnostico de los 4 rn del Box-Muller
  real(r8), device, allocatable, public :: d_rns_debug(:,:)   ! (4, nw)
  ! Para test de 100 rn: 25 atomos × 4 rn = todas las llamadas en 1 difusion
  real(r8), device, allocatable, public :: d_rns100(:,:)      ! (100, nw)

contains

  !===========================================================================
  subroutine gauss3_gpu_alloc(nw)
    integer(i4), intent(in) :: nw
    integer :: istat
    if (allocated(d_irn_g3)) deallocate(d_irn_g3, d_gvar3)
    allocate(d_irn_g3(nw),    stat=istat)
    allocate(d_gvar3(3, nw),  stat=istat)
  end subroutine gauss3_gpu_alloc

  !===========================================================================
  ! Inicializar semillas: d_irn_g3(1)=seed, resto derivadas con el mismo LCG
  !===========================================================================
  subroutine gauss3_gpu_init_seeds(seed, nw)
    integer(i8), intent(in) :: seed
    integer(i4), intent(in) :: nw
    integer(i8) :: h_irn(nw)
    integer(i4) :: iw
    integer(i8), parameter :: mask48 = ishft(1_i8,48)-1_i8
    integer(i8), parameter :: mult1  = 44485709377909_i8
    integer(i8), parameter :: iadd1  = 96309754297_i8
    h_irn(1) = iand(seed, mask48)
    do iw = 2, nw
      h_irn(iw) = iand(h_irn(iw-1)*mult1 + iadd1, mask48)
    end do
    d_irn_g3 = h_irn
  end subroutine gauss3_gpu_init_seeds

  !===========================================================================
  ! Device: generador LCG48 (identico a rand1 de mrandom2.f90)
  !===========================================================================
  attributes(device) function rn1_g3(iw) result(rn)
    integer(i4), value :: iw
    real(r8) :: rn
    integer(8) :: irn, is1, is2
    ! Uso de _8 (literal) en vez de _i8 (parametro): nvfortran device no resuelve
    ! correctamente parametros de modulo como kind designators en literales.
    integer(8), parameter :: mask24 = 16777215_8           ! 2^24 - 1
    integer(8), parameter :: mask48 = 281474976710655_8     ! 2^48 - 1
    real(r8),   parameter :: twom48 = 2.0_r8**(-48)
    integer(8), parameter :: mult1  = 44485709377909_8
    ! m11 y m12 hardcodeados: nvfortran no evalua ishft() correctamente
    ! en parametros de device (da m12=16649 en vez de 2651554).
    ! Verificado: m11 = lower 24 bits de mult1 = 0xE7B175 = 15184245
    !             m12 = bits 24-47 de mult1    = 0x2875A2 = 2651554
    integer(8), parameter :: m11    = 15184245_8
    integer(8), parameter :: m12    = 2651554_8
    integer(8), parameter :: iadd1  = 96309754297_8
    irn = d_irn_g3(iw)
    is2 = iand(ishft(irn,-24), mask24)
    is1 = iand(irn, mask24)
    irn = iand(ishft(iand(is1*m12+is2*m11,mask24),24)+is1*m11+iadd1, mask48)
    d_irn_g3(iw) = irn
    rn = ior(irn, 1_8) * twom48
  end function rn1_g3

  !===========================================================================
  ! Kernel diagnostico: captura intermedios del LCG SIN avanzar el estado
  !===========================================================================
  attributes(global) subroutine lcg_diagnostico_kernel(nw)
    integer(i4), value :: nw
    integer(i4) :: iw
    integer(8) :: irn, is1_l, is2_l, irn_nuevo
    real(r8)    :: rn_l
    integer(8), parameter :: mask24_d = 16777215_8
    integer(8), parameter :: mask48_d = 281474976710655_8
    real(r8),   parameter :: twom48_d = 2.0_r8**(-48)
    integer(8), parameter :: mult1_d  = 44485709377909_8
    integer(8), parameter :: m11_d    = 15184245_8
    integer(8), parameter :: m12_d    = 2651554_8
    integer(8), parameter :: iadd1_d  = 96309754297_8

    iw = (blockIdx%x-1)*blockDim%x + threadIdx%x
    if (iw > nw) return

    irn      = d_irn_g3(iw)
    is2_l    = iand(ishft(irn,-24), mask24_d)
    is1_l    = iand(irn, mask24_d)
    irn_nuevo= iand(ishft(iand(is1_l*m12_d+is2_l*m11_d,mask24_d),24)+is1_l*m11_d+iadd1_d, mask48_d)
    rn_l     = ior(irn_nuevo, 1_8) * twom48_d

    d_diag_is1(iw)      = is1_l
    d_diag_is2(iw)      = is2_l
    d_diag_m11(iw)      = m11_d
    d_diag_m12(iw)      = m12_d
    d_diag_irn_nuevo(iw) = irn_nuevo
    d_diag_rn(iw)       = rn_l
    ! NO actualiza d_irn_g3 - solo observacion
  end subroutine lcg_diagnostico_kernel

  subroutine gauss3_diag_alloc(nw)
    integer(i4), intent(in) :: nw
    integer :: istat
    if (allocated(d_diag_is1)) deallocate(d_diag_is1, d_diag_is2, d_diag_m11, &
                                            d_diag_m12, d_diag_irn_nuevo, d_diag_rn)
    allocate(d_diag_is1(nw), d_diag_is2(nw), d_diag_m11(nw), &
             d_diag_m12(nw), d_diag_irn_nuevo(nw), d_diag_rn(nw), stat=istat)
  end subroutine gauss3_diag_alloc

  subroutine gauss3_diag_run(nw)
    integer(i4), intent(in) :: nw
    integer(i4), parameter  :: NTHREADS = 256
    integer(i4) :: nblocks; integer :: istat
    nblocks = (nw+NTHREADS-1)/NTHREADS
    call lcg_diagnostico_kernel<<<nblocks,NTHREADS>>>(nw)
    istat = cudaDeviceSynchronize()
  end subroutine gauss3_diag_run

  !===========================================================================
  ! Device: gauss3 Box-Muller (identico a mrandom.f90)
  ! Gestion del estado LOCAL para evitar que nvfortran cachee d_irn_g3
  ! entre llamadas: carga el estado una sola vez, hace 4 pasos LCG en
  ! registros locales, escribe de vuelta al final.
  !===========================================================================
  attributes(device) subroutine gauss3_d(iw, g)
    integer(i4), value :: iw
    real(r8), intent(out) :: g(3)
    real(r8)   :: xl, rn_vals(4)
    integer(8) :: st, s1, s2, k
    integer(8), parameter :: mask24l = 16777215_8
    integer(8), parameter :: mask48l = 281474976710655_8
    real(r8),   parameter :: twom48l = 2.0_r8**(-48)
    integer(8), parameter :: m11l    = 15184245_8
    integer(8), parameter :: m12l    = 2651554_8
    integer(8), parameter :: iadd1l  = 96309754297_8

    st = d_irn_g3(iw)

    ! DO loop con indice i4 (no i8) para evitar problemas de indexacion en device
    do k = 1, 4
      s2 = iand(ishft(st,-24), mask24l)
      s1 = iand(st, mask24l)
      st = iand(ishft(iand(s1*m12l+s2*m11l,mask24l),24)+s1*m11l+iadd1l, mask48l)
      rn_vals(k) = real(ior(st, 1_8), r8) * twom48l
    end do

    d_irn_g3(iw) = st

    ! Box-Muller identico a mrandom.f90:gauss3
    xl   = sqrt(-2.0_r8 * log(rn_vals(2)))
    g(1) = xl * sin(2.0_r8 * PI_G3 * rn_vals(1))
    g(2) = xl * cos(2.0_r8 * PI_G3 * rn_vals(1))
    xl   = sqrt(-2.0_r8 * log(rn_vals(4)))
    g(3) = xl * sin(2.0_r8 * PI_G3 * rn_vals(3))
  end subroutine gauss3_d

  !===========================================================================
  ! Kernel: genera 3 valores gaussianos por walker
  !===========================================================================
  attributes(global) subroutine gauss3_kernel(nw)
    integer(i4), value :: nw
    integer(i4) :: iw
    real(r8) :: g(3)
    iw = (blockIdx%x-1)*blockDim%x + threadIdx%x
    if (iw > nw) return
    call gauss3_d(iw, g)
    d_gvar3(1,iw) = g(1)
    d_gvar3(2,iw) = g(2)
    d_gvar3(3,iw) = g(3)
  end subroutine gauss3_kernel

  !===========================================================================
  subroutine gauss3_gpu_run(nw)
    integer(i4), intent(in) :: nw
    integer(i4), parameter  :: NTHREADS = 256
    integer(i4) :: nblocks; integer :: istat
    nblocks = (nw+NTHREADS-1)/NTHREADS
    call gauss3_kernel<<<nblocks,NTHREADS>>>(nw)
    istat = cudaDeviceSynchronize()
  end subroutine gauss3_gpu_run

  !===========================================================================
  ! Kernel: guarda los 4 rn generados por el DO loop SIN hacer Box-Muller.
  ! Compara con CPU: rn_cpu(k) = rn1() llamado 4 veces desde misma semilla.
  !===========================================================================
  attributes(global) subroutine debug_rns_kernel(nw)
    integer(i4), value :: nw
    integer(i4) :: iw, k
    integer(8)  :: st, s1, s2
    integer(8), parameter :: mask24d = 16777215_8
    integer(8), parameter :: mask48d = 281474976710655_8
    real(r8),   parameter :: twom48d = 2.0_r8**(-48)
    integer(8), parameter :: m11d    = 15184245_8
    integer(8), parameter :: m12d    = 2651554_8
    integer(8), parameter :: iadd1d  = 96309754297_8

    iw = (blockIdx%x-1)*blockDim%x + threadIdx%x
    if (iw > nw) return

    st = d_irn_g3(iw)
    do k = 1, 4
      s2 = iand(ishft(st,-24), mask24d)
      s1 = iand(st, mask24d)
      st = iand(ishft(iand(s1*m12d+s2*m11d,mask24d),24)+s1*m11d+iadd1d, mask48d)
      d_rns_debug(k, iw) = real(ior(st, 1_8), r8) * twom48d
    end do
    ! NO avanza d_irn_g3 — solo observacion
  end subroutine debug_rns_kernel

  subroutine debug_rns_alloc(nw)
    integer(i4), intent(in) :: nw; integer :: istat
    if (allocated(d_rns_debug)) deallocate(d_rns_debug)
    allocate(d_rns_debug(4, nw), stat=istat)
  end subroutine debug_rns_alloc

  subroutine debug_rns_run(nw)
    integer(i4), intent(in) :: nw
    integer(i4), parameter  :: NTHREADS = 256
    integer(i4) :: nblocks; integer :: istat
    nblocks = (nw+NTHREADS-1)/NTHREADS
    call debug_rns_kernel<<<nblocks,NTHREADS>>>(nw)
    istat = cudaDeviceSynchronize()
  end subroutine debug_rns_run

  !===========================================================================
  ! Kernel que genera los 100 rn de una difusion completa (25 atomos × 4 rn)
  ! usando el MISMO LCG que difusion_kernel (estado en registro, no global mem)
  !===========================================================================
  attributes(global) subroutine test_100rns_kernel(nw, n_rns)
    integer(i4), value :: nw, n_rns
    integer(i4) :: iw, k
    integer(8) :: st, s1, s2
    integer(8), parameter :: mask24r = 16777215_8
    integer(8), parameter :: mask48r = 281474976710655_8
    real(r8),   parameter :: twom48r = 2.0_r8**(-48)
    integer(8), parameter :: m11r    = 15184245_8
    integer(8), parameter :: m12r    = 2651554_8
    integer(8), parameter :: ak1r    = 96309754297_8

    iw = (blockIdx%x-1)*blockDim%x + threadIdx%x
    if (iw > nw) return

    st = d_irn_g3(iw)
    do k = 1, n_rns
      s2=iand(ishft(st,-24),mask24r); s1=iand(st,mask24r)
      st=iand(ishft(iand(s1*m12r+s2*m11r,mask24r),24)+s1*m11r+ak1r,mask48r)
      d_rns100(k,iw) = real(ior(st,1_8),r8) * twom48r
    end do
  end subroutine test_100rns_kernel

  subroutine test_100rns_alloc(nw, n_rns)
    integer(i4), intent(in) :: nw, n_rns; integer :: istat
    if (allocated(d_rns100)) deallocate(d_rns100)
    allocate(d_rns100(n_rns, nw), stat=istat)
  end subroutine test_100rns_alloc

  subroutine test_100rns_run(nw, n_rns)
    integer(i4), intent(in) :: nw, n_rns
    integer(i4), parameter  :: NTHREADS = 256
    integer(i4) :: nblocks; integer :: istat
    nblocks = (nw+NTHREADS-1)/NTHREADS
    call test_100rns_kernel<<<nblocks,NTHREADS>>>(nw, n_rns)
    istat = cudaDeviceSynchronize()
  end subroutine test_100rns_run

end module mgauss3_gpu
