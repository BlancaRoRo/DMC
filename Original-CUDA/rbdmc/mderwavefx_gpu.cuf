! mderwavefx_gpu.cuf
!
! Kernel CUDA para derwavefx (mwavef.f90).
! Calcula el gradiente y laplaciano de ln(wfx) para la impureza molecular
! mediante derivadas analiticas (inlinea duhe4x, duhe3x, calderpleg).
!
! Salidas adicionales respecto a los otros derwavef:
!   d1zwf(2, nw) : gradiente de ln(wfx) respecto a angulos de rotacion
!   d2zwf(nw)    : laplaciano rotacional
!
module mderwavefx_gpu
  use cudafor
  implicit none

  integer, private, parameter :: r8 = selected_real_kind(15,9)
  integer, private, parameter :: i4 = selected_int_kind(9)

  integer(i4), parameter, public :: NATOM_MAX_DX = 26
  integer(i4), parameter, public :: LMAX_DX      = 8

  !---------------------------------------------------------------------------
  ! Parametros en device
  !---------------------------------------------------------------------------
  integer(i4), device, public :: d_nhe4_dx, d_ngatom_dx, d_natom_dx
  integer(i4), device, public :: d_lxhe4_dx, d_lxhe3_dx
  real(r8),    device, public :: d_pxhe4_dx(5, 0:LMAX_DX)
  real(r8),    device, public :: d_pxhe3_dx(5, 0:LMAX_DX)
  logical,     device, public :: d_impureza_dx, d_impurmol_dx

  !---------------------------------------------------------------------------
  ! SOA en device
  ! Entrada: atom(natom, nw), sprop(3, 3, nw) (todos los ejes, no solo el 3)
  ! Salida:  d1wf(3, natom, nw), d2wf(natom, nw), d1zwf(2, nw), d2zwf(nw)
  !---------------------------------------------------------------------------
  real(r8), device, allocatable, public :: d_atom_soa_dx(:,:,:)
  real(r8), device, allocatable, public :: d_sprop_soa_dx(:,:,:)
  real(r8), device, allocatable, public :: d_d1wfx_soa(:,:,:)
  real(r8), device, allocatable, public :: d_d2wfx_soa(:,:)
  real(r8), device, allocatable, public :: d_d1zwfx_soa(:,:)
  real(r8), device, allocatable, public :: d_d2zwfx_soa(:)

contains

  !===========================================================================
  subroutine derwavefx_gpu_init(nhe4_h, ngatom_h, natom_h,  &
                                  lxhe4_h, lxhe3_h,           &
                                  pxhe4_h, pxhe3_h,           &
                                  impureza_h, impurmol_h)
    integer(i4), intent(in) :: nhe4_h, ngatom_h, natom_h
    integer(i4), intent(in) :: lxhe4_h, lxhe3_h
    real(r8),    intent(in) :: pxhe4_h(5, 0:lxhe4_h), pxhe3_h(5, 0:lxhe3_h)
    logical,     intent(in) :: impureza_h, impurmol_h
    d_nhe4_dx   = nhe4_h;   d_ngatom_dx  = ngatom_h;  d_natom_dx  = natom_h
    d_lxhe4_dx  = lxhe4_h;  d_lxhe3_dx   = lxhe3_h
    d_pxhe4_dx(1:5, 0:lxhe4_h) = pxhe4_h
    d_pxhe3_dx(1:5, 0:lxhe3_h) = pxhe3_h
    d_impureza_dx  = impureza_h
    d_impurmol_dx  = impurmol_h
  end subroutine derwavefx_gpu_init

  !===========================================================================
  subroutine derwavefx_gpu_alloc(nw, na)
    integer(i4), intent(in) :: nw, na
    integer :: istat
    if (allocated(d_atom_soa_dx)) then
      deallocate(d_atom_soa_dx, d_sprop_soa_dx)
      deallocate(d_d1wfx_soa, d_d2wfx_soa, d_d1zwfx_soa, d_d2zwfx_soa)
    end if
    allocate(d_atom_soa_dx(3, na, nw),  stat=istat)
    allocate(d_sprop_soa_dx(3, 3, nw),  stat=istat)
    allocate(d_d1wfx_soa(3, na, nw),   stat=istat)
    allocate(d_d2wfx_soa(na, nw),      stat=istat)
    allocate(d_d1zwfx_soa(2, nw),      stat=istat)
    allocate(d_d2zwfx_soa(nw),         stat=istat)
  end subroutine derwavefx_gpu_alloc

  !===========================================================================
  ! AOS -> SOA (H2D): posiciones + orientacion molecular completa (3 ejes)
  !===========================================================================
  subroutine aos_to_soa_dx(wsim, nw, na)
    use mtipos, only: walker
    type(walker), intent(in) :: wsim(nw)
    integer(i4),  intent(in) :: nw, na
    real(r8) :: h_atom(3, na, nw), h_sprop(3, 3, nw)
    integer(i4) :: iw, ia, iv
    do iw = 1, nw
      do ia = 1, na
        h_atom(1,ia,iw) = wsim(iw)%atom(ia)%comp(1)
        h_atom(2,ia,iw) = wsim(iw)%atom(ia)%comp(2)
        h_atom(3,ia,iw) = wsim(iw)%atom(ia)%comp(3)
      end do
      do iv = 1, 3
        h_sprop(1,iv,iw) = wsim(iw)%sprop(iv)%comp(1)
        h_sprop(2,iv,iw) = wsim(iw)%sprop(iv)%comp(2)
        h_sprop(3,iv,iw) = wsim(iw)%sprop(iv)%comp(3)
      end do
    end do
    d_atom_soa_dx  = h_atom
    d_sprop_soa_dx = h_sprop
  end subroutine aos_to_soa_dx

  !===========================================================================
  ! Device: polinomios de Legendre con primera y segunda derivada
  ! (calderpleg de mlegendre.f90)
  !===========================================================================
  attributes(device) subroutine calderpleg_d_dx(l, x, pl, d1pl, d2pl)
    integer(i4), value :: l
    real(r8), value    :: x
    real(r8), intent(out) :: pl(0:LMAX_DX), d1pl(0:LMAX_DX), d2pl(0:LMAX_DX)
    integer(i4) :: il
    pl(0)=1.0_r8;  d1pl(0)=0.0_r8;  d2pl(0)=0.0_r8
    if (l < 1) return
    pl(1)=x;  d1pl(1)=1.0_r8;  d2pl(1)=0.0_r8
    do il = 1, l-1
      pl(il+1)   = ((2.0_r8*il+1.0_r8)*x*pl(il)   - il*pl(il-1))   / real(il+1,r8)
      d1pl(il+1) =  (2.0_r8*il+1.0_r8)*pl(il)   + d1pl(il-1)
      d2pl(il+1) =  (2.0_r8*il+1.0_r8)*d1pl(il) + d2pl(il-1)
    end do
  end subroutine calderpleg_d_dx

  !===========================================================================
  ! Device: duhe4x (mangwavef.f90) -- gradiente analitico He4-impureza
  ! rivec = r_He4 - r_impureza
  ! smol(3) = ejes moleculares normalizados (3 ejes x 3 componentes)
  !===========================================================================
  attributes(device) subroutine duhe4x_d_dx(rivec, smol, d1ux, d2ux, d1zux, d2zux)
    real(r8), intent(in)  :: rivec(3), smol(3, 3)
    real(r8), intent(out) :: d1ux(3), d2ux, d1zux(2), d2zux
    real(r8) :: grz(3), grpl(3), grul(3)
    real(r8) :: rij, cth, zpr, grz2, lapz, gpz(2), lpz, gpz2
    real(r8) :: ulx, ulxp, ulxs, lapl, rijp2, rijp4
    real(r8) :: pl(0:LMAX_DX), d1pl(0:LMAX_DX), d2pl(0:LMAX_DX)
    integer(i4) :: il

    rij = sqrt(rivec(1)**2 + rivec(2)**2 + rivec(3)**2)
    if (d_impurmol_dx) then
      cth  = (rivec(1)*smol(1,3) + rivec(2)*smol(2,3) + rivec(3)*smol(3,3)) / rij
      zpr  = cth / rij
      grz(1) = (smol(1,3) - zpr*rivec(1)) / rij
      grz(2) = (smol(2,3) - zpr*rivec(2)) / rij
      grz(3) = (smol(3,3) - zpr*rivec(3)) / rij
      grz2 = grz(1)**2 + grz(2)**2 + grz(3)**2
      lapz = -2.0_r8*zpr/rij
      gpz(1) = -(rivec(1)*smol(1,2) + rivec(2)*smol(2,2) + rivec(3)*smol(3,2)) / rij
      gpz(2) =  (rivec(1)*smol(1,1) + rivec(2)*smol(2,1) + rivec(3)*smol(3,1)) / rij
      gpz2 = gpz(1)**2 + gpz(2)**2
      lpz  = -cth - cth
    else
      cth=0.0_r8; grz=0.0_r8; grz2=0.0_r8; lapz=0.0_r8
      gpz=0.0_r8; gpz2=0.0_r8; lpz=0.0_r8
    end if

    call calderpleg_d_dx(d_lxhe4_dx, cth, pl, d1pl, d2pl)
    do il = 1, d_lxhe4_dx
      pl(il) = 1.0_r8-pl(il);  d1pl(il) = -d1pl(il);  d2pl(il) = -d2pl(il)
    end do

    d1ux=0.0_r8;  d2ux=0.0_r8;  d1zux=0.0_r8;  d2zux=0.0_r8
    do il = 0, d_lxhe4_dx
      rijp2 = rij**d_pxhe4_dx(2,il)
      rijp4 = rij**d_pxhe4_dx(4,il)
      ulx  = -d_pxhe4_dx(1,il)/rijp2 - d_pxhe4_dx(3,il)*rijp4 - d_pxhe4_dx(5,il)*log(rij)
      ulxp = ( d_pxhe4_dx(1,il)*d_pxhe4_dx(2,il)/rijp2 &
              - d_pxhe4_dx(3,il)*d_pxhe4_dx(4,il)*rijp4 - d_pxhe4_dx(5,il)) / rij
      ulxs = (-d_pxhe4_dx(1,il)*d_pxhe4_dx(2,il)*(d_pxhe4_dx(2,il)+1.0_r8)/rijp2 &
              - d_pxhe4_dx(3,il)*d_pxhe4_dx(4,il)*(d_pxhe4_dx(4,il)-1.0_r8)*rijp4 &
              + d_pxhe4_dx(5,il)) / rij**2 + 2.0_r8*ulxp/rij
      grul = ulxp/rij * rivec
      grpl = d1pl(il) * grz
      lapl = lapz*d1pl(il) + grz2*d2pl(il)
      d1ux  = d1ux + pl(il)*grul + ulx*grpl
      d2ux  = d2ux + pl(il)*ulxs + ulx*lapl + 2.0_r8*(grul(1)*grpl(1)+grul(2)*grpl(2)+grul(3)*grpl(3))
      d1zux = d1zux + ulx*d1pl(il)*gpz
      d2zux = d2zux + ulx*(d1pl(il)*lpz + d2pl(il)*gpz2)
    end do
  end subroutine duhe4x_d_dx

  !===========================================================================
  ! Device: duhe3x (mangwavef.f90) -- gradiente analitico He3-impureza
  !===========================================================================
  attributes(device) subroutine duhe3x_d_dx(rivec, smol, d1ux, d2ux, d1zux, d2zux)
    real(r8), intent(in)  :: rivec(3), smol(3, 3)
    real(r8), intent(out) :: d1ux(3), d2ux, d1zux(2), d2zux
    real(r8) :: grz(3), grpl(3), grul(3)
    real(r8) :: rij, cth, zpr, grz2, lapz, gpz(2), lpz, gpz2
    real(r8) :: ulx, ulxp, ulxs, lapl, rijp2, rijp4
    real(r8) :: pl(0:LMAX_DX), d1pl(0:LMAX_DX), d2pl(0:LMAX_DX)
    integer(i4) :: il

    rij = sqrt(rivec(1)**2 + rivec(2)**2 + rivec(3)**2)
    if (d_impurmol_dx) then
      cth  = (rivec(1)*smol(1,3) + rivec(2)*smol(2,3) + rivec(3)*smol(3,3)) / rij
      zpr  = cth / rij
      grz(1) = (smol(1,3) - zpr*rivec(1)) / rij
      grz(2) = (smol(2,3) - zpr*rivec(2)) / rij
      grz(3) = (smol(3,3) - zpr*rivec(3)) / rij
      grz2 = grz(1)**2 + grz(2)**2 + grz(3)**2
      lapz = -2.0_r8*zpr/rij
      gpz(1) = -(rivec(1)*smol(1,2) + rivec(2)*smol(2,2) + rivec(3)*smol(3,2)) / rij
      gpz(2) =  (rivec(1)*smol(1,1) + rivec(2)*smol(2,1) + rivec(3)*smol(3,1)) / rij
      gpz2 = gpz(1)**2 + gpz(2)**2
      lpz  = -cth - cth
    else
      cth=0.0_r8; grz=0.0_r8; grz2=0.0_r8; lapz=0.0_r8
      gpz=0.0_r8; gpz2=0.0_r8; lpz=0.0_r8
    end if

    call calderpleg_d_dx(d_lxhe3_dx, cth, pl, d1pl, d2pl)
    do il = 1, d_lxhe3_dx
      pl(il) = 1.0_r8-pl(il);  d1pl(il) = -d1pl(il);  d2pl(il) = -d2pl(il)
    end do

    d1ux=0.0_r8;  d2ux=0.0_r8;  d1zux=0.0_r8;  d2zux=0.0_r8
    do il = 0, d_lxhe3_dx
      rijp2 = rij**d_pxhe3_dx(2,il)
      rijp4 = rij**d_pxhe3_dx(4,il)
      ulx  = -d_pxhe3_dx(1,il)/rijp2 - d_pxhe3_dx(3,il)*rijp4 - d_pxhe3_dx(5,il)*log(rij)
      ulxp = ( d_pxhe3_dx(1,il)*d_pxhe3_dx(2,il)/rijp2 &
              - d_pxhe3_dx(3,il)*d_pxhe3_dx(4,il)*rijp4 - d_pxhe3_dx(5,il)) / rij
      ulxs = (-d_pxhe3_dx(1,il)*d_pxhe3_dx(2,il)*(d_pxhe3_dx(2,il)+1.0_r8)/rijp2 &
              - d_pxhe3_dx(3,il)*d_pxhe3_dx(4,il)*(d_pxhe3_dx(4,il)-1.0_r8)*rijp4 &
              + d_pxhe3_dx(5,il)) / rij**2 + 2.0_r8*ulxp/rij
      grul = ulxp/rij * rivec
      grpl = d1pl(il) * grz
      lapl = lapz*d1pl(il) + grz2*d2pl(il)
      d1ux  = d1ux + pl(il)*grul + ulx*grpl
      d2ux  = d2ux + pl(il)*ulxs + ulx*lapl + 2.0_r8*(grul(1)*grpl(1)+grul(2)*grpl(2)+grul(3)*grpl(3))
      d1zux = d1zux + ulx*d1pl(il)*gpz
      d2zux = d2zux + ulx*(d1pl(il)*lpz + d2pl(il)*gpz2)
    end do
  end subroutine duhe3x_d_dx

  !===========================================================================
  ! Kernel derwavefx: un hilo por walker
  !===========================================================================
  attributes(global) subroutine derwavefx_kernel(nw)
    integer(i4), value :: nw
    integer(i4) :: iw, iatom, jatom, jhe3, ic
    real(r8) :: atom(3, NATOM_MAX_DX), smol(3, 3)
    real(r8) :: d1wf(3, NATOM_MAX_DX), d2wf(NATOM_MAX_DX)
    real(r8) :: d1zwf(2), d2zwf
    real(r8) :: d1ux(3), d2ux, d1zux(2), d2zux
    real(r8) :: rivec(3), dnor

    iw = (blockIdx%x - 1) * blockDim%x + threadIdx%x
    if (iw > nw) return

    do iatom = 1, d_natom_dx
      atom(1,iatom) = d_atom_soa_dx(1, iatom, iw)
      atom(2,iatom) = d_atom_soa_dx(2, iatom, iw)
      atom(3,iatom) = d_atom_soa_dx(3, iatom, iw)
    end do

    ! Inicializar salida
    do iatom = 1, d_natom_dx
      d1wf(1,iatom) = 0.0_r8;  d1wf(2,iatom) = 0.0_r8;  d1wf(3,iatom) = 0.0_r8
      d2wf(iatom)   = 0.0_r8
    end do
    d1zwf = 0.0_r8;  d2zwf = 0.0_r8

    if (.not. d_impureza_dx) then
      ! Escribir ceros y salir
      do iatom = 1, d_natom_dx
        d_d1wfx_soa(1,iatom,iw) = 0.0_r8
        d_d1wfx_soa(2,iatom,iw) = 0.0_r8
        d_d1wfx_soa(3,iatom,iw) = 0.0_r8
        d_d2wfx_soa(iatom,iw)   = 0.0_r8
      end do
      d_d1zwfx_soa(1,iw) = 0.0_r8;  d_d1zwfx_soa(2,iw) = 0.0_r8
      d_d2zwfx_soa(iw)   = 0.0_r8
      return
    end if

    ! Normalizar ejes moleculares (smol = sprop normalizado)
    if (d_impurmol_dx) then
      do ic = 1, 3
        dnor = sqrt(d_sprop_soa_dx(1,ic,iw)**2 + d_sprop_soa_dx(2,ic,iw)**2 + d_sprop_soa_dx(3,ic,iw)**2)
        smol(1,ic) = d_sprop_soa_dx(1,ic,iw) / dnor
        smol(2,ic) = d_sprop_soa_dx(2,ic,iw) / dnor
        smol(3,ic) = d_sprop_soa_dx(3,ic,iw) / dnor
      end do
    end if

    ! He4 vs impureza
    do jatom = 1, d_nhe4_dx
      rivec(1) = atom(1,jatom) - atom(1,d_natom_dx)
      rivec(2) = atom(2,jatom) - atom(2,d_natom_dx)
      rivec(3) = atom(3,jatom) - atom(3,d_natom_dx)
      call duhe4x_d_dx(rivec, smol, d1ux, d2ux, d1zux, d2zux)
      d1wf(:,jatom)       = d1ux
      d1wf(:,d_natom_dx)  = d1wf(:,d_natom_dx) - d1ux
      d2wf(jatom)         = d2ux
      d2wf(d_natom_dx)    = d2wf(d_natom_dx) + d2ux
      d1zwf = d1zwf + d1zux
      d2zwf = d2zwf + d2zux
    end do

    ! He3 vs impureza
    do jhe3 = 1, d_ngatom_dx - d_nhe4_dx
      jatom = d_nhe4_dx + jhe3
      rivec(1) = atom(1,jatom) - atom(1,d_natom_dx)
      rivec(2) = atom(2,jatom) - atom(2,d_natom_dx)
      rivec(3) = atom(3,jatom) - atom(3,d_natom_dx)
      call duhe3x_d_dx(rivec, smol, d1ux, d2ux, d1zux, d2zux)
      d1wf(:,jatom)       = d1ux
      d1wf(:,d_natom_dx)  = d1wf(:,d_natom_dx) - d1ux
      d2wf(jatom)         = d2ux
      d2wf(d_natom_dx)    = d2wf(d_natom_dx) + d2ux
      d1zwf = d1zwf + d1zux
      d2zwf = d2zwf + d2zux
    end do

    ! Termino cuadratico del laplaciano
    do iatom = 1, d_natom_dx
      d2wf(iatom) = d2wf(iatom) + d1wf(1,iatom)**2 + d1wf(2,iatom)**2 + d1wf(3,iatom)**2
    end do
    d2zwf = d2zwf + d1zwf(1)**2 + d1zwf(2)**2

    ! Escribir al SOA
    do iatom = 1, d_natom_dx
      d_d1wfx_soa(1,iatom,iw) = d1wf(1,iatom)
      d_d1wfx_soa(2,iatom,iw) = d1wf(2,iatom)
      d_d1wfx_soa(3,iatom,iw) = d1wf(3,iatom)
      d_d2wfx_soa(iatom,iw)   = d2wf(iatom)
    end do
    d_d1zwfx_soa(1,iw) = d1zwf(1);  d_d1zwfx_soa(2,iw) = d1zwf(2)
    d_d2zwfx_soa(iw)   = d2zwf
  end subroutine derwavefx_kernel

  !===========================================================================
  subroutine derwavefx_gpu_run(nw)
    integer(i4), intent(in) :: nw
    integer(i4), parameter  :: NTHREADS = 128
    integer(i4) :: nblocks
    integer      :: istat
    nblocks = (nw + NTHREADS - 1) / NTHREADS
    call derwavefx_kernel<<<nblocks, NTHREADS>>>(nw)
    istat = cudaDeviceSynchronize()
  end subroutine derwavefx_gpu_run

  !===========================================================================
  ! SOA -> AOS (D2H)
  !===========================================================================
  subroutine soa_to_aos_dx(nw, na, d1wf_out, d2wf_out, d1zwf_out, d2zwf_out)
    integer(i4), intent(in)  :: nw, na
    real(r8),    intent(out) :: d1wf_out(3, na, nw), d2wf_out(na, nw)
    real(r8),    intent(out) :: d1zwf_out(2, nw), d2zwf_out(nw)
    d1wf_out  = d_d1wfx_soa
    d2wf_out  = d_d2wfx_soa
    d1zwf_out = d_d1zwfx_soa
    d2zwf_out = d_d2zwfx_soa
  end subroutine soa_to_aos_dx

  !===========================================================================
  ! Wrapper completo
  !===========================================================================
  subroutine derwavefx_gpu(wsim, nw, na, d1wf_out, d2wf_out, d1zwf_out, d2zwf_out)
    use mtipos, only: walker
    type(walker), intent(in) :: wsim(nw)
    integer(i4),  intent(in) :: nw, na
    real(r8),    intent(out) :: d1wf_out(3, na, nw), d2wf_out(na, nw)
    real(r8),    intent(out) :: d1zwf_out(2, nw), d2zwf_out(nw)
    call aos_to_soa_dx(wsim, nw, na)
    call derwavefx_gpu_run(nw)
    call soa_to_aos_dx(nw, na, d1wf_out, d2wf_out, d1zwf_out, d2zwf_out)
  end subroutine derwavefx_gpu

end module mderwavefx_gpu
