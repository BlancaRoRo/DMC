! mbhutils_gpu.cuf
!
! Kernels CUDA para vec_norm, scalar_product y angle (bh_heh2m.f).
! Son las funciones hoja llamadas por He_dihydrogen dentro de potenbh.
!
! El test las ejercita tal como las usa ENERGY2 de He_dihydrogen:
! calcula norma, producto escalar y angulo entre la posicion de cada
! atomo He4 (relativa a la impureza) y el eje de la molecula H2 (orHH).
! Esto hace que el test sea fisicamente relevante, no solo algebraico.
!
module mbhutils_gpu
  use cudafor
  implicit none

  integer, private, parameter :: r8 = selected_real_kind(15,9)
  integer, private, parameter :: i4 = selected_int_kind(9)

  integer(i4), parameter, public :: NHE4_MAX_BH  = 22
  integer(i4), parameter, public :: NATOM_MAX_BH = 26

  !---------------------------------------------------------------------------
  ! Parametros en device
  ! El eje orHH de la molecula H2 es (0, 0, -2*dhcm) en el sistema de
  ! referencia del CM de la molecula (de potenbh: orHH(3,1)=-2*dhcm).
  ! Se pasa como un vector de 3 componentes.
  !---------------------------------------------------------------------------
  integer(i4), device, public :: d_nhe4_bh, d_natom_bh

  !---------------------------------------------------------------------------
  ! SOA en device
  ! Entrada: posiciones de natom atomos (incluida impureza en natom)
  ! orHH: eje H2, constante para todos los walkers
  ! Salida por He4 y walker: norma, producto escalar, angulo
  !---------------------------------------------------------------------------
  real(r8), device, allocatable, public :: d_atom_soa_bh(:,:,:)  ! (3,natom,nw)
  real(r8), device,              public :: d_orHH_bh(3)          ! vector eje H2 (tamanho fijo)
  real(r8), device, allocatable, public :: d_norm_soa(:,:)        ! (nhe4,nw)
  real(r8), device, allocatable, public :: d_sprod_soa(:,:)       ! (nhe4,nw)
  real(r8), device, allocatable, public :: d_angle_soa(:,:)       ! (nhe4,nw)

contains

  !===========================================================================
  subroutine bhutils_gpu_init(nhe4_h, natom_h, orHH_h)
    integer(i4), intent(in) :: nhe4_h, natom_h
    real(r8),    intent(in) :: orHH_h(3)
    d_nhe4_bh  = nhe4_h
    d_natom_bh = natom_h
    d_orHH_bh  = orHH_h
  end subroutine bhutils_gpu_init

  !===========================================================================
  subroutine bhutils_gpu_alloc(nw, nh4, na)
    integer(i4), intent(in) :: nw, nh4, na
    integer :: istat
    if (allocated(d_atom_soa_bh)) &
      deallocate(d_atom_soa_bh, d_norm_soa, d_sprod_soa, d_angle_soa)
    allocate(d_atom_soa_bh(3, na, nw), stat=istat)
    allocate(d_norm_soa(nh4, nw),      stat=istat)
    allocate(d_sprod_soa(nh4, nw),     stat=istat)
    allocate(d_angle_soa(nh4, nw),     stat=istat)
  end subroutine bhutils_gpu_alloc

  !===========================================================================
  ! AOS -> SOA (H2D)
  !===========================================================================
  subroutine aos_to_soa_bh(wsim, nw, na)
    use mtipos, only: walker
    type(walker), intent(in) :: wsim(nw)
    integer(i4),  intent(in) :: nw, na
    real(r8) :: h_soa(3, na, nw)
    integer(i4) :: iw, ia
    do iw = 1, nw
      do ia = 1, na
        h_soa(1,ia,iw) = wsim(iw)%atom(ia)%comp(1)
        h_soa(2,ia,iw) = wsim(iw)%atom(ia)%comp(2)
        h_soa(3,ia,iw) = wsim(iw)%atom(ia)%comp(3)
      end do
    end do
    d_atom_soa_bh = h_soa
  end subroutine aos_to_soa_bh

  !===========================================================================
  ! Device: vec_norm (replica de bh_heh2m.f)
  ! xnorm = sqrt(vec(1)^2 + vec(2)^2 + vec(3)^2)
  !===========================================================================
  attributes(device) subroutine vec_norm_d(vec, xnorm)
    real(r8), intent(in)  :: vec(3)
    real(r8), intent(out) :: xnorm
    xnorm = sqrt(vec(1)**2 + vec(2)**2 + vec(3)**2)
  end subroutine vec_norm_d

  !===========================================================================
  ! Device: scalar_product (replica de bh_heh2m.f)
  ! sprod = vec1 · vec2
  !===========================================================================
  attributes(device) subroutine scalar_product_d(vec1, vec2, sprod)
    real(r8), intent(in)  :: vec1(3), vec2(3)
    real(r8), intent(out) :: sprod
    sprod = vec1(1)*vec2(1) + vec1(2)*vec2(2) + vec1(3)*vec2(3)
  end subroutine scalar_product_d

  !===========================================================================
  ! Device: angle (replica de bh_heh2m.f)
  ! ang = acos( (vec1·vec2) / (|vec1| * |vec2|) )
  !===========================================================================
  attributes(device) subroutine angle_d(vec1, vec2, ang)
    real(r8), intent(in)  :: vec1(3), vec2(3)
    real(r8), intent(out) :: ang
    real(r8) :: sprod, norm1, norm2
    call scalar_product_d(vec1, vec2, sprod)
    call vec_norm_d(vec1, norm1)
    call vec_norm_d(vec2, norm2)
    ang = acos(sprod / (norm1 * norm2))
  end subroutine angle_d

  !===========================================================================
  ! Kernel: un hilo por walker
  ! Para cada He4, calcula rvec = atom_He4 - atom_impureza, y obtiene
  ! norma(rvec), producto_escalar(rvec, orHH), angulo(rvec, orHH).
  ! Este es exactamente el calculo que hace ENERGY2 de He_dihydrogen.
  !===========================================================================
  attributes(global) subroutine bhutils_kernel(nw)
    integer(i4), value :: nw
    integer(i4) :: iw, ia
    real(r8) :: rvec(3), orHH(3), xnorm, sprod, ang

    iw = (blockIdx%x - 1) * blockDim%x + threadIdx%x
    if (iw > nw) return

    orHH(1) = d_orHH_bh(1)
    orHH(2) = d_orHH_bh(2)
    orHH(3) = d_orHH_bh(3)

    do ia = 1, d_nhe4_bh
      rvec(1) = d_atom_soa_bh(1, ia, iw) - d_atom_soa_bh(1, d_natom_bh, iw)
      rvec(2) = d_atom_soa_bh(2, ia, iw) - d_atom_soa_bh(2, d_natom_bh, iw)
      rvec(3) = d_atom_soa_bh(3, ia, iw) - d_atom_soa_bh(3, d_natom_bh, iw)

      call vec_norm_d(rvec, xnorm)
      call scalar_product_d(rvec, orHH, sprod)
      call angle_d(rvec, orHH, ang)

      d_norm_soa(ia, iw)  = xnorm
      d_sprod_soa(ia, iw) = sprod
      d_angle_soa(ia, iw) = ang
    end do
  end subroutine bhutils_kernel

  !===========================================================================
  subroutine bhutils_gpu_run(nw)
    integer(i4), intent(in) :: nw
    integer(i4), parameter  :: NTHREADS = 256
    integer(i4) :: nblocks; integer :: istat
    nblocks = (nw + NTHREADS - 1) / NTHREADS
    call bhutils_kernel<<<nblocks, NTHREADS>>>(nw)
    istat = cudaDeviceSynchronize()
  end subroutine bhutils_gpu_run

  !===========================================================================
  ! SOA -> AOS (D2H)
  !===========================================================================
  subroutine soa_to_aos_bh(nw, nh4, norm_out, sprod_out, angle_out)
    integer(i4), intent(in)  :: nw, nh4
    real(r8),    intent(out) :: norm_out(nh4, nw), sprod_out(nh4, nw), angle_out(nh4, nw)
    norm_out  = d_norm_soa
    sprod_out = d_sprod_soa
    angle_out = d_angle_soa
  end subroutine soa_to_aos_bh

  !===========================================================================
  ! Wrapper completo
  !===========================================================================
  subroutine bhutils_gpu(wsim, nw, nh4, na, orHH_h, norm_out, sprod_out, angle_out)
    use mtipos, only: walker
    type(walker), intent(in) :: wsim(nw)
    integer(i4),  intent(in) :: nw, nh4, na
    real(r8),     intent(in) :: orHH_h(3)
    real(r8),    intent(out) :: norm_out(nh4, nw), sprod_out(nh4, nw), angle_out(nh4, nw)
    call bhutils_gpu_init(nh4, na, orHH_h)
    call bhutils_gpu_alloc(nw, nh4, na)
    call aos_to_soa_bh(wsim, nw, na)
    call bhutils_gpu_run(nw)
    call soa_to_aos_bh(nw, nh4, norm_out, sprod_out, angle_out)
  end subroutine bhutils_gpu

end module mbhutils_gpu
