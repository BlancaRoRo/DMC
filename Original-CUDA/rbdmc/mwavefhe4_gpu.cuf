! mwavefhe4_gpu.cuf
!
! Kernels CUDA para wavefhe4 y derwavefhe4 (mwavef.f90).
! Ambos operan sobre pares He4-He4 (triangulo superior i<j).
!
! wavefhe4:
!   ujas = sum_{i<j, He4} [ -phe4(1)/rij^phe4(2) - phe4(3)*rij ]
!   wfhe4 = exp(clamp(ujas, -200, 200))
!   Salida: escalar por walker.
!
! derwavefhe4:
!   Gradiente y laplaciano de ln(psi_T) por la parte He4-He4.
!   Salida: d1wf(3, nhe4) y d2wf(nhe4) por walker.
!
module mwavefhe4_gpu
  use cudafor
  implicit none

  integer, private, parameter :: r8 = selected_real_kind(15,9)
  integer, private, parameter :: i4 = selected_int_kind(9)

  real(r8), private, parameter :: UMAX_HE4 =  200.0_r8
  real(r8), private, parameter :: UMIN_HE4 = -200.0_r8

  ! Tamanho maximo de nhe4 en compilacion
  integer(i4), parameter, public :: NHE4_MAX_GPU = 22

  !---------------------------------------------------------------------------
  ! Parametros en device
  !---------------------------------------------------------------------------
  integer(i4), device, public :: d_nhe4_he4
  real(r8),    device, public :: d_phe4_he4(3)

  !---------------------------------------------------------------------------
  ! Arrays SOA en device
  ! Solo se necesitan posiciones de atomos He4 (indices 1..nhe4).
  ! d_atom_soa_he4(ic, i, iw) : componente ic del atomo He4 i, walker iw
  ! d_wfhe4_soa(iw)           : resultado wavefhe4
  ! d_d1wfhe4_soa(ic, i, iw)  : gradiente derwavefhe4
  ! d_d2wfhe4_soa(i, iw)      : laplaciano derwavefhe4
  !---------------------------------------------------------------------------
  real(r8), device, allocatable, public :: d_atom_soa_he4(:,:,:)
  real(r8), device, allocatable, public :: d_wfhe4_soa(:)
  real(r8), device, allocatable, public :: d_d1wfhe4_soa(:,:,:)
  real(r8), device, allocatable, public :: d_d2wfhe4_soa(:,:)

contains

  !===========================================================================
  subroutine wavefhe4_gpu_init(nhe4_h, phe4_h)
    integer(i4), intent(in) :: nhe4_h
    real(r8),    intent(in) :: phe4_h(3)
    d_nhe4_he4 = nhe4_h
    d_phe4_he4 = phe4_h
  end subroutine wavefhe4_gpu_init

  !===========================================================================
  subroutine wavefhe4_gpu_alloc(nw, nh4)
    integer(i4), intent(in) :: nw, nh4
    integer :: istat
    if (allocated(d_atom_soa_he4)) then
      deallocate(d_atom_soa_he4, d_wfhe4_soa, d_d1wfhe4_soa, d_d2wfhe4_soa)
    end if
    allocate(d_atom_soa_he4(3, nh4, nw),  stat=istat)
    allocate(d_wfhe4_soa(nw),             stat=istat)
    allocate(d_d1wfhe4_soa(3, nh4, nw),  stat=istat)
    allocate(d_d2wfhe4_soa(nh4, nw),     stat=istat)
  end subroutine wavefhe4_gpu_alloc

  !===========================================================================
  ! AOS -> SOA (H2D): solo se transfieren los nhe4 primeros atomos
  !===========================================================================
  subroutine aos_to_soa_he4(wsim, nw, nh4)
    use mtipos, only: walker
    type(walker), intent(in) :: wsim(nw)
    integer(i4),  intent(in) :: nw, nh4
    real(r8) :: h_soa(3, nh4, nw)
    integer(i4) :: iw, ia
    do iw = 1, nw
      do ia = 1, nh4
        h_soa(1, ia, iw) = wsim(iw)%atom(ia)%comp(1)
        h_soa(2, ia, iw) = wsim(iw)%atom(ia)%comp(2)
        h_soa(3, ia, iw) = wsim(iw)%atom(ia)%comp(3)
      end do
    end do
    d_atom_soa_he4 = h_soa
  end subroutine aos_to_soa_he4

  !===========================================================================
  ! Kernel wavefhe4: un hilo por walker
  !===========================================================================
  attributes(global) subroutine wavefhe4_kernel(nw)
    integer(i4), value :: nw
    integer(i4) :: iw, i, j
    real(r8) :: atom(3, NHE4_MAX_GPU)
    real(r8) :: ujas, rij, rt(3)

    iw = (blockIdx%x - 1) * blockDim%x + threadIdx%x
    if (iw > nw) return

    do i = 1, d_nhe4_he4
      atom(1, i) = d_atom_soa_he4(1, i, iw)
      atom(2, i) = d_atom_soa_he4(2, i, iw)
      atom(3, i) = d_atom_soa_he4(3, i, iw)
    end do

    ujas = 0.0_r8
    do i = 1, d_nhe4_he4 - 1
      do j = i + 1, d_nhe4_he4
        rt(1) = atom(1,i) - atom(1,j)
        rt(2) = atom(2,i) - atom(2,j)
        rt(3) = atom(3,i) - atom(3,j)
        rij   = sqrt(rt(1)**2 + rt(2)**2 + rt(3)**2)
        ujas  = ujas - d_phe4_he4(1)/rij**d_phe4_he4(2) - d_phe4_he4(3)*rij
      end do
    end do

    ujas = min(ujas, UMAX_HE4)
    ujas = max(ujas, UMIN_HE4)
    d_wfhe4_soa(iw) = exp(ujas)
  end subroutine wavefhe4_kernel

  !===========================================================================
  ! Kernel derwavefhe4: un hilo por walker
  !===========================================================================
  attributes(global) subroutine derwavefhe4_kernel(nw)
    integer(i4), value :: nw
    integer(i4) :: iw, i, j, ic
    real(r8) :: atom(3, NHE4_MAX_GPU)
    real(r8) :: d1wf(3, NHE4_MAX_GPU), d2wf(NHE4_MAX_GPU)
    real(r8) :: rt(3), ujasp, ujass, rij

    iw = (blockIdx%x - 1) * blockDim%x + threadIdx%x
    if (iw > nw) return

    do i = 1, d_nhe4_he4
      atom(1, i) = d_atom_soa_he4(1, i, iw)
      atom(2, i) = d_atom_soa_he4(2, i, iw)
      atom(3, i) = d_atom_soa_he4(3, i, iw)
      d1wf(1, i) = 0.0_r8
      d1wf(2, i) = 0.0_r8
      d1wf(3, i) = 0.0_r8
      d2wf(i)    = 0.0_r8
    end do

    do i = 1, d_nhe4_he4 - 1
      do j = i + 1, d_nhe4_he4
        rt(1) = atom(1,i) - atom(1,j)
        rt(2) = atom(2,i) - atom(2,j)
        rt(3) = atom(3,i) - atom(3,j)
        rij   = sqrt(rt(1)**2 + rt(2)**2 + rt(3)**2)
        ujasp = d_phe4_he4(1)*d_phe4_he4(2) / rij**(d_phe4_he4(2)+1.0_r8)
        ujass = -(d_phe4_he4(2)+1.0_r8) * ujasp / rij
        ujasp = (ujasp - d_phe4_he4(3)) / rij
        d1wf(1, i) = d1wf(1, i) + ujasp*rt(1)
        d1wf(2, i) = d1wf(2, i) + ujasp*rt(2)
        d1wf(3, i) = d1wf(3, i) + ujasp*rt(3)
        d1wf(1, j) = d1wf(1, j) - ujasp*rt(1)
        d1wf(2, j) = d1wf(2, j) - ujasp*rt(2)
        d1wf(3, j) = d1wf(3, j) - ujasp*rt(3)
        d2wf(i) = d2wf(i) + ujass + 2.0_r8*ujasp
        d2wf(j) = d2wf(j) + ujass + 2.0_r8*ujasp
      end do
    end do

    do i = 1, d_nhe4_he4
      d2wf(i) = d2wf(i) + d1wf(1,i)**2 + d1wf(2,i)**2 + d1wf(3,i)**2
    end do

    do i = 1, d_nhe4_he4
      do ic = 1, 3
        d_d1wfhe4_soa(ic, i, iw) = d1wf(ic, i)
      end do
      d_d2wfhe4_soa(i, iw) = d2wf(i)
    end do
  end subroutine derwavefhe4_kernel

  !===========================================================================
  subroutine wavefhe4_gpu_run(nw)
    integer(i4), intent(in) :: nw
    integer(i4), parameter  :: NTHREADS = 256
    integer(i4) :: nblocks
    integer      :: istat
    nblocks = (nw + NTHREADS - 1) / NTHREADS
    call wavefhe4_kernel<<<nblocks, NTHREADS>>>(nw)
    istat = cudaDeviceSynchronize()
  end subroutine wavefhe4_gpu_run

  subroutine derwavefhe4_gpu_run(nw)
    integer(i4), intent(in) :: nw
    integer(i4), parameter  :: NTHREADS = 256
    integer(i4) :: nblocks
    integer      :: istat
    nblocks = (nw + NTHREADS - 1) / NTHREADS
    call derwavefhe4_kernel<<<nblocks, NTHREADS>>>(nw)
    istat = cudaDeviceSynchronize()
  end subroutine derwavefhe4_gpu_run

  !===========================================================================
  ! SOA -> AOS (D2H)
  !===========================================================================
  subroutine soa_to_aos_wfhe4(nw, wfhe4_out)
    integer(i4), intent(in)  :: nw
    real(r8),    intent(out) :: wfhe4_out(nw)
    wfhe4_out = d_wfhe4_soa
  end subroutine soa_to_aos_wfhe4

  subroutine soa_to_aos_derwavefhe4(nw, nh4, d1wf_out, d2wf_out)
    integer(i4), intent(in)  :: nw, nh4
    real(r8),    intent(out) :: d1wf_out(3, nh4, nw)
    real(r8),    intent(out) :: d2wf_out(nh4, nw)
    d1wf_out = d_d1wfhe4_soa
    d2wf_out = d_d2wfhe4_soa
  end subroutine soa_to_aos_derwavefhe4

  !===========================================================================
  ! Wrappers completos
  !===========================================================================
  subroutine wavefhe4_gpu(wsim, nw, nh4, wfhe4_out)
    use mtipos, only: walker
    type(walker), intent(in) :: wsim(nw)
    integer(i4),  intent(in) :: nw, nh4
    real(r8),    intent(out) :: wfhe4_out(nw)
    call aos_to_soa_he4(wsim, nw, nh4)
    call wavefhe4_gpu_run(nw)
    call soa_to_aos_wfhe4(nw, wfhe4_out)
  end subroutine wavefhe4_gpu

  subroutine derwavefhe4_gpu(wsim, nw, nh4, d1wf_out, d2wf_out)
    use mtipos, only: walker
    type(walker), intent(in) :: wsim(nw)
    integer(i4),  intent(in) :: nw, nh4
    real(r8),    intent(out) :: d1wf_out(3, nh4, nw)
    real(r8),    intent(out) :: d2wf_out(nh4, nw)
    call aos_to_soa_he4(wsim, nw, nh4)
    call derwavefhe4_gpu_run(nw)
    call soa_to_aos_derwavefhe4(nw, nh4, d1wf_out, d2wf_out)
  end subroutine derwavefhe4_gpu

end module mwavefhe4_gpu
