! mvpot_gpu.cuf
!
! Kernel CUDA para vpot (mwavef.f90).
! Calcula el potencial total para todos los walkers segun opot:
!
!   opot=4  -> ccuerpo + He_dihydrogen (He-H2+ de Breton et al.)
!              Inlinea la misma logica que mhedihydrogen_gpu.cuf.
!
!   opot!=4 -> aziz_nuevo He-He (hardcoded) + impureza:
!              - impurmol=.T., opot=1,2,3: STUB (pot_imp=0), igual que SIMT.
!              - impurmol=.F.: azizgen (parametros leidos de fichero via sacaaziz).
!              - sin impureza: solo aziz_nuevo.
!
! SOA entrada: atom(natom,nw), sprop(3,3,nw)
! SOA salida:  pot(nw)
!
module mvpot_gpu
  use cudafor
  implicit none

  integer, private, parameter :: r8 = selected_real_kind(15,9)
  integer, private, parameter :: i4 = selected_int_kind(9)

  integer(i4), parameter, public :: NATOM_MAX_VP  = 26
  integer(i4), parameter, public :: NGATOM_MAX_VP = 25

  !---------------------------------------------------------------------------
  ! Constantes de aziz_nuevo (hardcoded, iguales que en mvaziz.f90)
  !---------------------------------------------------------------------------
  real(r8), private, parameter :: &
    AZ_a=1.84431010d5, AZ_alpha=10.433295370_r8, AZ_c6=1.367452140_r8, &
    AZ_c8=0.421238070_r8, AZ_c10=0.174733180_r8, AZ_beta=-2.279651050_r8, &
    AZ_D=1.48260_r8, AZ_eps=10.9480_r8, AZ_rm=2.9630_r8

  !---------------------------------------------------------------------------
  ! Constantes de He_dihydrogen (para opot=4, de param_atoms_bh.h)
  !---------------------------------------------------------------------------
  real(r8), private, parameter :: &
    a0_vp=65344.8145d0,  a1_vp=-0.42497d0, a2_vp=3.95634d0, a3_vp=0.07852d0,   &
    b0_vp=3.49361d0,     b1_vp=0.13908d0,  b2_vp=1.89258d0, b3_vp=-0.01065d0,  &
    c60_vp=4091.45747d0, c61_vp=106.89633d0, c62_vp=226.68798d0, c63_vp=-117.37656d0, &
    conve3_vp=27.2d3, pi_vp=3.141592d0, pi12_vp=3.141592d0/2.0d0,               &
    A_He_vp=1.89635353d5,   c6_He_vp=1.34687065d0, c8_He_vp=0.41308398d0,       &
    c10_He_vp=0.17060159d0, alpha_He_vp=10.70203539d0, beta_He_vp=-1.90740649d0, &
    D_He_vp=1.4088d0,  req_He_vp=2.9695d0,                                       &
    eps_He_vp=10.97d0*0.695d0*4.55633538d-6,                                      &
    Aa_He_vp=0.0026d0, xx1_He_vp=1.003535949d0, xx2_He_vp=1.454790369d0,         &
    Ba_He_vp=2.0d0*3.141592d0/(1.454790369d0-1.003535949d0),                      &
    cte_vp=14393.894d0, alpha_ind_vp=1.38d0*(0.5291772d0)**3, q_vp=0.7435d0

  !---------------------------------------------------------------------------
  ! Parametros en device
  !---------------------------------------------------------------------------
  integer(i4), device, public :: d_opot_vp, d_ngatom_vp, d_natom_vp
  logical,     device, public :: d_impureza_vp, d_impurmol_vp
  real(r8),    device, public :: d_dhcm_vp
  ! azizgen (opot!=4, impureza atomica)
  real(r8),    device, public :: d_a_aziz_vp, d_alpha_aziz_vp
  real(r8),    device, public :: d_c6_aziz_vp, d_c7_aziz_vp, d_c8_aziz_vp
  real(r8),    device, public :: d_d_aziz_vp,  d_eps_aziz_vp, d_rm_aziz_vp

  !---------------------------------------------------------------------------
  ! SOA en device
  !---------------------------------------------------------------------------
  real(r8), device, allocatable, public :: d_atom_soa_vp(:,:,:)
  real(r8), device, allocatable, public :: d_sprop_soa_vp(:,:,:)
  real(r8), device, allocatable, public :: d_pot_vp(:)

contains

  !===========================================================================
  subroutine vpot_gpu_init(opot_h, ngatom_h, natom_h,         &
                             impureza_h, impurmol_h, dhcm_h,   &
                             aziz_h)
    integer(i4), intent(in) :: opot_h, ngatom_h, natom_h
    logical,     intent(in) :: impureza_h, impurmol_h
    real(r8),    intent(in) :: dhcm_h, aziz_h(8)
    d_opot_vp     = opot_h
    d_ngatom_vp   = ngatom_h
    d_natom_vp    = natom_h
    d_impureza_vp = impureza_h
    d_impurmol_vp = impurmol_h
    d_dhcm_vp     = dhcm_h
    d_a_aziz_vp   = aziz_h(1);  d_alpha_aziz_vp = aziz_h(2)
    d_c6_aziz_vp  = aziz_h(3);  d_c7_aziz_vp    = aziz_h(4)
    d_c8_aziz_vp  = aziz_h(5);  d_d_aziz_vp     = aziz_h(6)
    d_eps_aziz_vp = aziz_h(7);  d_rm_aziz_vp    = aziz_h(8)
  end subroutine vpot_gpu_init

  !===========================================================================
  subroutine vpot_gpu_alloc(nw, na)
    integer(i4), intent(in) :: nw, na
    integer :: istat
    if (allocated(d_atom_soa_vp)) deallocate(d_atom_soa_vp, d_sprop_soa_vp, d_pot_vp)
    allocate(d_atom_soa_vp(3, na, nw),  stat=istat)
    allocate(d_sprop_soa_vp(3, 3, nw), stat=istat)
    allocate(d_pot_vp(nw),              stat=istat)
  end subroutine vpot_gpu_alloc

  !===========================================================================
  subroutine aos_to_soa_vp(wsim, nw, na)
    use mtipos, only: walker
    type(walker), intent(in) :: wsim(nw)
    integer(i4),  intent(in) :: nw, na
    real(r8), allocatable :: h_atom(:,:,:), h_sprop(:,:,:)
    integer(i4) :: iw, ia, iv
    allocate(h_atom(3,na,nw), h_sprop(3,3,nw))
    do iw = 1, nw
      do ia = 1, na
        h_atom(1,ia,iw)=wsim(iw)%atom(ia)%comp(1)
        h_atom(2,ia,iw)=wsim(iw)%atom(ia)%comp(2)
        h_atom(3,ia,iw)=wsim(iw)%atom(ia)%comp(3)
      end do
      do iv = 1, 3
        h_sprop(1,iv,iw)=wsim(iw)%sprop(iv)%comp(1)
        h_sprop(2,iv,iw)=wsim(iw)%sprop(iv)%comp(2)
        h_sprop(3,iv,iw)=wsim(iw)%sprop(iv)%comp(3)
      end do
    end do
    d_atom_soa_vp=h_atom; d_sprop_soa_vp=h_sprop
    deallocate(h_atom, h_sprop)
  end subroutine aos_to_soa_vp

  !===========================================================================
  ! Device: aziz_nuevo (parametros hardcoded, identico a mvaziz.f90)
  !===========================================================================
  attributes(device) function aziz_nuevo_d_vp(r) result(v)
    real(r8), value :: r; real(r8) :: v, x, f
    x = r / AZ_rm; f = 1.0_r8
    if (x < AZ_D) f = exp(-(AZ_D/x - 1.0_r8)**2)
    v = (AZ_a*exp(-AZ_alpha*x + AZ_beta*x**2) - f*(AZ_c6/x**6 + AZ_c8/x**8 + AZ_c10/x**10)) * AZ_eps
  end function aziz_nuevo_d_vp

  !===========================================================================
  ! Device: azizgen (parametros leidos de fichero, en device variables)
  !===========================================================================
  attributes(device) function azizgen_d_vp(r) result(v)
    real(r8), value :: r; real(r8) :: v, x, f
    x = r / d_rm_aziz_vp; f = 1.0_r8
    if (x < d_d_aziz_vp) f = exp(-(d_d_aziz_vp/x - 1.0_r8)**2)
    v = (d_a_aziz_vp*exp(-d_alpha_aziz_vp*x) - &
         f*(d_c6_aziz_vp/x**6 + d_c7_aziz_vp/x**7 + d_c8_aziz_vp/x**8)) * d_eps_aziz_vp
  end function azizgen_d_vp

  !===========================================================================
  ! Device: funciones de amortiguamiento para He_dihydrogen (opot=4)
  !===========================================================================
  attributes(device) function FN1_vp(x) result(f)
    real(r8), value :: x; real(r8) :: ex, f
    ex=exp(-x); f=1.0d0-ex*(1.0d0+x+x**2/2.0d0+x**3/6.0d0+x**4/24.0d0+x**5/120.0d0+x**6/720.0d0)
  end function FN1_vp

  attributes(device) function FN2_vp(x) result(f)
    real(r8), value :: x; real(r8) :: ex, f
    ex=exp(-x); f=1.0d0-ex*(1.0d0+x+x**2/2.0d0)
  end function FN2_vp

  attributes(device) function V_hehe_vp(r) result(v)
    real(r8), value :: r; real(r8) :: v, x, x2, x6, x8, x10, F, vsum, addin
    x=r/req_He_vp; x2=x*x; x6=x2*x2*x2; x8=x6*x2; x10=x8*x2; F=1.0d0
    if(x<D_He_vp) F=exp(-(D_He_vp/x-1.0d0)**2)
    vsum=A_He_vp*exp(-alpha_He_vp*x+beta_He_vp*x2)-F*(c6_He_vp/x6+c8_He_vp/x8+c10_He_vp/x10)
    addin=0.0d0
    if(x>=xx1_He_vp.and.x<=xx2_He_vp) addin=Aa_He_vp*(sin(Ba_He_vp*(x-xx1_He_vp)-pi12_vp)+1.0d0)
    v=eps_He_vp*(vsum+addin)
  end function V_hehe_vp

  !===========================================================================
  ! Kernel vpot: un hilo por walker
  !===========================================================================
  attributes(global) subroutine vpot_kernel(nw)
    integer(i4), value :: nw
    integer(i4) :: iw, iatom, jatom, j, j1, j2, ic, jc
    real(r8) :: atom(3, NATOM_MAX_VP), sprop(3,3)
    real(r8) :: rtemp(3), rij, pot, cth, dnor, sprop3(3)
    ! Para opot=4
    real(r8) :: x_mol(3*NGATOM_MAX_VP), rtemp2(3)
    real(r8) :: dhcm, rdih1(3), rdih2(3), orHH(3)
    real(r8) :: e1, e2, e3, R, rvec(3), rnorm, onorm, theta, ror, fi
    real(r8) :: atheta, btheta, c6theta, rh1, rh2, r0, Ex0, Ey0, Ez0, q0_loc
    integer(i4) :: N

    iw = (blockIdx%x-1)*blockDim%x + threadIdx%x
    if (iw > nw) return

    do iatom = 1, d_natom_vp
      atom(1,iatom)=d_atom_soa_vp(1,iatom,iw)
      atom(2,iatom)=d_atom_soa_vp(2,iatom,iw)
      atom(3,iatom)=d_atom_soa_vp(3,iatom,iw)
    end do

    if (d_opot_vp == 4) then
      !--- opot=4: ccuerpo inline + He_dihydrogen ---
      N = d_ngatom_vp; dhcm = d_dhcm_vp
      do ic=1,3; do jc=1,3; sprop(jc,ic)=d_sprop_soa_vp(jc,ic,iw); end do; end do
      do jatom=1,N
        rtemp(1)=atom(1,jatom)-atom(1,d_natom_vp)
        rtemp(2)=atom(2,jatom)-atom(2,d_natom_vp)
        rtemp(3)=atom(3,jatom)-atom(3,d_natom_vp)
        do ic=1,3
          x_mol(3*(jatom-1)+ic)=sprop(1,ic)*rtemp(1)+sprop(2,ic)*rtemp(2)+sprop(3,ic)*rtemp(3)
        end do
      end do
      rdih1=(/ 0.0d0, 0.0d0,  dhcm /); rdih2=(/ 0.0d0, 0.0d0, -dhcm /)
      orHH =(/ 0.0d0, 0.0d0, -2.0d0*dhcm /)
      e1=0.0d0
      do j1=1,N-1; do j2=j1+1,N
        R=sqrt((x_mol(3*(j1-1)+1)-x_mol(3*(j2-1)+1))**2 &
              +(x_mol(3*(j1-1)+2)-x_mol(3*(j2-1)+2))**2 &
              +(x_mol(3*(j1-1)+3)-x_mol(3*(j2-1)+3))**2)
        e1=e1+V_hehe_vp(R)
      end do; end do
      e1=e1*conve3_vp
      onorm=sqrt(orHH(1)**2+orHH(2)**2+orHH(3)**2); e2=0.0d0
      do j=1,N
        rvec(1)=x_mol(3*(j-1)+1); rvec(2)=x_mol(3*(j-1)+2); rvec(3)=x_mol(3*(j-1)+3)
        rnorm=sqrt(rvec(1)**2+rvec(2)**2+rvec(3)**2)
        fi=min(1.0d0,max(-1.0d0,(rvec(1)*orHH(1)+rvec(2)*orHH(2)+rvec(3)*orHH(3))/(rnorm*onorm)))
        theta=acos(fi)
        atheta=a1_vp*cos(theta)**2+a2_vp*cos(theta)**4+a3_vp*cos(theta)**6
        btheta=b0_vp+b1_vp*cos(theta)**2+b2_vp*cos(theta)**4+b3_vp*cos(theta)**6
        c6theta=c60_vp+c61_vp*sin(theta)**2+c62_vp*sin(theta)**4+c63_vp*sin(theta)**6
        e2=e2+a0_vp*exp(atheta-rnorm*btheta)-FN1_vp(rnorm*btheta)*c6theta/rnorm**6
      end do
      e3=0.0d0; q0_loc=2.0d0*q_vp-1.0d0
      do j=1,N
        rh1=sqrt((x_mol(3*(j-1)+1)-rdih1(1))**2+(x_mol(3*(j-1)+2)-rdih1(2))**2+(x_mol(3*(j-1)+3)-rdih1(3))**2)
        rh2=sqrt((x_mol(3*(j-1)+1)-rdih2(1))**2+(x_mol(3*(j-1)+2)-rdih2(2))**2+(x_mol(3*(j-1)+3)-rdih2(3))**2)
        r0 =sqrt(x_mol(3*(j-1)+1)**2+x_mol(3*(j-1)+2)**2+x_mol(3*(j-1)+3)**2)
        rvec(1)=x_mol(3*(j-1)+1); rvec(2)=x_mol(3*(j-1)+2); rvec(3)=x_mol(3*(j-1)+3)
        rnorm=sqrt(rvec(1)**2+rvec(2)**2+rvec(3)**2)
        fi=min(1.0d0,max(-1.0d0,(rvec(1)*orHH(1)+rvec(2)*orHH(2)+rvec(3)*orHH(3))/(rnorm*onorm)))
        theta=acos(fi); btheta=b0_vp+b1_vp*cos(theta)**2+b2_vp*cos(theta)**4+b3_vp*cos(theta)**6
        Ex0=q_vp*FN2_vp(btheta*rh1)*(x_mol(3*(j-1)+1)-rdih1(1))/rh1**3 &
           +q_vp*FN2_vp(btheta*rh2)*(x_mol(3*(j-1)+1)-rdih2(1))/rh2**3 &
           -q0_loc*FN2_vp(btheta*r0)*x_mol(3*(j-1)+1)/r0**3
        Ey0=q_vp*FN2_vp(btheta*rh1)*(x_mol(3*(j-1)+2)-rdih1(2))/rh1**3 &
           +q_vp*FN2_vp(btheta*rh2)*(x_mol(3*(j-1)+2)-rdih2(2))/rh2**3 &
           -q0_loc*FN2_vp(btheta*r0)*x_mol(3*(j-1)+2)/r0**3
        Ez0=q_vp*FN2_vp(btheta*rh1)*(x_mol(3*(j-1)+3)-rdih1(3))/rh1**3 &
           +q_vp*FN2_vp(btheta*rh2)*(x_mol(3*(j-1)+3)-rdih2(3))/rh2**3 &
           -q0_loc*FN2_vp(btheta*r0)*x_mol(3*(j-1)+3)/r0**3
        e3=e3+Ex0*Ex0+Ey0*Ey0+Ez0*Ez0
      end do
      d_pot_vp(iw) = e1 + e2 + (-0.5d0*alpha_ind_vp*cte_vp*e3)

    else
      !--- opot != 4: aziz_nuevo He-He ---
      pot = 0.0_r8
      do iatom=1,d_ngatom_vp-1
        do jatom=iatom+1,d_ngatom_vp
          rtemp(1)=atom(1,iatom)-atom(1,jatom)
          rtemp(2)=atom(2,iatom)-atom(2,jatom)
          rtemp(3)=atom(3,iatom)-atom(3,jatom)
          rij=sqrt(rtemp(1)**2+rtemp(2)**2+rtemp(3)**2)
          pot=pot+aziz_nuevo_d_vp(rij)
        end do
      end do
      if (d_impureza_vp) then
        if (d_impurmol_vp) then
          ! STUB: vatomol opot=1,2,3 no implementado (igual que SIMT)
          ! pot_impureza = 0
        else
          ! Impureza atomica: azizgen
          do jatom=1,d_ngatom_vp
            rtemp(1)=atom(1,jatom)-atom(1,d_natom_vp)
            rtemp(2)=atom(2,jatom)-atom(2,d_natom_vp)
            rtemp(3)=atom(3,jatom)-atom(3,d_natom_vp)
            rij=sqrt(rtemp(1)**2+rtemp(2)**2+rtemp(3)**2)
            pot=pot+azizgen_d_vp(rij)
          end do
        end if
      end if
      d_pot_vp(iw) = pot
    end if
  end subroutine vpot_kernel

  !===========================================================================
  subroutine vpot_gpu_run(nw)
    integer(i4), intent(in) :: nw
    integer(i4), parameter  :: NTHREADS = 32
    integer(i4) :: nblocks; integer :: istat
    nblocks=(nw+NTHREADS-1)/NTHREADS
    call vpot_kernel<<<nblocks,NTHREADS>>>(nw)
    istat=cudaDeviceSynchronize()
  end subroutine vpot_gpu_run

  !===========================================================================
  subroutine soa_to_aos_vp(nw, pot_out)
    integer(i4), intent(in)  :: nw
    real(r8),    intent(out) :: pot_out(nw)
    pot_out = d_pot_vp
  end subroutine soa_to_aos_vp

  !===========================================================================
  subroutine vpot_gpu(wsim, nw, na, opot_h, impureza_h, impurmol_h, &
                       dhcm_h, aziz_h, pot_out)
    use mtipos, only: walker
    type(walker), intent(in) :: wsim(nw)
    integer(i4),  intent(in) :: nw, na, opot_h
    logical,      intent(in) :: impureza_h, impurmol_h
    real(r8),     intent(in) :: dhcm_h, aziz_h(8)
    real(r8),    intent(out) :: pot_out(nw)
    call vpot_gpu_init(opot_h, na-1, na, impureza_h, impurmol_h, dhcm_h, aziz_h)
    call vpot_gpu_alloc(nw, na)
    call aos_to_soa_vp(wsim, nw, na)
    call vpot_gpu_run(nw)
    call soa_to_aos_vp(nw, pot_out)
  end subroutine vpot_gpu

end module mvpot_gpu
