! test_equivalence_exp.cuf
!
! Prueba aislada: compara la version ACTUAL de bits_of/real_of/myexp
! (TRANSFER envuelto en array de tamano 1, ver glibc_exp_mod.cuf real
! en v1-cuda-desarrollo/glibc_math/ e hibrido_instrumentado/) contra
! una version alternativa con EQUIVALENCE, para ver si (a) compila y
! enlaza en device sin el problema de simbolo de runtime que forzo el
! workaround del array, y (b) da EXACTAMENTE los mismos bits que la
! version actual, en host y en device -- antes de siquiera plantearse
! si arregla el hallazgo de accesos no coalescidos de tiempo-ncu.md.
!
! No se toca ningun fichero real del proyecto -- ambas versiones viven
! aqui, con nombres de funcion distintos (_orig / _eq), y se comparan
! en el mismo programa.

module mtest_equiv
 implicit none
 integer, private, parameter :: i4 = selected_int_kind(9)
 integer, private, parameter :: i8 = selected_int_kind(18)
 integer, private, parameter :: r8 = selected_real_kind(15,9)

 real(kind=r8), parameter :: exp_invln2N  = transfer(int(z'40671547652b82fe',8), 1.0_r8)
 real(kind=r8), parameter :: exp_negln2hiN = transfer(int(z'bf762e42fefa0000',8), 1.0_r8)
 real(kind=r8), parameter :: exp_negln2loN = transfer(int(z'bd0cf79abc9e3b3a',8), 1.0_r8)
 real(kind=r8), parameter :: exp_shift = transfer(int(z'4338000000000000',8), 1.0_r8)
 real(kind=r8), parameter :: exp_c2 = transfer(int(z'3fdffffffffffdbd',8), 1.0_r8)
 real(kind=r8), parameter :: exp_c3 = transfer(int(z'3fc555555555543c',8), 1.0_r8)
 real(kind=r8), parameter :: exp_c4 = transfer(int(z'3fa55555cf172b91',8), 1.0_r8)
 real(kind=r8), parameter :: exp_c5 = transfer(int(z'3f81111167a4d017',8), 1.0_r8)

 integer(kind=i4), parameter :: exp_top12_tiny  = 969
 integer(kind=i4), parameter :: exp_top12_512   = 1032
 integer(kind=i4), parameter :: exp_top12_1024  = 1033
 integer(kind=i4), parameter :: exp_top12_inf   = 2047
 integer(kind=i8), parameter :: exp_bits_neginf = int(z'fff0000000000000',8)
 integer(kind=i8), parameter :: exp_bits_posinf = int(z'7ff0000000000000',8)

 include 'exp_tab_fortran.txt'

contains

! =====================================================================
! ---- VERSION ACTUAL (_orig): TRANSFER envuelto en array de tamano 1,
! copiada tal cual de glibc_exp_mod.cuf real ----
! =====================================================================
attributes(host, device) function bits_of_orig(x) result(ii)
  real(kind=r8), intent (in) :: x
  integer(kind=i8) :: ii
  integer(kind=i8) :: tmp(1)
    tmp = transfer( (/x/), tmp)
    ii = tmp(1)
end function bits_of_orig

attributes(host, device) function real_of_orig(ii) result(x)
  integer(kind=i8), intent (in) :: ii
  real(kind=r8) :: x
  real(kind=r8) :: tmp(1)
    tmp = transfer( (/ii/), tmp)
    x = tmp(1)
end function real_of_orig

attributes(host, device) function top12_of_orig(x) result(t)
  real(kind=r8), intent (in) :: x
  integer(kind=i4) :: t
    t = int(ishft(bits_of_orig(x), -52), i4)
    t = iand(t, int(z'7ff',i4))
end function top12_of_orig

attributes(host, device) function exp_specialcase_orig(tmp, sbits_in, ki) result(y)
  real(kind=r8), intent (in) :: tmp
  integer(kind=i8), intent (in) :: sbits_in, ki
  real(kind=r8) :: y
  integer(kind=i8) :: sbits
  real(kind=r8) :: scale, hi, lo
    sbits = sbits_in
    if (iand(ki, int(z'80000000',i8)) == 0_i8) then
      sbits = sbits - ishft(1009_i8, 52)
      scale = real_of_orig(sbits)
      y = (2.0_r8**1009) * (scale + scale*tmp)
      return
    endif
    sbits = sbits + ishft(1022_i8, 52)
    scale = real_of_orig(sbits)
    y = scale + scale*tmp
    if (y < 1.0_r8) then
      lo = scale - y + scale*tmp
      hi = 1.0_r8 + y
      lo = 1.0_r8 - hi + y + lo
      y = (hi + lo) - 1.0_r8
      if (y == 0.0_r8) y = 0.0_r8
    endif
    y = (2.0_r8**(-1022)) * y
end function exp_specialcase_orig

attributes(host, device) function myexp_orig(x) result(y)
  real(kind=r8), intent (in) :: x
  real(kind=r8) :: y
  integer(kind=i4) :: abstop
  integer(kind=i8) :: ki, idx, topbits, sbits, xbits
  real(kind=r8) :: kd, z, r, r2, scale, tail, tmp

    abstop = top12_of_orig(x)
    if (abstop < exp_top12_tiny .or. abstop >= exp_top12_512) then
      if (abstop < exp_top12_tiny) then
        y = 1.0_r8 + x
        return
      endif
      if (abstop >= exp_top12_1024) then
        xbits = bits_of_orig(x)
        if (xbits == exp_bits_neginf) then
          y = 0.0_r8
          return
        endif
        if (abstop >= exp_top12_inf) then
          y = 1.0_r8 + x
          return
        endif
        if (xbits < 0_i8) then
          y = 0.0_r8
        else
          y = real_of_orig(exp_bits_posinf)
        endif
        return
      endif
      abstop = 0
    endif

    z = exp_invln2N * x
    kd = z + exp_shift
    ki = bits_of_orig(kd)
    kd = kd - exp_shift
    r = x + kd*exp_negln2hiN + kd*exp_negln2loN

    idx = 2_i8 * iand(ki, 127_i8)
    topbits = ishft(ki, 52 - 7)
    tail = real_of_orig(exp_tab(idx))
    sbits = exp_tab(idx+1) + topbits

    r2 = r*r
    tmp = tail + r + r2*(exp_c2 + r*exp_c3) + r2*r2*(exp_c4 + r*exp_c5)

    if (abstop == 0) then
      y = exp_specialcase_orig(tmp, sbits, ki)
      return
    endif

    scale = real_of_orig(sbits)
    y = scale + scale*tmp
end function myexp_orig

! =====================================================================
! ---- VERSION NUEVA (_eq): EQUIVALENCE en vez de TRANSFER ----
! =====================================================================
attributes(host, device) function bits_of_eq(x) result(ii)
  real(kind=r8), intent (in) :: x
  integer(kind=i8) :: ii
  real(kind=r8) :: xx
  integer(kind=i8) :: iii
  equivalence (xx, iii)
    xx = x
    ii = iii
end function bits_of_eq

attributes(host, device) function real_of_eq(ii) result(x)
  integer(kind=i8), intent (in) :: ii
  real(kind=r8) :: x
  real(kind=r8) :: xx
  integer(kind=i8) :: iii
  equivalence (xx, iii)
    iii = ii
    x = xx
end function real_of_eq

attributes(host, device) function top12_of_eq(x) result(t)
  real(kind=r8), intent (in) :: x
  integer(kind=i4) :: t
    t = int(ishft(bits_of_eq(x), -52), i4)
    t = iand(t, int(z'7ff',i4))
end function top12_of_eq

attributes(host, device) function exp_specialcase_eq(tmp, sbits_in, ki) result(y)
  real(kind=r8), intent (in) :: tmp
  integer(kind=i8), intent (in) :: sbits_in, ki
  real(kind=r8) :: y
  integer(kind=i8) :: sbits
  real(kind=r8) :: scale, hi, lo
    sbits = sbits_in
    if (iand(ki, int(z'80000000',i8)) == 0_i8) then
      sbits = sbits - ishft(1009_i8, 52)
      scale = real_of_eq(sbits)
      y = (2.0_r8**1009) * (scale + scale*tmp)
      return
    endif
    sbits = sbits + ishft(1022_i8, 52)
    scale = real_of_eq(sbits)
    y = scale + scale*tmp
    if (y < 1.0_r8) then
      lo = scale - y + scale*tmp
      hi = 1.0_r8 + y
      lo = 1.0_r8 - hi + y + lo
      y = (hi + lo) - 1.0_r8
      if (y == 0.0_r8) y = 0.0_r8
    endif
    y = (2.0_r8**(-1022)) * y
end function exp_specialcase_eq

attributes(host, device) function myexp_eq(x) result(y)
  real(kind=r8), intent (in) :: x
  real(kind=r8) :: y
  integer(kind=i4) :: abstop
  integer(kind=i8) :: ki, idx, topbits, sbits, xbits
  real(kind=r8) :: kd, z, r, r2, scale, tail, tmp

    abstop = top12_of_eq(x)
    if (abstop < exp_top12_tiny .or. abstop >= exp_top12_512) then
      if (abstop < exp_top12_tiny) then
        y = 1.0_r8 + x
        return
      endif
      if (abstop >= exp_top12_1024) then
        xbits = bits_of_eq(x)
        if (xbits == exp_bits_neginf) then
          y = 0.0_r8
          return
        endif
        if (abstop >= exp_top12_inf) then
          y = 1.0_r8 + x
          return
        endif
        if (xbits < 0_i8) then
          y = 0.0_r8
        else
          y = real_of_eq(exp_bits_posinf)
        endif
        return
      endif
      abstop = 0
    endif

    z = exp_invln2N * x
    kd = z + exp_shift
    ki = bits_of_eq(kd)
    kd = kd - exp_shift
    r = x + kd*exp_negln2hiN + kd*exp_negln2loN

    idx = 2_i8 * iand(ki, 127_i8)
    topbits = ishft(ki, 52 - 7)
    tail = real_of_eq(exp_tab(idx))
    sbits = exp_tab(idx+1) + topbits

    r2 = r*r
    tmp = tail + r + r2*(exp_c2 + r*exp_c3) + r2*r2*(exp_c4 + r*exp_c5)

    if (abstop == 0) then
      y = exp_specialcase_eq(tmp, sbits, ki)
      return
    endif

    scale = real_of_eq(sbits)
    y = scale + scale*tmp
end function myexp_eq

attributes(global) subroutine k_compara(n, x, y_orig, y_eq)
  integer(kind=i4), value :: n
  real(kind=r8), device, intent (in)  :: x(n)
  real(kind=r8), device, intent (out) :: y_orig(n), y_eq(n)
  integer(kind=i4) :: i
  i = (blockIdx%x - 1) * blockDim%x + threadIdx%x
  if (i <= n) then
    y_orig(i) = myexp_orig(x(i))
    y_eq(i)   = myexp_eq(x(i))
  endif
end subroutine k_compara

end module mtest_equiv


program test_equivalence_exp
 use mtest_equiv
 use cudafor
 implicit none
 integer, parameter :: i4 = selected_int_kind(9)
 integer, parameter :: r8 = selected_real_kind(15,9)

 integer(kind=i4), parameter :: n = 14
 real(kind=r8) :: x_h(n), y_orig_cpu(n), y_eq_cpu(n)
 real(kind=r8) :: y_orig_gpu(n), y_eq_gpu(n)
 real(kind=r8), device :: x_d(n), y_orig_d(n), y_eq_d(n)
 integer(kind=i4) :: i, threads, blocks
 logical :: todo_ok

  x_h = (/ 0.0_r8, 1.0_r8, -1.0_r8, 0.5_r8, -0.5_r8, 2.71828182845905_r8, &
           -3.33333333333333_r8, 1.0d-30, -1.0d-30, 20.0_r8, -20.0_r8, &
           700.0_r8, -700.0_r8, 1.5707963267948966_r8 /)

  x_d = x_h
  threads = 32
  blocks = (n + threads - 1) / threads
  call k_compara<<<blocks,threads>>>(n, x_d, y_orig_d, y_eq_d)
  y_orig_gpu = y_orig_d
  y_eq_gpu   = y_eq_d

  todo_ok = .true.
  do i = 1, n
    y_orig_cpu(i) = myexp_orig(x_h(i))
    y_eq_cpu(i)   = myexp_eq(x_h(i))

    write(*,*)
    write(*,'(a,i0,a,es24.17)') '--- #', i, '  x=', x_h(i)
    write(*,'(a,es24.17)') '  myexp_orig CPU =', y_orig_cpu(i)
    write(*,'(a,es24.17)') '  myexp_eq   CPU =', y_eq_cpu(i)
    write(*,'(a,es24.17)') '  myexp_orig GPU =', y_orig_gpu(i)
    write(*,'(a,es24.17)') '  myexp_eq   GPU =', y_eq_gpu(i)

    if (y_orig_cpu(i) /= y_eq_cpu(i)) then
      write(*,*) '  DIFERENCIA CPU orig vs eq!'
      todo_ok = .false.
    endif
    if (y_orig_gpu(i) /= y_eq_gpu(i)) then
      write(*,*) '  DIFERENCIA GPU orig vs eq!'
      todo_ok = .false.
    endif
    if (y_orig_cpu(i) /= y_orig_gpu(i)) then
      write(*,*) '  DIFERENCIA orig CPU vs GPU! (no deberia pasar, ya validado antes)'
      todo_ok = .false.
    endif
  enddo

  write(*,*)
  if (todo_ok) then
    write(*,*) 'PASA: EQUIVALENCE da EXACTAMENTE los mismos bits que TRANSFER, en CPU y GPU'
  else
    write(*,*) 'FALLA: hay diferencias, ver arriba'
  endif

end program test_equivalence_exp
