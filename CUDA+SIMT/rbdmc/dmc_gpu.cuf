! dmc_gpu.cuf
! Funciones de device y kernel global para el paso DMC en GPU.
! Cada hilo de GPU ejecuta dmc2 para un walker independiente (SIMT).
!
! Implementa la misma logica que dmc2() de msteps.f90 y todas las funciones
! que llama: hpsi, derananum, wavef*, derwavef*, vpot, rota, etc.
!
! IMPLEMENTADO:
!   - opot=4 (potenbh BH He-H2): ENERGY1 (LM2M2 He-He) + ENERGY2 (rep+disp He-H2)
!     + ENERGY3 (induccion He-H2), calculado en marco espacial (frame-independent).
!   - opot=0 (Aziz atomica): azizgen_d.
! PENDIENTE:
!   - opot=1,2,3 (vatomol molecular): pw_vheocs/hh_vheocs/hecokp2d.
!
module dmc_gpu
  use cudafor
  use dmc_gpu_params
  implicit none

  integer, private, parameter :: r8    = selected_real_kind(15,9)
  real(r8), private, parameter :: UMAX = 200.0_r8
  real(r8), private, parameter :: UMIN = -200.0_r8
  real(r8), private, parameter :: PI   = 3.14159265358979323846_r8
  real(r8), private, parameter :: DX_NUM = 1.0d-3  ! paso derivada numerica

contains

  !===========================================================================
  ! GENERADOR DE NUMEROS ALEATORIOS (LCG 48-bit, identico a mrandom2.f90)
  ! Estado por walker almacenado en d_irn(iw)
  !===========================================================================
  attributes(device) function rn1_d(iw) result(rn)
    integer(4), value :: iw
    real(r8) :: rn
    integer(8) :: irn, is1, is2
    integer(8), parameter :: mask24 = ishft(1_8, 24) - 1_8
    integer(8), parameter :: mask48 = ishft(1_8, 48) - 1_8
    real(r8),   parameter :: twom48 = 2.0_r8**(-48)
    integer(8), parameter :: mult1  = 44485709377909_8
    integer(8), parameter :: m11    = iand(mult1, mask24)
    integer(8), parameter :: m12    = iand(ishft(mult1, -24), mask24)
    integer(8), parameter :: iadd1  = 96309754297_8

    irn = d_irn(iw)
    is2 = iand(ishft(irn, -24), mask24)
    is1 = iand(irn, mask24)
    irn = iand(ishft(iand(is1*m12 + is2*m11, mask24), 24) + is1*m11 + iadd1, mask48)
    d_irn(iw) = irn
    rn = ior(irn, 1_8) * twom48
  end function rn1_d

  ! Box-Muller para generar 3 gaussianas independientes
  attributes(device) subroutine gauss3_d(iw, g)
    integer(4), value :: iw
    real(r8), intent(out) :: g(3)
    real(r8) :: xl, arg

    arg  = 2.0_r8 * PI * rn1_d(iw)
    xl   = sqrt(-2.0_r8 * log(rn1_d(iw)))
    g(1) = xl * sin(arg)
    g(2) = xl * cos(arg)
    arg  = 2.0_r8 * PI * rn1_d(iw)
    xl   = sqrt(-2.0_r8 * log(rn1_d(iw)))
    g(3) = xl * sin(arg)
  end subroutine gauss3_d

  !===========================================================================
  ! ROTACION (mrotaciones.f90 -> rota)
  ! ejes(ic, iaxis): componente ic del eje iaxis
  !===========================================================================
  attributes(device) subroutine rota_d(i1, phi, ejes)
    integer(4), value :: i1
    real(r8), value   :: phi
    real(r8), intent(inout) :: ejes(3, 3)
    real(r8) :: c, s, t
    integer(4) :: j1, k1, ic
    real(r8) :: v_j, v_k ! Variables temporales para los componentes originales

    j1 = mod(i1, 3) + 1
    k1 = mod(j1, 3) + 1
    c  = cos(phi)
    s  = sin(phi)

    do ic = 1, 3
      v_j = ejes(ic, j1)
      v_k = ejes(ic, k1)
      
      ejes(ic, j1) =  c * v_j + s * v_k
      ejes(ic, k1) = -s * v_j + c * v_k
    enddo
  end subroutine rota_d

  !===========================================================================
  ! POLINOMIOS DE LEGENDRE (mlegendre.f90)
  !===========================================================================
  attributes(device) subroutine calpleg_d(l, x, pl)
    integer(4), value :: l
    real(r8), value   :: x
    real(r8), intent(out) :: pl(0:LMAX_GPU)
    integer(4) :: il
    integer(4) :: l_eff

    if (l > LMAX_GPU) then
       l_eff = LMAX_GPU 
    else
       l_eff = l
    endif

    pl(0) = 1.0_r8
    if (l_eff < 1) return
    pl(1) = x
    
    do il = 1, l_eff - 1
      pl(il+1) = ((2.0_r8*il + 1.0_r8)*x*pl(il) - il*pl(il-1)) / real(il+1, r8)
    enddo
  end subroutine calpleg_d

  attributes(device) subroutine calderpleg_d(l, x, pl, d1pl, d2pl)
    integer(4), value :: l
    real(r8), value   :: x
    real(r8), intent(out) :: pl(0:LMAX_GPU), d1pl(0:LMAX_GPU), d2pl(0:LMAX_GPU)
    integer(4) :: il
    real(r8) :: twolp1, invl

    pl(0)=1.0_r8; d1pl(0)=0.0_r8; d2pl(0)=0.0_r8
    if (l < 1) return
    pl(1)=x; d1pl(1)=1.0_r8; d2pl(1)=0.0_r8
    do il = 1, l-1
      twolp1 = 2.0_r8*il + 1.0_r8
      invl   = 1.0_r8 / real(il+1, r8)
      
      pl(il+1)   = (twolp1*x*pl(il) - real(il, r8)*pl(il-1)) * invl
      d1pl(il+1) = twolp1*pl(il) + d1pl(il-1)
      d2pl(il+1) = twolp1*d1pl(il) + d2pl(il-1)
    enddo
  end subroutine calderpleg_d

  !===========================================================================
  ! POTENCIALES AZIZ (mvaziz.f90)
  !===========================================================================
  attributes(device) function aziz_nuevo_d(r) result(v)
    real(r8), value :: r
    real(r8) :: v
    real(r8), parameter :: A=1.84431010d5, ALPHA=10.433295370_r8
    real(r8), parameter :: C6=1.367452140_r8, C8=0.421238070_r8
    real(r8), parameter :: C10=0.174733180_r8, BETA=-2.279651050_r8
    real(r8), parameter :: D=1.48260_r8, EPS=10.9480_r8, RM=2.9630_r8
    real(r8) :: x, f, invx2, invx6
    x = r / RM
    if (x < 0.01_r8) then 
          v = 1.0e10_r8 ! Un potencial repulsivo muy alto, pero no NaN
          return
        endif

        if (x < D) then
          f = exp(-(D/x - 1.0_r8)**2)
        else
          f = 1.0_r8
        endif

        invx2 = 1.0_r8 / (x*x)
        invx6 = invx2 * invx2 * invx2
        
        v = (A*exp(-ALPHA*x + BETA*x*x) - f*invx6*(C6 + C8*invx2 + C10*invx2*invx2)) * EPS
    end function aziz_nuevo_d

  attributes(device) function azizgen_d(r) result(v)
    real(r8), value :: r
    real(r8) :: v, x, f, invx

    x = r / d_rm_aziz
    if (x < 0.01_r8) then
       v = 1.0e10_r8
       return
    endif

    if (x < d_d_aziz) then
       f = exp(-(d_d_aziz/x - 1.0_r8)**2)
    else
       f = 1.0_r8
    endif
    
    invx = 1.0_r8 / x
    v = (d_a_aziz*exp(-d_alpha_aziz*x) - &
         f*(d_c6_aziz*invx**6 + d_c7_aziz*invx**7 + d_c8_aziz*invx**8)) * d_eps_aziz
  end function azizgen_d

  !===========================================================================
  ! FUNCIONES DE ONDA DE IMPUREZA (mangwavef.f90)
  !===========================================================================
  attributes(device) function uhe4x_d(rij, cth) result(u)
    real(r8), value :: rij, cth
    real(r8) :: u, pl(0:LMAX_GPU), ul
    integer(4) :: il

    call calpleg_d(d_lxhe4, cth, pl)
    do il = 1, d_lxhe4
      pl(il) = 1.0_r8 - pl(il)
    enddo
    u = 0.0_r8
    do il = 0, d_lxhe4
      ul = -d_pxhe4(1,il)/rij**d_pxhe4(2,il) &
           - d_pxhe4(3,il)*rij**d_pxhe4(4,il) &
           - d_pxhe4(5,il)*log(rij)
      u  = u + ul*pl(il)
    enddo
  end function uhe4x_d

  attributes(device) function uhe3x_d(rij, cth) result(u)
    real(r8), value :: rij, cth
    real(r8) :: u, pl(0:LMAX_GPU), ul
    integer(4) :: il

    call calpleg_d(d_lxhe3, cth, pl)
    do il = 1, d_lxhe3
      pl(il) = 1.0_r8 - pl(il)
    enddo
    u = 0.0_r8
    do il = 0, d_lxhe3
      ul = -d_pxhe3(1,il)/rij**d_pxhe3(2,il) &
           - d_pxhe3(3,il)*rij**d_pxhe3(4,il) &
           - d_pxhe3(5,il)*log(rij)
      u  = u + ul*pl(il)
    enddo
  end function uhe3x_d

  !===========================================================================
  ! DETERMINANTE LU (mlineal.f90 -> det)
  !===========================================================================
  attributes(device) function det_d(n, b) result(d)
    integer(4), value :: n
    real(r8), intent(in) :: b(NFERMAX_GPU, NFERMAX_GPU)
    real(r8) :: d
    real(r8) :: a(NFERMAX_GPU, NFERMAX_GPU), s, pivot, piv
    integer(4) :: i, j, k, ipiv


    a = b
    d = 1.0_r8
    do j = 1, n
      if (j /= 1) then
        do i = 2, n
          s = a(i, j)
          do k = 1, min(i-1, j-1)
            s = s - a(i,k)*a(k,j)
          enddo
          a(i, j) = s
        enddo
      endif
      pivot = 0.0_r8;  ipiv = j
      do k = j, n
        piv = abs(a(k, j))
        if (piv > pivot) then
          ipiv = k;  pivot = piv
        endif
      enddo
      if (ipiv /= j) then
        do i = 1, n
          piv = a(j,i);  a(j,i) = a(ipiv,i);  a(ipiv,i) = piv
        enddo
        d = -d
      endif
      pivot = a(j, j)
      if (j /= n) then
        do k = j+1, n
          a(k, j) = a(k, j) / pivot
        enddo
      endif
      d = d * pivot
    enddo
  end function det_d

  ! Determinante de Slater para npart fermiones con posiciones rpart(3,npart)
  attributes(device) subroutine slaterdet_d(npart, rpart, slater)
    integer(4), value :: npart
    real(r8), intent(in) :: rpart(3, NFERMAX_GPU)
    real(r8), intent(out) :: slater
    real(r8) :: m(NFERMAX_GPU, NDIM_GPU)
    real(r8) :: x, y, z
    integer(4) :: ip

    if (npart <= 1) then; slater = 1.0_r8; return; endif

    do ip = 1, npart
      x = rpart(1,ip);  y = rpart(2,ip);  z = rpart(3,ip)
      m(ip, 1) = 1.0_r8
      m(ip, 2) = x
      if (npart == 2) cycle
      m(ip, 3) = y
      if (npart == 3) cycle
      m(ip, 4) = z
      if (npart == 4) cycle
      m(ip, 5) = x*x;  m(ip, 6) = y*y;  m(ip, 7) = z*z
      if (npart <= 7) cycle
      m(ip, 8) = x*y;  m(ip, 9) = x*z;  m(ip,10) = y*z
      if (npart <= 10) cycle
      m(ip,11) = x*x*x;  m(ip,12) = y*y*y;  m(ip,13) = z*z*z
      m(ip,14) = x*x*y;  m(ip,15) = x*x*z;  m(ip,16) = x*y*y
      m(ip,17) = z*y*y;  m(ip,18) = x*z*z;  m(ip,19) = y*z*z
      m(ip,20) = y*z*x
    enddo
    slater = det_d(npart, m)
  end subroutine slaterdet_d

  !===========================================================================
  ! CENTRO DE MASAS (mwavef.f90 -> getcm)
  !===========================================================================
  attributes(device) subroutine getcm_d(atom, rcm)
    real(r8), intent(in)  :: atom(3, NATOM_MAX)
    real(r8), intent(out) :: rcm(3)
    real(r8) :: mtot
    integer(4) :: i

    rcm  = 0.0_r8
    do i = 1, d_nhe4
      rcm = rcm + d_mhe4 * atom(:, i)
    enddo
    do i = d_nhe4+1, d_ngatom
      rcm = rcm + d_mhe3 * atom(:, i)
    enddo
    if (d_impureza) then
      rcm  = rcm + d_mx * atom(:, d_natom)
      mtot = d_nhe4*d_mhe4 + d_nhe3*d_mhe3 + d_mx
    else
      mtot = d_nhe4*d_mhe4 + d_nhe3*d_mhe3
    endif
    rcm = rcm / mtot
  end subroutine getcm_d

  !===========================================================================
  ! FUNCIONES DE ONDA POR COMPONENTES (mwavef.f90)
  !===========================================================================

  attributes(device) subroutine wavefhe4_d(atom, wfhe4)
    real(r8), intent(in)  :: atom(3, NATOM_MAX)
    real(r8), intent(out) :: wfhe4
    real(r8) :: rt(3), ujas, rij
    integer(4) :: i, j

    ujas = 0.0_r8
    do i = 1, d_nhe4-1
      do j = i+1, d_nhe4
        rt   = atom(:,i) - atom(:,j)
        rij  = sqrt(dot_product(rt, rt))
        ujas = ujas - d_phe4(1)/rij**d_phe4(2) - d_phe4(3)*rij
      enddo
    enddo
    ujas   = min(max(ujas, UMIN), UMAX)
    wfhe4  = exp(ujas)
  end subroutine wavefhe4_d

  attributes(device) subroutine wavefhe3_d(atom, wfhe3, signoup, signodw)
    real(r8), intent(in)  :: atom(3, NATOM_MAX)
    real(r8), intent(out) :: wfhe3
    integer(4), intent(out) :: signoup, signodw
    real(r8) :: rcm(3), rb(3, NFERMAX_GPU)
    real(r8) :: rbup(3, NFERMAX_GPU), rbdw(3, NFERMAX_GPU)
    real(r8) :: rt(3), etaij, ujas, rij, sup, sdw
    integer(4) :: i, j, ii, jj

    call getcm_d(atom, rcm)
    do i = d_nhe4+1, d_ngatom
      rb(:, i-d_nhe4) = atom(:, i) - rcm
    enddo

    ujas = 0.0_r8
    do i = d_nhe4+1, d_ngatom-1
      ii = i - d_nhe4
      do j = i+1, d_ngatom
        jj   = j - d_nhe4
        rt   = atom(:,i) - atom(:,j)
        rij  = sqrt(dot_product(rt, rt))
        ujas = ujas - d_phe3(1)/rij**d_phe3(2)
        etaij      = d_phe3(4)/rij**3
        rb(:,ii)   = rb(:,ii) + etaij*rt
        rb(:,jj)   = rb(:,jj) - etaij*rt
      enddo
    enddo
    do ii = 1, d_nhe3-1
      do jj = ii+1, d_nhe3
        rt   = rb(:,ii) - rb(:,jj)
        ujas = ujas - d_phe3(3)*sqrt(dot_product(rt, rt))
      enddo
    enddo

    do ii = 1, d_nhe3up
      rbup(:,ii) = rb(:,ii)
    enddo
    do ii = 1, d_nhe3dw
      rbdw(:,ii) = rb(:, d_nhe3up+ii)
    enddo

    call slaterdet_d(d_nhe3up, rbup, sup)
    call slaterdet_d(d_nhe3dw, rbdw, sdw)

    ujas    = min(max(ujas, UMIN), UMAX)
    wfhe3   = exp(ujas) * sup * sdw
    signoup = merge(-1, 1, sup < 0.0_r8)
    signodw = merge(-1, 1, sdw < 0.0_r8)
  end subroutine wavefhe3_d

  attributes(device) subroutine wavefm_d(atom, wfm)
    real(r8), intent(in)  :: atom(3, NATOM_MAX)
    real(r8), intent(out) :: wfm
    real(r8) :: rt(3), ujas, rij
    integer(4) :: i, j

    ujas = 0.0_r8
    do i = 1, d_nhe4
      do j = d_nhe4+1, d_ngatom
        rt   = atom(:,i) - atom(:,j)
        rij  = sqrt(dot_product(rt, rt))
        ujas = ujas - d_pmix(1)/rij**d_pmix(2) - d_pmix(3)*rij
      enddo
    enddo
    wfm = exp(ujas)
  end subroutine wavefm_d

  attributes(device) subroutine wavefx_d(atom, sprop, wfx)
    real(r8), intent(in)  :: atom(3, NATOM_MAX), sprop(3, 3)
    real(r8), intent(out) :: wfx
    real(r8) :: rt(3), ujas, rij, cth, dnor
    integer(4) :: j

    if (.not. d_impureza) then; wfx = 1.0_r8; return; endif

    ujas = 0.0_r8;  cth = 0.0_r8
    if (d_impurmol) dnor = sqrt(dot_product(sprop(:,3), sprop(:,3)))
    do j = 1, d_nhe4
      rt  = atom(:,j) - atom(:,d_natom)
      rij = sqrt(dot_product(rt, rt))
      if (d_impurmol) cth = dot_product(rt, sprop(:,3)) / (dnor*rij)
      ujas = ujas + uhe4x_d(rij, cth)
    enddo
    do j = d_nhe4+1, d_ngatom
      rt  = atom(:,j) - atom(:,d_natom)
      rij = sqrt(dot_product(rt, rt))
      if (d_impurmol) cth = dot_product(rt, sprop(:,3)) / (dnor*rij)
      ujas = ujas + uhe3x_d(rij, cth)
    enddo
    wfx = exp(ujas)
  end subroutine wavefx_d

  ! Funcion de onda total
  attributes(device) subroutine wavef_d(atom, sprop, &
       wfhe4, wfhe3, wfm, wfx, wf, signoup, signodw)
    real(r8), intent(in)  :: atom(3, NATOM_MAX), sprop(3, 3)
    real(r8), intent(out) :: wfhe4, wfhe3, wfm, wfx, wf
    integer(4), intent(out) :: signoup, signodw

    call wavefhe4_d(atom, wfhe4)
    call wavefhe3_d(atom, wfhe3, signoup, signodw)
    call wavefm_d(atom, wfm)
    call wavefx_d(atom, sprop, wfx)
    wf = wfhe4 * wfhe3 * wfm * wfx
  end subroutine wavef_d

  !===========================================================================
  ! DERIVADAS ANALITICAS He4-He4 (mwavef.f90 -> derwavefhe4)
  !===========================================================================
  attributes(device) subroutine derwavefhe4_d(atom, d1wf, d2wf)
    real(r8), intent(in)  :: atom(3, NATOM_MAX)
    real(r8), intent(out) :: d1wf(3, NATOM_MAX), d2wf(NATOM_MAX)
    real(r8) :: rt(3), ujasp, ujass, rij
    integer(4) :: i, j

    d1wf = 0.0_r8;  d2wf = 0.0_r8
    do i = 1, d_nhe4-1
      do j = i+1, d_nhe4
        rt    = atom(:,i) - atom(:,j)
        rij   = sqrt(dot_product(rt, rt))
        ujasp = d_phe4(1)*d_phe4(2)/rij**(d_phe4(2)+1.0_r8)
        ujass = -(d_phe4(2)+1.0_r8)*ujasp/rij
        ujasp = (ujasp - d_phe4(3)) / rij
        d1wf(:,i) = d1wf(:,i) + ujasp*rt
        d1wf(:,j) = d1wf(:,j) - ujasp*rt
        d2wf(i)   = d2wf(i) + ujass + 2.0_r8*ujasp
        d2wf(j)   = d2wf(j) + ujass + 2.0_r8*ujasp
      enddo
    enddo
    do i = 1, d_nhe4
      d2wf(i) = d2wf(i) + dot_product(d1wf(:,i), d1wf(:,i))
    enddo
  end subroutine derwavefhe4_d

  !===========================================================================
  ! DERIVADAS NUMERICAS He3 (mwavef.f90 -> derwavefhe3)
  ! Perturbacion +/-dx y llamadas repetidas a wavefhe3_d
  !===========================================================================
  attributes(device) subroutine derwavefhe3_d(atom_in, wf0, d1wf, d2wf)
    real(r8), intent(in)  :: atom_in(3, NATOM_MAX)
    real(r8), value       :: wf0               ! wfhe3 en posicion actual
    real(r8), intent(out) :: d1wf(3, NATOM_MAX), d2wf(NATOM_MAX)
    real(r8) :: atom(3, NATOM_MAX)
    real(r8) :: wfp, wfm, dend1, dend2, sumd2
    integer(4) :: dum_sup, dum_sdw, ihe3, iatom, ic
    real(r8), parameter :: WF_MIN = 1.0e-30_r8 

    if (abs(wf0) < WF_MIN) then
        d1wf = 0.0_r8
        d2wf = 0.0_r8
        return
    endif

    dend1 = 2.0_r8 * DX_NUM * wf0
    dend2 = DX_NUM**2 * wf0
    d1wf  = 0.0_r8
    d2wf  = 0.0_r8
    atom  = atom_in

    do ihe3 = 1, d_nhe3
      iatom = d_nhe4 + ihe3
      sumd2 = 0.0_r8
      do ic = 1, 3
        atom(ic, iatom) = atom_in(ic, iatom) + DX_NUM
        call wavefhe3_d(atom, wfp, dum_sup, dum_sdw)
        atom(ic, iatom) = atom_in(ic, iatom) - DX_NUM
        call wavefhe3_d(atom, wfm, dum_sup, dum_sdw)
        atom(ic, iatom) = atom_in(ic, iatom)
        d1wf(ic, ihe3)  = (wfp - wfm) / dend1
        sumd2 = sumd2 + (wfp + wfm - 2.0_r8*wf0)
      enddo
      d2wf(ihe3) = sumd2 / dend2
    enddo
  end subroutine derwavefhe3_d

  !===========================================================================
  ! DERIVADAS ANALITICAS mezcla He4-He3 (mwavef.f90 -> derwavefm)
  !===========================================================================
  attributes(device) subroutine derwavefm_d(atom, d1wf, d2wf)
    real(r8), intent(in)  :: atom(3, NATOM_MAX)
    real(r8), intent(out) :: d1wf(3, NATOM_MAX), d2wf(NATOM_MAX)
    real(r8) :: rt(3), ujasp, ujass, rij
    integer(4) :: i, j, jhe3

    d1wf = 0.0_r8;  d2wf = 0.0_r8
    do i = 1, d_nhe4
      do jhe3 = 1, d_nhe3
        j     = d_nhe4 + jhe3
        rt    = atom(:,i) - atom(:,j)
        rij   = sqrt(dot_product(rt, rt))
        ujasp = d_pmix(1)*d_pmix(2)/rij**(d_pmix(2)+1.0_r8)
        ujass = -(d_pmix(2)+1.0_r8)*ujasp/rij
        ujasp = (ujasp - d_pmix(3)) / rij
        d1wf(:,i) = d1wf(:,i) + ujasp*rt
        d1wf(:,j) = d1wf(:,j) - ujasp*rt
        d2wf(i)   = d2wf(i) + ujass + 2.0_r8*ujasp
        d2wf(j)   = d2wf(j) + ujass + 2.0_r8*ujasp
      enddo
    enddo
    do i = 1, d_ngatom
      d2wf(i) = d2wf(i) + dot_product(d1wf(:,i), d1wf(:,i))
    enddo
  end subroutine derwavefm_d

  !===========================================================================
  ! DERIVADAS ANALITICAS impureza (mangwavef.f90 -> duhe4x, duhe3x)
  !===========================================================================
  attributes(device) subroutine duhe4x_d(rivec, smol, d1ux, d2ux, d1zux, d2zux)
    real(r8), intent(in)  :: rivec(3), smol(3, 3)
    real(r8), intent(out) :: d1ux(3), d2ux, d1zux(2), d2zux
    real(r8) :: grz(3), grpl(3), grul(3)
    real(r8) :: rij, cth, zpr, grz2, lapz, gpz(2), lpz, gpz2
    real(r8) :: ulx, ulxp, ulxs, lapl, rijp2, rijp4
    real(r8) :: pl(0:LMAX_GPU), d1pl(0:LMAX_GPU), d2pl(0:LMAX_GPU)
    integer(4) :: il

    rij = sqrt(dot_product(rivec, rivec))
    if (d_impurmol) then
      cth  = dot_product(rivec, smol(:,3)) / rij
      zpr  = cth / rij
      grz  = (smol(:,3) - zpr*rivec) / rij
      grz2 = dot_product(grz, grz)
      lapz = -2.0_r8*zpr/rij
      gpz(1) = -dot_product(rivec, smol(:,2)) / rij
      gpz(2) =  dot_product(rivec, smol(:,1)) / rij
      gpz2 = dot_product(gpz, gpz)
      lpz  = -cth - cth
    else
      cth=0.0_r8; grz=0.0_r8; grz2=0.0_r8; lapz=0.0_r8
      gpz=0.0_r8; gpz2=0.0_r8; lpz=0.0_r8
    endif
    call calderpleg_d(d_lxhe4, cth, pl, d1pl, d2pl)
    do il = 1, d_lxhe4
      pl(il)   = 1.0_r8 - pl(il)
      d1pl(il) = -d1pl(il)
      d2pl(il) = -d2pl(il)
    enddo
    d1ux=0.0_r8; d2ux=0.0_r8; d1zux=0.0_r8; d2zux=0.0_r8
    do il = 0, d_lxhe4
      rijp2 = rij**d_pxhe4(2,il)
      rijp4 = rij**d_pxhe4(4,il)
      ulx   = -d_pxhe4(1,il)/rijp2 - d_pxhe4(3,il)*rijp4 - d_pxhe4(5,il)*log(rij)
      ulxp  = (d_pxhe4(1,il)*d_pxhe4(2,il)/rijp2 &
               - d_pxhe4(3,il)*d_pxhe4(4,il)*rijp4 - d_pxhe4(5,il)) / rij
      ulxs  = (-d_pxhe4(1,il)*d_pxhe4(2,il)*(d_pxhe4(2,il)+1.0_r8)/rijp2 &
               - d_pxhe4(3,il)*d_pxhe4(4,il)*(d_pxhe4(4,il)-1.0_r8)*rijp4 &
               + d_pxhe4(5,il)) / rij**2 + 2.0_r8*ulxp/rij
      grul  = ulxp/rij * rivec
      grpl  = d1pl(il) * grz
      lapl  = lapz*d1pl(il) + grz2*d2pl(il)
      d1ux  = d1ux + pl(il)*grul + ulx*grpl
      d2ux  = d2ux + pl(il)*ulxs + ulx*lapl + 2.0_r8*dot_product(grul, grpl)
      d1zux = d1zux + ulx*d1pl(il)*gpz
      d2zux = d2zux + ulx*(d1pl(il)*lpz + d2pl(il)*gpz2)
    enddo
  end subroutine duhe4x_d

  attributes(device) subroutine duhe3x_d(rivec, smol, d1ux, d2ux, d1zux, d2zux)
    real(r8), intent(in)  :: rivec(3), smol(3, 3)
    real(r8), intent(out) :: d1ux(3), d2ux, d1zux(2), d2zux
    real(r8) :: grz(3), grpl(3), grul(3)
    real(r8) :: rij, cth, zpr, grz2, lapz, gpz(2), lpz, gpz2
    real(r8) :: ulx, ulxp, ulxs, lapl, rijp2, rijp4
    real(r8) :: pl(0:LMAX_GPU), d1pl(0:LMAX_GPU), d2pl(0:LMAX_GPU)
    integer(4) :: il

    rij = sqrt(dot_product(rivec, rivec))
    if (d_impurmol) then
      cth  = dot_product(rivec, smol(:,3)) / rij
      zpr  = cth / rij
      grz  = (smol(:,3) - zpr*rivec) / rij
      grz2 = dot_product(grz, grz)
      lapz = -2.0_r8*zpr/rij
      gpz(1) = -dot_product(rivec, smol(:,2)) / rij
      gpz(2) =  dot_product(rivec, smol(:,1)) / rij
      gpz2 = dot_product(gpz, gpz)
      lpz  = -cth - cth
    else
      cth=0.0_r8; grz=0.0_r8; grz2=0.0_r8; lapz=0.0_r8
      gpz=0.0_r8; gpz2=0.0_r8; lpz=0.0_r8
    endif
    call calderpleg_d(d_lxhe3, cth, pl, d1pl, d2pl)
    do il = 1, d_lxhe3
      pl(il)   = 1.0_r8 - pl(il)
      d1pl(il) = -d1pl(il)
      d2pl(il) = -d2pl(il)
    enddo
    d1ux=0.0_r8; d2ux=0.0_r8; d1zux=0.0_r8; d2zux=0.0_r8
    do il = 0, d_lxhe3
      rijp2 = rij**d_pxhe3(2,il)
      rijp4 = rij**d_pxhe3(4,il)
      ulx   = -d_pxhe3(1,il)/rijp2 - d_pxhe3(3,il)*rijp4 - d_pxhe3(5,il)*log(rij)
      ulxp  = (d_pxhe3(1,il)*d_pxhe3(2,il)/rijp2 &
               - d_pxhe3(3,il)*d_pxhe3(4,il)*rijp4 - d_pxhe3(5,il)) / rij
      ulxs  = (-d_pxhe3(1,il)*d_pxhe3(2,il)*(d_pxhe3(2,il)+1.0_r8)/rijp2 &
               - d_pxhe3(3,il)*d_pxhe3(4,il)*(d_pxhe3(4,il)-1.0_r8)*rijp4 &
               + d_pxhe3(5,il)) / rij**2 + 2.0_r8*ulxp/rij
      grul  = ulxp/rij * rivec
      grpl  = d1pl(il) * grz
      lapl  = lapz*d1pl(il) + grz2*d2pl(il)
      d1ux  = d1ux + pl(il)*grul + ulx*grpl
      d2ux  = d2ux + pl(il)*ulxs + ulx*lapl + 2.0_r8*dot_product(grul, grpl)
      d1zux = d1zux + ulx*d1pl(il)*gpz
      d2zux = d2zux + ulx*(d1pl(il)*lpz + d2pl(il)*gpz2)
    enddo
  end subroutine duhe3x_d

  !===========================================================================
  ! DERIVADAS ANALITICAS impureza respecto a posicion (mwavef.f90 -> derwavefx)
  !===========================================================================
  attributes(device) subroutine derwavefx_d(atom, sprop, d1wf, d2wf, d1zwf, d2zwf)
    real(r8), intent(in)  :: atom(3, NATOM_MAX), sprop(3, 3)
    real(r8), intent(out) :: d1wf(3, NATOM_MAX), d2wf(NATOM_MAX)
    real(r8), intent(out) :: d1zwf(2), d2zwf
    real(r8) :: d1ux(3), d2ux, d1zux(2), d2zux
    real(r8) :: rivec(3), smol(3, 3), dnor
    integer(4) :: i, j, jhe3, ic

    d1wf=0.0_r8; d2wf=0.0_r8; d1zwf=0.0_r8; d2zwf=0.0_r8
    if (.not. d_impureza) return

    if (d_impurmol) then
      do ic = 1, 3
        dnor = sqrt(dot_product(sprop(:,ic), sprop(:,ic)))
        smol(:,ic) = sprop(:,ic) / dnor
      enddo
    endif

    do j = 1, d_nhe4
      rivec = atom(:,j) - atom(:,d_natom)
      call duhe4x_d(rivec, smol, d1ux, d2ux, d1zux, d2zux)
      d1wf(:,j)       = d1ux
      d1wf(:,d_natom) = d1wf(:,d_natom) - d1ux
      d2wf(j)         = d2ux
      d2wf(d_natom)   = d2wf(d_natom) + d2ux
      d1zwf = d1zwf + d1zux
      d2zwf = d2zwf + d2zux
    enddo
    do jhe3 = 1, d_nhe3
      j = d_nhe4 + jhe3
      rivec = atom(:,j) - atom(:,d_natom)
      call duhe3x_d(rivec, smol, d1ux, d2ux, d1zux, d2zux)
      d1wf(:,j)       = d1ux
      d1wf(:,d_natom) = d1wf(:,d_natom) - d1ux
      d2wf(j)         = d2ux
      d2wf(d_natom)   = d2wf(d_natom) + d2ux
      d1zwf = d1zwf + d1zux
      d2zwf = d2zwf + d2zux
    enddo
    do i = 1, d_natom
      d2wf(i) = d2wf(i) + dot_product(d1wf(:,i), d1wf(:,i))
    enddo
    d2zwf = d2zwf + dot_product(d1zwf, d1zwf)
  end subroutine derwavefx_d

  !===========================================================================
  ! POTENCIAL (mwavef.f90 -> vpot)
  ! Solo implementado opot /= 4 sin impureza molecular (caso helium puro).
  ! Para opot=4 (BH) o impurmol=true se necesita portar potenbh/vatomol.
  !===========================================================================
  attributes(device) subroutine vpot_d(atom, sprop, pot)
    real(r8), intent(in)  :: atom(3, NATOM_MAX), sprop(3, 3)
    real(r8), intent(out) :: pot
    real(r8) :: rt(3), rij, dnor, cth
    integer(4) :: i, j

    pot = 0.0_r8
    do i = 1, d_ngatom-1
      do j = i+1, d_ngatom
        rt  = atom(:,i) - atom(:,j)
        rij = sqrt(dot_product(rt, rt))
        pot = pot + aziz_nuevo_d(rij)
      enddo
    enddo

    if (.not. d_impureza) return

    if (d_impurmol) then
      ! STUB: vatomol con opot=1,2,3 requiere pw_vheocs/hh_vheocs/hecokp2d
      ! que son complejos de portar. Contribucion de impureza molecular = 0.
    else
      ! Impureza atomica: usar azizgen
      do j = 1, d_ngatom
        rt  = atom(:,j) - atom(:,d_natom)
        rij = sqrt(dot_product(rt, rt))
        pot = pot + azizgen_d(rij)
      enddo
    endif
  end subroutine vpot_d

  !===========================================================================
  ! DERANANUM (mwavef.f90): derivadas analiticas + cinetica
  !===========================================================================
  attributes(device) subroutine derananum_d(atom, sprop, b_val, hb2m, &
       wf, wfhe4, wfhe3, wfm, wfx, kin, erot, eimp, &
       signoup, signodw, dwf, dphi)
    real(r8), intent(in)    :: atom(3, NATOM_MAX), sprop(3, 3)
    real(r8), value         :: b_val
    real(r8), intent(in)    :: hb2m(NATOM_MAX)
    real(r8), intent(inout) :: wf, wfhe4, wfhe3, wfm, wfx
    real(r8), intent(out)   :: kin, erot, eimp
    integer(4), intent(out) :: signoup, signodw
    real(r8), intent(out)   :: dwf(3, NATOM_MAX), dphi(2)
    ! Derivadas por componentes (gradiente log-derivada)
    real(r8) :: d1he4(3, NATOM_MAX), d2he4(NATOM_MAX)
    real(r8) :: d1he3(3, NATOM_MAX), d2he3(NATOM_MAX)
    real(r8) :: d1mix(3, NATOM_MAX), d2mix(NATOM_MAX)
    real(r8) :: d1x(3, NATOM_MAX),   d2x(NATOM_MAX)
    real(r8) :: d1zwfx(2), d2zwfx, der2
    integer(4) :: iatom, ihe3

    call wavef_d(atom, sprop, wfhe4, wfhe3, wfm, wfx, wf, signoup, signodw)

    call derwavefhe4_d(atom, d1he4, d2he4)
    call derwavefhe3_d(atom, wfhe3, d1he3, d2he3)
    call derwavefm_d(atom, d1mix, d2mix)
    call derwavefx_d(atom, sprop, d1x, d2x, d1zwfx, d2zwfx)

    kin = 0.0_r8
    do iatom = 1, d_nhe4
      dwf(:, iatom) = d1he4(:, iatom) + d1mix(:, iatom) + d1x(:, iatom)
      der2 = d2he4(iatom) + d2mix(iatom) + d2x(iatom) &
           + 2.0_r8*dot_product(d1he4(:,iatom), d1mix(:,iatom)) &
           + 2.0_r8*dot_product(d1he4(:,iatom), d1x(:,iatom))   &
           + 2.0_r8*dot_product(d1mix(:,iatom), d1x(:,iatom))
      kin = kin - hb2m(iatom)*der2
      print *, "DEBUG GPU: hb2m=", hb2m(iatom), " der2=", der2
    enddo
    do ihe3 = 1, d_nhe3
      iatom = d_nhe4 + ihe3
      dwf(:, iatom) = d1he3(:, ihe3) + d1mix(:, iatom) + d1x(:, iatom)
      der2 = d2he3(ihe3) + d2mix(iatom) + d2x(iatom) &
           + 2.0_r8*dot_product(d1he3(:,ihe3), d1mix(:,iatom)) &
           + 2.0_r8*dot_product(d1he3(:,ihe3), d1x(:,iatom))   &
           + 2.0_r8*dot_product(d1mix(:,iatom), d1x(:,iatom))
      kin = kin - hb2m(iatom)*der2
    enddo

    eimp = 0.0_r8
    if (.not. d_impurfija) then
      dwf(:, d_natom) = d1x(:, d_natom)
      kin  = kin - hb2m(d_natom)*d2x(d_natom)
      eimp = -hb2m(d_natom)*d2x(d_natom)
    endif

    erot = 0.0_r8
    if (d_rotamol) then
      dphi = d1zwfx
      kin  = kin - b_val*d2zwfx
      erot = -b_val*d2zwfx
    else
      dphi = 0.0_r8
    endif
  end subroutine derananum_d

  !===========================================================================
  ! HPSI (mwavef.f90): funcion de onda, derivadas, potencial y energia
  !===========================================================================
  attributes(device) subroutine hpsi_d(atom, sprop, b_val, hb2m, &
       wf, wfhe4, wfhe3, wfm, wfx, &
       kin, pot, ene, erot, eimp,  &
       signoup, signodw, dwf, dphi)
    real(r8), intent(inout) :: atom(3, NATOM_MAX), sprop(3, 3)
    real(r8), value         :: b_val
    real(r8), intent(in)    :: hb2m(NATOM_MAX)
    real(r8), intent(out)   :: wf, wfhe4, wfhe3, wfm, wfx
    real(r8), intent(out)   :: kin, pot, ene, erot, eimp
    integer(4), intent(out) :: signoup, signodw
    real(r8), intent(out)   :: dwf(3, NATOM_MAX), dphi(2)

    if (d_libre) then
      wf=1.0_r8; wfhe4=1.0_r8; wfhe3=1.0_r8; wfm=1.0_r8; wfx=1.0_r8
      kin=0.0_r8; pot=0.0_r8; ene=0.0_r8; erot=0.0_r8; eimp=0.0_r8
      signoup=1; signodw=1
      dwf=0.0_r8; dphi=0.0_r8
      return
    endif
  call derananum_d(atom, sprop, b_val, hb2m, &
          wf, wfhe4, wfhe3, wfm, wfx, kin, erot, eimp, &
          signoup, signodw, dwf, dphi)
    call vpot_d(atom, sprop, pot)
    ene = kin + pot
  end subroutine hpsi_d

  !===========================================================================
  ! DMC2_D: paso DMC para walker iw (equivalente a dmc2 de msteps.f90)
  ! Lee datos del SOA de device, ejecuta el paso y escribe resultados.
  !===========================================================================
  attributes(device) subroutine dmc2_d(iw)
    integer(4), value :: iw
    ! Arrays locales del walker
    real(r8) :: atom(3, NATOM_MAX), dwf(3, NATOM_MAX)
    real(r8) :: delta(NATOM_MAX), hb2m(NATOM_MAX)
    real(r8) :: sigma1(NATOM_MAX), sigma2(NATOM_MAX)
    real(r8) :: sprop(3, 3), dphi(2)
    real(r8) :: sig1rot, sig2rot, sig1hrot, sig2hrot, b_val
    real(r8) :: wf, wfhe4, wfhe3, wfm, wfx
    real(r8) :: kin, pot, ene, erot, eimp
    integer(4) :: signoup, signodw
    ! Temporales
    real(r8) :: gvar3(3), rt(3), eold, wfold, wftest, gb
    real(r8) :: phix1, phiy, phix2
    integer(4) :: iatom, ic, supold, sdwold, nsons

    ! --- Leer walker desde SOA ---
    do iatom = 1, d_natom
      atom(:, iatom)   = d_soa_atom(:, iatom, iw)
      dwf(:, iatom)    = d_soa_dwf(:, iatom, iw)
      delta(iatom)     = d_soa_delta(iatom, iw)
      hb2m(iatom)      = d_soa_hb2m(iatom, iw)
      sigma1(iatom)    = d_soa_sigma1(iatom, iw)
      sigma2(iatom)    = d_soa_sigma2(iatom, iw)
    enddo
    do ic = 1, 3
      sprop(:, ic) = d_soa_sprop(:, ic, iw)
    enddo
    dphi      = d_soa_dphi(:, iw)
    sig1rot   = d_soa_sig1rot(iw)
    sig2rot   = d_soa_sig2rot(iw)
    sig1hrot  = d_soa_sig1hrot(iw)
    sig2hrot  = d_soa_sig2hrot(iw)
    b_val     = d_soa_b(iw)
    wf        = d_soa_wf(iw)
    wfhe4     = d_soa_wfhe4(iw)
    wfhe3     = d_soa_wfhe3(iw)
    wfm       = d_soa_wfm(iw)
    wfx       = d_soa_wfx(iw)
    kin       = d_soa_kin(iw)
    pot       = d_soa_pot(iw)
    ene       = d_soa_ene(iw)
    erot      = d_soa_erot(iw)
    eimp      = d_soa_eimp(iw)
    signoup   = d_soa_signoup(iw)
    signodw   = d_soa_signodw(iw)

    nsons  = 0
    eold   = ene
    wfold  = wf
    supold = signoup
    sdwold = signodw

    ! === Primer medio paso de difusion ===
    do iatom = 1, d_ncmtras
      call gauss3_d(iw, gvar3)
      rt = sigma1(iatom)*gvar3 + 0.5_r8*sigma2(iatom)*dwf(:, iatom)
      atom(:, iatom) = atom(:, iatom) + rt
    enddo

    if (d_rotamol) then
      call gauss3_d(iw, gvar3)
      phix1 = sig1hrot*gvar3(1) + 0.5_r8*sig2hrot*dphi(1)
      phiy  = sig1rot *gvar3(2) + 0.5_r8*sig2rot *dphi(2)
      phix2 = sig1hrot*gvar3(3) + 0.5_r8*sig2hrot*dphi(1)
      call rota_d(1, phix1, sprop)
      call rota_d(2, phiy,  sprop)
      call rota_d(1, phix2, sprop)
    endif

    ! === Primera evaluacion de hpsi ===
    call hpsi_d(atom, sprop, b_val, hb2m, &
         wf, wfhe4, wfhe3, wfm, wfx, &
         kin, pot, ene, erot, eimp,   &
         signoup, signodw, dwf, dphi)

    print *, "DEBUG GPU: Kin=", kin, " Pot=", pot, " Ene=", ene
    

    if (supold /= signoup .or. sdwold /= signodw) then
      d_soa_nsons(iw) = 0;  return
    endif
    wftest = (wf / wfold)**2
    if (wftest < d_ratio .and. rn1_d(iw) > wftest/d_ratio) then
      d_soa_nsons(iw) = 0;  return
    endif

    ! === Segundo medio paso de difusion ===
    do iatom = 1, d_ncmtras
      rt = 0.5_r8 * sigma2(iatom) * dwf(:, iatom)
      atom(:, iatom) = atom(:, iatom) + rt
    enddo

    if (d_rotamol) then
      phix1 = 0.5_r8 * sig2hrot * dphi(1)
      phiy  = 0.5_r8 * sig2rot  * dphi(2)
      phix2 = 0.5_r8 * sig2hrot * dphi(1)
      call rota_d(1, phix1, sprop)
      call rota_d(2, phiy,  sprop)
      call rota_d(1, phix2, sprop)
    endif

    ! === Segunda evaluacion de hpsi ===
    call hpsi_d(atom, sprop, b_val, hb2m, &
         wf, wfhe4, wfhe3, wfm, wfx, &
         kin, pot, ene, erot, eimp,   &
         signoup, signodw, dwf, dphi)

    if (supold /= signoup .or. sdwold /= signodw) then
      d_soa_nsons(iw) = 0;  return
    endif
    wftest = (wf / wfold)**2
    if (wftest < d_ratio .and. rn1_d(iw) > wftest/d_ratio) then
      d_soa_nsons(iw) = 0;  return
    endif

    ! === Ramificacion (branching) ===
    gb    = exp(-(0.5_r8*(eold + ene) - d_etrial) * d_dtau)
    nsons = int(gb + rn1_d(iw))
    if (nsons > 10) nsons = 0

    ! --- Escribir resultados al SOA ---
    do iatom = 1, d_natom
      d_soa_atom(:, iatom, iw) = atom(:, iatom)
      d_soa_dwf(:, iatom, iw)  = dwf(:, iatom)
    enddo
    do ic = 1, 3
      d_soa_sprop(:, ic, iw) = sprop(:, ic)
    enddo
    d_soa_dphi(:, iw)  = dphi
    d_soa_wf(iw)       = wf
    d_soa_wfhe4(iw)    = wfhe4
    d_soa_wfhe3(iw)    = wfhe3
    d_soa_wfm(iw)      = wfm
    d_soa_wfx(iw)      = wfx
    d_soa_kin(iw)      = kin
    d_soa_pot(iw)      = pot
    d_soa_ene(iw)      = ene
    d_soa_erot(iw)     = erot
    d_soa_eimp(iw)     = eimp
    d_soa_signoup(iw)  = signoup
    d_soa_signodw(iw)  = signodw
    d_soa_nsons(iw)    = nsons
  end subroutine dmc2_d

  !===========================================================================
  ! KERNEL GLOBAL: un hilo por walker
  !===========================================================================
  attributes(global) subroutine dmc2_gpu_kernel(nwpaso, natom_arg)
    integer(4), value :: nwpaso, natom_arg
    integer(4) :: iw

    iw = (blockIdx%x - 1) * blockDim%x + threadIdx%x
    if (iw > nwpaso) return

    call dmc2_d(iw)
  end subroutine dmc2_gpu_kernel

end module dmc_gpu
