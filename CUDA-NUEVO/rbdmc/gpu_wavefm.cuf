! ============================================================
! gpu_wavefm.cuf
!
! Módulo CUDA Fortran para el cálculo de wavefm en GPU.
!
! Contenido:
!   - walkers_soa : tipo SOA con layout (nw, na) coalescente
!   - init_soa / free_soa : gestión de memoria
!   - walkers_to_soa / soa_to_walkers_wfm : conversión AOS<->SOA
!     (usa tipos walker de mtipos y variables de mparametros)
!   - array_to_soa / soa_to_array_wfm : conversión desde arrays
!     simples (sin depender del tipo walker; para testing)
!   - wavefm_cpu_soa : implementación CPU de referencia en SOA
!   - wavefm_kernel  : kernel CUDA (un hilo = un walker)
!   - wavefm_gpu     : wrapper host que lanza el kernel
!     (FASE 2: no se llama desde mwavef.f90 todavía)
!
! NOTA SOBRE LAYOUT SOA:
!   x(iw, ia), y(iw, ia), z(iw, ia)   con iw=walker, ia=átomo
!   El índice walker es el PRIMERO (más rápido en Fortran).
!   Así, cuando todos los hilos de un warp acceden al mismo
!   átomo ia, sus posiciones de memoria son contiguas -> acceso
!   coalescente en GPU.
!   (dmc_gpu.cuf usa (3,na,nw) por coherencia con el walker SOA
!    completo; aquí se prioriza la coalescencia para wavefm.)
!
! FASES:
!   Fase 1 (actual):
!     gpu_wavefm.o se compila e incluye en el ejecutable, pero
!     mwavef.f90 sigue usando el bucle CPU en wavefm().
!     Prueba: make -f Makefile.cuda test_wavefm_gpu
!
!   Fase 2 (futura):
!     En mwavef.f90:wavefm(), sustituir el bucle sobre átomos
!     por una llamada a wavefm_gpu.
!     Ver comentario "FASE 2" en wavefm_gpu y en el test.
! ============================================================

module gpu_wavefm

  use cudafor
  use mtipos
  use mparametros

  implicit none

  integer, private, parameter :: i4 = selected_int_kind(9)
  integer, private, parameter :: r8 = selected_real_kind(15,9)

  ! ----------------------------------------------------------
  ! Tipo SOA (Structure of Arrays) para un batch de walkers.
  !
  ! Índices: x(iw, ia)
  !   iw  walker index   1..nw   -> dimensión RÁPIDA (contigua)
  !   ia  atom index     1..na   -> dimensión LENTA
  !
  ! Beneficio GPU: al acceder x(iw, ia) con ia fijo y todos los
  ! hilos de un warp usando iw consecutivos, los accesos son
  ! a posiciones adyacentes en memoria (coalescentes).
  ! ----------------------------------------------------------
  type, public :: walkers_soa
    real(r8), allocatable :: x(:,:)     ! (nw, na)
    real(r8), allocatable :: y(:,:)
    real(r8), allocatable :: z(:,:)
    real(r8), allocatable :: wfm(:)     ! (nw)
    integer(i4) :: nw = 0
    integer(i4) :: na = 0
  end type walkers_soa

contains

  ! ----------------------------------------------------------
  ! Alloca el SOA en memoria del host.
  ! ----------------------------------------------------------
  subroutine init_soa(soa, nw, na)
    type(walkers_soa), intent(inout) :: soa
    integer(i4),       intent(in)    :: nw, na

    call free_soa(soa)
    soa%nw = nw
    soa%na = na
    allocate(soa%x(nw, na), soa%y(nw, na), soa%z(nw, na), soa%wfm(nw))
    soa%wfm = 0.0_r8
  end subroutine init_soa

  ! ----------------------------------------------------------
  ! Libera la memoria del SOA.
  ! ----------------------------------------------------------
  subroutine free_soa(soa)
    type(walkers_soa), intent(inout) :: soa

    if (allocated(soa%x))   deallocate(soa%x, soa%y, soa%z)
    if (allocated(soa%wfm)) deallocate(soa%wfm)
    soa%nw = 0
    soa%na = 0
  end subroutine free_soa

  ! ----------------------------------------------------------
  ! AOS -> SOA: convierte un array de walker (tipo walker de
  ! mtipos) al layout SOA.
  ! Usa natom de mparametros.
  !
  ! Conversión:
  !   soa%x(iw, ia) <- w(iw)%atom(ia)%comp(1)
  ! ----------------------------------------------------------
  subroutine walkers_to_soa(w, nw, soa)
    type(walker),      intent(in)    :: w(nw)
    integer(i4),       intent(in)    :: nw
    type(walkers_soa), intent(inout) :: soa
    integer(i4) :: iw, ia

    call init_soa(soa, nw, natom)
    do iw = 1, nw
      do ia = 1, natom
        soa%x(iw, ia) = w(iw)%atom(ia)%comp(1)
        soa%y(iw, ia) = w(iw)%atom(ia)%comp(2)
        soa%z(iw, ia) = w(iw)%atom(ia)%comp(3)
      enddo
    enddo
  end subroutine walkers_to_soa

  ! ----------------------------------------------------------
  ! SOA -> AOS: copia el campo wfm de vuelta a los walkers.
  ! Conversión: w(iw)%lw%wfm <- soa%wfm(iw)
  ! (w%lw%wfm es real(r16); se convierte implícitamente)
  ! ----------------------------------------------------------
  subroutine soa_to_walkers_wfm(soa, w, nw)
    type(walkers_soa), intent(in)    :: soa
    type(walker),      intent(inout) :: w(nw)
    integer(i4),       intent(in)    :: nw
    integer(i4) :: iw

    do iw = 1, nw
      w(iw)%lw%wfm = soa%wfm(iw)
    enddo
  end subroutine soa_to_walkers_wfm

  ! ----------------------------------------------------------
  ! AOS -> SOA desde arrays simples (sin tipo walker).
  ! Para testing: atom_x(ia, iw) -> soa%x(iw, ia)
  ! ----------------------------------------------------------
  subroutine array_to_soa(atom_x, atom_y, atom_z, nw, na, soa)
    integer(i4), intent(in)    :: nw, na
    real(r8),    intent(in)    :: atom_x(na, nw), atom_y(na, nw), atom_z(na, nw)
    type(walkers_soa), intent(inout) :: soa
    integer(i4) :: iw, ia

    call init_soa(soa, nw, na)
    do iw = 1, nw
      do ia = 1, na
        soa%x(iw, ia) = atom_x(ia, iw)
        soa%y(iw, ia) = atom_y(ia, iw)
        soa%z(iw, ia) = atom_z(ia, iw)
      enddo
    enddo
  end subroutine array_to_soa

  ! ----------------------------------------------------------
  ! SOA -> array simple (solo wfm), sin tipo walker.
  ! ----------------------------------------------------------
  subroutine soa_to_array_wfm(soa, wfm_out)
    type(walkers_soa), intent(in)  :: soa
    real(r8),          intent(out) :: wfm_out(soa%nw)

    wfm_out(1:soa%nw) = soa%wfm(1:soa%nw)
  end subroutine soa_to_array_wfm

  ! ----------------------------------------------------------
  ! Implementación CPU de wavefm en layout SOA.
  ! Sirve de referencia para verificar el kernel GPU.
  !
  ! Calcula para cada walker iw:
  !   ujas = sum_{i<nhe4, j=nhe4+1..ngatom} [
  !              -pmix(1)/rij^pmix(2) - pmix(3)*rij ]
  !   wfm(iw) = exp(ujas)
  ! ----------------------------------------------------------
  subroutine wavefm_cpu_soa(soa, pmix, nhe4, ngatom)
    type(walkers_soa), intent(inout) :: soa
    real(r8),          intent(in)    :: pmix(3)
    integer(i4),       intent(in)    :: nhe4, ngatom
    integer(i4) :: iw, i, j
    real(r8) :: dx, dy, dz, ujas, rij

    do iw = 1, soa%nw
      ujas = 0.0_r8
      do i = 1, nhe4
        do j = nhe4 + 1, ngatom
          dx  = soa%x(iw, i) - soa%x(iw, j)
          dy  = soa%y(iw, i) - soa%y(iw, j)
          dz  = soa%z(iw, i) - soa%z(iw, j)
          rij = sqrt(dx*dx + dy*dy + dz*dz)
          ujas = ujas - pmix(1)/rij**pmix(2) - pmix(3)*rij
        enddo
      enddo
      soa%wfm(iw) = exp(ujas)
    enddo
  end subroutine wavefm_cpu_soa

  ! ----------------------------------------------------------
  ! Kernel CUDA: wavefm para un batch de walkers.
  !
  ! Paralelismo: un hilo = un walker completo.
  ! Cada hilo iw itera sobre todos los pares (He4, He3)
  ! y acumula la suma del exponente de Jastrow.
  !
  ! Argumentos device:
  !   x, y, z   (nw, na) coordenadas SOA
  !   wfm       (nw)     salida
  !   pmix      (3)      parámetros Jastrow He4-He3
  !   nhe4      número de átomos He4 (índices 1..nhe4)
  !   ngatom    número total He4+He3 (índices nhe4+1..ngatom)
  !   nw        número de walkers
  !   na        número de átomos (dimensión de x, y, z)
  !
  ! Acceso coalescente: x(iw, ia) con iw = threadIdx en el warp
  !   -> threads 1,2,...,warp acceden a posiciones contiguas.
  ! ----------------------------------------------------------
  attributes(global) subroutine wavefm_kernel(x, y, z, wfm, pmix, &
                                               nhe4, ngatom, nw, na)
    implicit none
    integer,  value, intent(in) :: nhe4, ngatom, nw, na
    real(r8), device, intent(in)  :: x(nw, na), y(nw, na), z(nw, na)
    real(r8), device, intent(out) :: wfm(nw)
    real(r8), device, intent(in)  :: pmix(3)

    integer  :: iw, i, j
    real(r8) :: dx, dy, dz, ujas, rij

    iw = (blockIdx%x - 1) * blockDim%x + threadIdx%x
    if (iw > nw) return

    ujas = 0.0_r8
    do i = 1, nhe4
      do j = nhe4 + 1, ngatom
        dx  = x(iw, i) - x(iw, j)
        dy  = y(iw, i) - y(iw, j)
        dz  = z(iw, i) - z(iw, j)
        rij = sqrt(dx*dx + dy*dy + dz*dz)
        ujas = ujas - pmix(1)/rij**pmix(2) - pmix(3)*rij
      enddo
    enddo
    wfm(iw) = exp(ujas)
  end subroutine wavefm_kernel

  ! ----------------------------------------------------------
  ! Wrapper host: copia datos a GPU, lanza kernel, recupera wfm.
  !
  ! NOTA FASE 2:
  !   Esta subrutina se llamará desde mwavef.f90:wavefm()
  !   cuando se active el soporte GPU.
  !   De momento NO SE LLAMA desde ningún módulo del código.
  !
  ! Patrón de integración futura (en mwavef.f90:wavefm o su
  ! llamador en msteps.f90/mmontecarlo.f90):
  !
  !   use gpu_wavefm
  !   type(walkers_soa) :: soa_g
  !   ...
  !   call walkers_to_soa(walkers, nw, soa_g)
  !   call wavefm_gpu(soa_g, pmix, nhe4, ngatom)
  !   call soa_to_walkers_wfm(soa_g, walkers, nw)
  ! ----------------------------------------------------------
  subroutine wavefm_gpu(soa, pmix, nhe4, ngatom)
    type(walkers_soa), intent(inout) :: soa
    real(r8),          intent(in)    :: pmix(3)
    integer(i4),       intent(in)    :: nhe4, ngatom

    real(r8), device, allocatable :: d_x(:,:), d_y(:,:), d_z(:,:)
    real(r8), device, allocatable :: d_wfm(:), d_pmix(:)
    integer :: nw, na, nblocks, tpb, istat

    nw  = soa%nw
    na  = soa%na
    tpb    = 256
    nblocks = (nw + tpb - 1) / tpb

    allocate(d_x(nw, na), d_y(nw, na), d_z(nw, na), d_wfm(nw), d_pmix(3))

    d_x    = soa%x
    d_y    = soa%y
    d_z    = soa%z
    d_pmix = pmix

    call wavefm_kernel<<<nblocks, tpb>>>(d_x, d_y, d_z, d_wfm, d_pmix, &
                                          int(nhe4, 4), int(ngatom, 4), &
                                          nw, na)
    istat = cudaDeviceSynchronize()

    soa%wfm(1:nw) = d_wfm(1:nw)

    deallocate(d_x, d_y, d_z, d_wfm, d_pmix)
  end subroutine wavefm_gpu

end module gpu_wavefm
