# Makefile2.mpi
# Compila el código original (mtipos.f90 y mwavef.f90 sin modificar).
# Usa mpif90 del sistema con gfortran como backend (OMPI_FC=gfortran).
# gfortran soporta real(16) (__float128) por lo que
# selected_real_kind(30) devuelve 16, como espera el código original.
# nvfortran 24.1 NO soporta real(16), por eso hace falta gfortran aquí.

export OMPI_FC = gfortran
FC      = mpif90
FFLAGS  = -O2
MPILIBS = -lmpi
LDFLAGS = -llapack -lblas


.SUFFIXES:
.SUFFIXES: .f90 .f .o

.f90.o:
	$(FC) $(FFLAGS) -c $<

.f.o:
	$(FC) $(FFLAGS) -c $<

OBJECTS=\
 qmccluster.o\
 mmontecarlo.o\
 mminimiza.o\
 mentradatos.o\
 mconfiguraciones.o\
 mparametros.o\
 mrandom.o\
 mrandom2.o\
 mtipos.o\
 mdensidades.o\
 msteps.o\
 mwavef.o\
 mangwavef.o\
 mimagina.o\
 mrotaciones.o\
 msistref.o\
 mvaziz.o\
 mvmolecula.o\
 mmcvpromedia.o\
 mdmcpromedia.o\
 bh_heh2m.o\
 pw_heocs.o\
 mhh_heocs.o\
 mkp_heco.o\
 kpcoef.o\
 mlineal.o\
 mlegendre.o\
 modlegendre.o\

qmccluster: $(OBJECTS) mmpi.o
	$(FC) $(FFLAGS) -o $@ $^ $(LDFLAGS) $(MPILIBS)

clean:
	rm -f qmccluster *\.o *\.d work.pc work.pcl tags *\.mod

qmccluster.o: qmccluster.f90 mmontecarlo.o mminimiza.o mentradatos.o mparametros.o mmpi.o

mmontecarlo.o: mmontecarlo.f90 mparametros.o mconfiguraciones.o mtipos.o msteps.o mwavef.o msistref.o mkp_heco.o mdensidades.o mimagina.o mmcvpromedia.o mdmcpromedia.o mrandom.o mmpi.o

mminimiza.o: mminimiza.f90 mmontecarlo.o mentradatos.o mparametros.o mmpi.o

msteps.o: msteps.f90 mparametros.o mtipos.o mrandom.o mwavef.o mrotaciones.o mmcvpromedia.o

mwavef.o: mwavef.f90 mparametros.o mtipos.o mangwavef.o mrotaciones.o msistref.o mvaziz.o mvmolecula.o bh_heh2m.o mlineal.o

mangwavef.o: mangwavef.f90 mparametros.o mtipos.o mlegendre.o

mimagina.o: mimagina.f90 mtipos.o mlegendre.o

mrotaciones.o: mrotaciones.f90 mtipos.o

msistref.o: msistref.f90 mparametros.o mtipos.o

mmcvpromedia.o: mmcvpromedia.f90 mtipos.o mdensidades.o

mdmcpromedia.o: mdmcpromedia.f90 mtipos.o

mdensidades.o: mdensidades.f90 msistref.o mparametros.o mtipos.o

mentradatos.o: mentradatos.f90 mparametros.o mvaziz.o bh_heh2m.o pw_heocs.o mhh_heocs.o mkp_heco.o mrandom.o

mconfiguraciones.o: mconfiguraciones.f90 mrandom.o

mparametros.o: mparametros.f90

mrandom.o: mrandom.f90 mrandom2.o

mrandom2.o: mrandom2.f90

mtipos.o: mtipos.f90

mvaziz.o: mvaziz.f90

mvmolecula.o: mvmolecula.f90 bh_heh2m.o pw_heocs.o mhh_heocs.o mkp_heco.o

bh_heh2m.o: bh_heh2m.f

pw_heocs.o: pw_heocs.f

mhh_heocs.o: mhh_heocs.f90 modlegendre.o

mkp_heco.o: mkp_heco.f90 kpcoef.o

kpcoef.o: kpcoef.f
	$(FC) $(FFLAGS) -c $< $(LDFLAGS)

mlineal.o: mlineal.f90

mlegendre.o: mlegendre.f90

modlegendre.o: modlegendre.f

mmpi.o: mmpi.f90 mtipos.o mrandom.o mrandom2.o mvaziz.o mvmolecula.o mparametros.o
	$(FC) $(FFLAGS) -c $< $(MPILIBS)
