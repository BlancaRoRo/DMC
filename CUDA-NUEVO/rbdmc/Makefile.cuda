# Makefile.cuda
# Compilación CUDA Fortran + MPI para qmccluster
# Usa nvfortran (NVIDIA HPC SDK) como compilador base.
#
# Uso:
#   make -f Makefile.cuda              -> ejecutable qmccluster (Fase 1)
#   make -f Makefile.cuda test_wavefm_gpu -> test standalone wavefm
#   make -f Makefile.cuda clean_cuda
#
# FASES:
#   Fase 1: gpu_wavefm.cuf se compila e incluye en el ejecutable,
#           pero mwavef.f90 sigue usando el bucle CPU. Verificar que
#           el binario tiene el mismo comportamiento que antes.
#   Fase 2: Añadir llamadas GPU en mwavef.f90 y recompilar.

# --- Rutas y arquitectura -------------------------------------------
CUDA_HOME = /opt/nvidia/hpc_sdk/Linux_x86_64/24.1/cuda
GPUARCH   = cc89
# Ajustar GPUARCH según tu GPU:
#   cc86 = RTX 30xx/A-series   cc80 = A100   cc89 = RTX 4xxx/Ada
#   cc90 = H100

# --- Compilador -----------------------------------------------------
# Usar el mpif90 del NVIDIA HPC SDK, que envuelve nvfortran con una
# versión de OpenMPI compilada con nvfortran.
# El mpif90 del sistema (/usr/bin/mpif90) usa módulos MPI compilados
# con gfortran, que nvfortran en modo -cuda no puede leer.
NVMPI_BIN = /opt/nvidia/hpc_sdk/Linux_x86_64/24.1/comm_libs/openmpi4/bin
NVMPI_LIB = /opt/nvidia/hpc_sdk/Linux_x86_64/24.1/comm_libs/12.3/openmpi4/openmpi-4.1.5/lib
FC = $(NVMPI_BIN)/mpif90

# --- Flags ----------------------------------------------------------
FFLAGS   = -O2 -tp=native -cuda -gpu=$(GPUARCH)
# Para ver info de registros/spilling:
#   FFLAGS = -O2 -tp=native -cuda -gpu=$(GPUARCH) -Minfo=accel
# Para depuración:
#   FFLAGS = -O0 -g -cuda -gpu=$(GPUARCH) -Minfo=accel

CUDALIBS = -L$(CUDA_HOME)/lib64 -lcudart
MPILIBS  = -L$(NVMPI_LIB) -lmpi
LDFLAGS  = -llapack -lblas

# --- Reglas de sufijo -----------------------------------------------
.SUFFIXES:
.SUFFIXES: .f90 .f .cuf .o

.f90.o:
	$(FC) $(FFLAGS) -c $<

.f.o:
	$(FC) $(FFLAGS) -c $<

.cuf.o:
	$(FC) $(FFLAGS) -c $<

# --- Lista de objetos -----------------------------------------------
OBJECTS = \
 qmccluster.o    \
 mmontecarlo.o   \
 mminimiza.o     \
 mentradatos.o   \
 mconfiguraciones.o \
 mparametros.o   \
 mrandom.o       \
 mrandom2.o      \
 mtipos.o        \
 mdensidades.o   \
 msteps.o        \
 mwavef.o        \
 mangwavef.o     \
 mimagina.o      \
 mrotaciones.o   \
 msistref.o      \
 mvaziz.o        \
 mvmolecula.o    \
 mmcvpromedia.o  \
 mdmcpromedia.o  \
 bh_heh2m.o      \
 pw_heocs.o      \
 mhh_heocs.o     \
 mkp_heco.o      \
 kpcoef.o        \
 mlineal.o       \
 mlegendre.o     \
 modlegendre.o   \
 gpu_wavefm.o

# --- Ejecutable principal -------------------------------------------
# Fase 1: gpu_wavefm.o enlazado pero sin llamadas GPU desde mwavef.f90
qmccluster: $(OBJECTS) mmpi.o
	$(FC) $(FFLAGS) -o $@ $^ $(LDFLAGS) $(MPILIBS) $(CUDALIBS)

# --- Test: CPU wavefm (mwavef.f90) vs GPU wavefm_gpu -----------------
# Compila mwavef y todas sus dependencias para poder llamar a
# wavefm(w1) y comparar con wavefm_gpu sobre los mismos datos.
MWAVEF_DEPS = mangwavef.o mrotaciones.o msistref.o mvaziz.o \
              mvmolecula.o bh_heh2m.o pw_heocs.o mhh_heocs.o \
              modlegendre.o mkp_heco.o kpcoef.o mlineal.o mlegendre.o

test_wavefm_gpu: mparametros.o mtipos.o gpu_wavefm.o mwavef.o \
                 $(MWAVEF_DEPS) test_wavefm_gpu.o
	$(FC) $(FFLAGS) -o $@ $^ $(LDFLAGS) $(CUDALIBS)

test_wavefm_gpu.o: test_wavefm_gpu.f90 gpu_wavefm.o mwavef.o
	$(FC) $(FFLAGS) -c $<

# --- Limpieza -------------------------------------------------------
clean_cuda:
	rm -f qmccluster test_wavefm_gpu *.o *.d *.mod work.pc work.pcl

# ====================================================================
# Dependencias
# ====================================================================

# --- Módulos base (sin GPU) -----------------------------------------
mparametros.o: mparametros.f90

mrandom2.o: mrandom2.f90

mrandom.o: mrandom.f90 mrandom2.o

mtipos.o: mtipos.f90

mvaziz.o: mvaziz.f90

mlineal.o: mlineal.f90

mlegendre.o: mlegendre.f90

modlegendre.o: modlegendre.f

bh_heh2m.o: bh_heh2m.f

pw_heocs.o: pw_heocs.f

kpcoef.o: kpcoef.f
	$(FC) $(FFLAGS) -c $< $(LDFLAGS)

mrotaciones.o: mrotaciones.f90 mtipos.o

msistref.o: msistref.f90 mparametros.o mtipos.o

mangwavef.o: mangwavef.f90 mparametros.o mtipos.o mlegendre.o

mimagina.o: mimagina.f90 mtipos.o mlegendre.o

mvmolecula.o: mvmolecula.f90 pw_heocs.o mhh_heocs.o mkp_heco.o

mhh_heocs.o: mhh_heocs.f90 modlegendre.o

mkp_heco.o: mkp_heco.f90 kpcoef.o

mmcvpromedia.o: mmcvpromedia.f90 mtipos.o mdensidades.o

mdmcpromedia.o: mdmcpromedia.f90 mtipos.o

mdensidades.o: mdensidades.f90 msistref.o mparametros.o mtipos.o

mentradatos.o: mentradatos.f90 mparametros.o mvaziz.o bh_heh2m.o \
               pw_heocs.o mhh_heocs.o mkp_heco.o mrandom.o

mconfiguraciones.o: mconfiguraciones.f90 mrandom.o

# --- Módulo GPU wavefm ----------------------------------------------
# Depende de mparametros y mtipos por walkers_to_soa/soa_to_walkers_wfm
gpu_wavefm.o: gpu_wavefm.cuf mparametros.o mtipos.o
	$(FC) $(FFLAGS) -c $<

# --- Módulos que usan ondas y GPU -----------------------------------
# Fase 1: mwavef.f90 NO usa gpu_wavefm (sin llamadas GPU todavía)
# Fase 2: añadir gpu_wavefm.o a la dependencia de mwavef.o cuando
#         se integren las llamadas GPU
mwavef.o: mwavef.f90 mparametros.o mtipos.o mangwavef.o mrotaciones.o \
          msistref.o mvaziz.o mvmolecula.o bh_heh2m.o mlineal.o

msteps.o: msteps.f90 mparametros.o mtipos.o mrandom.o mwavef.o \
          mrotaciones.o mmcvpromedia.o

mmontecarlo.o: mmontecarlo.f90 mparametros.o mconfiguraciones.o mtipos.o \
               msteps.o mwavef.o msistref.o mkp_heco.o mdensidades.o    \
               mimagina.o mmcvpromedia.o mdmcpromedia.o mrandom.o mmpi.o

mminimiza.o: mminimiza.f90 mmontecarlo.o mentradatos.o mparametros.o mmpi.o

qmccluster.o: qmccluster.f90 mmontecarlo.o mminimiza.o mentradatos.o \
              mparametros.o mmpi.o

mmpi.o: mmpi.f90 mtipos.o mrandom.o mrandom2.o mvaziz.o mvmolecula.o mparametros.o
	$(FC) -I. $(FFLAGS) -c $< $(MPILIBS)
