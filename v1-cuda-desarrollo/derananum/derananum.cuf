! derananum.cuf
!
! Puerto CUDA Fortran de derananum/derwavefm/derwavefhe3 de
! mwavef.f90 (derananum: lineas 40-91; derwavefm: 230-261;
! derwavefhe3: 677-711). derananum calcula la energia cinetica de un
! walker a partir de las derivadas de las 4 partes de la funcion de
! onda (He4-He4, He3-He3, mezcla He4-He3, e impureza/molecula), mas
! las energias de impureza (eimp) y rotacion (erot) si aplica.
!
! derwavefm y derwavefhe3 son los "2 metodos no alcanzables por la
! configuracion" (nhe3=0 en este proyecto, igual que duhe3x/uhe3x en
! der_wavefx.cuf y wavefm/wavefhe3 en wavef.cuf): sus bucles relevantes
! (jhe3=1,nhe3 en derwavefm; ihe3=1,nhe3 en derwavefhe3) no ejecutan
! ninguna iteracion en la simulacion real, pero derananum los llama
! incondicionalmente, asi que el codigo tiene que existir y compilar
! igual -- mismo criterio ya aplicado y documentado en der_wavefx.md.
!
! Reutiliza en vez de redeclarar: wavefhe4/derwavefhe4 (der_wavefhe4),
! wavefx/derwavefx/nhe4/nhe3/ngatom/natom/impureza (der_wavefx),
! wavefhe3/wavefm/pmix (mwavef_gpu, wavef.cuf) -- todo ya portado y
! probado en kernels anteriores.

module mderananum
 use mtipos, only: vec3
 use der_wavefhe4, only: wavefhe4, derwavefhe4
 use der_wavefx, only: wavefx, derwavefx, nhe4, nhe3, ngatom, natom, impureza
 use mwavef_gpu, only: wavefhe3, wavefm, pmix
 ! rij**(pmix(2)+1): exponente REAL, mismo motivo que en wavefm
 ! (wavef.cuf) y el resto del arbol. Ver docs-kernels/glibc_math.md
 ! Parte 4.
 use glibc_pow_mod, only: mypow

 implicit none
 integer, private, parameter :: i4 = selected_int_kind(9)
 integer, private, parameter :: r8 = selected_real_kind(15,9)

 ! impurfija/rotamol: variables reales de mparametros.f90 (publicas,
 ! sin "parameter"), fijadas una vez al leer in.mcv -- mismo
 ! tratamiento que impureza en der_wavefx.
 logical, device :: impurfija, rotamol

contains

! ---- derwavefm: sin cambios de formula, w1%atom(:) -> atom(:). El
! bucle "jhe3=1,nhe3" (mezcla He4-He3) no ejecuta ninguna iteracion con
! nhe3=0 -- d1wf/d2wf quedan a 0 para todos los atomos en ese caso,
! igual que en el original. ----
attributes(host, device) subroutine derwavefm(atom, d1wf, d2wf)
  type(vec3), intent (in)  :: atom(ngatom)
  type(vec3), intent (out) :: d1wf(ngatom)
  real(kind=r8), intent (out) :: d2wf(ngatom)
  type(vec3) :: rtemp
  integer(kind=i4) :: iatom, jatom, jhe3
  real(kind=r8) :: ujasp, ujass, rij

   do iatom=1,ngatom
     d1wf(iatom)%comp(:)=0.0_r8
     d2wf(iatom)=0.0_r8
   enddo

   do iatom=1,nhe4
     do jhe3=1,nhe3
         jatom=nhe4+jhe3
         rtemp%comp=atom(iatom)%comp-atom(jatom)%comp
         rij=sqrt(dot_product(rtemp%comp,rtemp%comp))
         ujasp=pmix(1)*pmix(2)/mypow(rij,pmix(2)+1.0_r8)
         ujass=-(pmix(2)+1)*ujasp/rij
         ujasp=(ujasp-pmix(3))/rij
         d1wf(iatom)%comp(:)=d1wf(iatom)%comp(:)+ujasp*rtemp%comp(:)
         d1wf(jatom)%comp(:)=d1wf(jatom)%comp(:)-ujasp*rtemp%comp(:)
         d2wf(iatom)=d2wf(iatom)+ujass
         d2wf(iatom)=d2wf(iatom)+2.0_r8*ujasp
         d2wf(jatom)=d2wf(jatom)+ujass
         d2wf(jatom)=d2wf(jatom)+2.0_r8*ujasp
     enddo
   enddo
   do iatom=1,ngatom
     d2wf(iatom)=d2wf(iatom)+dot_product(d1wf(iatom)%comp,d1wf(iatom)%comp)
   enddo

end subroutine derwavefm

! ---- derwavefhe3: derivada NUMERICA (diferencias finitas centradas)
! de wavefhe3 respecto a cada coordenada de cada atomo de He3. El
! original perturba w1%atom(iatom) temporalmente y lo restaura al
! salir, ademas de restaurar w1%lw%wfhe3 (que wavefhe3(w1) sobreescribe
! como efecto secundario en cada llamada). Aqui, al usar la version ya
! portada wavefhe3(atom,wfhe3) -- que devuelve el resultado en una
! variable local, sin tocar ningun estado externo -- la restauracion
! de wfhe3 ya no hace falta: no hay nada que ensuciar. Solo se
! mantiene la restauracion de atom(iatom), que SI hace falta (las
! llamadas siguientes de derananum vuelven a usar atom). El bucle
! "ihe3=1,nhe3" no ejecuta ninguna iteracion con nhe3=0 -- d1wf/d2wf
! son arrays de tamano nhe3 (vacios en ese caso). ----
attributes(host, device) subroutine derwavefhe3(atom, wfhe3_0, d1wf, d2wf)
  type(vec3), intent (inout) :: atom(natom)
  real(kind=r8), intent (in) :: wfhe3_0
  type(vec3), intent (out) :: d1wf(nhe3)
  real(kind=r8), intent (out) :: d2wf(nhe3)
  type(vec3) :: rtemp
  real(kind=r8) :: wfmas, wfmen, dend1, dend2
  real(kind=r8) :: sumd2
  integer(kind=i4) :: ihe3, iatom, ic
  real(kind=r8), parameter :: dx=1.d-3

   dend1=2.0_r8*dx*wfhe3_0
   dend2=dx**2*wfhe3_0

   do ihe3=1,nhe3
     iatom=nhe4+ihe3
     rtemp%comp=atom(iatom)%comp
     sumd2=0.0_r8
     do ic=1,3
       atom(iatom)%comp(ic)=rtemp%comp(ic)+dx
       call wavefhe3(atom, wfmas)
       atom(iatom)%comp(ic)=rtemp%comp(ic)-dx
       call wavefhe3(atom, wfmen)
       atom(iatom)%comp(ic)=rtemp%comp(ic)
       d1wf(ihe3)%comp(ic)=(wfmas-wfmen)/dend1
       sumd2=sumd2+(wfmas+wfmen-2.0_r8*wfhe3_0)
     enddo
     d2wf(ihe3)=sumd2/dend2
   enddo

end subroutine derwavefhe3

! ---- derananum: la interfaz cambia de w1 a atom(natom)+sprop(3)+
! hb2m(natom)+b, igual que en derwavefx -- w1%hb2m (allocatable) y
! w1%b (escalar) son campos del walker que derananum necesita leer, asi
! que se extraen como argumentos. Devuelve wf/wfhe4/wfhe3/wfm/wfx
! ademas de kin/eimp/erot/dwf/dphi: el original los deja escritos en
! w1%lw%* via "call wavef(w1)" (que a su vez llama a wavefhe4/wavefhe3/
! wavefm/wavefx) -- aqui se calculan igual, con las versiones ya
! portadas, en vez de reconstruir wavef() entero (que solo devolvia el
! producto, no las 4 partes por separado). ----
attributes(host, device) subroutine derananum(atom, sprop, hb2m, b, &
                                               wf, wfhe4, wfhe3, wfm, wfx, &
                                               kin, eimp, erot, dwf, dphi)
  type(vec3), intent (inout) :: atom(natom)
  type(vec3), intent (in) :: sprop(3)
  real(kind=r8), intent (in) :: hb2m(natom)
  real(kind=r8), intent (in) :: b
  real(kind=r8), intent (out) :: wf, wfhe4, wfhe3, wfm, wfx
  real(kind=r8), intent (out) :: kin, eimp, erot
  type(vec3), intent (out) :: dwf(natom)
  real(kind=r8), intent (out) :: dphi(2)

  type(vec3) :: d1wfhe4(nhe4), d1wfhe3(nhe3), d1wfm(ngatom), d1wfx(natom)
  real(kind=r8) :: d2wfhe4(nhe4), d2wfhe3(nhe3), d2wfm(ngatom), d2wfx(natom)
  real(kind=r8) :: d1zwfx(2), d2zwfx
  real(kind=r8) :: der2
  integer(kind=i4) :: ihe3, iatom

   call wavefhe4(atom(1:nhe4), wfhe4)
   call wavefhe3(atom, wfhe3)
   call wavefm(atom(1:ngatom), wfm)
   call wavefx(atom, sprop(3), wfx)
   wf = wfhe4*wfhe3*wfm*wfx

   call derwavefhe4(atom(1:nhe4), d1wfhe4, d2wfhe4)
   call derwavefhe3(atom, wfhe3, d1wfhe3, d2wfhe3)
   call derwavefm(atom(1:ngatom), d1wfm, d2wfm)
   call derwavefx(atom, sprop, d1wfx, d2wfx, d1zwfx, d2zwfx)

   kin=0.0_r8
   do iatom=1,nhe4
     dwf(iatom)%comp=d1wfhe4(iatom)%comp+d1wfm(iatom)%comp+d1wfx(iatom)%comp
     der2=d2wfhe4(iatom)+d2wfm(iatom)+d2wfx(iatom)                        &
 &       +2.0_r8*dot_product(d1wfhe4(iatom)%comp,d1wfm(iatom)%comp)       &
 &       +2.0_r8*dot_product(d1wfhe4(iatom)%comp,d1wfx(iatom)%comp)       &
 &       +2.0_r8*dot_product(d1wfm(iatom)%comp,d1wfx(iatom)%comp)
     kin=kin-hb2m(iatom)*der2
   enddo

   do ihe3=1,nhe3
     iatom=nhe4+ihe3
     dwf(iatom)%comp=d1wfhe3(ihe3)%comp+d1wfm(iatom)%comp+d1wfx(iatom)%comp
     der2=d2wfhe3(ihe3)+d2wfm(iatom)+d2wfx(iatom)                         &
 &       +2.0_r8*dot_product(d1wfhe3(ihe3)%comp,d1wfm(iatom)%comp)        &
 &       +2.0_r8*dot_product(d1wfhe3(ihe3)%comp,d1wfx(iatom)%comp)        &
 &       +2.0_r8*dot_product(d1wfm(iatom)%comp,d1wfx(iatom)%comp)
     kin=kin-hb2m(iatom)*der2
   enddo

   if (.not. impurfija) then
     dwf(natom)%comp=d1wfx(natom)%comp
     kin=kin-hb2m(natom)*d2wfx(natom)
     eimp=-hb2m(natom)*d2wfx(natom)
   else
     eimp=0.0_r8
   endif
   if (rotamol) then
     dphi(:)=d1zwfx(:)
     kin=kin-b*d2zwfx
     erot=-b*d2zwfx
   else
     erot=0.0_r8
   endif

end subroutine derananum

! un hilo = un walker
attributes(global) subroutine k_derananum(n, atom, sprop, hb2m, b, &
                                           wf, wfhe4, wfhe3, wfm, wfx, &
                                           kin, eimp, erot, dwf, dphi)
 integer(kind=i4), value :: n
 type(vec3), device, intent (inout) :: atom(natom,n)
 type(vec3), device, intent (in) :: sprop(3,n)
 real(kind=r8), device, intent (in) :: hb2m(natom,n)
 real(kind=r8), device, intent (in) :: b(n)
 real(kind=r8), device, intent (out) :: wf(n), wfhe4(n), wfhe3(n), wfm(n), wfx(n)
 real(kind=r8), device, intent (out) :: kin(n), eimp(n), erot(n)
 type(vec3), device, intent (out) :: dwf(natom,n)
 real(kind=r8), device, intent (out) :: dphi(2,n)
 integer(kind=i4) :: i

  i = (blockIdx%x - 1) * blockDim%x + threadIdx%x
  if (i <= n) then
    call derananum(atom(:,i), sprop(:,i), hb2m(:,i), b(i), &
                    wf(i), wfhe4(i), wfhe3(i), wfm(i), wfx(i), &
                    kin(i), eimp(i), erot(i), dwf(:,i), dphi(:,i))
  endif
end subroutine k_derananum

end module mderananum


program test_derananum
 ! CPU de confianza: derananum de mwavef.f90 ORIGINAL, sin tocar
 ! (recibe el type(walker) completo, con w1%hb2m/w1%b incluidos).
 use mwavef, only: derananum_cpu => derananum
 use mtipos, only: vec3, walker, allocatewalker
 use mparametros, only: nhe4_real => nhe4, nhe3_real => nhe3, ngatom_real => ngatom, &
                         natom_real => natom, impureza_real => impureza, impurmol_real => impurmol, &
                         lxhe4_real => lxhe4, pxhe4_real => pxhe4, lxhe3_real => lxhe3, pxhe3_real => pxhe3, &
                         phe4_real => phe4, phe3_real => phe3, pmix_real => pmix, &
                         nhe3up_real => nhe3up, nhe3dw_real => nhe3dw, &
                         mhe4_real => mhe4, mhe3_real => mhe3, mx_real => mx, &
                         impurfija_real => impurfija, rotamol_real => rotamol
 use mwavef_gpu, only: pmix_dev => pmix, phe3, nhe3up, nhe3dw, mhe4, mhe3, mx
 use mderananum
 use d_uhex4, only: lxhe4, pxhe4, impurmol
 use der_wavefhe4, only: nhe4_he4 => nhe4, phe4
 use cudafor
 implicit none
 integer, parameter :: i4 = selected_int_kind(9)
 integer, parameter :: r8 = selected_real_kind(15,9)

 integer(kind=i4), parameter :: n_he4  = 4
 integer(kind=i4), parameter :: n_atom = n_he4 + 1
 integer(kind=i4), parameter :: n_walk = 5   ! 3 normales + 2 extremos (contacto/largo alcance)

 real(kind=r8), parameter :: bxhe4(0:4)    = (/ 1.680309d0, 0.000000d0, 3.033954d0, 0.000000d0, 0.732198d0 /)
 real(kind=r8), parameter :: nuxhe4(0:4)   = (/ 9.763290d0, 1.000000d0, 3.155952d0, 1.000000d0, 11.036848d0 /)
 real(kind=r8), parameter :: alfaxhe4(0:4) = (/ 0.643208d0, 0.000000d0, 0.004908d0, 0.000000d0, 0.078598d0 /)
 real(kind=r8), parameter :: p4xhe4(0:4)   = (/ 0.129298d0, 0.000000d0, 0.084248d0, 0.000000d0, 0.096948d0 /)
 real(kind=r8), parameter :: p5xhe4(0:4)   = (/ 13.568705d0, 0.000000d0, 0.000706d0, 0.000000d0, 0.020823d0 /)
 real(kind=r8), parameter :: bhe4 = 3.139383d0, nuhe4 = 4.725025d0, alfahe4 = 0.009428d0

 ! hb2he4/hb2x/brot: derivados de hb2=hbc**2/(2*umac2)*1.d-4/kb (constantes
 ! reales de mparametros.f90) con las masas/distancia reales de in.mcv
 ! (masa He4=4.00260, masa H=1.00782503210, d(H-H)=1.0588710), pasados a
 ! meV con k2mev_bh (igual que hace mentradatos.f90 para opot=4) --
 ! valores REALES, no inventados, aunque no se replique aqui la lectura
 ! completa de in.mcv.
 real(kind=r8), parameter :: hb2he4_real = 0.5219359033034199_r8
 real(kind=r8), parameter :: hb2x_real   = 1.036440145869973_r8
 real(kind=r8), parameter :: brot_real   = 3.6975845184944736_r8

 type(vec3) :: atom_h(n_atom,n_walk), sprop_h(3,n_walk)
 type(vec3), device :: atom_d(n_atom,n_walk), sprop_d(3,n_walk)
 real(kind=r8) :: hb2m_h(n_atom,n_walk), b_h(n_walk)
 real(kind=r8), device :: hb2m_d(n_atom,n_walk), b_d(n_walk)

 real(kind=r8) :: wf_cpu(n_walk), wfhe4_cpu(n_walk), wfhe3_cpu(n_walk), wfm_cpu(n_walk), wfx_cpu(n_walk)
 real(kind=r8) :: kin_cpu(n_walk), eimp_cpu(n_walk), erot_cpu(n_walk)
 type(vec3) :: dwf_cpu(n_atom,n_walk)
 real(kind=r8) :: dphi_cpu(2,n_walk)

 real(kind=r8) :: wf_h(n_walk), wfhe4_h(n_walk), wfhe3_h(n_walk), wfm_h(n_walk), wfx_h(n_walk)
 real(kind=r8) :: kin_h(n_walk), eimp_h(n_walk), erot_h(n_walk)
 type(vec3) :: dwf_h(n_atom,n_walk)
 real(kind=r8) :: dphi_h(2,n_walk)

 real(kind=r8), device :: wf_d(n_walk), wfhe4_d(n_walk), wfhe3_d(n_walk), wfm_d(n_walk), wfx_d(n_walk)
 real(kind=r8), device :: kin_d(n_walk), eimp_d(n_walk), erot_d(n_walk)
 type(vec3), device :: dwf_d(n_atom,n_walk)
 real(kind=r8), device :: dphi_d(2,n_walk)

 type(walker) :: w1
 integer(kind=i4) :: iw, ia, threads, blocks
 real(kind=r8) :: err, errmax

  ! ---- copias device (GPU), modulos ya portados ----
  nhe4 = n_he4
  nhe3 = 0
  ngatom = n_he4
  natom = n_atom
  impureza = .true.
  impurmol = .true.
  impurfija = .false.   ! impurtras=.T. en in.mcv real -> impurfija=.not.impurtras
  rotamol = .true.      ! "la impureza rota" = .T. en in.mcv real
  lxhe4 = 4
  do ia = 0, 4
    pxhe4(1,ia) = 0.50_r8*(bxhe4(ia)**nuxhe4(ia))
    pxhe4(2,ia) = nuxhe4(ia)
    pxhe4(3,ia) = alfaxhe4(ia)
    pxhe4(4,ia) = p4xhe4(ia)
    pxhe4(5,ia) = p5xhe4(ia)
  enddo

  nhe4_he4 = n_he4
  phe4(1) = 0.50_r8*(bhe4**nuhe4)
  phe4(2) = nuhe4
  phe4(3) = alfahe4

  ! phe3/pmix/nhe3up/nhe3dw/masas: con nhe3=0 no influyen en el
  ! resultado (wavefhe3/wavefm/derwavefhe3/derwavefm dan siempre 0/1),
  ! se fijan solo para que la comparacion con la CPU no dependa de
  ! basura sin inicializar -- mismo criterio que en wavef.cuf.
  phe3 = 0.0_r8
  pmix_dev(1) = 0.0_r8   ! "b mezclas"=0.0 en in.mcv real
  pmix_dev(2) = 1.0_r8   ! "nu mezclas"=1.0
  pmix_dev(3) = 0.0_r8   ! "alfa mezclas"=0.0
  nhe3up = 0
  nhe3dw = 0
  mhe4 = 4.00260_r8
  mhe3 = 3.01604_r8
  mx   = 2.01565006_r8

  ! ---- copias reales (CPU), mparametros.f90, para el derananum ORIGINAL ----
  nhe4_real = n_he4
  nhe3_real = 0
  ngatom_real = n_he4
  natom_real = n_atom
  impureza_real = .true.
  impurmol_real = .true.
  impurfija_real = .false.
  rotamol_real = .true.
  lxhe4_real = 4
  pxhe4_real(:,0:4) = pxhe4(:,0:4)
  lxhe3_real = 0
  pxhe3_real = 0.0_r8
  phe4_real = phe4
  phe3_real = phe3
  pmix_real = pmix_dev
  nhe3up_real = 0
  nhe3dw_real = 0
  mhe4_real = mhe4
  mhe3_real = mhe3
  mx_real   = mx

  atom_h(1,1)%comp = (/  0.0d0,  0.0d0,  0.0d0 /)
  atom_h(2,1)%comp = (/  3.5d0,  0.0d0,  0.0d0 /)
  atom_h(3,1)%comp = (/  0.0d0,  4.0d0,  1.0d0 /)
  atom_h(4,1)%comp = (/ -2.0d0, -3.0d0,  2.5d0 /)
  atom_h(5,1)%comp = (/  1.0d0,  1.0d0,  1.0d0 /)

  atom_h(1,2)%comp = (/  1.0d0,  1.0d0,  1.0d0 /)
  atom_h(2,2)%comp = (/ -1.0d0,  2.0d0,  0.5d0 /)
  atom_h(3,2)%comp = (/  2.5d0, -1.5d0,  3.0d0 /)
  atom_h(4,2)%comp = (/  0.0d0,  0.0d0, -4.0d0 /)
  atom_h(5,2)%comp = (/  0.5d0, -0.5d0,  0.5d0 /)

  atom_h(1,3)%comp = (/  5.0d0,  0.0d0,  0.0d0 /)
  atom_h(2,3)%comp = (/  0.0d0,  5.0d0,  0.0d0 /)
  atom_h(3,3)%comp = (/  0.0d0,  0.0d0,  5.0d0 /)
  atom_h(4,3)%comp = (/  2.0d0,  2.0d0,  2.0d0 /)
  atom_h(5,3)%comp = (/  1.5d0,  1.5d0,  1.5d0 /)

  sprop_h(1,1)%comp = (/ 2.0d0, 0.0d0, 0.0d0 /)
  sprop_h(2,1)%comp = (/ 0.0d0, 1.5d0, 0.0d0 /)
  sprop_h(3,1)%comp = (/ 0.3d0, 0.4d0, 1.2d0 /)

  sprop_h(1,2)%comp = (/ 1.0d0, 0.2d0, 0.0d0 /)
  sprop_h(2,2)%comp = (/ 0.0d0, 1.0d0, 0.3d0 /)
  sprop_h(3,2)%comp = (/ 0.5d0, 0.0d0, 1.0d0 /)

  sprop_h(1,3)%comp = (/ 0.7d0, 0.7d0, 0.0d0 /)
  sprop_h(2,3)%comp = (/ -0.7d0, 0.7d0, 0.0d0 /)
  sprop_h(3,3)%comp = (/ 0.0d0, 0.0d0, 2.0d0 /)

  ! walker 4 (extremo): impureza a contacto muy cercano de un atomo de
  ! He4 (rij(1,5)~0.05) -- mismo caso que der_wavefx.md §10
  atom_h(1,4)%comp = (/  1.05d0,  1.0d0,  1.0d0 /)
  atom_h(2,4)%comp = (/ -1.0d0,  2.0d0,  0.5d0 /)
  atom_h(3,4)%comp = (/  2.5d0, -1.5d0,  3.0d0 /)
  atom_h(4,4)%comp = (/  0.0d0,  0.0d0, -4.0d0 /)
  atom_h(5,4)%comp = (/  1.0d0,  1.0d0,  1.0d0 /)
  sprop_h(1,4)%comp = (/ 1.0d0, 0.2d0, 0.0d0 /)
  sprop_h(2,4)%comp = (/ 0.0d0, 1.0d0, 0.3d0 /)
  sprop_h(3,4)%comp = (/ 0.5d0, 0.0d0, 1.0d0 /)

  ! walker 5 (extremo): impureza a largo alcance de los 4 atomos de
  ! He4 (rij~1000 en los 4 casos)
  atom_h(1,5)%comp = (/ 1000.0d0,    0.0d0,    0.0d0 /)
  atom_h(2,5)%comp = (/    0.0d0, 1000.0d0,    0.0d0 /)
  atom_h(3,5)%comp = (/    0.0d0,    0.0d0, 1000.0d0 /)
  atom_h(4,5)%comp = (/-1000.0d0,    0.0d0,    0.0d0 /)
  atom_h(5,5)%comp = (/    0.0d0,    0.0d0,    0.0d0 /)
  sprop_h(1,5)%comp = (/ 0.7d0, 0.7d0, 0.0d0 /)
  sprop_h(2,5)%comp = (/ -0.7d0, 0.7d0, 0.0d0 /)
  sprop_h(3,5)%comp = (/ 0.0d0, 0.0d0, 2.0d0 /)

  do iw = 1, n_walk
    do ia = 1, n_he4
      hb2m_h(ia,iw) = hb2he4_real
    enddo
    hb2m_h(n_atom,iw) = hb2x_real
    b_h(iw) = brot_real
  enddo

  atom_d  = atom_h
  sprop_d = sprop_h
  hb2m_d  = hb2m_h
  b_d     = b_h

  threads = 32
  blocks = (n_walk + threads - 1) / threads
  call k_derananum<<<blocks,threads>>>(n_walk, atom_d, sprop_d, hb2m_d, b_d, &
                                        wf_d, wfhe4_d, wfhe3_d, wfm_d, wfx_d, &
                                        kin_d, eimp_d, erot_d, dwf_d, dphi_d)
  wf_h = wf_d; wfhe4_h = wfhe4_d; wfhe3_h = wfhe3_d; wfm_h = wfm_d; wfx_h = wfx_d
  kin_h = kin_d; eimp_h = eimp_d; erot_h = erot_d
  dwf_h = dwf_d; dphi_h = dphi_d

  write(*,*) '=== caso real de la simulacion: nhe3=0, impureza=.T. ==='
  errmax = 0.0d0
  do iw = 1, n_walk
    call allocatewalker(w1, n_atom)
    do ia = 1, n_atom
      w1%atom(ia) = atom_h(ia,iw)
      w1%hb2m(ia) = hb2m_h(ia,iw)
    enddo
    w1%sprop(1) = sprop_h(1,iw)
    w1%sprop(2) = sprop_h(2,iw)
    w1%sprop(3) = sprop_h(3,iw)
    w1%b = b_h(iw)

    call derananum_cpu(w1)
    wf_cpu(iw)=real(w1%lw%wf,r8); wfhe4_cpu(iw)=real(w1%lw%wfhe4,r8)
    wfhe3_cpu(iw)=real(w1%lw%wfhe3,r8); wfm_cpu(iw)=real(w1%lw%wfm,r8)
    wfx_cpu(iw)=real(w1%lw%wfx,r8)
    kin_cpu(iw)=w1%lw%kin; eimp_cpu(iw)=w1%lw%eimp; erot_cpu(iw)=w1%lw%erot
    do ia = 1, n_atom
      dwf_cpu(ia,iw) = w1%dwf(ia)
    enddo
    dphi_cpu(:,iw) = w1%dphi

    write(*,*)
    write(*,'(a,i0)') '--- walker ', iw
    write(*,'(a,f18.10,a,f18.10)') '  wf    CPU=', wf_cpu(iw), '   GPU=', wf_h(iw)
    write(*,'(a,f18.10,a,f18.10)') '  wfhe4 CPU=', wfhe4_cpu(iw), '   GPU=', wfhe4_h(iw)
    write(*,'(a,f18.10,a,f18.10)') '  wfhe3 CPU=', wfhe3_cpu(iw), '   GPU=', wfhe3_h(iw)
    write(*,'(a,f18.10,a,f18.10)') '  wfm   CPU=', wfm_cpu(iw), '   GPU=', wfm_h(iw)
    write(*,'(a,f18.10,a,f18.10)') '  wfx   CPU=', wfx_cpu(iw), '   GPU=', wfx_h(iw)
    write(*,'(a,es24.13,a,es24.13)') '  kin   CPU=', kin_cpu(iw), '   GPU=', kin_h(iw)
    write(*,'(a,es24.13,a,es24.13)') '  eimp  CPU=', eimp_cpu(iw), '   GPU=', eimp_h(iw)
    write(*,'(a,es24.13,a,es24.13)') '  erot  CPU=', erot_cpu(iw), '   GPU=', erot_h(iw)
    write(*,'(a,es24.17,a,es24.17)') '  HP kin   CPU=', kin_cpu(iw), '   GPU=', kin_h(iw)
    write(*,'(a,es24.17,a,es24.17)') '  HP eimp  CPU=', eimp_cpu(iw), '   GPU=', eimp_h(iw)
    write(*,'(a,es24.17,a,es24.17)') '  HP erot  CPU=', erot_cpu(iw), '   GPU=', erot_h(iw)

    err = abs(wf_h(iw)-wf_cpu(iw))
    err = max(err, abs(wfhe4_h(iw)-wfhe4_cpu(iw)))
    err = max(err, abs(wfhe3_h(iw)-wfhe3_cpu(iw)))
    err = max(err, abs(wfm_h(iw)-wfm_cpu(iw)))
    err = max(err, abs(wfx_h(iw)-wfx_cpu(iw)))
    err = max(err, abs(kin_h(iw)-kin_cpu(iw)))
    err = max(err, abs(eimp_h(iw)-eimp_cpu(iw)))
    err = max(err, abs(erot_h(iw)-erot_cpu(iw)))
    do ia = 1, n_atom
      write(*,'(a,i0,a,3f16.8)') '  atom ',ia,' dwf CPU=', dwf_cpu(ia,iw)%comp
      write(*,'(a,i0,a,3f16.8)') '  atom ',ia,' dwf GPU=', dwf_h(ia,iw)%comp
      err = max(err, maxval(abs(dwf_h(ia,iw)%comp-dwf_cpu(ia,iw)%comp)))
    enddo
    write(*,'(a,2f16.8,a,2f16.8)') '  dphi CPU=', dphi_cpu(:,iw), '   GPU=', dphi_h(:,iw)
    err = max(err, maxval(abs(dphi_h(:,iw)-dphi_cpu(:,iw))))

    write(*,'(a,es10.2)') '  |err| max=', err
    errmax = max(errmax, err)
  enddo

  ! ---- prueba directa de derwavefm/derwavefhe3 con nhe3=2, para que
  ! sus bucles pairwise (jhe3/ihe3) iteren de verdad -- con nhe3=0 dan
  ! siempre d1wf=0/d2wf=0. Mismo criterio que la prueba de nhe3=2 en
  ! wavef.cuf. impureza=.false. aqui (sin impureza, natom=ngatom), asi
  ! que impurfija=.true./rotamol=.false. (rama "else" de mentradatos.f90,
  ! evita contar dos veces el ultimo atomo). ----
  block
    integer(kind=i4), parameter :: n_he4b = 4, n_he3b = 2, n_gatomb = n_he4b+n_he3b
    integer(kind=i4), parameter :: n_caseb = 3   ! normal + contacto muy cercano + largo alcance (He3-He3)
    real(kind=r8), parameter :: bhe3 = 3.0d0, nuhe3 = 5.0d0, alfahe3 = 0.5d0, bback = 0.2d0
    real(kind=r8), parameter :: bmix = 2.5d0, numix = 4.0d0, alfamix = 0.3d0

    type(vec3) :: atomb_h(n_gatomb,n_caseb), spropb_h(3,n_caseb)
    type(vec3), device :: atomb_d(n_gatomb,n_caseb), spropb_d(3,n_caseb)
    real(kind=r8) :: hb2mb_h(n_gatomb,n_caseb), bb_h(n_caseb)
    real(kind=r8), device :: hb2mb_d(n_gatomb,n_caseb), bb_d(n_caseb)
    real(kind=r8) :: wfb_cpu(n_caseb), wfhe4b_cpu(n_caseb), wfhe3b_cpu(n_caseb), wfmb_cpu(n_caseb), wfxb_cpu(n_caseb)
    real(kind=r8) :: kinb_cpu(n_caseb), eimpb_cpu(n_caseb), erotb_cpu(n_caseb)
    type(vec3) :: dwfb_cpu(n_gatomb,n_caseb)
    real(kind=r8) :: dphib_cpu(2,n_caseb)
    real(kind=r8) :: wfb_h(n_caseb), wfhe4b_h(n_caseb), wfhe3b_h(n_caseb), wfmb_h(n_caseb), wfxb_h(n_caseb)
    real(kind=r8) :: kinb_h(n_caseb), eimpb_h(n_caseb), erotb_h(n_caseb)
    type(vec3) :: dwfb_h(n_gatomb,n_caseb)
    real(kind=r8) :: dphib_h(2,n_caseb)
    real(kind=r8), device :: wfb_d(n_caseb), wfhe4b_d(n_caseb), wfhe3b_d(n_caseb), wfmb_d(n_caseb), wfxb_d(n_caseb)
    real(kind=r8), device :: kinb_d(n_caseb), eimpb_d(n_caseb), erotb_d(n_caseb)
    type(vec3), device :: dwfb_d(n_gatomb,n_caseb)
    real(kind=r8), device :: dphib_d(2,n_caseb)
    type(walker) :: wb
    integer(kind=i4) :: ia2, icb
    real(kind=r8) :: errb

     nhe4 = n_he4b
     nhe3 = n_he3b
     ngatom = n_gatomb
     natom = n_gatomb        ! impureza=.false. -> natom=ngatom
     impureza = .false.
     impurfija = .true.
     rotamol = .false.
     nhe4_he4 = n_he4b

     phe3(1) = 0.50_r8*(bhe3**nuhe3)
     phe3(2) = nuhe3
     phe3(3) = alfahe3
     phe3(4) = bback
     pmix_dev(1) = 0.50_r8*(bmix**numix)
     pmix_dev(2) = numix
     pmix_dev(3) = alfamix
     nhe3up = 1
     nhe3dw = 1

     nhe4_real = n_he4b
     nhe3_real = n_he3b
     ngatom_real = n_gatomb
     natom_real = n_gatomb
     impureza_real = .false.
     impurfija_real = .true.
     rotamol_real = .false.
     phe3_real = phe3
     pmix_real = pmix_dev
     nhe3up_real = 1
     nhe3dw_real = 1
     mhe4_real = mhe4
     mhe3_real = mhe3

     ! caso 1: geometria "normal"
     atomb_h(1,1)%comp = (/  0.0d0,  0.0d0,  0.0d0 /)
     atomb_h(2,1)%comp = (/  3.5d0,  0.0d0,  0.0d0 /)
     atomb_h(3,1)%comp = (/  0.0d0,  4.0d0,  1.0d0 /)
     atomb_h(4,1)%comp = (/ -2.0d0, -3.0d0,  2.5d0 /)
     atomb_h(5,1)%comp = (/  1.5d0,  1.5d0,  1.5d0 /)   ! He3 #1
     atomb_h(6,1)%comp = (/ -1.0d0,  2.2d0, -0.8d0 /)   ! He3 #2

     ! caso 2 (extremo): par He3-He3 (atomos 5,6) a contacto muy
     ! cercano (rij~0.05)
     atomb_h(1,2)%comp = (/  0.0d0,  0.0d0,  0.0d0 /)
     atomb_h(2,2)%comp = (/  3.5d0,  0.0d0,  0.0d0 /)
     atomb_h(3,2)%comp = (/  0.0d0,  4.0d0,  1.0d0 /)
     atomb_h(4,2)%comp = (/ -2.0d0, -3.0d0,  2.5d0 /)
     atomb_h(5,2)%comp = (/  1.5d0,  1.5d0,  1.5d0 /)
     atomb_h(6,2)%comp = (/  1.5d0,  1.5d0,  1.55d0 /)  ! rij(5,6)~0.05

     ! caso 3 (extremo): par He3-He3 a largo alcance (rij~1000)
     atomb_h(1,3)%comp = (/  0.0d0,  0.0d0,  0.0d0 /)
     atomb_h(2,3)%comp = (/  3.5d0,  0.0d0,  0.0d0 /)
     atomb_h(3,3)%comp = (/  0.0d0,  4.0d0,  1.0d0 /)
     atomb_h(4,3)%comp = (/ -2.0d0, -3.0d0,  2.5d0 /)
     atomb_h(5,3)%comp = (/  1.5d0,  1.5d0,  1.5d0 /)
     atomb_h(6,3)%comp = (/  1.5d0,  1.5d0,  1001.5d0 /) ! rij(5,6)~1000

     do icb = 1, n_caseb
       spropb_h(1,icb)%comp = (/ 1.0d0, 0.0d0, 0.0d0 /)
       spropb_h(2,icb)%comp = (/ 0.0d0, 1.0d0, 0.0d0 /)
       spropb_h(3,icb)%comp = (/ 0.0d0, 0.0d0, 1.0d0 /)
       do ia2 = 1, n_he4b
         hb2mb_h(ia2,icb) = hb2he4_real
       enddo
       do ia2 = n_he4b+1, n_gatomb
         ! hb2he3 no calculado aqui; reutiliza el mismo valor que
         ! hb2he4 -- no influye en lo comparado con la CPU (misma
         ! constante en ambos lados)
         hb2mb_h(ia2,icb) = hb2he4_real
       enddo
       bb_h(icb) = 0.0_r8
     enddo

     atomb_d  = atomb_h
     spropb_d = spropb_h
     hb2mb_d  = hb2mb_h
     bb_d     = bb_h

     call k_derananum<<<1,32>>>(n_caseb, atomb_d, spropb_d, hb2mb_d, bb_d, &
                                 wfb_d, wfhe4b_d, wfhe3b_d, wfmb_d, wfxb_d, &
                                 kinb_d, eimpb_d, erotb_d, dwfb_d, dphib_d)
     wfb_h=wfb_d; wfhe4b_h=wfhe4b_d; wfhe3b_h=wfhe3b_d; wfmb_h=wfmb_d; wfxb_h=wfxb_d
     kinb_h=kinb_d; eimpb_h=eimpb_d; erotb_h=erotb_d
     dwfb_h=dwfb_d; dphib_h=dphib_d

     do icb = 1, n_caseb
       call allocatewalker(wb, n_gatomb)
       do ia2 = 1, n_gatomb
         wb%atom(ia2) = atomb_h(ia2,icb)
         wb%hb2m(ia2) = hb2mb_h(ia2,icb)
       enddo
       wb%sprop(1) = spropb_h(1,icb)
       wb%sprop(2) = spropb_h(2,icb)
       wb%sprop(3) = spropb_h(3,icb)
       wb%b = bb_h(icb)

       call derananum_cpu(wb)
       wfb_cpu(icb)=real(wb%lw%wf,r8); wfhe4b_cpu(icb)=real(wb%lw%wfhe4,r8)
       wfhe3b_cpu(icb)=real(wb%lw%wfhe3,r8); wfmb_cpu(icb)=real(wb%lw%wfm,r8)
       wfxb_cpu(icb)=real(wb%lw%wfx,r8)
       kinb_cpu(icb)=wb%lw%kin; eimpb_cpu(icb)=wb%lw%eimp; erotb_cpu(icb)=wb%lw%erot
       do ia2 = 1, n_gatomb
         dwfb_cpu(ia2,icb) = wb%dwf(ia2)
       enddo

       write(*,*)
       write(*,'(a,i0)') '=== prueba directa de derwavefm/derwavefhe3, nhe3=2, caso ', icb
       write(*,'(a,f18.10,a,f18.10)') '  wfhe3 CPU=', wfhe3b_cpu(icb), '   GPU=', wfhe3b_h(icb)
       write(*,'(a,f18.10,a,f18.10)') '  wfm   CPU=', wfmb_cpu(icb), '   GPU=', wfmb_h(icb)
       write(*,'(a,es24.17,a,es24.17)') '  HP kin   CPU=', kinb_cpu(icb), '   GPU=', kinb_h(icb)
       errb = max(abs(wfhe3b_h(icb)-wfhe3b_cpu(icb)), abs(wfmb_h(icb)-wfmb_cpu(icb)), abs(kinb_h(icb)-kinb_cpu(icb)))
       do ia2 = 1, n_gatomb
         write(*,'(a,i0,a,3f16.8)') '  atom ',ia2,' dwf CPU=', dwfb_cpu(ia2,icb)%comp
         write(*,'(a,i0,a,3f16.8)') '  atom ',ia2,' dwf GPU=', dwfb_h(ia2,icb)%comp
         errb = max(errb, maxval(abs(dwfb_h(ia2,icb)%comp-dwfb_cpu(ia2,icb)%comp)))
       enddo
       write(*,'(a,es10.2)') '  |err| max=', errb
       errmax = max(errmax, errb)
     enddo
  end block

  write(*,*)
  if (errmax < 1.0d-8) then
    write(*,*) 'PASA: GPU y CPU coinciden dentro de tolerancia'
  else
    write(*,*) 'FALLA: diferencia maxima =', errmax
  endif

end program test_derananum
