! glibc_acos.cuf
!
! Puerto a CUDA Fortran de __ieee754_acos de glibc 2.39
! (sysdeps/ieee754/dbl-64/e_asin.c -- la funcion acos esta en el mismo
! fichero que asin, "IBM Accurate Mathematical Library", ~0.523 ULP
! maximo), mas las tablas asincos.tbl (asncs.x, 2568 valores), root.tbl
! (inroot, 128 valores) y powtwo.tbl (28 valores), y las constantes de
! uasncs.h.
!
! Fuente original: LGPL-2.1-or-later, (C) 2001-2024 Free Software
! Foundation, Inc. -- ver https://sourceware.org/git/?p=glibc.git;
! a=blob;f=sysdeps/ieee754/dbl-64/e_asin.c;hb=glibc-2.39
!
! Motivo del puerto: se confirmo (docs-kernels/He_dihydrogen.md, Parte
! 4) que dacos tiene, igual que dexp/dcos/dsin antes de portarlas,
! implementaciones distintas en el host de nvfortran (libnvcpumath.so,
! simbolo __pd_acos_1) y en el device (intrinseco de libdevice,
! compilado en linea, sin simbolo de libreria) -- confirmado con
! cuobjdump --dump-ptx. gfortran coincide con el host de nvfortran para
! el caso de prueba, no con el device. Se porta acos para tener una
! tercera implementacion, identica en ambos lados, que ademas coincida
! con gfortran/glibc.

module glibc_acos_mod
 use glibc_exp_mod, only: bits_of, real_of
 implicit none
 integer, private, parameter :: i4 = selected_int_kind(9)
 integer, private, parameter :: i8 = selected_int_kind(18)
 integer, private, parameter :: r8 = selected_real_kind(15,9)

 ! ---- constantes de uasncs.h ----
 real(kind=r8), parameter :: ac_hp0 = transfer(int(z'3ff921fb54442d18',8), 1.0_r8)
 real(kind=r8), parameter :: ac_hp1 = transfer(int(z'3c91a62633145c07',8), 1.0_r8)
 real(kind=r8), parameter :: ac_f1 = 1.66666666666664110590506577996662E-01_r8
 real(kind=r8), parameter :: ac_f2 = 7.50000000026122686814431784722623E-02_r8
 real(kind=r8), parameter :: ac_f3 = 4.46428561421059750978517350006940E-02_r8
 real(kind=r8), parameter :: ac_f4 = 3.03821268582119319911193410625235E-02_r8
 real(kind=r8), parameter :: ac_f5 = 2.23551211026525610742786300334557E-02_r8
 real(kind=r8), parameter :: ac_f6 = 1.81382903404565056280372531963613E-02_r8
 real(kind=r8), parameter :: ac_t27 = 134217728.0_r8
 real(kind=r8), parameter :: ac_rt0 = 9.99999999859990725855365213134618E-01_r8
 real(kind=r8), parameter :: ac_rt1 = 4.99999999495955425917856814202739E-01_r8
 real(kind=r8), parameter :: ac_rt2 = 3.75017500867345182581453026130850E-01_r8
 real(kind=r8), parameter :: ac_rt3 = 3.12523626554518656309172508769531E-01_r8

 ! tablas: root.tbl (usqrt), powtwo.tbl (upow), asincos.tbl (asin/acos)
 include 'inroot_fortran.txt'
 include 'powtwo_fortran.txt'
 include 'asincos_tab_fortran.txt'

contains

attributes(host, device) function high32_of(x) result(h)
  real(kind=r8), intent (in) :: x
  integer(kind=i8) :: h
    h = iand(ishft(bits_of(x), -32), int(z'ffffffff',i8))
end function high32_of

! myacos: puerto fiel de __ieee754_acos (e_asin.c). Mismas 8 zonas de
! tabla que el original; "m>0" del C (signo del entero de 32 bits) se
! sustituye por comprobar el signo de x directamente (equivalente para
! todo el rango que llega a estas ramas, igual que en glibc_sincos.cuf).
attributes(host, device) function myacos(x) result(res)
  real(kind=r8), intent (in) :: x
  real(kind=r8) :: res
  real(kind=r8) :: x2, xx, res1, p, t, r, cor, cc, y, c, z
  integer(kind=i8) :: k, kz
  integer(kind=i4) :: n
  logical :: mpos

    k = iand(high32_of(x), int(z'7fffffff',i8))
    mpos = (x > 0.0_r8)

    if (k < int(z'3c880000',i8)) then
      res = ac_hp0
      return
    else if (k < int(z'3fc00000',i8)) then
      x2 = x*x
      t = (((((ac_f6*x2+ac_f5)*x2+ac_f4)*x2+ac_f3)*x2+ac_f2)*x2+ac_f1)*(x2*x)
      r = ac_hp0-x
      cor = (((ac_hp0-r)-x)+ac_hp1)-t
      res = r+cor
      return
    else if (k < int(z'3fe00000',i8)) then
      if (k < int(z'3fd00000',i8)) then
        n = int(11_i8*ishft(iand(k,int(z'000fffff',i8)),-15), i4)
      else
        n = int(11_i8*ishft(iand(k,int(z'000fffff',i8)),-14)+352_i8, i4)
      end if
      if (mpos) then
        xx = x - asncs_tab(n)
      else
        xx = -x - asncs_tab(n)
      end if
      t = asncs_tab(n+1)*xx
      p = xx*xx*(asncs_tab(n+2)+xx*(asncs_tab(n+3)+xx*(asncs_tab(n+4)+ &
          xx*(asncs_tab(n+5)+xx*asncs_tab(n+6)))))+asncs_tab(n+7)
      t = t+p
      if (mpos) then
        y = ac_hp0-asncs_tab(n+8)
        t = ac_hp1-t
      else
        y = ac_hp0+asncs_tab(n+8)
        t = ac_hp1+t
      end if
      res = y+t
      return
    else if (k < int(z'3fe80000',i8)) then
      n = int(1056_i8+ishft(iand(k,int(z'000fe000',i8)),-11)*3_i8, i4)
      if (mpos) then
        xx = x - asncs_tab(n)
      else
        xx = -x - asncs_tab(n)
      end if
      t = asncs_tab(n+1)*xx
      p = xx*xx*(asncs_tab(n+2)+xx*(asncs_tab(n+3)+xx*(asncs_tab(n+4)+ &
          xx*(asncs_tab(n+5)+xx*(asncs_tab(n+6)+ &
          xx*asncs_tab(n+7))))))+asncs_tab(n+8)
      t = t+p
      if (mpos) then
        y = ac_hp0-asncs_tab(n+9)
        t = ac_hp1-t
      else
        y = ac_hp0+asncs_tab(n+9)
        t = ac_hp1+t
      end if
      res = y+t
      return
    else if (k < int(z'3fed8000',i8)) then
      n = int(992_i8+ishft(iand(k,int(z'000fe000',i8)),-13)*13_i8, i4)
      if (mpos) then
        xx = x - asncs_tab(n)
      else
        xx = -x - asncs_tab(n)
      end if
      t = asncs_tab(n+1)*xx
      p = xx*xx*(asncs_tab(n+2)+xx*(asncs_tab(n+3)+xx*(asncs_tab(n+4)+ &
          xx*(asncs_tab(n+5)+xx*(asncs_tab(n+6)+xx*(asncs_tab(n+7)+ &
          xx*asncs_tab(n+8)))))))+asncs_tab(n+9)
      t = t+p
      if (mpos) then
        y = ac_hp0-asncs_tab(n+10)
        t = ac_hp1-t
      else
        y = ac_hp0+asncs_tab(n+10)
        t = ac_hp1+t
      end if
      res = y+t
      return
    else if (k < int(z'3fee8000',i8)) then
      n = int(884_i8+ishft(iand(k,int(z'000fe000',i8)),-13)*14_i8, i4)
      if (mpos) then
        xx = x - asncs_tab(n)
      else
        xx = -x - asncs_tab(n)
      end if
      t = asncs_tab(n+1)*xx
      p = xx*xx*(asncs_tab(n+2)+xx*(asncs_tab(n+3)+xx*(asncs_tab(n+4)+ &
          xx*(asncs_tab(n+5)+xx*(asncs_tab(n+6) &
          +xx*(asncs_tab(n+7)+xx*(asncs_tab(n+8)+ &
          xx*asncs_tab(n+9))))))))+asncs_tab(n+10)
      t = t+p
      if (mpos) then
        y = ac_hp0-asncs_tab(n+11)
        t = ac_hp1-t
      else
        y = ac_hp0+asncs_tab(n+11)
        t = ac_hp1+t
      end if
      res = y+t
      return
    else if (k < int(z'3fef0000',i8)) then
      n = int(768_i8+ishft(iand(k,int(z'000fe000',i8)),-13)*15_i8, i4)
      if (mpos) then
        xx = x - asncs_tab(n)
      else
        xx = -x - asncs_tab(n)
      end if
      t = asncs_tab(n+1)*xx
      p = xx*xx*(asncs_tab(n+2)+xx*(asncs_tab(n+3)+xx*(asncs_tab(n+4)+ &
          xx*(asncs_tab(n+5)+xx*(asncs_tab(n+6) &
          +xx*(asncs_tab(n+7)+xx*(asncs_tab(n+8)+xx*(asncs_tab(n+9)+ &
          xx*asncs_tab(n+10)))))))))+asncs_tab(n+11)
      t = t+p
      if (mpos) then
        y = ac_hp0-asncs_tab(n+12)
        t = ac_hp1-t
      else
        y = ac_hp0+asncs_tab(n+12)
        t = ac_hp1+t
      end if
      res = y+t
      return
    else if (k < int(z'3ff00000',i8)) then
      if (mpos) then
        z = 0.5d0*(1.0d0-x)
      else
        z = 0.5d0*(1.0d0+x)
      end if
      kz = high32_of(z)
      t = ac_inroot(int(ishft(iand(kz,int(z'001fffff',i8)),-14),i4)) &
          *ac_powtwo(int(511_i8-ishft(kz,-21),i4))
      r = 1.0d0-t*t*z
      t = t*(ac_rt0+r*(ac_rt1+r*(ac_rt2+r*ac_rt3)))
      c = t*z
      t = c*(1.5d0-0.5d0*t*c)
      y = (ac_t27*c+c)-ac_t27*c
      cc = (z-y*y)/(t+y)
      p = (((((ac_f6*z+ac_f5)*z+ac_f4)*z+ac_f3)*z+ac_f2)*z+ac_f1)*z
      if (.not. mpos) then
        cor = (ac_hp1-cc)-(y+cc)*p
        res1 = ac_hp0-y
        res = res1+cor
        res = res+res
        return
      else
        cor = cc+p*(y+cc)
        res = y+cor
        res = res+res
        return
      end if
    else if (abs(x) == 1.0d0) then
      if (mpos) then
        res = 0.0d0
      else
        res = 2.0d0*ac_hp0
      end if
      return
    else
      res = (x-x)/(x-x)
      return
    end if
end function myacos

attributes(global) subroutine k_myacos(n, x, y)
 integer(kind=i4), value :: n
 real(kind=r8), device, intent(in) :: x(n)
 real(kind=r8), device, intent(out) :: y(n)
 integer(kind=i4) :: i
  i = (blockIdx%x - 1) * blockDim%x + threadIdx%x
  if (i <= n) then
    y(i) = myacos(x(i))
  endif
end subroutine k_myacos

end module glibc_acos_mod
