module mvpot
 ! ccuerpo/potenbh: ya portados y probados por separado (mccuerpo,
 ! mpotenbh) -- se reutilizan tal cual, sin tocar ninguna linea.
 use mtipos, only: vec3
 use mccuerpo, only: ccuerpo, ngatom, natom
 use mpotenbh, only: potenbh
 implicit none
 integer, private, parameter :: i4 = selected_int_kind(9)
 integer, private, parameter :: r8 = selected_real_kind(15,9)

 ! natms: PARAMETER real de param_atoms_bh.h (=30), cota maxima de
 ! atomos de He -- el mismo limite que ya usa He_dihydrogen.f para sus
 ! propios arrays locales R2/G. Se reutiliza aqui para "rhe" (ver
 ! subrutina vpot mas abajo), en vez de dimensionarlo con "ngatom"
 ! (variable device, tamano solo conocido en tiempo de ejecucion --
 ! mismo problema ya resuelto varias veces en este proyecto).
 include 'param_atoms_bh_freeform.h'

 ! opot: variable real de mparametros.f90 (publica, sin "parameter"),
 ! fijada una vez al leer in.mcv (=4 en esta simulacion, ver in.mcv y
 ! la discusion de por que aziz_nuevo/vatomol/azizgen no se portan,
 ! documentada abajo) -- mismo tratamiento device que ngatom/natom/
 ! nhe4 en kernels anteriores.
 !
 ! cmtok NO se importa: es un PARAMETER real (mparametros.f90, no
 ! haria falta copia device ni aunque se usara), pero en el original
 ! solo aparece en la llamada a vatomol -- la rama que no se porta
 ! (ver comentario de la subrutina vpot). No hace falta para nada aqui.
 integer(kind=i4), device :: opot

contains

! ---- vpot: w1 se descompone en atom(natom)/sprop(3), igual que en
! ccuerpo/wavef, y devuelve "pot" como escalar en vez de escribir en
! w1%lw%pot. w1%lw (type vloc) no tiene ningun componente allocatable
! -- a diferencia de "walker", SI se podria pasar entero a device tal
! cual -- pero como vpot solo escribe un unico campo (pot), se
! mantiene el mismo criterio que en wavef/wavefx: un escalar de
! salida y ya, interfaz minima.
!
! Solo se porta la rama "opot==4" (ccuerpo+potenbh, ya verificados por
! separado). La rama "opot/=4" del original (aziz_nuevo para el He-He
! puro, y vatomol/azizgen segun impurmol para otras impurezas
! He-OCS/He-CO) NO se porta: con opot=4 fijo en el in.mcv real de esta
! simulacion, esa rama es codigo muerto de verdad -- el "return" al
! final del if en el original nunca deja que se alcance. A diferencia
! de wavefm/wavefhe3 en wavef.cuf (que SI se llaman siempre, solo con
! resultado trivial para nhe3=0), aqui ni siquiera se ejecuta la
! llamada, asi que no aplica el criterio de "portar aunque sea
! barato" -- es exactamente el mismo caso ya discutido para vpot antes
! de empezar a portar wavef. Se mantiene el "if(opot==4)" (comparacion
! uniforme para todos los walkers, coste cero de divergencia, igual
! que GTEST en He_dihydrogen) por fidelidad y por si algun dia cambia
! opot, pero no hay ninguna rama alternativa que ejecutar si no se
! cumple. ----
attributes(host, device) subroutine vpot(atom, sprop, pot)
  type(vec3), intent (in) :: atom(natom), sprop(3)
  real(kind=r8), intent (out) :: pot
  real(kind=r8) :: rhe(3*natms)
  real(kind=r8) :: vpotbh

    if (opot == 4) then
      call ccuerpo(atom, sprop, rhe(1:3*ngatom))
      call potenbh(ngatom, rhe(1:3*ngatom), vpotbh)
      pot = vpotbh
    endif

end subroutine vpot

attributes(global) subroutine k_vpot(n, atom, sprop, pot)
  integer(kind=i4), value :: n
  type(vec3), device, intent (in)  :: atom(natom,n), sprop(3,n)
  real(kind=r8), device, intent (out) :: pot(n)
  integer(kind=i4) :: i

  i = (blockIdx%x - 1) * blockDim%x + threadIdx%x
  if (i <= n) then
    call vpot(atom(:,i), sprop(:,i), pot(i))
  endif
end subroutine k_vpot

end module mvpot
