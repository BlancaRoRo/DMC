module d_uhex4
 ! vec3: se reutiliza la definicion real de mtipos.f90 (no se retipea).
 ! Solo se usa a traves de %comp en todo duhe4x/uhe4x -- nunca se llama
 ! a los operadores sobrecargados (+,-,*,=) que mtipos.f90 define para
 ! vec3, asi que no hace falta preocuparse de si esos operadores (que
 ! son solo host) se pueden usar en device: aqui no se usan en absoluto.
 use mtipos, only: vec3
 ! calpleg/calderpleg ya portados y probados en calpleg-calderpleg/ --
 ! se reutilizan en vez de volver a escribirlos.
 use mlegendre_gpu, only: calpleg => calplegd, calderpleg => calderplegd, lmax_dev
 ! rij**pxhe4(2,il)/rij**pxhe4(4,il): exponente REAL (nu/p4 de in.mcv,
 ! no enteros) -> pow(x,y), que tiene implementaciones independientes
 ! en host (rapida/precisa segun -Kieee) y device (libdevice), sin
 ! garantia de coincidir con gfortran -- ver docs-kernels/
 ! He_dihydrogen.md Parte 5 y glibc_math.md Parte 4. mypow (glibc_pow.cuf)
 ! cierra ese hueco, verificado con 30 casos (incluido este rij real).
 use glibc_pow_mod, only: mypow

 implicit none
 integer, private, parameter :: i4 = selected_int_kind(9)
 integer, private, parameter :: r8 = selected_real_kind(15,9)

 ! lxhe4, impurmol y pxhe4 en el original (mparametros.f90) NO son
 ! PARAMETER: son variables que mentradatos.f90 rellena una vez al leer
 ! in.mcv y que se quedan fijas el resto de la simulacion. Al ser
 ! variables de verdad (no constantes de compilacion), necesitan su
 ! propia copia "device" y un copiado explicito desde el host -- pero
 ! se declaran aqui, a nivel de modulo, con el MISMO nombre que usa el
 ! cuerpo de duhe4x/uhe4x (sin cambiar ni una linea de esos cuerpos),
 ! y una variable device a nivel de modulo se puede leer tanto desde
 ! el host como desde el device de una subrutina host,device (comprobado).
 integer(kind=i4), device :: lxhe4
 logical, device :: impurmol
 real(kind=r8), device :: pxhe4(5,0:lmax_dev)

contains

attributes(host, device) subroutine duhe4x(rivec, smol, d1ux, d2ux, d1zux, d2zux)
  type(vec3), intent (in) :: rivec,smol(3)
  type(vec3), intent (out) :: d1ux
  real(kind=r8), intent (out) :: d2ux
  real(kind=r8), intent (out) :: d1zux(2),d2zux
  type(vec3) :: grz,grpl,grul
  real(kind=r8) :: rij,cth,zpr,grz2,lapz
  real(kind=r8) :: gpz(2),lpz,gpz2
  real(kind=r8) :: ulx,ulxp,ulxs,lapl
  real(kind=r8) :: rijp2,rijp4
  real(kind=r8) :: pl(0:lmax_dev),d1pl(0:lmax_dev),d2pl(0:lmax_dev)
  integer(kind=i4) :: il

   rij=sqrt(dot_product(rivec%comp,rivec%comp))
   if(impurmol) then
     cth=dot_product(rivec%comp,smol(3)%comp)/rij
     zpr=cth/rij
     grz%comp=(smol(3)%comp-zpr*rivec%comp)/rij
     grz2=dot_product(grz%comp,grz%comp)
     lapz=-2.0_r8*zpr/rij
     gpz(1)=-dot_product(rivec%comp,smol(2)%comp)/rij
     gpz(2)= dot_product(rivec%comp,smol(1)%comp)/rij
     gpz2=dot_product(gpz,gpz)
     lpz=-cth-cth
   else
     cth=0.0_r8
     grz%comp=0.0_r8
     grz2=0.0_r8
     lapz=0.0_r8
     gpz=0.0_r8
     lpz=0.0_r8
   endif
   call calderpleg(lxhe4,cth,pl(0:lxhe4),d1pl(0:lxhe4),d2pl(0:lxhe4))
   do il=1,lxhe4
     pl(il)=1.0_r8-pl(il)
     d1pl(il)=-d1pl(il)
     d2pl(il)=-d2pl(il)
   enddo

   d1ux%comp=0.0_r8
   d2ux=0.0_r8
   d1zux=0.0_r8
   d2zux=0.0_r8
   do il=0,lxhe4
     rijp2=mypow(rij,pxhe4(2,il))
     rijp4=mypow(rij,pxhe4(4,il))
     ulx=  -pxhe4(1,il)/rijp2                                   &
 &         -pxhe4(3,il)*rijp4-pxhe4(5,il)*log(rij)
     ulxp=( pxhe4(1,il)*pxhe4(2,il)/rijp2                       &
 &         -pxhe4(3,il)*pxhe4(4,il)*rijp4-pxhe4(5,il))/rij
     ulxs=(-pxhe4(1,il)*pxhe4(2,il)*(pxhe4(2,il)+1.0_r8)/rijp2  &
 &         -pxhe4(3,il)*pxhe4(4,il)*(pxhe4(4,il)-1.0_r8)*rijp4  &
 &         +pxhe4(5,il))/rij**2
     ulxs=ulxs+2.0_r8*ulxp/rij
     grul%comp=ulxp/rij*rivec%comp
     grpl%comp=d1pl(il)*grz%comp
     lapl=lapz*d1pl(il)+grz2*d2pl(il)
     d1ux%comp=d1ux%comp+pl(il)*grul%comp
     d1ux%comp=d1ux%comp+ulx*grpl%comp
     d2ux=d2ux+pl(il)*ulxs
     d2ux=d2ux+ulx*lapl
     d2ux=d2ux+2.0_r8*dot_product(grul%comp,grpl%comp)
     d1zux(:)=d1zux(:)+ulx*d1pl(il)*gpz(:)
     d2zux=d2zux+ulx*(d1pl(il)*lpz+d2pl(il)*gpz2)
   enddo
end subroutine duhe4x

attributes(host, device) function uhe4x(rij, cth)
  real(kind=r8) :: uhe4x
  real(kind=r8), intent (in) :: rij,cth
  real(kind=r8) :: pl(0:lmax_dev)
  real(kind=r8) :: ul
  integer(kind=i4) :: il

   call calpleg(lxhe4,cth,pl(0:lxhe4))
   do il=1,lxhe4
     pl(il)=1.0_r8-pl(il)
   enddo

   uhe4x=0.0_r8
   do il=0,lxhe4
     ul=-pxhe4(1,il)/mypow(rij,pxhe4(2,il))-pxhe4(3,il)*mypow(rij,pxhe4(4,il))  &
 &      -pxhe4(5,il)*log(rij)
     uhe4x=uhe4x+ul*pl(il)
   enddo
end function uhe4x

! un hilo = un rivec (+ el marco smol compartido) = un duhe4x
attributes(global) subroutine k_duhe4x(n, rivec, smol, d1ux, d2ux, d1zux, d2zux)
  integer(kind=i4), value :: n
  type(vec3), device, intent (in)  :: rivec(n), smol(3)
  type(vec3), device, intent (out) :: d1ux(n)
  real(kind=r8), device, intent (out) :: d2ux(n)
  real(kind=r8), device, intent (out) :: d1zux(2,n), d2zux(n)
  integer(kind=i4) :: i

  i = (blockIdx%x - 1) * blockDim%x + threadIdx%x
  if (i <= n) then
    call duhe4x(rivec(i), smol, d1ux(i), d2ux(i), d1zux(:,i), d2zux(i))
  endif
end subroutine k_duhe4x

! un hilo = un (rij,cth) = un uhe4x
attributes(global) subroutine k_uhe4x(n, rij, cth, uhe4x_out)
  integer(kind=i4), value :: n
  real(kind=r8), device, intent (in)  :: rij(n), cth(n)
  real(kind=r8), device, intent (out) :: uhe4x_out(n)
  integer(kind=i4) :: i

  i = (blockIdx%x - 1) * blockDim%x + threadIdx%x
  if (i <= n) then
    uhe4x_out(i) = uhe4x(rij(i), cth(i))
  endif
end subroutine k_uhe4x

end module d_uhex4


program test_duhe4x
 ! CPU de confianza: duhe4x/uhe4x de mangwavef.f90 sin tocar. Aqui SI es
 ! un modulo (a diferencia de bh_heh2m.f), asi que se importa con "use"
 ! renombrando para no chocar con las versiones GPU de d_uhex4.
 use mangwavef, only: duhe4x_cpu => duhe4x, uhe4x_cpu => uhe4x
 use mtipos, only: vec3
 use mparametros, only: lxhe4_real => lxhe4, impurmol_real => impurmol, &
                         pxhe4_real => pxhe4
 use d_uhex4
 use cudafor
 implicit none
 integer, parameter :: i4 = selected_int_kind(9)
 integer, parameter :: r8 = selected_real_kind(15,9)

 integer(kind=i4), parameter :: n = 9

 ! valores reales de in.mcv (l=0..4, columna "b,nu,alfa,p4,p5" impureza-he4)
 real(kind=r8), parameter :: bxhe4(0:4)    = (/ 1.680309d0, 0.000000d0, 3.033954d0, 0.000000d0, 0.732198d0 /)
 real(kind=r8), parameter :: nuxhe4(0:4)   = (/ 9.763290d0, 1.000000d0, 3.155952d0, 1.000000d0, 11.036848d0 /)
 real(kind=r8), parameter :: alfaxhe4(0:4) = (/ 0.643208d0, 0.000000d0, 0.004908d0, 0.000000d0, 0.078598d0 /)
 real(kind=r8), parameter :: p4xhe4(0:4)   = (/ 0.129298d0, 0.000000d0, 0.084248d0, 0.000000d0, 0.096948d0 /)
 real(kind=r8), parameter :: p5xhe4(0:4)   = (/ 13.568705d0, 0.000000d0, 0.000706d0, 0.000000d0, 0.020823d0 /)

 type(vec3) :: rivec_h(n), smol_h(3)
 type(vec3) :: d1ux_cpu(n), d1ux_h(n)
 real(kind=r8) :: d2ux_cpu(n), d1zux_cpu(2,n), d2zux_cpu(n)
 real(kind=r8) :: d2ux_h(n), d1zux_h(2,n), d2zux_h(n)
 real(kind=r8) :: uhe4x_cpu_v(n), uhe4x_h(n)
 real(kind=r8) :: rij_h(n), cth_h(n)

 type(vec3), device :: rivec_d(n), smol_d(3)
 type(vec3), device :: d1ux_d(n)
 real(kind=r8), device :: d2ux_d(n), d1zux_d(2,n), d2zux_d(n)
 real(kind=r8), device :: rij_d(n), cth_d(n), uhe4x_d(n)

 integer(kind=i4) :: il, i, threads, blocks
 real(kind=r8) :: err, errmax

  ! datos "de simulacion" (equivalentes a lo que mentradatos.f90 deja en
  ! mparametros): lxhe4=4 e impurmol=.T. son los valores reales de este
  ! in.mcv. pxhe4 se calcula con la MISMA formula que usa mentradatos.f90
  ! (0.5*b**nu, nu, alfa, p4, p5) a partir de los b/nu/alfa/p4/p5 de arriba,
  ! en vez de teclear pxhe4 ya calculado a mano.
  lxhe4 = 4
  impurmol = .true.
  do il = 0, 4
    pxhe4(1,il) = 0.50_r8*(bxhe4(il)**nuxhe4(il))
    pxhe4(2,il) = nuxhe4(il)
    pxhe4(3,il) = alfaxhe4(il)
    pxhe4(4,il) = p4xhe4(il)
    pxhe4(5,il) = p5xhe4(il)
  enddo

  ! marco molecular sin rotar (ejes cartesianos estandar)
  smol_h(1)%comp = (/ 1.0d0, 0.0d0, 0.0d0 /)
  smol_h(2)%comp = (/ 0.0d0, 1.0d0, 0.0d0 /)
  smol_h(3)%comp = (/ 0.0d0, 0.0d0, 1.0d0 /)

  ! 4 posiciones relativas He-impureza de prueba (bohr)
  rivec_h(1)%comp = (/  3.0d0,  0.0d0,  0.0d0 /)
  rivec_h(2)%comp = (/  0.0d0,  4.0d0,  0.0d0 /)
  rivec_h(3)%comp = (/  2.0d0,  2.0d0,  3.0d0 /)
  rivec_h(4)%comp = (/ -1.5d0,  2.5d0, -3.2d0 /)
  ! extremos: contacto muy cercano, largo alcance, y los 3 angulos
  ! "especiales" de calpleg (cth=+1,-1,0) respecto al eje smol(3)
  rivec_h(5)%comp = (/  0.1d0,  0.0d0,  0.0d0 /)   ! contacto muy cercano
  rivec_h(6)%comp = (/  0.0d0,  0.0d0, 1000.0d0 /) ! largo alcance
  rivec_h(7)%comp = (/  0.0d0,  0.0d0,  5.0d0 /)   ! cth=+1 exacto
  rivec_h(8)%comp = (/  0.0d0,  0.0d0, -5.0d0 /)   ! cth=-1 exacto
  rivec_h(9)%comp = (/  5.0d0,  0.0d0,  0.0d0 /)   ! cth=0 exacto

  do i = 1, n
    rij_h(i) = sqrt(dot_product(rivec_h(i)%comp, rivec_h(i)%comp))
    cth_h(i) = rivec_h(i)%comp(3) / rij_h(i)   ! cos(theta) respecto al eje smol(3)
  enddo

  smol_d  = smol_h
  rivec_d = rivec_h
  rij_d   = rij_h
  cth_d   = cth_h

  threads = 32
  blocks = (n + threads - 1) / threads

  call k_duhe4x<<<blocks,threads>>>(n, rivec_d, smol_d, d1ux_d, d2ux_d, d1zux_d, d2zux_d)
  call k_uhe4x<<<blocks,threads>>>(n, rij_d, cth_d, uhe4x_d)

  d1ux_h  = d1ux_d
  d2ux_h  = d2ux_d
  d1zux_h = d1zux_d
  d2zux_h = d2zux_d
  uhe4x_h = uhe4x_d

  ! referencia CPU: se rellenan lxhe4/impurmol/pxhe4 REALES de mparametros
  ! (mismos valores, distinta variable) y se llama a mangwavef.f90 sin tocar
  lxhe4_real = 4
  impurmol_real = .true.
  pxhe4_real(:,0:4) = pxhe4(:,0:4)   ! copia device->host de lo ya calculado arriba

  errmax = 0.0d0
  do i = 1, n
    call duhe4x_cpu(rivec_h(i), smol_h, d1ux_cpu(i), d2ux_cpu(i), d1zux_cpu(:,i), d2zux_cpu(i))
    uhe4x_cpu_v(i) = uhe4x_cpu(rij_h(i), cth_h(i))

    write(*,*)
    write(*,'(a,i0)') '--- rivec ', i
    write(*,'(a,3f18.12)') '  d1ux%comp CPU=', d1ux_cpu(i)%comp
    write(*,'(a,3f18.12)') '  d1ux%comp GPU=', d1ux_h(i)%comp
    write(*,'(a,f18.12,a,f18.12)') '  d2ux  CPU=', d2ux_cpu(i), '   GPU=', d2ux_h(i)
    write(*,'(a,f18.12,a,f18.12)') '  uhe4x CPU=', uhe4x_cpu_v(i), '   GPU=', uhe4x_h(i)
    write(*,'(a,3es24.17)') '  HP d1ux%comp CPU=', d1ux_cpu(i)%comp
    write(*,'(a,3es24.17)') '  HP d1ux%comp GPU=', d1ux_h(i)%comp
    write(*,'(a,es24.17,a,es24.17)') '  HP d2ux  CPU=', d2ux_cpu(i), '   GPU=', d2ux_h(i)
    write(*,'(a,2es24.17)') '  HP d1zux CPU=', d1zux_cpu(:,i)
    write(*,'(a,2es24.17)') '  HP d1zux GPU=', d1zux_h(:,i)
    write(*,'(a,es24.17,a,es24.17)') '  HP d2zux CPU=', d2zux_cpu(i), '   GPU=', d2zux_h(i)
    write(*,'(a,es24.17,a,es24.17)') '  HP uhe4x CPU=', uhe4x_cpu_v(i), '   GPU=', uhe4x_h(i)

    err = max(maxval(abs(d1ux_h(i)%comp - d1ux_cpu(i)%comp)), &
              abs(d2ux_h(i) - d2ux_cpu(i)), &
              maxval(abs(d1zux_h(:,i) - d1zux_cpu(:,i))), &
              abs(d2zux_h(i) - d2zux_cpu(i)), &
              abs(uhe4x_h(i) - uhe4x_cpu_v(i)))
    write(*,'(a,es10.2)') '  |err| max=', err
    errmax = max(errmax, err)
  enddo

  write(*,*)
  if (errmax < 1.0d-9) then
    write(*,*) 'PASA: GPU y CPU coinciden dentro de tolerancia'
  else
    write(*,*) 'FALLA: diferencia maxima =', errmax
  endif

end program test_duhe4x
