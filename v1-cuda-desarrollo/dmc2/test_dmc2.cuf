! test_dmc2.cuf
!
! Mismos 5 walkers que hpsi.cuf/derananum.cuf (3 normales + contacto
! muy cercano + largo alcance). Para cada uno: se llama a hpsi una vez
! para fijar el estado inicial (wf/ene/dwf/dphi, igual que hace
! iniwalkers en mmontecarlo.f90 antes del primer paso DMC), se reparte
! una semilla por walker (k_split_seeds, mismo mecanismo que
! mrandom.md), y se ejecuta un paso completo de dmc2.
!
! CPU de confianza: dmc2 de msteps.f90 ORIGINAL, sin tocar (recibe el
! type(walker) completo).

program test_dmc2
 use mdmc2, only: k_dmc2, ncmtras, dtau, etrial
 use mhpsi, only: k_hpsi, libre
 use mrandgpu, only: k_split_seeds
 use mderananum
 use mvpot, only: opot
 use mpotenbh, only: dhcm
 use mccuerpo, only: ngatom_cc => ngatom, natom_cc => natom
 use mwavef, only: hpsi_cpu => hpsi
 use msteps, only: dmc2_cpu => dmc2
 use mrandom, only: fijasemilla
 use mrandom2, only: rand1p
 use mtipos, only: vec3, walker, allocatewalker
 use mparametros, only: nhe4_real => nhe4, nhe3_real => nhe3, ngatom_real => ngatom, &
                         natom_real => natom, impureza_real => impureza, impurmol_real => impurmol, &
                         lxhe4_real => lxhe4, pxhe4_real => pxhe4, lxhe3_real => lxhe3, pxhe3_real => pxhe3, &
                         phe4_real => phe4, phe3_real => phe3, pmix_real => pmix, &
                         nhe3up_real => nhe3up, nhe3dw_real => nhe3dw, &
                         mhe4_real => mhe4, mhe3_real => mhe3, mx_real => mx, &
                         impurfija_real => impurfija, rotamol_real => rotamol, &
                         opot_real => opot, libre_real => libre, &
                         ncmtras_real => ncmtras, dtau_real => dtau, etrial_real => etrial
 use mwavef_gpu, only: pmix_dev => pmix, phe3, nhe3up, nhe3dw, mhe4, mhe3, mx
 use d_uhex4, only: lxhe4, pxhe4, impurmol
 use der_wavefx, only: nhe4, nhe3, ngatom, natom, impureza
 use der_wavefhe4, only: nhe4_he4 => nhe4, phe4
 use cudafor
 implicit none
 integer, parameter :: i4 = selected_int_kind(9)
 integer, parameter :: i8 = selected_int_kind(15)
 integer, parameter :: r8 = selected_real_kind(15,9)

 real(kind=r8) :: dhcm_cpu
 common / datosbh / dhcm_cpu

 integer(kind=i4), parameter :: n_he4  = 4
 integer(kind=i4), parameter :: n_atom = n_he4 + 1
 integer(kind=i4), parameter :: n_walk = 5

 real(kind=r8), parameter :: bxhe4(0:4)    = (/ 1.680309d0, 0.000000d0, 3.033954d0, 0.000000d0, 0.732198d0 /)
 real(kind=r8), parameter :: nuxhe4(0:4)   = (/ 9.763290d0, 1.000000d0, 3.155952d0, 1.000000d0, 11.036848d0 /)
 real(kind=r8), parameter :: alfaxhe4(0:4) = (/ 0.643208d0, 0.000000d0, 0.004908d0, 0.000000d0, 0.078598d0 /)
 real(kind=r8), parameter :: p4xhe4(0:4)   = (/ 0.129298d0, 0.000000d0, 0.084248d0, 0.000000d0, 0.096948d0 /)
 real(kind=r8), parameter :: p5xhe4(0:4)   = (/ 13.568705d0, 0.000000d0, 0.000706d0, 0.000000d0, 0.020823d0 /)
 real(kind=r8), parameter :: bhe4 = 3.139383d0, nuhe4 = 4.725025d0, alfahe4 = 0.009428d0
 real(kind=r8), parameter :: hb2he4_real = 0.5219359033034199_r8
 real(kind=r8), parameter :: hb2x_real   = 1.036440145869973_r8
 real(kind=r8), parameter :: brot_real   = 3.6975845184944736_r8
 real(kind=r8), parameter :: dhcm_real   = 0.52943550d0
 real(kind=r8), parameter :: dtau_val    = 1.0d-3
 real(kind=r8), parameter :: etrial_val  = -150.0d0
 integer(kind=i8), parameter :: seed0    = 123456789013_i8

 type(vec3) :: atom_h(n_atom,n_walk), sprop_h(3,n_walk), atom0(n_atom,n_walk), sprop0(3,n_walk)
 type(vec3), device :: atom_d(n_atom,n_walk), sprop_d(3,n_walk)
 real(kind=r8) :: hb2m_h(n_atom,n_walk), b_h(n_walk)
 real(kind=r8), device :: hb2m_d(n_atom,n_walk), b_d(n_walk)

 real(kind=r8), device :: wf_d(n_walk), wfhe4_d(n_walk), wfhe3_d(n_walk), wfm_d(n_walk), wfx_d(n_walk)
 real(kind=r8), device :: kin_d(n_walk), eimp_d(n_walk), erot_d(n_walk), pot_d(n_walk), ene_d(n_walk)
 type(vec3), device :: dwf_d(n_atom,n_walk)
 real(kind=r8), device :: dphi_d(2,n_walk)
 integer(kind=i8), device :: irn_d(n_walk)
 integer(kind=i4), device :: nsons_d(n_walk)

 real(kind=r8) :: wf_h(n_walk), wfhe4_h(n_walk), wfhe3_h(n_walk), wfm_h(n_walk), wfx_h(n_walk)
 real(kind=r8) :: kin_h(n_walk), eimp_h(n_walk), erot_h(n_walk), pot_h(n_walk), ene_h(n_walk)
 type(vec3) :: dwf_h(n_atom,n_walk)
 real(kind=r8) :: dphi_h(2,n_walk)
 integer(kind=i8) :: irn_h(n_walk)
 integer(kind=i4) :: nsons_h(n_walk)

 real(kind=r8) :: wf_cpu, wfhe4_cpu, wfhe3_cpu, wfm_cpu, wfx_cpu
 real(kind=r8) :: kin_cpu, eimp_cpu, erot_cpu, pot_cpu, ene_cpu
 type(vec3) :: dwf_cpu(n_atom)
 real(kind=r8) :: dphi_cpu(2)
 integer(kind=i4) :: nsons_cpu

 type(walker) :: w1
 integer(kind=i4) :: iw, ia, threads, blocks
 real(kind=r8) :: err, errmax
 real(kind=r8), device :: ene0_d(n_walk)
 real(kind=r8) :: ene0_h(n_walk)
 real(kind=r8) :: ene0_cpu
 logical :: gb_patologico

  ! ---- copias device (GPU) ----
  libre = .false.
  nhe4 = n_he4
  nhe3 = 0
  ngatom = n_he4
  natom = n_atom
  impureza = .true.
  impurmol = .true.
  impurfija = .false.
  rotamol = .true.
  lxhe4 = 4
  do ia = 0, 4
    pxhe4(1,ia) = 0.50_r8*(bxhe4(ia)**nuxhe4(ia))
    pxhe4(2,ia) = nuxhe4(ia)
    pxhe4(3,ia) = alfaxhe4(ia)
    pxhe4(4,ia) = p4xhe4(ia)
    pxhe4(5,ia) = p5xhe4(ia)
  enddo
  nhe4_he4 = n_he4
  phe4(1) = 0.50_r8*(bhe4**nuhe4)
  phe4(2) = nuhe4
  phe4(3) = alfahe4
  phe3 = 0.0_r8
  pmix_dev(1) = 0.0_r8
  pmix_dev(2) = 1.0_r8
  pmix_dev(3) = 0.0_r8
  nhe3up = 0
  nhe3dw = 0
  mhe4 = 4.00260_r8
  mhe3 = 3.01604_r8
  mx   = 2.01565006_r8
  ngatom_cc = n_he4
  natom_cc  = n_atom
  opot = 4
  dhcm = dhcm_real
  ncmtras = n_atom
  dtau = dtau_val
  etrial = etrial_val

  ! ---- copias reales (CPU), mparametros.f90 ----
  libre_real = .false.
  nhe4_real = n_he4
  nhe3_real = 0
  ngatom_real = n_he4
  natom_real = n_atom
  impureza_real = .true.
  impurmol_real = .true.
  impurfija_real = .false.
  rotamol_real = .true.
  lxhe4_real = 4
  pxhe4_real(:,0:4) = pxhe4(:,0:4)
  lxhe3_real = 0
  pxhe3_real = 0.0_r8
  phe4_real = phe4
  phe3_real = phe3
  pmix_real = pmix_dev
  nhe3up_real = 0
  nhe3dw_real = 0
  mhe4_real = mhe4
  mhe3_real = mhe3
  mx_real   = mx
  opot_real = 4
  dhcm_cpu = dhcm_real
  ncmtras_real = n_atom
  dtau_real = dtau_val
  etrial_real = etrial_val

  atom_h(1,1)%comp = (/  0.0d0,  0.0d0,  0.0d0 /)
  atom_h(2,1)%comp = (/  3.5d0,  0.0d0,  0.0d0 /)
  atom_h(3,1)%comp = (/  0.0d0,  4.0d0,  1.0d0 /)
  atom_h(4,1)%comp = (/ -2.0d0, -3.0d0,  2.5d0 /)
  atom_h(5,1)%comp = (/  1.0d0,  1.0d0,  1.0d0 /)

  atom_h(1,2)%comp = (/  1.0d0,  1.0d0,  1.0d0 /)
  atom_h(2,2)%comp = (/ -1.0d0,  2.0d0,  0.5d0 /)
  atom_h(3,2)%comp = (/  2.5d0, -1.5d0,  3.0d0 /)
  atom_h(4,2)%comp = (/  0.0d0,  0.0d0, -4.0d0 /)
  atom_h(5,2)%comp = (/  0.5d0, -0.5d0,  0.5d0 /)

  atom_h(1,3)%comp = (/  5.0d0,  0.0d0,  0.0d0 /)
  atom_h(2,3)%comp = (/  0.0d0,  5.0d0,  0.0d0 /)
  atom_h(3,3)%comp = (/  0.0d0,  0.0d0,  5.0d0 /)
  atom_h(4,3)%comp = (/  2.0d0,  2.0d0,  2.0d0 /)
  atom_h(5,3)%comp = (/  1.5d0,  1.5d0,  1.5d0 /)

  ! walker 4 (extremo): impureza a contacto muy cercano de un atomo
  ! de He4 (rij~0.05) -- ejercita el "return" anticipado por wftest<ratio
  atom_h(1,4)%comp = (/  1.05d0,  1.0d0,  1.0d0 /)
  atom_h(2,4)%comp = (/ -1.0d0,  2.0d0,  0.5d0 /)
  atom_h(3,4)%comp = (/  2.5d0, -1.5d0,  3.0d0 /)
  atom_h(4,4)%comp = (/  0.0d0,  0.0d0, -4.0d0 /)
  atom_h(5,4)%comp = (/  1.0d0,  1.0d0,  1.0d0 /)

  ! walker 5 (extremo): impureza a largo alcance de los 4 atomos de He4
  atom_h(1,5)%comp = (/ 1000.0d0,    0.0d0,    0.0d0 /)
  atom_h(2,5)%comp = (/    0.0d0, 1000.0d0,    0.0d0 /)
  atom_h(3,5)%comp = (/    0.0d0,    0.0d0, 1000.0d0 /)
  atom_h(4,5)%comp = (/-1000.0d0,    0.0d0,    0.0d0 /)
  atom_h(5,5)%comp = (/    0.0d0,    0.0d0,    0.0d0 /)

  sprop_h(1,1)%comp = (/ 2.0d0, 0.0d0, 0.0d0 /)
  sprop_h(2,1)%comp = (/ 0.0d0, 1.5d0, 0.0d0 /)
  sprop_h(3,1)%comp = (/ 0.3d0, 0.4d0, 1.2d0 /)

  sprop_h(1,2)%comp = (/ 1.0d0, 0.2d0, 0.0d0 /)
  sprop_h(2,2)%comp = (/ 0.0d0, 1.0d0, 0.3d0 /)
  sprop_h(3,2)%comp = (/ 0.5d0, 0.0d0, 1.0d0 /)

  sprop_h(1,3)%comp = (/ 0.7d0, 0.7d0, 0.0d0 /)
  sprop_h(2,3)%comp = (/ -0.7d0, 0.7d0, 0.0d0 /)
  sprop_h(3,3)%comp = (/ 0.0d0, 0.0d0, 2.0d0 /)

  sprop_h(1,4)%comp = (/ 1.0d0, 0.2d0, 0.0d0 /)
  sprop_h(2,4)%comp = (/ 0.0d0, 1.0d0, 0.3d0 /)
  sprop_h(3,4)%comp = (/ 0.5d0, 0.0d0, 1.0d0 /)

  sprop_h(1,5)%comp = (/ 0.7d0, 0.7d0, 0.0d0 /)
  sprop_h(2,5)%comp = (/ -0.7d0, 0.7d0, 0.0d0 /)
  sprop_h(3,5)%comp = (/ 0.0d0, 0.0d0, 2.0d0 /)

  do iw = 1, n_walk
    do ia = 1, n_he4
      hb2m_h(ia,iw) = hb2he4_real
    enddo
    hb2m_h(n_atom,iw) = hb2x_real
    b_h(iw) = brot_real
  enddo

  atom0 = atom_h
  sprop0 = sprop_h
  atom_d  = atom_h
  sprop_d = sprop_h
  hb2m_d  = hb2m_h
  b_d     = b_h

  threads = 32
  blocks = (n_walk + threads - 1) / threads

  ! ---- estado inicial: una llamada a hpsi (igual que iniwalkers) ----
  call k_hpsi<<<blocks,threads>>>(n_walk, atom_d, sprop_d, hb2m_d, b_d, &
                                   wf_d, wfhe4_d, wfhe3_d, wfm_d, wfx_d, &
                                   kin_d, eimp_d, erot_d, pot_d, ene_d, dwf_d, dphi_d)

  ene0_d = ene_d
  ene0_h = ene0_d

  ! ---- reparto de semillas, una por walker ----
  call k_split_seeds<<<blocks,threads>>>(n_walk, seed0, irn_d)

  ! ---- paso DMC completo ----
  call k_dmc2<<<blocks,threads>>>(n_walk, atom_d, sprop_d, hb2m_d, b_d, &
                                   wf_d, wfhe4_d, wfhe3_d, wfm_d, wfx_d, &
                                   kin_d, eimp_d, erot_d, pot_d, ene_d, &
                                   dwf_d, dphi_d, irn_d, nsons_d)

  atom_h=atom_d; sprop_h=sprop_d
  wf_h=wf_d; wfhe4_h=wfhe4_d; wfhe3_h=wfhe3_d; wfm_h=wfm_d; wfx_h=wfx_d
  kin_h=kin_d; eimp_h=eimp_d; erot_h=erot_d; pot_h=pot_d; ene_h=ene_d
  dwf_h=dwf_d; dphi_h=dphi_d; irn_h=irn_d; nsons_h=nsons_d

  errmax = 0.0d0
  do iw = 1, n_walk
    call allocatewalker(w1, n_atom)
    do ia = 1, n_atom
      w1%atom(ia) = atom0(ia,iw)
      w1%hb2m(ia) = hb2m_h(ia,iw)
      ! sigma1/sigma2: normalmente los fija iniwalkers (mmontecarlo.f90:
      ! 436-450) una sola vez, a partir de hb2m/dtau -- aqui se fijan
      ! igual, a mano, ya que no llamamos a iniwalkers en esta prueba.
      w1%sigma1(ia) = sqrt(2.0_r8*w1%hb2m(ia)*dtau_val)
      w1%sigma2(ia) = 2.0_r8*w1%hb2m(ia)*dtau_val
    enddo
    w1%sprop(1) = sprop0(1,iw)
    w1%sprop(2) = sprop0(2,iw)
    w1%sprop(3) = sprop0(3,iw)
    w1%b = b_h(iw)
    ! sig1rot/sig2rot/sig1hrot/sig2hrot: mismas formulas que
    ! mmontecarlo.f90:478-480 (brot=w1%b aqui)
    w1%sig1rot  = sqrt(2.0_r8*w1%b*dtau_val)
    w1%sig2rot  = 2.0_r8*w1%b*dtau_val
    w1%sig1hrot = sqrt(w1%b*dtau_val)
    w1%sig2hrot = w1%b*dtau_val

    call hpsi_cpu(w1)
    ene0_cpu = w1%lw%ene

    ! semilla de este walker: mismo reparto que k_split_seeds (rand1p
    ! aplicado iw veces desde la misma semilla maestra)
    block
      integer(kind=i8) :: irn_ref
      real(kind=r8) :: rn_ref
      integer(kind=i4) :: j
      irn_ref = seed0
      do j = 1, iw
        call rand1p(rn_ref, irn_ref)
      enddo
      call fijasemilla(irn_ref)
    end block

    call dmc2_cpu(w1, nsons_cpu)

    wf_cpu=real(w1%lw%wf,r8); wfhe4_cpu=real(w1%lw%wfhe4,r8)
    wfhe3_cpu=real(w1%lw%wfhe3,r8); wfm_cpu=real(w1%lw%wfm,r8); wfx_cpu=real(w1%lw%wfx,r8)
    kin_cpu=w1%lw%kin; eimp_cpu=w1%lw%eimp; erot_cpu=w1%lw%erot
    pot_cpu=w1%lw%pot; ene_cpu=w1%lw%ene
    do ia = 1, n_atom
      dwf_cpu(ia) = w1%dwf(ia)
    enddo
    dphi_cpu = w1%dphi

    write(*,*)
    write(*,'(a,i0)') '--- walker ', iw
    write(*,'(a,i0,a,i0)') '  nsons CPU=', nsons_cpu, '   GPU=', nsons_h(iw)
    write(*,'(a,es24.17,a,es24.17)') '  HP ene CPU=', ene_cpu, '   GPU=', ene_h(iw)
    write(*,'(a,es24.17,a,es24.17)') '  HP kin CPU=', kin_cpu, '   GPU=', kin_h(iw)
    write(*,'(a,es24.17,a,es24.17)') '  HP pot CPU=', pot_cpu, '   GPU=', pot_h(iw)

    ! caso patologico esperado (ver docs-kernels/dmc2.md): si la
    ! geometria inicial es muy extrema (ej. walker 3, energia de
    ! partida ~-2E7 por cancelacion casi total en dwf) y el paso
    ! aleatorio la mueve a una geometria normal, gb=exp(...) desborda
    ! a +Inf -- int(Inf+rn) es comportamiento NO DEFINIDO por el
    ! estandar (no hay "resultado correcto" que comparar), CPU y GPU
    ! pueden dar cualquier cosa sin que sea un error de puerto. Se
    ! detecta por el salto de energia y se excluye nsons de |err| en
    ! ese caso -- el resto de campos (atom/wf/kin/pot/ene/dwf/dphi) SI
    ! se comparan igual, sin ninguna excepcion.
    gb_patologico = abs(ene0_h(iw)-ene0_cpu) .gt. 1.0d3 .or. abs(ene0_cpu) .gt. 1.0d6

    err = abs(wf_h(iw)-wf_cpu)
    err = max(err, abs(kin_h(iw)-kin_cpu))
    err = max(err, abs(eimp_h(iw)-eimp_cpu))
    err = max(err, abs(erot_h(iw)-erot_cpu))
    err = max(err, abs(pot_h(iw)-pot_cpu))
    err = max(err, abs(ene_h(iw)-ene_cpu))
    if (gb_patologico) then
      write(*,*) '  (gb patologico: exp() desborda, nsons no comparable -- ver dmc2.md)'
    else
      err = max(err, real(abs(nsons_h(iw)-nsons_cpu),r8))
    endif
    do ia = 1, n_atom
      err = max(err, maxval(abs(atom_h(ia,iw)%comp-w1%atom(ia)%comp)))
      err = max(err, maxval(abs(dwf_h(ia,iw)%comp-dwf_cpu(ia)%comp)))
    enddo
    do ia = 1, 3
      err = max(err, maxval(abs(sprop_h(ia,iw)%comp-w1%sprop(ia)%comp)))
    enddo
    err = max(err, maxval(abs(dphi_h(:,iw)-dphi_cpu)))

    write(*,'(a,es10.2)') '  |err| max=', err
    errmax = max(errmax, err)
  enddo

  write(*,*)
  if (errmax < 1.0d-8) then
    write(*,*) 'PASA: GPU y CPU coinciden dentro de tolerancia'
  else
    write(*,*) 'FALLA: diferencia maxima =', errmax
  endif

end program test_dmc2
