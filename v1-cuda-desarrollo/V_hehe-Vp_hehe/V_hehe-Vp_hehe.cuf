module mVheheVphehe
! dexp/dsin/dcos sustituidas por myexp/mysin/mycos (glibc_math/,
! docs-kernels/glibc_math.md): reproducen bit a bit el algoritmo real
! de la glibc de esta maquina, en vez de depender de que la
! intrinseca de nvfortran (libnvcpumath/libdevice) coincida con la de
! gfortran (libm) por casualidad -- ver docs-kernels/
! gpu_vs_gfortran_arbol.md para el porque.
use glibc_exp_mod, only: myexp
use glibc_sincos_mod, only: mysin, mycos
implicit none
integer, private, parameter :: i4 = selected_int_kind(9)

contains
attributes(host, device) function V_hehe (r)
include 'param_atoms_bh_freeform.h'
double precision, intent(in) :: r
double precision :: V_hehe
double precision :: x, x2, x6, x8, x10, F, sum, addin
    x  = r/req_HeHe
    x2 = x*x
    x6 = x2*x2*x2
    x8 = x6*x2
    x10= x8*x2
    F = 1.d0
    if(x < D_HeHe) F=myexp(-(D_HeHe/x-1.d0)**2)
    sum = c6_HeHe/x6 + c8_HeHe/x8 + c10_HeHe/x10
    sum = A_HeHe*myexp(-alpha_HeHe*x + beta_HeHe*x2) - F*sum
    addin=0.d0
    if (x >= xx1_HeHe .and. x <=xx2_HeHe) then
        addin = Aa_HeHe*(mysin( Ba_HeHe*(x-xx1_HeHe)-pi12)+1.d0)
    end if
    V_hehe = sum + addin
    V_hehe = eps_HeHe * V_hehe

end function V_hehe

attributes(host, device) function Vp_hehe (r)
include 'param_atoms_bh_freeform.h'
    double precision, intent(in) :: r
    double precision :: x, x2, x3, x6, x7, x8, x9, x10, x11
    double precision :: F, Fp, sum1, sum2
    double precision :: Vap, Vbp, Vp_hehe

    x  = r/req_HeHe
    x2 = x*x
    x3 = x2*x
    x6 = x3*x3
    x7 = x6*x
    x8 = x6*x2
    x9 = x8*x
    x10= x8*x2
    x11= x10*x
    F  = 1.d0
    Fp = 0.d0
    if(x < D_HeHe) then
        F =myexp(-(D_HeHe/x-1.d0)**2)
        Fp=2.d0*(D_HeHe/x-1.d0)*(D_HeHe/x2) * F
    end if

    sum1 = c6_HeHe/x6 + c8_HeHe/x8 + c10_HeHe/x10
    sum2 = 6.d0*c6_HeHe/x7 + 8.d0*c8_HeHe/x9 + 10.d0*c10_HeHe/x11
    Vbp = A_HeHe*(-alpha_HeHe+2.d0*beta_HeHe*x) &
        *myexp(-alpha_HeHe*x + beta_HeHe*x2) - Fp*sum1 + F*sum2

    ! Vap solo se define dentro del rango [xx1_HeHe,xx2_HeHe] en el
    ! original (bh_heh2m.f:505-534): fuera de ese rango se usaba sin
    ! inicializar. Se corrige aqui recuperando la linea que estaba
    ! comentada en el original (!Vap=0.d0).
    Vap = 0.d0
    if (x >= xx1_HeHe .and. x <=xx2_HeHe) then
        Vap = Aa_HeHe * Ba_HeHe* mycos(Ba_HeHe*(x-xx1_HeHe)-pi12)
    end if

    Vp_hehe = (eps_HeHe/req_HeHe) * (Vap+Vbp)

end function Vp_hehe


! un hilo = un valor de r = un V_hehe(r)
attributes(global) subroutine k_V_hehe(n, r, v_out)
integer(kind=i4), value :: n
double precision, device, intent(in)  :: r(n)
double precision, device, intent(out) :: v_out(n)
integer(kind=i4) :: i

 i = (blockIdx%x - 1) * blockDim%x + threadIdx%x
   if (i <= n) then
     v_out(i) = V_hehe(r(i))
   endif

end subroutine k_V_hehe

! un hilo = un valor de r = un Vp_hehe(r)
attributes(global) subroutine k_Vp_hehe(n, r, v_out)
integer(kind=i4), value :: n
double precision, device, intent(in)  :: r(n)
double precision, device, intent(out) :: v_out(n)
integer(kind=i4) :: i

 i = (blockIdx%x - 1) * blockDim%x + threadIdx%x
   if (i <= n) then
     v_out(i) = Vp_hehe(r(i))
   endif

end subroutine k_Vp_hehe

end module mVheheVphehe


program test_V_hehe_Vp_hehe
 ! CPU "de confianza": las funciones de verdad de bh_heh2m.f (sin tocar),
 ! compiladas junto a este fichero. Son procedimientos externos (bh_heh2m.f
 ! no es un modulo), asi que se declaran explicitamente en vez de "use".
 use mVheheVphehe, only: k_V_hehe, k_Vp_hehe
 use cudafor
 implicit none
 double precision :: V_hehe, Vp_hehe
 external :: V_hehe, Vp_hehe

 integer, parameter :: i4 = selected_int_kind(9)
 integer(kind=i4), parameter :: n = 7

 ! valores de r (bohr) elegidos para cruzar los tres regimenes de V_hehe:
 ! corto alcance (F amortiguada), la ventana del termino "add-in"
 ! [xx1_HeHe,xx2_HeHe], y largo alcance (F=1, addin=0)
 double precision :: r_h(n)
 double precision :: v_cpu(n), vp_cpu(n)
 double precision :: v_h(n), vp_h(n)

 double precision, device :: r_d(n), v_d(n), vp_d(n)

 integer(kind=i4) :: i, threads, blocks
 double precision :: err_v, err_vp, errmax

  r_h = (/ 2.0d0, 3.0d0, 4.0d0, 5.0d0, 6.0d0, 8.0d0, 12.0d0 /)

  r_d = r_h   ! copia CPU -> GPU

  threads = 32
  blocks = (n + threads - 1) / threads

  call k_V_hehe<<<blocks, threads>>>(n, r_d, v_d)
  call k_Vp_hehe<<<blocks, threads>>>(n, r_d, vp_d)

  v_h  = v_d   ! copia GPU -> CPU
  vp_h = vp_d

  errmax = 0.0d0
  do i = 1, n
    v_cpu(i)  = V_hehe(r_h(i))
    vp_cpu(i) = Vp_hehe(r_h(i))

    write(*,*)
    write(*,'(a,i0,a,f8.4)') '--- par ', i, '   r = ', r_h(i)
    write(*,'(a,es16.8)') '  V_hehe  CPU:', v_cpu(i)
    write(*,'(a,es16.8)') '  V_hehe  GPU:', v_h(i)
    write(*,'(a,es16.8)') '  Vp_hehe CPU:', vp_cpu(i)
    write(*,'(a,es16.8)') '  Vp_hehe GPU:', vp_h(i)
    ! alta precision (17 cifras significativas, cubre un double
    ! entero), solo para comparar contra gfortran a nivel de bit
    write(*,'(a,es24.17)') '  HP V_hehe  CPU:', v_cpu(i)
    write(*,'(a,es24.17)') '  HP V_hehe  GPU:', v_h(i)
    write(*,'(a,es24.17)') '  HP Vp_hehe CPU:', vp_cpu(i)
    write(*,'(a,es24.17)') '  HP Vp_hehe GPU:', vp_h(i)

    err_v  = abs(v_h(i)  - v_cpu(i))
    err_vp = abs(vp_h(i) - vp_cpu(i))
    write(*,'(a,es10.2,a,es10.2)') '  |err|  V_hehe=', err_v, '   Vp_hehe=', err_vp

    errmax = max(errmax, err_v, err_vp)
  enddo

  write(*,*)
  if (errmax < 1.0d-10) then
    write(*,*) 'PASA: GPU y CPU coinciden dentro de tolerancia'
  else
    write(*,*) 'FALLA: diferencia maxima =', errmax
  endif

end program test_V_hehe_Vp_hehe
