module mccuerpo
 use mtipos, only: vec3
 implicit none
 integer, private, parameter :: i4 = selected_int_kind(9)
 integer, private, parameter :: r8 = selected_real_kind(15,9)
 integer(kind=i4), device :: ngatom, natom

contains

attributes(host, device) subroutine ccuerpo(atom, sprop, rhesal)
  type(vec3), intent (in)  :: atom(natom), sprop(3)
  real(kind=r8), intent (out) :: rhesal(3*ngatom)
  type(vec3) :: rtemp
  integer(kind=i4) :: iatom,jatom,ic,jc

    iatom=0
      do jatom=1,ngatom
          rtemp%comp = atom(jatom)%comp - atom(natom)%comp
         do ic=1,3
           rhesal(iatom+ic)=0.0_r8
           do jc=1,3
             rhesal(iatom+ic)=rhesal(iatom+ic)+sprop(ic)%comp(jc)*rtemp%comp(jc)
           enddo
         enddo
         iatom=iatom+3
      enddo

 end subroutine ccuerpo

attributes(global) subroutine k_ccuerpo(n, atom, sprop, rhesal)
  integer(kind=i4), value :: n
  type(vec3), device, intent (in)  :: atom(natom,n), sprop(3,n)
  real(kind=r8), device, intent (out) :: rhesal(3*ngatom,n)
  integer(kind=i4) :: i

  i = (blockIdx%x - 1) * blockDim%x + threadIdx%x
  if (i <= n) then
    call ccuerpo(atom(:,i), sprop(:,i), rhesal(:,i))
  endif
end subroutine k_ccuerpo

end module mccuerpo


program test_ccuerpo
 ! CPU de confianza: ccuerpo de msistref.f90 ORIGINAL, sin tocar (recibe
 ! el type(walker) completo, tal cual la simulacion real).
 use mccuerpo, only: k_ccuerpo, ngatom, natom
 use msistref, only: ccuerpo
 use mtipos, only: vec3, walker, allocatewalker
 use mparametros, only: ngatom_real => ngatom, natom_real => natom
 use cudafor
 implicit none
 integer, parameter :: i4 = selected_int_kind(9)
 integer, parameter :: r8 = selected_real_kind(15,9)

 integer(kind=i4), parameter :: n_gatom = 4
 integer(kind=i4), parameter :: n_atom  = n_gatom + 1
 integer(kind=i4), parameter :: n_walk  = 3

 type(vec3) :: atom_h(n_atom,n_walk), sprop_h(3,n_walk)
 real(kind=r8) :: rhesal_cpu(3*n_gatom,n_walk), rhesal_h(3*n_gatom,n_walk)
 type(vec3), device :: atom_d(n_atom,n_walk), sprop_d(3,n_walk)
 real(kind=r8), device :: rhesal_d(3*n_gatom,n_walk)

 type(walker) :: w1
 integer(kind=i4) :: iw, ia, threads, blocks
 real(kind=r8) :: err, errmax

  atom_h(1,1)%comp = (/  0.0d0,  0.0d0,  0.0d0 /)
  atom_h(2,1)%comp = (/  3.5d0,  0.0d0,  0.0d0 /)
  atom_h(3,1)%comp = (/  0.0d0,  4.0d0,  1.0d0 /)
  atom_h(4,1)%comp = (/ -2.0d0, -3.0d0,  2.5d0 /)
  atom_h(5,1)%comp = (/  1.0d0,  1.0d0,  1.0d0 /)

  atom_h(1,2)%comp = (/  1.0d0,  1.0d0,  1.0d0 /)
  atom_h(2,2)%comp = (/ -1.0d0,  2.0d0,  0.5d0 /)
  atom_h(3,2)%comp = (/  2.5d0, -1.5d0,  3.0d0 /)
  atom_h(4,2)%comp = (/  0.0d0,  0.0d0, -4.0d0 /)
  atom_h(5,2)%comp = (/  0.5d0, -0.5d0,  0.5d0 /)

  atom_h(1,3)%comp = (/  5.0d0,  0.0d0,  0.0d0 /)
  atom_h(2,3)%comp = (/  0.0d0,  5.0d0,  0.0d0 /)
  atom_h(3,3)%comp = (/  0.0d0,  0.0d0,  5.0d0 /)
  atom_h(4,3)%comp = (/  2.0d0,  2.0d0,  2.0d0 /)
  atom_h(5,3)%comp = (/  1.5d0,  1.5d0,  1.5d0 /)

  sprop_h(1,1)%comp = (/ 2.0d0, 0.0d0, 0.0d0 /)
  sprop_h(2,1)%comp = (/ 0.0d0, 1.5d0, 0.0d0 /)
  sprop_h(3,1)%comp = (/ 0.3d0, 0.4d0, 1.2d0 /)

  sprop_h(1,2)%comp = (/ 1.0d0, 0.2d0, 0.0d0 /)
  sprop_h(2,2)%comp = (/ 0.0d0, 1.0d0, 0.3d0 /)
  sprop_h(3,2)%comp = (/ 0.5d0, 0.0d0, 1.0d0 /)

  sprop_h(1,3)%comp = (/ 0.7d0, 0.7d0, 0.0d0 /)
  sprop_h(2,3)%comp = (/ -0.7d0, 0.7d0, 0.0d0 /)
  sprop_h(3,3)%comp = (/ 0.0d0, 0.0d0, 2.0d0 /)

  ! ngatom/natom: hay que fijar las DOS copias por separado -- la
  ! device de mccuerpo (la que ve el kernel) y la real de mparametros
  ! (la que ve ccuerpo del msistref.f90 ORIGINAL, usado como CPU)
  ngatom = n_gatom
  natom  = n_atom
  ngatom_real = n_gatom
  natom_real  = n_atom

  atom_d  = atom_h
  sprop_d = sprop_h

  threads = 32
  blocks = (n_walk + threads - 1) / threads
  call k_ccuerpo<<<blocks,threads>>>(n_walk, atom_d, sprop_d, rhesal_d)
  rhesal_h = rhesal_d

  errmax = 0.0d0
  do iw = 1, n_walk
    call allocatewalker(w1, n_atom)
    do ia = 1, n_atom
      w1%atom(ia) = atom_h(ia,iw)
    enddo
    w1%sprop(1) = sprop_h(1,iw)
    w1%sprop(2) = sprop_h(2,iw)
    w1%sprop(3) = sprop_h(3,iw)

    call ccuerpo(w1, rhesal_cpu(:,iw))

    write(*,*)
    write(*,'(a,i0)') '--- walker ', iw
    write(*,'(a,3f16.8)') '  rhesal(1:3) CPU=', rhesal_cpu(1:3,iw)
    write(*,'(a,3f16.8)') '  rhesal(1:3) GPU=', rhesal_h(1:3,iw)
    write(*,'(a,3f16.8)') '  rhesal(4:6) CPU=', rhesal_cpu(4:6,iw)
    write(*,'(a,3f16.8)') '  rhesal(4:6) GPU=', rhesal_h(4:6,iw)
    write(*,'(a,3es24.17)') '  HP rhesal(1:3) CPU=', rhesal_cpu(1:3,iw)
    write(*,'(a,3es24.17)') '  HP rhesal(1:3) GPU=', rhesal_h(1:3,iw)
    write(*,'(a,3es24.17)') '  HP rhesal(4:6) CPU=', rhesal_cpu(4:6,iw)
    write(*,'(a,3es24.17)') '  HP rhesal(4:6) GPU=', rhesal_h(4:6,iw)

    err = maxval(abs(rhesal_h(:,iw)-rhesal_cpu(:,iw)))
    write(*,'(a,es10.2)') '  |err| max=', err
    errmax = max(errmax, err)
  enddo

  write(*,*)
  if (errmax < 1.0d-10) then
    write(*,*) 'PASA: GPU y CPU coinciden dentro de tolerancia'
  else
    write(*,*) 'FALLA: diferencia maxima =', errmax
  endif

end program test_ccuerpo
