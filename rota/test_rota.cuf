! test_rota.cuf
!
! 8 casos: i1=1,2,3 con phi=+da/-da (da=1.d-4, el valor real que usa
! hpsi/mwavef.f90) para cubrir los 3 valores de i1 (y por tanto el
! ajuste de indices j1/k1 con y sin "vuelta" modulo 3), mas 2 casos
! extremos de phi (muy grande y muy pequeno) para ejercitar ramas de
! reduccion de rango distintas dentro de mysin/mycos (glibc_sincos.cuf,
! ya validado a fondo por separado -- ver glibc_math.md) con un
! argumento real de este kernel.
!
! CPU de confianza: rota de mrotaciones.f90 ORIGINAL, sin tocar.

program test_rota
 use mrota, only: k_rota
 use mrotaciones, only: rota_cpu => rota
 use mtipos, only: vec3
 use cudafor
 implicit none
 integer, parameter :: i4 = selected_int_kind(9)
 integer, parameter :: r8 = selected_real_kind(15,9)
 real(kind=r8), parameter :: da = 1.d-4

 integer(kind=i4), parameter :: n_case = 8

 integer(kind=i4) :: i1_h(n_case)
 real(kind=r8) :: phi_h(n_case)
 integer(kind=i4), device :: i1_d(n_case)
 real(kind=r8), device :: phi_d(n_case)
 type(vec3) :: ejes_h(3,n_case), ejes0(3,n_case)
 type(vec3), device :: ejes_d(3,n_case)

 type(vec3) :: ejes_cpu(3)
 integer(kind=i4) :: ic, icomp
 real(kind=r8) :: err, errmax

  ! casos 1-6: los 3 valores de i1, ambos signos de da (caso real)
  i1_h(1)=1; phi_h(1)= da
  i1_h(2)=1; phi_h(2)=-da
  i1_h(3)=2; phi_h(3)= da
  i1_h(4)=2; phi_h(4)=-da
  i1_h(5)=3; phi_h(5)= da
  i1_h(6)=3; phi_h(6)=-da
  ! casos 7-8 (extremos): phi muy grande / muy pequeno, mismo i1=1
  i1_h(7)=1; phi_h(7)=1.0d10
  i1_h(8)=1; phi_h(8)=1.0d-300

  do ic = 1, n_case
    ejes0(1,ic)%comp = (/  1.0d0,  0.2d0, -0.7d0 /)
    ejes0(2,ic)%comp = (/ -0.3d0,  1.0d0,  0.5d0 /)
    ejes0(3,ic)%comp = (/  0.8d0, -0.6d0,  1.0d0 /)
  enddo
  ! caso extra de magnitud grande en los ejes, sobre el caso 7
  ejes0(1,7)%comp = (/  1.0d8,  2.0d8, -3.0d8 /)
  ejes0(2,7)%comp = (/ -4.0d8,  5.0d8,  6.0d8 /)
  ejes0(3,7)%comp = (/  7.0d8, -8.0d8,  9.0d8 /)

  ejes_h = ejes0
  i1_d = i1_h
  phi_d = phi_h
  ejes_d = ejes_h

  call k_rota<<<1,32>>>(n_case, i1_d, phi_d, ejes_d)
  ejes_h = ejes_d

  errmax = 0.0d0
  do ic = 1, n_case
    ejes_cpu = ejes0(:,ic)
    call rota_cpu(i1_h(ic), phi_h(ic), ejes_cpu)

    write(*,*)
    write(*,'(a,i0,a,i0,a,es10.2)') '--- caso ', ic, ': i1=', i1_h(ic), ' phi=', phi_h(ic)
    err = 0.0d0
    do icomp = 1, 3
      write(*,'(a,i0,a,3es24.17)') '  eje ',icomp,' CPU=', ejes_cpu(icomp)%comp
      write(*,'(a,i0,a,3es24.17)') '  eje ',icomp,' GPU=', ejes_h(icomp,ic)%comp
      err = max(err, maxval(abs(ejes_cpu(icomp)%comp - ejes_h(icomp,ic)%comp)))
    enddo
    write(*,'(a,es10.2)') '  |err| max=', err
    errmax = max(errmax, err)
  enddo

  write(*,*)
  if (errmax < 1.0d-8) then
    write(*,*) 'PASA: GPU y CPU coinciden dentro de tolerancia'
  else
    write(*,*) 'FALLA: diferencia maxima =', errmax
  endif

end program test_rota
